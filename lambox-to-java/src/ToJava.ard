\import LambdaBox
-- Only `map`/`mkArray`/`Big`: importing Data.Array wholesale would shadow
-- String's `++` with the Array one, so array append is imported under the
-- alias `++A` (used in `appendStmts`, `concatMembers` and `compileClass`).
\import Data.Array (map, mkArray, Big, ++ \as \infixr 5 ++A)
\import Data.Bool
\import Data.Maybe
\import Data.String
\import JavaAst
\import JavaPrint
\import Set
\import StringUtil

-- =============================================================================
-- lambda-box (LBTerm) -> Java generator.
--
-- It builds `JavaAst` values (`JavaAst.ard`), NOT source text: the target
-- language is defined by that AST, and spelling it out is the sole job of the
-- trusted printer (`JavaPrint.ard`). `compileProgramWith` composes the two, so
-- callers still get a `String`.
--
-- Termination approach: Arend's foetus/size-change checker rejects a separate
-- list-typed helper that calls compileExpr (it crosses the LBTerm <-> Array
-- LBTerm type boundary). So, following arend-lib's HRS.ard
-- (`\lam i => apply (arguments i)`), compileExpr recurses over Array children
-- INLINE via `xs i` / direct projections like `(brs i).2` (same type, indexed
-- sub-term / direct projection of the recursion argument) -- never through a
-- `\case`-bound variable, which loses the structural link the checker needs.
-- For the same reason `Data.Array.map` cannot be used HERE: it hides `args i`
-- behind a closure (verified: the checker rejects it), so the inline arrays are
-- built with `mkArray {..} {xs.len} (\lam i => .. (xs i))`.
-- The per-child results are then combined by array operations (`Data.Array`'s
-- `++`/`Big`/`map`) that do NOT call compileExpr, so they terminate on their
-- own; `map` is fine there and everywhere outside the recursion.
--
-- No fresh-name counter: a structural `path : String` is passed DOWN and
-- branched per child, so names are unique without left-to-right state
-- threading (which would force a sequential helper).
--
-- Design (unchanged): untyped -> Java `Object`; closures = anonymous inner
-- classes (no invokedynamic); constructors -> `Data{int tag; Object f0, f1, f2;
-- Object[] rest}` (fields 0..2 inline, see `dataNew`/`dataField`);
-- constants -> zero-arg static methods; fix -> mutable `Fn[]` knot-tying.
--
-- The fixed part of that encoding (`Fn`, `Data` + its `toString`, `BOX`) is NOT
-- generated: it lives in the hand-written `runtime/Rt.java` shipped alongside
-- the output, and generated code refers to it through `rt` below.
--
-- Everything target-specific (the runtime class name and the representation of
-- λ□ primitive ints) is collected in the `JavaTarget` record below, which the
-- generator takes as an instance parameter instead of threading a
-- representation argument through every definition.
-- =============================================================================

-- A Java compilation target: the runtime it talks to plus the representation it
-- picks for λ□ primitive ints. This is a configuration record (no classifying
-- field), so it is passed EXPLICITLY once at the top (`compileProgramWith`) and
-- inferred from there on, as a local instance, by everything it calls.
--
-- Adding a new representation is adding a new value of this record -- no new
-- constructor and no new `\elim` clause anywhere in the generator.
--
-- Representation of λ□ primitive ints in the generated Java (`intLit` /
-- `primOpSuffix`).
--
-- KNOWN MISMATCH (documented, not fixed). A λ□ `prim (primInt, _)` is a 63-bit
-- machine integer with cyclic (mod 2^63) arithmetic -- MetaRocq's
-- erasure/theories/EPrimitive.v has `primIntModel (i : PrimInt63.int)`,
-- lean-to-lambdabox has `PrimModel .primInt := BitVec 63`, and the Rocq refman
-- ("Primitive objects / Primitive integers") specifies the width plus the
-- unsigned/signed views `Uint63`/`Sint63`. No Java type matches that, and our
-- own AST does not either (LambdaBox.ard's `PrimModel primInt => Int` is
-- unbounded). So both targets below are approximations, and the caller picks:
--   * `targetLong`       -- java.lang.Long: Java's built-in 64-bit integer. The
--     DEFAULT (see `compileProgram`), because it is the closer approximation:
--     it is a fixed-width integer with wraparound, so only the width is wrong
--     (2^64 instead of 2^63) and the sign convention differs, whereas
--     `PrimInt63` reduction is unsigned/cyclic. It is also much faster.
--   * `targetBigInteger` -- java.math.BigInteger: unbounded, never overflows,
--     but boxed arithmetic and NO wraparound. Matches OUR AST's `Int`, not the
--     source's int63 nor the C/OCaml int63 runtimes, so it is further from the
--     source semantics than `targetLong`, not more conservative. Kept because
--     unbounded arithmetic is occasionally useful when debugging.
-- Both agree with the C backend (CertiRocq's prim_int63_*) and the OCaml one
-- (unboxed OCaml `int`, cf. ExtrOCamlInt63) only while values stay well below
-- 2^62, which holds for the current examples.
-- FUTURE WORK: a third `targetInt63` value whose literals and
-- `Rt.PRIM_*` ops normalize mod 2^63 (following `Uint63`), which is the only
-- one that could be proved to agree with λ□'s evaluation relation once that
-- exists. See LambdaBox.ard's `PrimModel` and RESEARCH_AND_PLAN.md.
--
-- Everything below is parameterized by this choice; there is no default hidden
-- inside the generator (see `compileProgramWith` / `compileProgram`).
\class JavaTarget
  -- Name of the runtime class (see runtime/Rt.java); `rt` below is the qualifier
  -- used in every emitted reference, so retargeting the runtime is one field.
  | runtimeClass : String
  -- A `prim (primInt, i)` literal in this target's representation.
  | intLit : Int -> JExpr
  -- Suffix of the runtime's primitive-op constants (`Rt.PRIM_ADD_INT` vs
  -- `Rt.PRIM_ADD_LONG`); the families are otherwise identical in ABI.
  | primOpSuffix : String

-- Qualifier for every runtime reference (`Rt.`), used to build qualified names
-- for `jCallStatic`/`tClass`; `rtRef` is the same thing as an expression.
\func rt {t : JavaTarget} : String => runtimeClass ++ "."

\func rtRef {t : JavaTarget} : JExpr => jStatic runtimeClass

\func rtFn {t : JavaTarget} : JType => tClass (rt ++ "Fn")

\func rtFn2 {t : JavaTarget} : JType => tClass (rt ++ "Fn2")

\func rtFn3 {t : JavaTarget} : JType => tClass (rt ++ "Fn3")

\func rtData {t : JavaTarget} : JType => tClass (rt ++ "Data")

-- Build a constructor value. `Rt.Data` keeps its first THREE fields inline, so
-- arities 0..3 -- which is nearly every λ□ constructor -- allocate ONE object
-- and no argument array. Arity 4+ goes through the `Rt.data` factory with a
-- spill array (see Rt.java for why that is a factory and not an overload).
\func dataNew {t : JavaTarget} (tag : Nat) (fs : Array JExpr) : JExpr \elim fs
  | nil => jNew rtData (jIntLit tag :: nil)
  | a :: nil => jNew rtData (jIntLit tag :: a :: nil)
  | a :: b :: nil => jNew rtData (jIntLit tag :: a :: b :: nil)
  | a :: b :: c :: nil => jNew rtData (jIntLit tag :: a :: b :: c :: nil)
  | fs => jCallStatic (rt ++ "data") (jIntLit tag :: jNewArrayInit tObject fs :: nil)

-- Read field `i` of a constructor value: a `getfield` at a constant offset for
-- the inline fields, an index into the spill array beyond them. The index is
-- always known statically here, so `Rt.Data.field(int)` is never called by
-- generated code.
\func dataField (d : JExpr) (i : Nat) : JExpr \elim i
  | 0 => jField d "f0"
  | 1 => jField d "f1"
  | 2 => jField d "f2"
  | suc (suc (suc k)) => jIndex (jField d "rest") (jIntLit k)

\func targetLong : JavaTarget \cowith
  | runtimeClass => "Rt"
  | intLit i => jCallStatic "Long.valueOf" (jLongLit i :: nil)
  | primOpSuffix => "LONG"

\func targetBigInteger : JavaTarget \cowith
  | runtimeClass => "Rt"
  | intLit i => jNew (tClass "java.math.BigInteger") (jStringLit (intToStr i) :: nil)
  | primOpSuffix => "INT"

-- Realization of λ□ axioms (constants without a body) in the Java runtime.
-- Peregrine does this per run via `--attributes` (see ExampleMatMul.ard's
-- matMulAttrsC/OCaml, remapping onto CertiRocq's prim_int63_*); the Java
-- backend instead has this fixed table of axiom name -> runtime expression,
-- since the runtime it targets (`runtime/Rt.java`) is ours. An axiom listed
-- here compiles to the runtime constant, everything else to a throwing stub.
-- Keys are fully mangled kernames: the Lean frontend places machine-Nat
-- primitives under `Nat`, while the hand-written examples use root names.
-- Keeping the module path avoids treating an unrelated `Foo.add` as Nat.add.
--
-- The third component is the realization's CALLABLE ARITY, i.e. which of the
-- runtime's entry points it implements: every `Bin` is an `Fn2` (2), every
-- `curry`-collected operation and `EQ_REC` an `Fn3` (3), the rest a plain `Fn`
-- (1). `applySpine` uses it to call the entry point directly instead of going
-- through the shared `Rt.app2`/`app3` dispatcher. It is the arity of the
-- REALIZATION, not of the axiom: a `curry`-collector accepts three arguments
-- even when it collects only two (`Rt.step` handles over-application), and a
-- shorter spine simply falls back to the dispatcher.
\func javaAxioms {t : JavaTarget} : Array (\Sigma String JExpr Nat) =>
  \let | op (nm : String) => jField rtRef ("PRIM_" ++ nm ++ "_" ++ primOpSuffix)
       -- An operation that neither takes nor returns a λ□ primitive int is the
       -- same in both representations, so it has ONE runtime constant.
       | fixed (nm : String) => jField rtRef nm
  \in ("c___prim_add_int", op "ADD", 2) ::
      ("c___prim_mul_int", op "MUL", 2) ::
      ("c___prim_sub_int", op "SUB", 2) ::
      ("c___prim_eqb_int", op "EQB", 2) ::
      ("c__Nat__add", op "ADD", 2) ::
      ("c__Nat__mul", op "MUL", 2) ::
      -- NOT `op "SUB"`: Lean's Nat subtraction truncates at zero, while
      -- `prim_sub_int` is Peregrine's wrapping int63 subtraction.
      ("c__Nat__sub", jField rtRef ("NAT_SUB_" ++ primOpSuffix), 2) ::
      ("c__Nat__beq", op "EQB", 2) ::
      -- The rest of the machine-Nat operations lean-to-lambdabox leaves as
      -- axioms. `div`/`mod` follow Lean's total conventions and
      -- `decEq`/`decLe`/`decLt` return `Decidable`, not `Bool` (see Rt.java).
      ("c__Nat__div", op "DIV", 2) ::
      ("c__Nat__mod", op "MOD", 2) ::
      ("c__Nat__pow", op "POW", 2) ::
      ("c__Nat__ble", op "BLE", 2) ::
      ("c__Nat__blt", op "BLT", 2) ::
      ("c__Nat__decEq", op "DEC_EQ", 2) ::
      ("c__Nat__decLe", op "DEC_LE", 2) ::
      ("c__Nat__decLt", op "DEC_LT", 2) ::
      -- Lean's machine-`Int` operations. `Int` erases to the same λ□ primitive
      -- int as `Nat`, so `ofNat` is the identity in both representations.
      ("c__Int__ofNat", fixed "INT_OF_NAT", 1) ::
      ("c__Int__negSucc", jField rtRef ("INT_NEG_SUCC_" ++ primOpSuffix), 1) ::
      ("c__Int__neg", jField rtRef ("INT_NEG_" ++ primOpSuffix), 1) ::
      ("c__Int__add", jField rtRef ("INT_ADD_" ++ primOpSuffix), 2) ::
      ("c__Int__mul", jField rtRef ("INT_MUL_" ++ primOpSuffix), 2) ::
      ("c__Int__ediv", jField rtRef ("INT_EDIV_" ++ primOpSuffix), 2) ::
      ("c__Int__emod", jField rtRef ("INT_EMOD_" ++ primOpSuffix), 2) ::
      ("c__Int__decEq", jField rtRef ("INT_DEC_EQ_" ++ primOpSuffix), 2) ::
      -- Lean's `Array` operations (`@[extern]`, so erasure keeps no body). Only
      -- `size` returns a Nat, hence only it depends on the representation. The
      -- Lean frontend writes `!` in a name as `_u33`.
      ("c__Array__mk", fixed "ARRAY_MK", 3) ::
      ("c__Array__emptyWithCapacity", fixed "ARRAY_EMPTY_WITH_CAPACITY", 3) ::
      ("c__Array__push", fixed "ARRAY_PUSH", 3) ::
      ("c__Array__getInternal", fixed "ARRAY_GET_INTERNAL", 3) ::
      ("c__Array__get_u33Internal", fixed "ARRAY_GET_BANG_INTERNAL", 3) ::
      ("c__Array__set_u33", fixed "ARRAY_SET_BANG", 3) ::
      ("c__Array__swap", fixed "ARRAY_SWAP", 3) ::
      ("c__Array__size", jField rtRef ("ARRAY_SIZE_" ++ primOpSuffix), 3) ::
      -- Rewriting along an equality is the identity at runtime.
      ("c__Eq__rec", fixed "EQ_REC", 3) ::
      ("c__Eq__ndrec", fixed "EQ_REC", 3) ::
      nil

-- Lookup by fully mangled kername, including its module path.
\func lookupAxiom (name : String) (tbl : Array (\Sigma String JExpr Nat)) : Maybe JExpr \elim tbl
  | nil => nothing
  | e :: tbl => \case e.1 == name \with {
    | true => just e.2
    | false => lookupAxiom name tbl
  }

-- The same lookup for the realization's callable arity; 0 = "not an axiom".
\func lookupAxiomArity (name : String) (tbl : Array (\Sigma String JExpr Nat)) : Nat \elim tbl
  | nil => 0
  | e :: tbl => \case e.1 == name \with {
    | true => e.3
    | false => lookupAxiomArity name tbl
  }

-- Compilation result: (statements to run first, value expression).
\func Out : \Type => \Sigma (Array JStmt) JExpr

-- The environment maps a de Bruijn index to the EXPRESSION that denotes it:
-- usually a variable (`jVar "p3"`), but a `fix` slot is an array element
-- (`x3[0]`), which is why this is an `Array JExpr` and not an `Array JIdent`.
-- Head = index 0.
-- An index larger than the number of enclosing binders is ill-formed input (a
-- closed λ□ program has none), so instead of a silent `null` we emit a runtime
-- call that fails immediately and reports the index and the node.  `n0` is the
-- original index, kept for the message while `n` counts down.
--
-- Each entry also carries the KNOWN CALLABLE ARITY of the value it denotes (0 =
-- unknown): a `fix` slot holds a function we compiled ourselves, so its arity is
-- known and a call to it needs no dispatcher (see `applySpine`). Lambda
-- parameters and constructor fields are opaque, hence 0.
\func Env : \Type => Array (\Sigma JExpr Nat)

-- An env entry for a value of unknown arity.
\func opaque (e : JExpr) : \Sigma JExpr Nat => (e, 0)

\func nthVar {t : JavaTarget} (n : Nat) (env : Env) (n0 : Nat) (path : String) : JExpr \elim n, env
  | _, nil => jCallStatic (rt ++ "unbound") (jIntLit n0 :: jStringLit path :: nil)
  | 0, x :: _ => x.1
  | suc n, _ :: env => nthVar n env n0 path

\func nthArity (n : Nat) (env : Env) : Nat \elim n, env
  | _, nil => 0
  | 0, x :: _ => x.2
  | suc n, _ :: env => nthArity n env

-- Array append and flattening of per-child results. Both come from Data.Array;
-- neither calls compileExpr, so the recursion above stays in its own SCC.
-- `appendStmts` is the main place the aliased array append `++A` is used (see
-- the import).
\func appendStmts (xs ys : Array JStmt) : Array JStmt => xs ++A ys

\func concatStmtBlocks (bs : Array (Array JStmt)) : Array JStmt => Big appendStmts nil bs

-- The statements of a sequence of child results, in order.
\func concatStmts (rs : Array Out) : Array JStmt => concatStmtBlocks (map (\lam r => r.1) rs)

-- Emit the call for a flattened application spine (see the `app` clause of
-- compileExpr). A 1-argument spine stays the plain curried call, so nothing
-- changes for the common case; 2- and 3-argument spines become ONE call to the
-- runtime dispatcher `Rt.app2`/`Rt.app3`, which hits the callee's Fn2/Fn3
-- entry point directly when arities match (one interface call, arguments in
-- registers, no intermediate closures) and falls back to the curried protocol
-- otherwise. Longer spines are chunked: app3 on the first three arguments,
-- then recurse on the rest (structural on `args`).
--
-- `ar` is the head's KNOWN callable arity (0 = unknown, see `headArity`). When
-- the spine has at least that many arguments the entry point is called DIRECTLY
-- -- `((Rt.Fn2) f).apply(a, b)` -- with no runtime check and, more importantly,
-- at a call site of its own: profiling showed `Rt.app2`/`app3` as the hottest
-- frame of both matmul cases (77%/85% of samples), because one shared static
-- helper is a single maximally megamorphic dispatch that the JIT cannot inline
-- through, whereas a per-site `apply` sees only the few callees that reach it.
-- The remaining arguments continue with arity 0, since the result of a
-- saturated call is an unknown value again.
\func applySpine {t : JavaTarget} (ar : Nat) (f : JExpr) (args : Array JExpr) : JExpr \elim ar, args
  | _, nil => f
  | 1, a :: args => applySpine 0 (jInvoke (jCast rtFn f) "apply" (a :: nil)) args
  | 2, a :: b :: args => applySpine 0 (jInvoke (jCast rtFn2 f) "apply" (a :: b :: nil)) args
  | 3, a :: b :: c :: args => applySpine 0 (jInvoke (jCast rtFn3 f) "apply" (a :: b :: c :: nil)) args
  | _, a :: nil => jInvoke (jCast rtFn f) "apply" (a :: nil)
  | _, a :: b :: nil => jCallStatic (rt ++ "app2") (f :: a :: b :: nil)
  | _, a :: b :: c :: nil => jCallStatic (rt ++ "app3") (f :: a :: b :: c :: nil)
  | _, a :: b :: c :: args => applySpine 0 (jCallStatic (rt ++ "app3") (f :: a :: b :: c :: nil)) args

-- Callable arity of a compiled value, i.e. which of `Rt.Fn`/`Fn2`/`Fn3` the
-- generated object implements. A lambda nest compiles to one class with a
-- multi-argument entry point (see compileExpr), capped at 3; anything else is
-- opaque here.
\func lamDepth (t : LBTerm) : Nat
  | lambda _ (lambda _ (lambda _ _)) => 3
  | lambda _ (lambda _ _) => 2
  | lambda _ _ => 1
  | _ => 0

-- Arity of the j-th slot of a `fix`: the slot holds the compiled lambda nest of
-- that definition's body. Total in `j`, so no `Fin` juggling at the use sites.
\func fixSlotArity (j : Nat) (defs : Array (FixDef LBTerm)) : Nat \elim j, defs
  | _, nil => 0
  | 0, d :: _ => lamDepth d.defBody
  | suc j, _ :: defs => fixSlotArity j defs

-- Arity of the value a term evaluates to, for the cases where we can see it: a
-- lambda nest, or a `fix` (whose value is the selected slot).
\func valueArity (t : LBTerm) : Nat
  | fix defs i => fixSlotArity i defs
  | t => lamDepth t

-- Kername -> Java method name. Every source component is encoded at this one
-- boundary; the fixed separators and leading `c_` are legal by construction.
\func joinDirs (ds : Array String) : String \elim ds
  | nil => ""
  | d :: nil => javaIdentPart d
  | d :: ds => javaIdentPart d ++ "_" ++ joinDirs ds

\func mangleModPath (mp : ModPath) : String \elim mp
  | mpFile dp => joinDirs dp
  | mpBound dp id n => joinDirs dp ++ "_" ++ javaIdentPart id ++ "_" ++ natToStr n
  | mpDot mp id => mangleModPath mp ++ "_" ++ javaIdentPart id

\func mangleKername (k : Kername) : String =>
  "c_" ++ mangleModPath k.kerModPath ++ "__" ++ javaIdentPart k.kerName

-- Bind a branch's fields to fresh locals, starting at field index `fieldIx`
-- (= npars, to skip inductive parameters). Returns (bind-statements, extended env).
-- Recurses on the binder array only; never calls compileExpr.
-- Pushing left-to-right makes the LAST binder de Bruijn index 0 (matches iota_red).
\func bindFields (dv : JExpr) (fieldIx : Nat) (bs : Array BinderName) (env : Env) (path : String)
  : \Sigma (Array JStmt) Env \elim bs
  | nil => (nil, env)
  | _ :: bs =>
    \let | nm => "g" ++ natToStr fieldIx ++ path
         | st => jLocal true tObject nm (just (dataField dv fieldIx))
         | r  => bindFields dv (suc fieldIx) bs (opaque (jVar nm) :: env) path
    \in (st :: r.1, r.2)

-- Push the k fix slots arr[0..k-1] onto env; head = arr[k-1] = de Bruijn 0
-- (= the LAST mutually-defined function, matching λ□'s fix_subst). No compileExpr.
-- Each slot's arity is the lambda depth of its own body, so a recursive call is
-- compiled as a direct `apply` (see applySpine) rather than a dispatch.
\func pushFix (arr : String) (defs : Array (FixDef LBTerm)) (j k : Nat) (env : Env) : Env \elim k
  | 0 => env
  | suc k => pushFix arr defs (suc j) k ((jIndex (jVar arr) (jIntLit j), fixSlotArity j defs) :: env)

-- Occurrence count of de Bruijn index `n`, used to decide whether a `let`-bound
-- lambda may be SUNK into its use site (see compileExpr's letIn clause). An
-- occurrence under a lambda or fix binder is counted TWICE: it is reached once
-- per call of the enclosing function, so sinking there would turn one allocation
-- into many. Hence `occ 0 body <= 1` means "evaluated at most once, right here".
\func natEq (a b : Nat) : Bool \elim a, b
  | 0, 0 => true
  | suc a, suc b => natEq a b
  | _, _ => false

\func addNat (a b : Nat) : Nat => a Nat.+ b

\func occ (n : Nat) (t : LBTerm) : Nat \elim t
  | box => 0
  | bvar k => \case natEq k n \with { | true => 1 | false => 0 }
  | fvar _ => 0
  | const _ => 0
  | prim _ => 0
  | lambda _ b => \let o => occ (suc n) b \in addNat o o
  | letIn _ v b => addNat (occ n v) (occ (suc n) b)
  | app f a => addNat (occ n f) (occ n a)
  | proj _ s => occ n s
  | construct _ _ args => Big addNat 0 (mkArray {Nat} {args.len} (\lam i => occ n (args i)))
  | case _ _ s brs =>
    addNat (occ n s)
           (Big addNat 0 (mkArray {Nat} {brs.len} (\lam i => occ (addNat n (brs i).1.len) (brs i).2)))
  | fix defs _ =>
    \let o => Big addNat 0 (mkArray {Nat} {defs.len} (\lam j => occ (addNat n defs.len) (defs j).defBody))
    \in addNat o o

-- May the `let`'s value be sunk into the body instead of bound to a local? Only
-- if it is a lambda (allocation only -- no evaluation to duplicate or lose) and
-- the body uses it at most once, unconditionally-per-evaluation. This is the
-- shape Lean's matchers always produce: every branch alternative is a lambda
-- `let`-bound before the `switch` and used in exactly ONE branch, so without
-- sinking all of them are allocated on every call. Profiling `lean-matmul`
-- attributed 92% of its allocation to exactly these dead alternatives.
\func sinkable (value body : LBTerm) : Bool =>
  \case lamDepth value \with {
    | 0 => false
    | _ => \case occ 0 body \with { | 0 => true | 1 => true | _ => false }
  }

-- Core compiler. `path` uniquely identifies this node; binder names and child
-- paths are derived from it, so no state threading is needed.
-- `cas` maps a mangled top-level name to the callable arity of the value its
-- generated method returns (0 = unknown); see `constArities` and `headArity`.
\func compileExpr {tgt : JavaTarget} (cas : Array (\Sigma String Nat)) (env : Env) (path : String) (t : LBTerm) : Out \elim t
  | box => (nil, jField rtRef "BOX")

  | bvar n => (nil, nthVar n env n path)

  -- A locally-nameless free variable has no Java counterpart at all (the
  -- serializer likewise emits `tVar_UNREACHABLE`), so compile it to a throwing
  -- runtime call naming the variable rather than to a silent `null`.
  | fvar v => (nil, jCallStatic (rt ++ "freeVar") (jStringLit v.varName :: jStringLit path :: nil))

  | prim (primInt, i) => (nil, intLit i)

  | const k => (nil, jCallStatic (mangleKername k) nil)

  -- Application: flatten the left-nested binary spine `((f a) b) c` into ONE
  -- call site (Malfunction's `Mapply_u`, done while compiling). `compileApp`
  -- walks down the function side collecting already-compiled arguments, and
  -- `applySpine` emits either the plain unary `.apply` (spine of length 1,
  -- unchanged) or a single `Rt.app2`/`Rt.app3` dispatch.
  | app f a =>
    \let oa => compileExpr cas env ("A" ++ path) a
    \in compileApp cas env ("F" ++ path) f (oa.1 :: nil) (oa.2 :: nil)

  -- Lambda nests compile to ONE anonymous class with a real multi-argument
  -- entry point: 3+-deep nests to Rt.Fn3, 2-deep to Rt.Fn2, single lambdas to
  -- Rt.Fn as before. The interfaces' default unary `apply` provides partial
  -- application, so this is invisible to curried callers. Parameters read
  -- outside-in (`p`, `q`, `s`), so the innermost binder is de Bruijn 0.
  -- A deeper nest (arity 4+) is an Fn3 whose body returns the remaining
  -- lambdas -- exactly matching applySpine's 3-argument chunking.
  | lambda _ (lambda _ (lambda _ body)) =>
    \let | pv => "p" ++ path
         | qv => "q" ++ path
         | sv => "s" ++ path
         | ob => compileExpr cas (opaque (jVar sv) :: opaque (jVar qv) :: opaque (jVar pv) :: env) ("L" ++ path) body
    \in (nil, jAnonFn3 rtFn3 pv qv sv (appendStmts ob.1 (jReturn ob.2 :: nil)))

  | lambda _ (lambda _ body) =>
    \let | pv => "p" ++ path
         | qv => "q" ++ path
         | ob => compileExpr cas (opaque (jVar qv) :: opaque (jVar pv) :: env) ("L" ++ path) body
    \in (nil, jAnonFn2 rtFn2 pv qv (appendStmts ob.1 (jReturn ob.2 :: nil)))

  | lambda _ body =>
    \let | pv => "p" ++ path
         | ob => compileExpr cas (opaque (jVar pv) :: env) ("L" ++ path) body
    \in (nil, jAnonFn rtFn pv (appendStmts ob.1 (jReturn ob.2 :: nil)))

  -- let: normally a `final Object l<path> = <value>;` local before the body.
  -- A `let`-bound LAMBDA used at most once is SUNK instead: its expression is
  -- substituted at the single use site, so the closure is allocated only if that
  -- code is reached (inside one `switch` branch, typically) instead of always.
  -- See `sinkable`. Nothing is duplicated (at most one occurrence) and nothing
  -- is reordered that could matter -- building a closure has no other effect.
  | letIn _ value body =>
    \let | ov => compileExpr cas env ("V" ++ path) value
         | lv => "l" ++ path
    \in \case sinkable value body \with {
      | true =>
        \let ob => compileExpr cas ((ov.2, lamDepth value) :: env) ("B" ++ path) body
        \in (appendStmts ov.1 ob.1, ob.2)
      | false =>
        \let ob => compileExpr cas (opaque (jVar lv) :: env) ("B" ++ path) body
        \in (appendStmts ov.1 (jLocal true tObject lv (just ov.2) :: ob.1), ob.2)
    }

  -- construct: recurse inline over the Array of args.
  | construct _ cidx args =>
    \let | results => mkArray {Out} {args.len} (\lam i => compileExpr cas env ("c" ++ natToStr i ++ path) (args i))
    \in (concatStmts results, dataNew cidx (map (\lam r => r.2) results))

  -- case: switch on the scrutinee's tag; each branch binds fields[npars ..] then
  -- evaluates its body. We map inline over `brs i`, binding the body by pattern.
  -- The switch has no value, so the branches assign to a result local `r<path>`,
  -- which is this node's value expression.
  | case _ npars scrut brs =>
    \let | os => compileExpr cas env ("S" ++ path) scrut
         | dv => "d" ++ path
         | rv => "r" ++ path
         -- Recurse on the DIRECT projection `(brs i).2`, NOT a `\case`-bound
         -- variable: the checker tracks `(brs i).2 < t` (index into the sub-term
         -- `brs`, then project) but loses that through a `\case` pattern binding.
         | cases => mkArray {\Sigma Nat (Array JStmt)} {brs.len} (\lam i =>
             \let | bp  => "b" ++ natToStr i ++ path
                  | bnd => bindFields (jVar dv) npars (brs i).1 env bp
                  | ob  => compileExpr cas bnd.2 bp (brs i).2
             \in (i, appendStmts bnd.1 (appendStmts ob.1 (jAssign (jVar rv) ob.2 :: nil))))
    \in (appendStmts os.1
           (jLocal true rtData dv (just (jCast rtData os.2)) ::
            jLocal false tObject rv nothing ::
            jSwitch (jField (jVar dv) "tag") cases
              (jThrow (jNew (tClass "RuntimeException") (jStringLit "no matching branch" :: nil)) :: nil) ::
            nil),
         jVar rv)

  -- proj: the AST has no arithmetic node, so `npars + idx` is added here.
  | proj pinfo scrut =>
    \let | os => compileExpr cas env ("P" ++ path) scrut
    \in (os.1,
         dataField (jCast rtData os.2) (pinfo.projParamCount Nat.+ pinfo.projFieldIdx))

  -- fix: mutable Fn[] + knot-tying; map inline over `defs j`, projecting the
  -- body directly (`(defs j).defBody`), same reasoning as `case` above.
  | fix defs idx =>
    \let | arr => "x" ++ path
         | k   => defs.len
         | env' => pushFix arr defs 0 k env
         | assigns => mkArray {Array JStmt} {k} (\lam j =>
             \let | ob => compileExpr cas env' ("y" ++ natToStr j ++ path) (defs j).defBody
             \in appendStmts ob.1 (jAssign (jIndex (jVar arr) (jIntLit j)) (jCast rtFn ob.2) :: nil)
         )
    \in (jLocal true (tArray rtFn) arr (just (jNewArraySized rtFn (jIntLit k))) ::
           concatStmtBlocks assigns,
         jIndex (jVar arr) (jIntLit idx))

-- Spine collector for `app` (mutual with compileExpr). Walks the FUNCTION side
-- of a left-nested application, compiling each argument as it is passed and
-- PREPENDING it, so the accumulators end up left-to-right; statements run in
-- head-then-arguments order. Termination: the `app` clause recurses on the
-- direct sub-term `f`, and the catch-all hands the SAME term to compileExpr --
-- every cycle through the compileExpr/compileApp SCC still strictly decreases
-- the LBTerm argument (compileExpr's `app` clause enters with the sub-term `f`).
\func compileApp {tgt : JavaTarget} (cas : Array (\Sigma String Nat)) (env : Env) (path : String) (t : LBTerm)
                 (argStmts : Array (Array JStmt)) (argExprs : Array JExpr) : Out \elim t
  | app f a =>
    \let oa => compileExpr cas env ("A" ++ path) a
    \in compileApp cas env ("F" ++ path) f (oa.1 :: argStmts) (oa.2 :: argExprs)
  | t =>
    \let | of => compileExpr cas env path t
         -- Only a spine of TWO or more arguments can profit from a known arity
         -- (a 1-argument spine compiles to the same `.apply(a)` either way), and
         -- `headArity`'s table lookups compare mangled names, so this gate keeps
         -- generation time down on programs with many unary applications.
         | ar => spineArity cas env t argExprs
    \in (appendStmts of.1 (concatStmtBlocks argStmts), applySpine ar of.2 argExprs)

\func spineArity {tgt : JavaTarget} (cas : Array (\Sigma String Nat)) (env : Env) (t : LBTerm)
                 (args : Array JExpr) : Nat \elim args
  | _ :: _ :: _ => headArity cas env t
  | _ => 0

-- Callable arity of a spine's HEAD, whenever it can be read off the term: a
-- lambda nest is compiled here (so we know it), a `fix` slot and a `let`-sunk
-- lambda carry their arity in the environment, an axiom's arity comes from
-- `javaAxioms`, and a top-level constant's from the program-wide table `cas`.
-- Everything else is 0 = unknown, and keeps the `Rt.app2`/`app3` dispatch.
\func headArity {tgt : JavaTarget} (cas : Array (\Sigma String Nat)) (env : Env) (t : LBTerm) : Nat \elim t
  | bvar n => nthArity n env
  | const k =>
    \let | nm => mangleKername k
         | a  => lookupAxiomArity nm javaAxioms
    \in \case a \with { | 0 => lookupNat nm cas | _ => a }
  | lambda _ (lambda _ (lambda _ _)) => 3
  | lambda _ (lambda _ _) => 2
  | lambda _ _ => 1
  | fix defs i => fixSlotArity i defs
  | _ => 0

\func lookupNat (name : String) (tbl : Array (\Sigma String Nat)) : Nat \elim tbl
  | nil => 0
  | e :: tbl => \case e.1 == name \with {
    | true => e.2
    | false => lookupNat name tbl
  }


-- ---------------------------------------------------------------------------
-- Program assembly.
-- ---------------------------------------------------------------------------

-- Every generated member is a `public static Object f(){ .. }`, so this is the
-- only method shape the assembly needs.
\func constMethod (name : String) (body : Array JStmt) : JMember =>
  jMethod (\new JMethod true tObject name nil body)

-- NOT MEMOIZED, and measured: giving each constant a `private static Object
-- memo_c_foo` cell filled on the first call (`if (memo_c_foo == null) ..`) makes
-- `lean-deriv` SLOWER -- 38-40 s -> 41-43 s wall, 57 s -> 66 s CPU -- even
-- though it removes >2 GB of allocation (Lean's typeclass dictionaries, rebuilt
-- at every use because λ□ has no sharing of top-level definitions: `const k` is
-- a call). The JVM was already handling this better than a cache can: a freshly
-- built dictionary is a type-exact, non-escaping object, so escape analysis
-- deletes the allocation and the `apply` on it is monomorphic and inlined,
-- whereas a value loaded from a mutable static field has unknown type -- a real
-- virtual dispatch plus a memory load per use. (Same conclusion as the
-- pre-Fn2/Fn3 memoization experiment, now with allocation numbers to explain
-- it.) The `jIfNull`/`jStaticField` AST nodes the experiment needed were
-- removed again; a future *typed* dictionary hoist would reintroduce them.

-- Callable arity of what a top-level declaration's generated method RETURNS, so
-- that a call `Rt.app2(c_foo(), a, b)` can become `((Rt.Fn2) c_foo()).apply(a, b)`
-- (see headArity/applySpine). λ□ has no arity in its syntax, so this is read off
-- the body: its leading lambdas, or -- for the usual `\let rec` shape -- the
-- leading lambdas of the selected `fix` slot. Axioms get theirs from javaAxioms.
\func constArities (ds : GlobalDeclarations) : Array (\Sigma String Nat) =>
  map (\lam d => (mangleKername d.1, declArity d.2)) ds

\func declArity (d : GlobalDecl) : Nat => \case d \with {
  | constantDecl cb => \case cb.cstBody \with {
    | just body => valueArity body
    | nothing => 0
  }
  | inductiveDecl _ => 0
}

\func compileDecl {t : JavaTarget} (cas : Array (\Sigma String Nat)) (kd : \Sigma Kername GlobalDecl) : Array JMember =>
  \let | name => mangleKername kd.1
  \in \case kd.2 \with {
    | constantDecl cb => \case cb.cstBody \with {
      | just body =>
        \let | o => compileExpr cas nil "" body
        \in constMethod name (appendStmts o.1 (jReturn o.2 :: nil)) :: nil
      | nothing => \case lookupAxiom name javaAxioms \with {
        -- An axiom's realization is a runtime constant already (`Rt.PRIM_ADD_LONG`),
        -- so there is nothing to cache.
        | just impl => constMethod name (jReturn impl :: nil) :: nil
        | nothing =>
          constMethod name
            (jThrow (jNew (tClass "RuntimeException")
                          (jStringLit ("axiom " ++ name ++ " not implemented") :: nil)) :: nil) :: nil
      }
    }
    | inductiveDecl _ =>
      jMemberComment ("inductive " ++ name ++ ": erased; values use Data(tag, fields)") :: nil
  }

\func compileDecls {t : JavaTarget} (cas : Array (\Sigma String Nat)) (ds : GlobalDeclarations) : Array JMember =>
  concatMembers (map (\lam d => compileDecl cas d) ds)

\func concatMembers (ms : Array (Array JMember)) : Array JMember \elim ms
  | nil => nil
  | m :: ms => m ++A concatMembers ms

-- `__main` holds the program's body; `main` is the entry point printing it.
\func compileMain {tgt : JavaTarget} (cas : Array (\Sigma String Nat)) (t : LBTerm) : Array JMember =>
  \let | o => compileExpr cas nil "" t
  \in constMethod "__main" (appendStmts o.1 (jReturn o.2 :: nil)) ::
      jMethod (\new JMethod true tVoid "main"
                 ((\new JParam (tArray (tClass "String")) "args") :: nil)
                 (jExprStmt (jInvoke (jStatic "System.out") "println"
                                     (jCallStatic "__main" nil :: nil)) :: nil)) ::
      nil

-- Only the program-specific class is generated; `Fn`, `Data` (with its
-- human-readable `toString`) and `BOX` come from the hand-written runtime class
-- `runtime/Rt.java`, which must be compiled together with this output.
\func compileClass {t : JavaTarget} (p : LBProgram) : JClass =>
  \let cas => constArities p.1
  \in \new JClass "Prog" (compileDecls cas p.1 ++A compileMain cas p.2)

-- The generator and the printer, composed. The int representation is explicit
-- here; `compileProgram` below fixes it to `targetLong`, the representation
-- closest to λ□'s int63 (see `JavaTarget`).
\func compileProgramWith (t : JavaTarget) (p : LBProgram) : String => printClass (compileClass p)

\func compileProgram (p : LBProgram) : String => compileProgramWith targetLong p

-- Print a generated program with `putStrLn` (Data.String -> console).
-- \import Debug
-- \func main => putStrLn (compileProgram (nil, prim (primInt, -44)))