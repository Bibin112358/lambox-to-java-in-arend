\import Data.Maybe
\import Proof.CompileValue
\import Proof.CompileValueLemmas (cvValRel)
\import Proof.Statement (ValRel, progClassName)
\import Proof.EnvToJava
\import Semantics.LambdaBoxEnv
\import Proof.SubstToEnv (evalToEvalEnv)
\import Semantics.JavaEval
\import Proof.JavaExec (execRetApp, bindOk)
\import Semantics.JavaValue
\import Semantics.LambdaBoxEval
\import Semantics.Res
\import Compiler.JavaAst
\import Compiler.LambdaBox
\import Paths
\import Paths.Meta
\import Compiler.ToJava

-- =============================================================================
-- THE BACKEND IS CORRECT ON CLOSED PROGRAMS: the two steps composed.
--
--   λ□ by substitution  --evalToEvalEnv-->  λ□ by environments  --simE-->  Java
--   (Semantics/LambdaBoxEval)  (Proof/SubstToEnv)  (Semantics/LambdaBoxEnv)  (Proof/EnvToJava)
--
-- `backendCorrect`: if λ□ evaluates a closed program (closed body, closed
-- constant bodies) to `v`, then the compiled class's `body()` RETURNS -- never
-- throws, never gets stuck -- a Java value `CV`-related to an environment
-- value `w` whose read-back is `v` (for a function: the closure compiled from
-- it). `backendCorrectFO`: for a first-order `v`, that value satisfies
-- `ValRel` (Proof/Statement.ard).
--
-- Closedness is needed because λ□'s substitution captures free variables. The
-- other hypotheses are `SimHyps` (class, runtime and oracle facts, discharged
-- for the shipped backend in Proof/MainTheorem.ard) and `BodyAt`, where
-- `body()` is. As upstream (MetaRocq's `verified_malfunction_pipeline_theorem`),
-- the guarantee a Java caller can inspect is the first-order one.
-- =============================================================================

-- The class has a `body()` method compiled from `t`.
\func BodyAt (cls : JClass) (t : LBTerm) : \Type =>
  \Sigma (m : JMethod) (lookupMethod cls bodyMethodName = just m) (JMethod.mBody {m} = constBody t)

\func backendCorrect {spec : LBSpec} {rt : RtSpec} {p : LBProgram} {v : LBTerm}
                     (H : SimHyps spec rt (compileClass progClassName p) p.1)
                     (hBody : BodyAt (compileClass progClassName p) p.2)
                     (gc : GlobClosed p.1) (ct : LCf 0 p.2) (d : EvalProgram spec p v)
  : \Sigma (w : EV) (v = quote w) (jv : Value)
           (JEval rt (compileClass progClassName p) bodyMethodName jv)
           (CV rt (compileClass progClassName p) w jv) =>
  \let | cls => compileClass progClassName p
       | s1 => evalToEvalEnv {spec} {p.1} H.hFO gc ct d
       | r => simE H s1.2 {nil} {nil} {nil} erNil
       | vv => r.5 nil ()
       | ex => execRetApp r.4 vv.3
       | cs : callStatic rt cls (suc ex.1) bodyMethodName nil = rOk (eVal vv.1) =>
         rewrite hBody.2 (bindOk (transport (\lam B => execStmts rt cls ex.1 nil B = rOk (oReturn vv.1)) (inv hBody.3) ex.2) idp)
  \in (s1.1, s1.3, vv.1, (suc ex.1, bindOk cs idp), vv.4)

\func backendCorrectFO {spec : LBSpec} {rt : RtSpec} {p : LBProgram} {v : LBTerm}
                       (H : SimHyps spec rt (compileClass progClassName p) p.1)
                       (hBody : BodyAt (compileClass progClassName p) p.2)
                       (gc : GlobClosed p.1) (ct : LCf 0 p.2) (d : EvalProgram spec p v) (fo : FOVal v)
  : \Sigma (jv : Value) (JEval rt (compileClass progClassName p) bodyMethodName jv) (ValRel v jv) =>
  \let r => backendCorrect H hBody gc ct d
  \in (r.3, r.4, transport (ValRel __ r.3) (inv r.2) (cvValRel r.1 r.5 (transport FOVal r.2 fo)))
