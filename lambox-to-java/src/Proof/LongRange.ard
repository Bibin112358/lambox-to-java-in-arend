\import Algebra.Meta
\import Arith.Int (iabs)
\import Arith.Nat
\import Data.Bool
\import Data.Maybe
\import Data.String
\import Logic
\import Meta
\import Order.Biordered
\import Order.PartialOrder
\import Order.StrictOrder
\import Paths
\import Paths.Meta
\import Set
\import Compiler.Int63 (int63Mod, int64Mod, signed64, norm63, wrap63)
\import Compiler.JavaAst
\import Proof.Mod64 (m64, modU<, modU64-eq, signed64-read)
\import Proof.OracleArith (eqTrue, minusLt, minusNeg<=, minusCancel, signB)
\import Semantics.JavaValue
\import Semantics.Res
\import Semantics.RtInt63
\import Semantics.RtLong

-- =============================================================================
-- Every `long` the model can produce is a real Java `long`.
--
-- `vLong` (`Semantics/JavaValue.ard`) holds an unbounded `Int`, while a Java
-- `long` lies in [-2^63, 2^63). The Java fragment never computes on longs, so
-- they come from compiler literals (`int63LitIn`, `longLitIn`) or from the
-- runtime model `rtInt63`: its builtins return only in-range longs, on any
-- arguments (`builtinRunIn`), `Long.valueOf` returns its in-range argument
-- (`staticCallIn`), and no field is a long (`rtFieldIn`).
-- =============================================================================

-- `-P <= x < P`. The bound stays abstract (see `Proof/OracleArith.ard`).
\func InRange (P : Nat) (x : Int) : \Prop \elim x
  | pos n => n < P
  | neg (suc n) => suc n <= P

-- A Java `long`: -2^63 <= x < 2^63.
\func InLong (x : Int) : \Prop => InRange pow2_63 x

-- Every `vLong` among `vs` is a Java `long`.
\func LongsIn (vs : Array Value) : \Prop =>
  \Pi (j : Fin vs.len) {x : Int} -> vs j = vLong x -> InLong x

-- ---------------------------------------------------------------------------
-- Reading a residue signed lands in range, for abstract `P` and `M = P + P`.
-- ---------------------------------------------------------------------------

-- A residue `r < M`, read signed modulo `M = P + P`, is in [-P, P).
\lemma readIn (P M r : Nat) (hM : M = P Nat.+ P) (hr : r < M) : InRange P (readSigned M r (r Nat.- P)) =>
  \case r Nat.- P \as d, idp : r Nat.- P = d \return InRange P (readSigned M r d) \with {
    | pos k, p =>
      \let | er : r = k Nat.+ P => minusPosEq p
           | t : k Nat.+ P < P Nat.+ P => transport2 (<) er hM hr
           | kP : k < P => linarith
           | lt => minusLt kP
           | e : r Nat.- M = neg (suc lt.1) => pmap2 (Nat.-) er hM *> minusCancel k P P *> lt.2
      \in transportInv (InRange P) e (minusNeg<= lt.2)
    | neg (suc k), p => minusNegLt p
  }
  \where {
    -- | `a - b` is negative only if `a < b`.
    \lemma minusNegLt {a b k : Nat} (e : a Nat.- b = neg (suc k)) : a < b \elim a, b
      | 0, 0 => \case pmap signB e \with {}
      | 0, suc b => NatOrder.zero<suc
      | suc a, 0 => \case pmap signB e \with {}
      | suc a, suc b => NatOrder.suc<suc (minusNegLt e)

    -- | `a - b = k` means `a = k + b`.
    \lemma minusPosEq {a b k : Nat} (e : a Nat.- b = pos k) : a = k Nat.+ b \elim a, b
      | 0, 0 => pmap iabs e
      | 0, suc b => \case pmap signB e \with {}
      | suc a, 0 => pmap iabs e
      | suc a, suc b => pmap suc (minusPosEq e)
  }

-- ---------------------------------------------------------------------------
-- The runtime's normal forms are in range.
-- ---------------------------------------------------------------------------

-- `wrap64` always lands in range: `long` arithmetic cannot leave a `long`.
\lemma wrap64In (z : Int) : InLong (wrap64 z) =>
  readIn pow2_63 pow2_64 (modU64 z) idp (transportInv (__ < pow2_64) (modU64-eq z) (modU< m64 z))

-- A `Uint63` is a non-negative `long`.
\lemma norm63In (z : Int) : InLong (norm63 z) => fin_< (wrap63 z)

\lemma zeroIn : InLong 0 => NatOrder.zero<suc

\lemma clampIn {d : Int} (h : InLong d) : InLong (clampL d) \elim d
  | pos k => h
  | neg (suc k) => zeroIn

\lemma ifZeroIn (b : Bool) {u v : Int} (hu : InLong u) (hv : InLong v) : InLong (ifZeroL b u v) \elim b
  | true => hu
  | false => hv

-- `%` is no larger than its dividend (JLS 15.17.3).
\lemma remIn {a : Int} (b : Int) (h : InLong a) : InLong (javaRem a b) \elim a
  | pos n => mod<=left <∘r h
  | neg (suc n) => negIn (mod<=left <=∘ h)
  \where
    \lemma negIn {m : Nat} (h : m <= pow2_63) : InLong (neg m) \elim m
      | 0 => zeroIn
      | suc m => h

-- ---------------------------------------------------------------------------
-- 1. The literals the compiler emits (`Compiler/JavaAxioms.ard`).
-- ---------------------------------------------------------------------------

-- `int63Lit i` is `Long.valueOf(i)`, and `i < 2^63`.
\lemma int63LitIn (i : Fin int63Mod) : InLong (pos i) => fin_< i

-- `longLit i` is `Long.valueOf(signed64 i)`, the signed reading of a 64-bit pattern.
\lemma longLitIn (i : Fin int64Mod) : InLong (signed64 i) =>
  transportInv InLong (signed64-read i) (readIn pow2_63 pow2_64 i idp (fin_< i))

-- ---------------------------------------------------------------------------
-- 2. The builtins of `rtInt63` return only in-range longs, on any arguments:
-- each result is normalized (`norm63`, `wrap64`), or is `lng(x) % lng(y)` or
-- `lng(x)` of a normalized operand.
-- ---------------------------------------------------------------------------

-- A result that is a long is in range.
\func LongOut (r : Res Value) : \Prop \elim r
  | rOk (vLong x) => InLong x
  | _ => \Sigma

-- A builtin of `rtInt63` that returns a long returns a Java `long`, whatever its arguments.
\lemma builtinRunIn {nm : JIdent} {js : Array Value} {x : Int}
  (e : builtinRun {rtInt63} nm js = rOk (vLong x)) : InLong x =>
  transport LongOut e (shippedOut nm js)
  \where {
    \lemma shippedOut (f : JIdent) (vs : Array Value) : LongOut (builtinRunShipped f vs) =>
      unfold builtinRunShipped (cases (builtinArityInt63 f) \with {
        | just _ => (layersOut f vs).1
        | nothing => (layersOut f vs).2
      })

    -- | Both layers are stuck unless given two longs. Arrays match on their
    -- length first, then on the elements; a catch-all clause would not reduce.
    \lemma layersOut (f : JIdent) (vs : Array Value)
      : \Sigma (LongOut (builtinRunInt63 f vs)) (LongOut (builtinRunLong f vs)) \elim vs
      | nil => ((), ())
      | _ :: nil => ((), ())
      | a :: b :: nil => pairOut f a b
      | _ :: _ :: _ :: _ => ((), ())

    \lemma pairOut (f : JIdent) (a b : Value)
      : \Sigma (LongOut (builtinRunInt63 f (a :: b :: nil))) (LongOut (builtinRunLong f (a :: b :: nil))) \elim a, b
      | vLong x, vLong y => (int63Out f x y, longOut f x y)
      | vBox, _ => ((), ())
      | vData _ _, _ => ((), ())
      | vClos _ _ _, _ => ((), ())
      | vObj _ _ _, _ => ((), ())
      | vBuiltin _ _, _ => ((), ())
      | vStaticRef _, _ => ((), ())
      | vStr _, _ => ((), ())
      | vInt _, _ => ((), ())
      | vBool _, _ => ((), ())
      | vExcObj _ _, _ => ((), ())
      | vLong _, vBox => ((), ())
      | vLong _, vData _ _ => ((), ())
      | vLong _, vClos _ _ _ => ((), ())
      | vLong _, vObj _ _ _ => ((), ())
      | vLong _, vBuiltin _ _ => ((), ())
      | vLong _, vStaticRef _ => ((), ())
      | vLong _, vStr _ => ((), ())
      | vLong _, vInt _ => ((), ())
      | vLong _, vBool _ => ((), ())
      | vLong _, vExcObj _ _ => ((), ())

    \lemma int63Out (f : JIdent) (x y : Int) : LongOut (builtinRunInt63 f (vLong x :: vLong y :: nil)) =>
      unfold builtinRunInt63 (cases (f == "PRIM_ADD_INT63") \with { | true => norm63In (pos (wrap63 x Nat.+ wrap63 y)) | false =>
      cases (f == "PRIM_MUL_INT63") \with { | true => norm63In (pos (wrap63 x Nat.* wrap63 y)) | false =>
      cases (f == "PRIM_SUB_INT63") \with { | true => norm63In (wrap63 x Nat.- wrap63 y) | false =>
      cases (f == "PRIM_EQB_INT63") \with { | true => () | false => () } } } })

    \lemma longOut (f : JIdent) (x y : Int) : LongOut (builtinRunLong f (vLong x :: vLong y :: nil)) =>
      unfold builtinRunLong (cases (f == "PRIM_ADD_LONG") \with { | true => wrap64In _ | false =>
      cases (f == "PRIM_SUB_LONG") \with { | true => wrap64In _ | false =>
      cases (f == "PRIM_MUL_LONG") \with { | true => wrap64In _ | false =>
      cases (f == "PRIM_EQB_LONG") \with { | true => () | false =>
      cases (f == "NAT_SUB_LONG") \with { | true => clampIn (wrap64In _) | false =>
      cases (f == "PRIM_DIV_LONG") \with { | true => ifZeroIn _ zeroIn (wrap64In _) | false =>
      cases (f == "PRIM_MOD_LONG") \with { | true => ifZeroIn _ (wrap64In x) (remIn _ (wrap64In x)) | false =>
      cases (f == "PRIM_BLE_LONG") \with { | true => () | false =>
      cases (f == "PRIM_BLT_LONG") \with { | true => () | false => () } } } } } } } } })
  }

-- ---------------------------------------------------------------------------
-- 3. The static methods and fields of `rtInt63`.
-- ---------------------------------------------------------------------------

-- A result that is a long is in range.
\func CallOut (m : Maybe (Res ExprOut)) : \Prop \elim m
  | just (rOk (eVal (vLong x))) => InLong x
  | _ => \Sigma

-- A static call returning a long (only `Long.valueOf` does) returns an in-range argument.
\lemma staticCallIn {q : JQIdent} {js : Array Value} {x : Int} (h : LongsIn js)
  (e : rtStaticCall {rtInt63} q js = just (rOk (eVal (vLong x)))) : InLong x =>
  transport CallOut e (callOut q js h)
  \where {
    \lemma callOut (q : JQIdent) (js : Array Value) (h : LongsIn js) : CallOut (rtStaticCallLong q js) =>
      \case q == "Long.valueOf" \as b, idp : (q == "Long.valueOf") = b \with {
        | true, p => rewrite (eqTrue p) (valueOfOut js h)
        | false, p => unfold rtStaticCallLong (cases (q == "Rt.unbound") \with { | true => () | false =>
                      cases (q == "Rt.freeVar") \with { | true => () | false =>
                      cases (q == "Rt.noBranch") \with { | true => () | false => rewrite p () } } })
      }

    -- | `Long.valueOf` returns its argument, and is stuck on anything but one long.
    \lemma valueOfOut (js : Array Value) (h : LongsIn js) : CallOut (rtStaticCallLong "Long.valueOf" js) \elim js
      | nil => ()
      | vLong x :: nil => h 0 idp
      | vBox :: nil => ()
      | vData _ _ :: nil => ()
      | vClos _ _ _ :: nil => ()
      | vObj _ _ _ :: nil => ()
      | vBuiltin _ _ :: nil => ()
      | vStaticRef _ :: nil => ()
      | vStr _ :: nil => ()
      | vInt _ :: nil => ()
      | vBool _ :: nil => ()
      | vExcObj _ _ :: nil => ()
      | _ :: _ :: _ => ()
  }

-- No field of `Rt` is a long.
\lemma rtFieldIn {nm : JIdent} {x : Int} (e : rtField {rtInt63} nm = just (vLong x)) : Empty =>
  transport FieldOut e (fieldOut nm)
  \where {
    \func FieldOut (m : Maybe Value) : \Prop \elim m
      | just (vLong _) => Empty
      | _ => \Sigma

    \lemma fieldOut (nm : JIdent) : FieldOut (rtFieldInt63 nm) =>
      unfold rtFieldInt63 (cases (builtinArityShipped nm) \with {
        | just _ => ()
        | nothing => ()
      })
  }
