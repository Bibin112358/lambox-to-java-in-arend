\import Algebra.Meta
\import Arith.Nat
\import Data.Array (++)
\import Data.Maybe
\import Proof.JavaExec (lookupOther, lookupSelf)
\import Semantics.JavaValue
\import Proof.NodePathUnique (renderName-inj)
\import Compiler.JavaAst
\import Logic
\import Logic.Meta
\import Meta
\import Compiler.NodePath
\import Order.PartialOrder
\import Order.StrictOrder
\import Paths
\import Paths.Meta
\import Set
\import Compiler.StringUtil

-- =============================================================================
-- FRESH NAMES, BY POSITION IN THE TREE.
--
-- Java looks a variable up by NAME, and every generated name is `renderName k
-- q` for the path `q` of the node that minted it (Proof/NodePathUnique.ard:
-- `renderName` is injective). The backend proof needs "binding this name hides
-- nothing that is read later", and the λ-fragment proof (`CorrectLam.ard`) got
-- it from path LENGTHS: every variable in scope was minted strictly above.
--
-- Lengths are not enough once a node emits statements. In `app f a` the
-- statements of `f` run, then those of `a`, and only then is `f`'s value
-- expression evaluated -- in an environment that `a`'s statements extended.
-- `f` and `a` sit at the SAME depth, so what separates their names is that
-- their paths are different, not that one is shorter. Hence the relations here
-- are about SUFFIXES (a path is a list with the innermost selector at the head,
-- so the ancestors of `p` are exactly its suffixes):
--
--   * `IsSuffix q p`: `q` is `p` or an ancestor of `p`.
--   * `StrictSuf q c`: `q` is a proper ancestor of `c`. The variables a node
--     at `c` can READ were minted at such paths (an enclosing lambda, let,
--     case scrutinee or fix class).
--   * `Indep q p`: neither is an ancestor of the other -- `q` is in a
--     different subtree. What a SIBLING's statements bind is at such paths,
--     and independence is inherited by every descendant of `p`.
--
-- `NamesAt ext P` says every name bound in the environment segment `ext` is
-- `renderName k q` for some `q` with `P q`; `lookupSkip` is the one fact the
-- simulation uses: a lookup of a name whose path is excluded by `P` walks past
-- the whole segment.
-- =============================================================================

\data IsSuffix (q p : Path)
  | sufRefl (q = p)
  | sufCons (s : Sel) (p' : Path) (p = s :: p') (IsSuffix q p')

\func StrictSuf (q c : Path) : \Set0 \elim c
  | nil => Empty
  | s :: p => IsSuffix q p

\func Indep (q p : Path) : \Set0 => \Sigma (IsSuffix q p -> Empty) (IsSuffix p q -> Empty)

\func NamesAt (ext : Env) (P : Path -> \Set0) : \Set0 \elim ext
  | nil => \Sigma
  | e :: ext => \Sigma (\Sigma (k : NameKind) (q : Path) (e.1 = renderName k q) (P q)) (NamesAt ext P)

-- The three instances the simulation uses.
-- What a node's statements bind: names in its own subtree (at `p` or below).
\func Within (ext : Env) (p : Path) : \Set0 => NamesAt ext (\lam q => IsSuffix p q)
-- What may be bound between a variable's binding and its use at `c`.
\func NotAnc (ext : Env) (c : Path) : \Set0 => NamesAt ext (\lam q => StrictSuf q c -> Empty)
-- What may be bound between a node's statements and its value expression.
\func IndepOf (ext : Env) (p : Path) : \Set0 => NamesAt ext (\lam q => Indep q p)

-- ---------------------------------------------------------------------------
-- Suffixes.
-- ---------------------------------------------------------------------------

\func pHead (p : Path) (d : Sel) : Sel \elim p
  | nil => d
  | s :: _ => s

\func pTail (p : Path) : Path \elim p
  | nil => nil
  | _ :: p => p

\func sufSelf (p : Path) : IsSuffix p p => sufRefl idp

\func sufChild {q p : Path} (s : Sel) (h : IsSuffix q p) : IsSuffix q (s :: p) => sufCons s p idp h

\func sufLen {q p : Path} (h : IsSuffix q p) : q.len <= p.len \elim h
  | sufRefl e => rewrite e <=-refl
  | sufCons s p' e h' => rewrite e (linarith (sufLen h'))

\func sufTrans {a b c : Path} (h1 : IsSuffix a b) (h2 : IsSuffix b c) : IsSuffix a c \elim h2
  | sufRefl e => rewriteI e h1
  | sufCons s c' e h2' => sufCons s c' e (sufTrans h1 h2')

\lemma sufEqLen {q p : Path} (h : IsSuffix q p) (e : q.len = p.len) : q = p \elim h
  | sufRefl e' => e'
  | sufCons s p' e' h' => absurd (linarith (sufLen h', pmap (\lam (r : Path) => r.len) e', e))

\lemma sufUnique {a b c : Path} (ha : IsSuffix a c) (hb : IsSuffix b c) (e : a.len = b.len) : a = b \elim c, ha, hb
  | nil, sufRefl e1, sufRefl e2 => e1 *> inv e2
  | nil, sufRefl e1, sufCons s' c' e2 hb' => contradiction
  | nil, sufCons s' c' e1 ha', _ => contradiction
  | s :: c, sufRefl e1, sufRefl e2 => e1 *> inv e2
  | s :: c, sufRefl e1, sufCons s' c' e2 hb' =>
    \let | la : a.len = suc c.len => pmap (\lam (r : Path) => r.len) e1
         | lb : b.len <= c'.len => sufLen hb'
         | lq : c = c' => pmap pTail e2
    \in absurd (linarith (la, lb, e, pmap (\lam (r : Path) => r.len) lq))
  | s :: c, sufCons s' c' e1 ha', sufRefl e2 =>
    \let | la : a.len <= c'.len => sufLen ha'
         | lb : b.len = suc c.len => pmap (\lam (r : Path) => r.len) e2
         | lq : c = c' => pmap pTail e1
    \in absurd (linarith (la, lb, e, pmap (\lam (r : Path) => r.len) lq))
  | s :: c, sufCons s1 c1 e1 ha', sufCons s2 c2 e2 hb' =>
    \let | eq : c1 = c2 => pmap pTail (inv e1 *> e2)
    \in sufUnique ha' (transport (IsSuffix b) (inv eq) hb') e

-- ---------------------------------------------------------------------------
-- Strict ancestors.
-- ---------------------------------------------------------------------------

-- The parent is a strict ancestor.
\func parentStrict (s : Sel) (p : Path) : StrictSuf p (s :: p) => sufSelf p

\func strictChild {q c : Path} (s : Sel) (h : StrictSuf q c) : StrictSuf q (s :: c) \elim c
  | nil => absurd h
  | s' :: c' => sufChild s' h

\func strictLen {q c : Path} (h : StrictSuf q c) : q.len < c.len \elim c
  | nil => absurd h
  | s :: p => linarith (sufLen h)

\lemma notStrictSelf (p : Path) (h : StrictSuf p p) : Empty =>
  linarith (strictLen h)

-- Nothing in the subtree of a child of `p` is a strict ancestor of `p`.
\lemma childNotStrict {s : Sel} {p q : Path} (w : IsSuffix (s :: p) q) (h : StrictSuf q p) : Empty =>
  linarith (sufLen w, strictLen h)

-- ---------------------------------------------------------------------------
-- Independence.
-- ---------------------------------------------------------------------------

\func indepChild {q p : Path} (s : Sel) (h : Indep q p) : Indep q (s :: p) =>
  ( \lam w => \case w \with {
      | sufRefl e => h.2 (sufCons s p e (sufRefl idp))
      | sufCons s' p' e w' => \let eq : p' = p => pmap pTail (inv e) \in h.1 (transport (IsSuffix q) eq w')
    }
  , \lam w => h.2 (sufTrans (sufCons s p idp (sufRefl idp)) w)
  )

\func indepNotStrict {q p : Path} (h : Indep q p) (st : StrictSuf q p) : Empty \elim p
  | nil => absurd st
  | s :: p' => h.1 (sufChild s st)

\func indepNotSelf {q p : Path} (h : Indep q p) (e : q = p) : Empty =>
  h.1 (sufRefl e)

-- The subtrees of two different children of `p` are independent.
\func siblingIndep {s s' : Sel} (ne : s' /= s) {p q : Path} (w : IsSuffix (s' :: p) q) : Indep q (s :: p) =>
  ( \lam w2 => \let w3 => sufTrans w w2 \in ne (pmap (\lam p0 => pHead p0 s) (sufEqLen w3 idp))
  , \lam w2 => ne (pmap (\lam p0 => pHead p0 s) (sufUnique w w2 idp))
  )

-- ---------------------------------------------------------------------------
-- Selectors that differ.
-- ---------------------------------------------------------------------------

\func ctorArgNe {i j : Nat} (ne : i /= j) : sCtorArg i /= sCtorArg j =>
  \lam e => ne (pmap (\lam s => \case s \with { | sCtorArg k => k | _ => 0 }) e)

-- ---------------------------------------------------------------------------
-- Environment segments.
-- ---------------------------------------------------------------------------

\func namesNil {P : Path -> \Set0} : NamesAt nil P => ()

\func namesOne {P : Path -> \Set0} (k : NameKind) (q : Path) (v : Value) (h : P q) : NamesAt ((renderName k q, v) :: nil) P =>
  ((k, q, idp, h), ())

\func namesAppend {P : Path -> \Set0} {X Y : Env} (hx : NamesAt X P) (hy : NamesAt Y P) : NamesAt (X ++ Y) P \elim X
  | nil => hy
  | e :: X => (hx.1, namesAppend hx.2 hy)

\func namesMono {P P' : Path -> \Set0} (f : \Pi (q : Path) -> P q -> P' q) {X : Env} (h : NamesAt X P) : NamesAt X P' \elim X
  | nil => ()
  | e :: X => ((h.1.1, h.1.2, h.1.3, f h.1.2 h.1.4), namesMono f h.2)

\func envAssoc (X Y Z : Env) : (X ++ Y) ++ Z = X ++ (Y ++ Z) \elim X
  | nil => idp
  | e :: X => pmap (e ::) (envAssoc X Y Z)

-- THE fact: a name whose path the segment excludes is looked up past it.
\func lookupSkip {P : Path -> \Set0} {X : Env} (h : NamesAt X P) (k : NameKind) {q : Path} (np : P q -> Empty) (env : Env)
  : lookupVar (X ++ env) (renderName k q) = lookupVar env (renderName k q) \elim X
  | nil => idp
  | a :: X =>
    lookupOther a.2 (X ++ env) (\lam ee =>
      \let | (k', q', e1, Pq') => h.1
           | (ek, eq) => renderName-inj (inv e1 *> ee)
      \in np (transport P eq Pq')
    ) *> lookupSkip h.2 k np env

-- Distinct kinds or distinct paths give distinct names.
\func renderNeKind {k k' : NameKind} (ne : k /= k') (p p' : Path) : renderName k p /= renderName k' p' =>
  \lam e => ne (renderName-inj e).1

\func renderNePath {p p' : Path} (ne : p /= p') (k k' : NameKind) : renderName k p /= renderName k' p' =>
  \lam e => ne (renderName-inj e).2

-- One binding of a different name is skipped; the head binding is found.
\func lookupCons {x y : JIdent} (v : Value) (env : Env) (ne : x /= y) : lookupVar ((x, v) :: env) y = lookupVar env y =>
  lookupOther v env ne

\func lookupHead (x : JIdent) (v : Value) (env : Env) : lookupVar ((x, v) :: env) x = just v =>
  lookupSelf x v env

