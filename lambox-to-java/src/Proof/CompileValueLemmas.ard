-- =============================================================================
-- Lemmas about the value relation of `Proof/CompileValue.ard`:
--
--   * `EnvRel` moves DOWN the tree (`erChild`) and survives bindings made at
--     paths that are not strict ancestors of the use site (`erExtend`); a
--     variable found by `EvalE` is found by the compiled code (`erLookup`).
--   * `castFn`: a value λ□ can APPLY is, on the Java side, an `Rt.Fn`.
--   * THE FIRST-ORDER BRIDGE to `Proof/Statement.ard`'s `ValRel`, in both
--     directions (`cvValRel`, `valRelCV`): the oracle hypothesis `OracleAgree`
--     speaks `ValRel`, the simulation speaks `CV`.
--   * THE AXIOM SPINE: what `axiomSat` sees when an axiom value is applied
--     (`satEq`), and how its arguments, collected newest first on the λ□ side,
--     line up with the oldest-first `vBuiltin` on the Java side (`qRev`).
-- =============================================================================

-- ---------------------------------------------------------------------------
-- The environment relation.
-- ---------------------------------------------------------------------------

\func erChild {rt : RtSpec} {cls : JClass} {rho : Array EV} {cenv : Array JExpr} {jenv : Env} {p : Path} (s : Sel)
              (er : EnvRel rt cls rho cenv jenv p) : EnvRel rt cls rho cenv jenv (s :: p) \elim rho, cenv, er
  | nil, nil, erNil => erNil
  | w :: rho, e :: cenv, erCons h er =>
    erCons (\lam X nx => h X (namesMono {\lam q => StrictSuf q (s :: p) -> Empty} {\lam q => StrictSuf q p -> Empty}
                                     (\lam q nq st => nq (strictChild s st)) nx)) (erChild s er)

\func erExtend {rt : RtSpec} {cls : JClass} {rho : Array EV} {cenv : Array JExpr} {jenv : Env} {c : Path}
               (er : EnvRel rt cls rho cenv jenv c) (Y : Env) (ny : NotAnc Y c)
  : EnvRel rt cls rho cenv (Y ++ jenv) c \elim rho, cenv, er
  | nil, nil, erNil => erNil
  | w :: rho, e :: cenv, erCons h er =>
    erCons (\lam X nx => \let r => h (X ++ Y) (namesAppend nx ny)
                        \in (r.1, r.2, transport (\lam E => evalExpr {\new Machine rt cls} r.2 E e = rOk (eVal r.1)) (++-assoc {_} {X} {Y} {jenv}) r.3, r.4))
           (erExtend er Y ny)

\func EntryOK (rt : RtSpec) (cls : JClass) (w : EV) (e : JExpr) (jenv : Env) (c : Path) : \Type =>
  \Pi (X : Env) -> NotAnc X c ->
    \Sigma (jv : Value) (m : Nat) (evalExpr {\new Machine rt cls} m (X ++ jenv) e = rOk (eVal jv)) (CV rt cls w jv)

\func erLookup {rt : RtSpec} {cls : JClass} {rho : Array EV} {cenv : Array JExpr} {jenv : Env} {c : Path}
               (er : EnvRel rt cls rho cenv jenv c) {n : Nat} {w : EV} (h : nthArr n rho = just w)
  : \Sigma (e : JExpr) (nthArr n cenv = just e) (EntryOK rt cls w e jenv c) \elim rho, cenv, er, n
  | nil, nil, erNil, 0 => \case h
  | nil, nil, erNil, suc _ => \case h
  | w' :: rho, e :: cenv, erCons hh er, 0 => (e, idp, transport (\lam z => EntryOK rt cls z e jenv c) (just-injective h) hh)
  | w' :: rho, e :: cenv, erCons hh er, suc n => erLookup er h

-- ---------------------------------------------------------------------------
-- What λ□ applies is an `Rt.Fn`.
-- ---------------------------------------------------------------------------

-- In an environment of generated names, `Rt.Fn` is the runtime's interface.
\func castFn {spec : LBSpec} {genv : GlobalDeclarations} {rt : RtSpec} {cls : JClass} {wf wa w : EV} {jf : Value} {env : Env}
             (g : Generated env) (d : ApplyE spec genv wf wa w) (cf : CV rt cls wf jf) : castOk env tFn jf = just true =>
  castResolved {env} {tFn} (resolveFnGen g) jf *> isFn d cf
  \where
    \func isFn {spec : LBSpec} {genv : GlobalDeclarations} {rt : RtSpec} {cls : JClass} {wf wa w : EV} {jf : Value}
               (d : ApplyE spec genv wf wa w) (cf : CV rt cls wf jf) : instanceOf jf cRtFn = just true \elim wf, cf
      | evBox, cvBox e => rewrite e idp
      | evClos _ _ _, cvClos e _ _ => rewrite e idp
      | evFix _ _ _, cvFix e _ _ _ => rewrite e idp
      | evAx _ _, cvAx e _ _ _ => rewrite e idp
      | evCon _ _ _, _ => \case d
      | evPrim _, _ => \case d

-- ---------------------------------------------------------------------------
-- The first-order bridge.
-- ---------------------------------------------------------------------------

\func quoteAxNotFO (kn : Kername) (qs : Array LBTerm) (fo : FOVal (quoteAx kn qs)) : Empty \elim qs
  | nil => fo
  | q :: qs => fo

\func cvValRel {rt : RtSpec} {cls : JClass} (w : EV) {jv : Value} (cv : CV rt cls w jv) (fo : FOVal (quote w))
  : ValRel (quote w) jv \elim w, cv
  | evBox, cvBox e => rewrite e idp
  | evPrim (rocqUint63, i), cvP63 e => rewrite e (intEqB-refl (pos i))
  | evPrim (javaLong, i), cvP64 e => rewrite e (intEqB-refl _)
  | evCon ind c ws, cvCon {fs} e ac => rewrite e (pmap2 (\lam a b => a and b) (eqSelf c) (allValRel ws fs ac fo))
  | evClos na b rho, _ => absurd (transport FOVal (skLamF 0 (quoteEnv rho) na b) fo)
  | evFix defs idx rho, _ => absurd (transport FOVal (skFixF 0 (quoteEnv rho) defs idx) fo)
  | evAx kn args, _ => absurd (quoteAxNotFO kn (quoteEnv args) fo)

\func allValRel {rt : RtSpec} {cls : JClass} (ws : Array EV) (fs : Array Value) (ac : AllCV rt cls ws fs)
                 (fo : \Pi (i : Fin ws.len) -> FOVal (quote (ws i)))
  : allWith ws.len fs (\lam i => agrees (quote (ws i))) = true \elim ws, fs, ac
  | nil, nil, acNil => idp
  | w :: ws, f :: fs, acCons cv ac =>
    pmap2 (\lam a b => a and b) (cvValRel w cv (fo 0)) (allValRel ws fs ac (\lam i => fo (suc i)))

-- The converse, for what the oracle returns.
\func boxInv (jv : Value) (h : agrees box jv = true) : jv = vBox \elim jv
  | vBox => idp
  | vData _ _ => \case h
  | vClos _ _ _ => \case h
  | vObj _ _ _ => \case h
  | vBuiltin _ _ => \case h
  | vStaticRef _ => \case h
  | vLong _ => \case h
  | vStr _ => \case h
  | vBool _ => \case h
  | vExcObj _ _ => \case h

\func p63Inv (i : Fin int63Mod) (jv : Value) (h : agrees (prim (rocqUint63, i)) jv = true) : jv = vLong (longOfUint63 i) \elim jv
  | vBox => \case h
  | vData _ _ => \case h
  | vClos _ _ _ => \case h
  | vObj _ _ _ => \case h
  | vBuiltin _ _ => \case h
  | vStaticRef _ => \case h
  | vLong j => pmap vLong (longExt (inv (intEqB-sound h)))
  | vStr _ => \case h
  | vBool _ => \case h
  | vExcObj _ _ => \case h

\func p64Inv (i : Fin int64Mod) (jv : Value) (h : agrees (prim (javaLong, i)) jv = true) : jv = vLong (longOfBits i) \elim jv
  | vBox => \case h
  | vData _ _ => \case h
  | vClos _ _ _ => \case h
  | vObj _ _ _ => \case h
  | vBuiltin _ _ => \case h
  | vStaticRef _ => \case h
  | vLong j => pmap vLong (longExt (inv (intEqB-sound h)))
  | vStr _ => \case h
  | vBool _ => \case h
  | vExcObj _ _ => \case h

\func conInv (ind : InductiveId) (c : Nat) (args : Array LBTerm) (jv : Value) (h : agrees (construct ind c args) jv = true)
  : \Sigma (fs : Array Value) (jv = vData c fs) (allWith args.len fs (\lam i => agrees (args i)) = true) \elim jv
  | vBox => \case h
  | vData tg fs => \let s => and.toSigma h \in (fs, pmap (vData __ fs) (inv (eqTrue s.1)), s.2)
  | vClos _ _ _ => \case h
  | vObj _ _ _ => \case h
  | vBuiltin _ _ => \case h
  | vStaticRef _ => \case h
  | vLong _ => \case h
  | vStr _ => \case h
  | vBool _ => \case h
  | vExcObj _ _ => \case h

\func agreesCV {rt : RtSpec} {cls : JClass} (r : LBTerm) (jv : Value) (fo : FOVal r) (h : agrees r jv = true)
  : CV rt cls (ofFO r) jv \elim r
  | box => cvBox (boxInv jv h)
  | prim (rocqUint63, i) => cvP63 (p63Inv i jv h)
  | prim (javaLong, i) => cvP64 (p64Inv i jv h)
  | construct ind c args =>
    \let s => conInv ind c args jv h
    \in cvCon s.2 (agreesAllCV args s.1 (\lam i v => agreesCV (args i) v (fo i)) s.3)
  | bvar _ => \case fo
  | fvar _ => \case fo
  | lambda _ _ => \case fo
  | letIn _ _ _ => \case fo
  | app _ _ => \case fo
  | const _ => \case fo
  | case _ _ _ _ => \case fo
  | proj _ _ => \case fo
  | fix _ _ => \case fo
  \where
    -- The fields, given the claim for each field (so that the recursion
    -- above is on `args i`, which the termination checker accepts).
    \func agreesAllCV (ts : Array LBTerm) (vs : Array Value)
                      (ih : \Pi (i : Fin ts.len) (v : Value) -> agrees (ts i) v = true -> CV rt cls (ofFO (ts i)) v)
                      (h : allWith ts.len vs (\lam i => agrees (ts i)) = true)
      : AllCV rt cls (mkArray {EV} {ts.len} (\lam i => ofFO (ts i))) vs \elim ts, vs
      | nil, nil => acNil
      | t :: ts, v :: vs => \let s => and.toSigma h \in acCons (ih 0 v s.1) (agreesAllCV ts vs (\lam i => ih (suc i)) s.2)
      | nil, _ :: _ => \case h
      | _ :: _, nil => \case h

\func valRelCV {rt : RtSpec} {cls : JClass} {r : LBTerm} {jv : Value} (fo : FOVal r) (vr : ValRel r jv) : CV rt cls (ofFO r) jv =>
  agreesCV r jv fo vr

-- ---------------------------------------------------------------------------
-- The axiom spine.
-- ---------------------------------------------------------------------------

\func spineQ (kn : Kername) (qs acc : Array LBTerm) : axiomSpine (quoteAx kn qs) acc = just (kn, revAppendArr qs acc) \elim qs
  | nil => idp
  | q :: qs => spineQ kn qs (q :: acc)

\func satB (kn : Kername) (xs : Array LBTerm) (b : Bool) : Maybe (\Sigma Kername (Array LBTerm)) \elim b
  | true => just (kn, xs)
  | false => nothing

\func satArity (kn : Kername) (xs : Array LBTerm) (m : Maybe Nat) : Maybe (\Sigma Kername (Array LBTerm)) \elim m
  | nothing => nothing
  | just ar => satB kn xs (xs.len == ar)

\func satSpine (spec : LBSpec) (m : Maybe (\Sigma Kername (Array LBTerm))) : Maybe (\Sigma Kername (Array LBTerm)) \elim m
  | nothing => nothing
  | just (kn, xs) => satArity kn xs (axiomArity {spec} kn)

\func satAritySplit (kn : Kername) (xs : Array LBTerm) (b : Bool)
  : (\case b \with { | false => nothing | true => just (kn, xs) }) = satB kn xs b \elim b
  | true => idp
  | false => idp

\func satSpineEq (spec : LBSpec) (t : LBTerm) : axiomSat spec t = satSpine spec (axiomSpine t nil) =>
  unfold axiomSat (cases (axiomSpine t nil) \with {
    | nothing => idp
    | just (kn, xs) => cases (axiomArity {spec} kn) \with {
      | nothing => idp
      | just ar => satAritySplit kn xs (xs.len == ar)
    }
  })

-- What `axiomSat` sees when the axiom value `evAx kn args` is applied to `wa`.
\func satEq (spec : LBSpec) (kn : Kername) (args : Array EV) (wa : EV) {k : Nat} (ar : axiomArity {spec} kn = just k)
  : axiomSat spec (app (quote (evAx kn args)) (quote wa))
  = satB kn (revAppendArr (quoteEnv args) (quote wa :: nil)) ((revAppendArr (quoteEnv args) (quote wa :: nil)).len == k) =>
  \let sp : axiomSpine (app (quoteAx kn (quoteEnv args)) (quote wa)) nil
             = just (kn, revAppendArr (quoteEnv args) (quote wa :: nil)) => spineQ kn (quoteEnv args) (quote wa :: nil)
  \in satSpineEq spec (app (quoteAx kn (quoteEnv args)) (quote wa)) *> pmap (satSpine spec) sp
    *> pmap (satArity kn (revAppendArr (quoteEnv args) (quote wa :: nil))) ar

-- Arguments related one by one, each the read-back of a related value.
\data QRel (rt : RtSpec) (cls : JClass) (ts : Array LBTerm) (vs : Array Value) \elim ts, vs
  | nil, nil => qNil
  | t :: ts, v :: vs => qCons (w : EV) (t = quote w) (CV rt cls w v) (QRel rt cls ts vs)

\func qLen {rt : RtSpec} {cls : JClass} {ts : Array LBTerm} {vs : Array Value} (q : QRel rt cls ts vs) : ts.len = vs.len
  \elim ts, vs, q
  | nil, nil, qNil => idp
  | t :: ts, v :: vs, qCons _ _ _ q => pmap suc (qLen q)

\func qRev {rt : RtSpec} {cls : JClass} {ws : Array EV} {got : Array Value} (rc : RevCV rt cls ws got)
           (acc : Array LBTerm) (jacc : Array Value) (qa : QRel rt cls acc jacc)
  : QRel rt cls (revAppendArr (quoteEnv ws) acc) (got ++ jacc) \elim ws, rc
  | nil, rcNil e => transport (\lam g => QRel rt cls acc (g ++ jacc)) (inv e) qa
  | w :: ws, rcCons {got0} j cv rc e =>
    transport (\lam g => QRel rt cls (revAppendArr (quoteEnv ws) (quote w :: acc)) g)
              (inv (++-assoc {_} {got0} {j :: nil} {jacc}) *> pmap (__ ++ jacc) (inv e))
              (qRev rc (quote w :: acc) (j :: jacc) (qCons w idp cv qa))

-- The shape `OracleAgree` asks for: a length-indexed array, pointwise `ValRel`.
\func qJargs {rt : RtSpec} {cls : JClass} {ts : Array LBTerm} {vs : Array Value} (q : QRel rt cls ts vs)
             (fo : \Pi (i : Fin ts.len) -> FOVal (ts i))
  : \Sigma (jargs : Array Value ts.len) (jargs = {Array Value} vs) (\Pi (i : Fin ts.len) -> ValRel (ts i) (jargs i))
  \elim ts, vs, q
  | nil, nil, qNil => (nil, idp, \lam i => \case i \with {})
  | t :: ts, v :: vs, qCons w et cv q =>
    \let | r => qJargs q (\lam i => fo (suc i))
         | h0 : ValRel t v => transport (ValRel __ v) (inv et) (cvValRel w cv (transport FOVal et (fo 0)))
    \in (v :: r.1, pmap (v ::) r.2, \lam i => \case \elim i \with {
      | 0 => h0
      | suc i => r.3 i
    })
