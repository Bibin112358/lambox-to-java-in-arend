\import Arith.Nat
\import Data.Bool
\import Data.Maybe
\import Semantics.JavaEval
\import Semantics.JavaValue
\import Semantics.Res
\import Compiler.JavaAst
\import Logic.Meta
\import Meta
\import Paths
\import Paths.Meta

-- =============================================================================
-- Fuel monotonicity of the Java-fragment evaluator (`Semantics/JavaEval.ard`):
-- a run that returns `rOk r` at fuel `n` returns the same `rOk r` at any
-- larger fuel. Proofs by induction on derivations use it to combine the
-- clocks of sub-derivations (`Proof/JavaExec.ard`).
--
-- One lemma per function of the evaluator's mutual cycle, each stating
-- `F n .. <= F (suc n) ..` for the order `Mono`. Every clause of the
-- evaluator sequences recursive calls at the same fuel (`>>=`, `>>=*`, `>>>`,
-- `methodResult`, `bindRes`), so each clause of the proof combines the
-- induction hypotheses with the matching lemma below; continuations that do
-- not recurse are identical at both clocks (`monoRefl`).
-- =============================================================================

-- `a` is below `b`: whatever value `a` produces, `b` produces too. Timeouts and
-- stuck states on the left are unconstrained, which is exactly "more fuel can
-- only turn a timeout into an answer".
\func Mono {A : \Type} (a b : Res A) : \Type => \Pi (r : A) -> a = rOk r -> b = rOk r

\func monoRefl {A : \Type} {a : Res A} : Mono a a => \lam r p => p

\func monoTrans {A : \Type} {a b c : Res A} (p : Mono a b) (q : Mono b c) : Mono a c =>
  \lam r s => q r (p r s)

\func monoFuel {A : \Type} {b : Res A} : Mono rOutOfFuel b => \lam r p => contradiction

\func bindMono {A B : \Type} {m m' : Res A} {k k' : A -> Res B}
               (hm : Mono m m') (hk : \Pi (x : A) -> Mono (k x) (k' x))
  : Mono (bindRes m k) (bindRes m' k') \elim m
  | rOk a => \lam r p => rewrite (hm a idp) (hk a r p)
  | rStuck => \lam r p => contradiction
  | rOutOfFuel => \lam r p => contradiction

\func thenEMono {B : CanThrow} {m m' : Res ExprOut} {k k' : Value -> Res B}
                (hm : Mono m m') (hk : \Pi (v : Value) -> Mono (k v) (k' v))
  : Mono (m >>= k) (m' >>= k') =>
  bindMono hm (\lam o => \case \elim o \with {
    | eExc ev => monoRefl
    | eVal v => hk v
  })

\func thenAMono {B : CanThrow} {m m' : Res ArgsOut} {k k' : Array Value -> Res B}
                (hm : Mono m m') (hk : \Pi (vs : Array Value) -> Mono (k vs) (k' vs))
  : Mono (m >>=* k) (m' >>=* k') =>
  bindMono hm (\lam o => \case \elim o \with {
    | aExc ev => monoRefl
    | aVals vs => hk vs
  })

\func methodResultMono {m m' : Res StmtOut} (hm : Mono m m') : Mono (methodResult m) (methodResult m') =>
  bindMono hm (\lam o => monoRefl)

-- ---------------------------------------------------------------------------
-- The mutual cycle, one step of fuel.
-- ---------------------------------------------------------------------------

\func evalExprMono (rt : RtSpec) (cls : JClass) (n : Nat) (env : Env) (e : JExpr)
  : Mono (evalExpr {\new Machine rt cls} n env e) (evalExpr {\new Machine rt cls} (suc n) env e) \elim n, e
  | 0, _ => monoFuel
  | suc n, jLit l => monoRefl
  | suc n, jBox => monoRefl
  | suc n, jVar x => monoRefl
  | suc n, jStatic q => monoRefl
  | suc n, jClosure p body => monoRefl
  | suc n, jQualThis q => monoRefl
  | suc n, jField recv f => thenEMono (evalExprMono rt cls n env recv) (\lam v => monoRefl)
  | suc n, jCast t e => thenEMono (evalExprMono rt cls n env e) (\lam v => monoRefl)
  | suc n, jApply f a => thenEMono (evalExprMono rt cls n env f) (\lam fv =>
    thenEMono monoRefl (\lam fn =>
    thenEMono (evalExprMono rt cls n env a) (\lam av => applyValMono rt cls n fn av)))
  | suc n, jInvoke recv m args => thenEMono (evalExprMono rt cls n env recv) (\lam rv =>
    thenAMono (evalArgsMono rt cls n env args) (\lam vs => invokeMethodMono rt cls n rv m vs))
  | suc n, jCallStatic q args => thenAMono (evalArgsMono rt cls n env args) (\lam vs => callStaticMono rt cls n q vs)
  | suc n, jNew t args => thenAMono (evalArgsMono rt cls n env args) (\lam vs => monoRefl)
  | suc n, jDataNew tag args => thenAMono (evalArgsMono rt cls n env args) (\lam vs => monoRefl)
  | suc n, jTagEq d k => thenEMono (evalExprMono rt cls n env d) (\lam v => monoRefl)
  | suc n, jDataField d i => thenEMono (evalExprMono rt cls n env d) (\lam v => monoRefl)
  | suc n, jCond c a b => thenEMono (evalExprMono rt cls n env c) (\lam v => \case \elim v \with {
    | vBool true => evalExprMono rt cls n env a
    | vBool false => evalExprMono rt cls n env b
    | vBox => monoRefl
    | vData _ _ => monoRefl
    | vClos _ _ _ => monoRefl
    | vObj _ _ _ => monoRefl
    | vBuiltin _ _ => monoRefl
    | vStaticRef _ => monoRefl
    | vLong _ => monoRefl
    | vStr _ => monoRefl
    | vExcObj _ _ => monoRefl
  })

\func evalArgsMono (rt : RtSpec) (cls : JClass) (n : Nat) (env : Env) (es : Array JExpr)
  : Mono (evalArgs {\new Machine rt cls} n env es) (evalArgs {\new Machine rt cls} (suc n) env es) \elim n, es
  | 0, _ => monoFuel
  | suc n, nil => monoRefl
  | suc n, e :: es => thenEMono (evalExprMono rt cls n env e) (\lam v =>
    thenAMono {ArgsThrows} {_} {_} {\lam vs => rOk (aVals (v :: vs))} {\lam vs => rOk (aVals (v :: vs))}
              (evalArgsMono rt cls n env es) (\lam vs => monoRefl))

\func applyValMono (rt : RtSpec) (cls : JClass) (n : Nat) (f a : Value)
  : Mono (applyVal {\new Machine rt cls} n f a) (applyVal {\new Machine rt cls} (suc n) f a) \elim n, f
  | 0, _ => monoFuel
  | suc n, vClos p body cenv => methodResultMono (execStmtsMono rt cls n (bindVar cenv p a) body)
  | suc n, vBuiltin nm got => monoRefl
  | suc n, vBox => monoRefl
  | suc n, vData _ _ => monoRefl
  | suc n, vObj _ _ _ => monoRefl
  | suc n, vStaticRef _ => monoRefl
  | suc n, vLong _ => monoRefl
  | suc n, vStr _ => monoRefl
  | suc n, vBool _ => monoRefl
  | suc n, vExcObj _ _ => monoRefl

\func invokeMethodMono (rt : RtSpec) (cls : JClass) (n : Nat) (recv : Value) (m : JIdent) (vs : Array Value)
  : Mono (invokeMethod {\new Machine rt cls} n recv m vs) (invokeMethod {\new Machine rt cls} (suc n) recv m vs) \elim n, recv
  | 0, _ => monoFuel
  | suc n, vObj c ms cenv => cases (lookupClassMethod ms m) \with {
    | nothing => monoRefl
    | just pb => cases vs \with {
      | a :: nil => methodResultMono (execStmtsMono rt cls n (bindVar (bindType cenv c (vObj c ms cenv)) pb.1 a) pb.2)
      | nil => monoRefl
      | a :: b :: vs => monoRefl
    }
  }
  | suc n, vBox => monoRefl
  | suc n, vData _ _ => monoRefl
  | suc n, vClos _ _ _ => monoRefl
  | suc n, vBuiltin _ _ => monoRefl
  | suc n, vStaticRef _ => monoRefl
  | suc n, vLong _ => monoRefl
  | suc n, vStr _ => monoRefl
  | suc n, vBool _ => monoRefl
  | suc n, vExcObj _ _ => monoRefl

\func callStaticMono (rt : RtSpec) (cls : JClass) (n : Nat) (q : JQIdent) (vs : Array Value)
  : Mono (callStatic {\new Machine rt cls} n q vs) (callStatic {\new Machine rt cls} (suc n) q vs) \elim n
  | 0 => monoFuel
  | suc n => cases (lookupMethod cls q) \with {
    | just mth => cases vs \with {
      | nil => methodResultMono (execStmtsMono rt cls n nil (JMethod.mBody {mth}))
      | _ :: _ => monoRefl
    }
    | nothing => monoRefl
  }

\func execStmtMono (rt : RtSpec) (cls : JClass) (n : Nat) (env : Env) (s : JStmt)
  : Mono (execStmt {\new Machine rt cls} n env s) (execStmt {\new Machine rt cls} (suc n) env s) \elim n, s
  | 0, _ => monoFuel
  | suc n, jComment _ => monoRefl
  | suc n, jLocal _ x e => thenEMono (evalExprMono rt cls n env e) (\lam v => monoRefl)
  | suc n, jLocalClass c ms => monoRefl
  | suc n, jThrow e => thenEMono (evalExprMono rt cls n env e) (\lam v => monoRefl)
  | suc n, jReturn e => thenEMono (evalExprMono rt cls n env e) (\lam v => monoRefl)

\func execStmtsMono (rt : RtSpec) (cls : JClass) (n : Nat) (env : Env) (ss : Array JStmt)
  : Mono (execStmts {\new Machine rt cls} n env ss) (execStmts {\new Machine rt cls} (suc n) env ss) \elim n, ss
  | 0, _ => monoFuel
  | suc n, nil => monoRefl
  | suc n, s :: ss => bindMono (execStmtMono rt cls n env s) (\lam o => \case \elim o \with {
    | oReturn v => monoRefl
    | oExcS ev => monoRefl
    | oNormal env' => execStmtsMono rt cls n env' ss
  })

-- ---------------------------------------------------------------------------
-- Any amount of extra fuel. Stated as `n + k` rather than `n <= m`: `+`
-- recurses on its second argument, so `n + suc k` is `suc (n + k)` and the
-- step lemmas iterate with no arithmetic.
-- ---------------------------------------------------------------------------

\func evalExprMonoPlus (rt : RtSpec) (cls : JClass) (n k : Nat) (env : Env) (e : JExpr)
  : Mono (evalExpr {\new Machine rt cls} n env e) (evalExpr {\new Machine rt cls} (n Nat.+ k) env e) \elim k
  | 0 => monoRefl
  | suc k => monoTrans (evalExprMonoPlus rt cls n k env e) (evalExprMono rt cls (n Nat.+ k) env e)

\func execStmtsMonoPlus (rt : RtSpec) (cls : JClass) (n k : Nat) (env : Env) (ss : Array JStmt)
  : Mono (execStmts {\new Machine rt cls} n env ss) (execStmts {\new Machine rt cls} (n Nat.+ k) env ss) \elim k
  | 0 => monoRefl
  | suc k => monoTrans (execStmtsMonoPlus rt cls n k env ss) (execStmtsMono rt cls (n Nat.+ k) env ss)

\func fuelMono {rt : RtSpec} {cls : JClass} {n : Nat} {env : Env} {e : JExpr} {r : ExprOut}
                (p : evalExpr {\new Machine rt cls} n env e = rOk r) : evalExpr {\new Machine rt cls} (suc n) env e = rOk r =>
  evalExprMono rt cls n env e r p
