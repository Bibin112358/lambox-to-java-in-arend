\import Arith.Nat
\import Data.Array (mkArray, ++)
\import Semantics.LambdaBoxEval
\import Compiler.LambdaBox
\import Logic
\import Logic.Meta
\import Paths
\import Paths.Meta

-- =============================================================================
-- The substitution algebra of λ□'s closed substitution `csubst`
-- (`Semantics/LambdaBoxEval.ard`), used by `Proof/SubstToEnv.ard` to relate
-- evaluation by substitution to evaluation in an environment.
--
--   * Scope is `LCf k t` (`Semantics/LambdaBoxEval.ard`): the free de Bruijn
--     indices of `t` are below `k`; `LCf 0` is "closed".
--   * `csClosedF`: a term in scope `k` is untouched by a substitution at `k`
--     or above. `csScopeF`: substituting a closed term at `k` removes `k`.
--   * `csCommGen`: two closed substitutions at depths `k <= K` commute. It
--     gives `substCommuteF` (a beta step on a closure's substituted body is
--     the closure's environment extended by the argument) and
--     `substKAppend` (the multi-substitutions of `iotaRed` and `cunfoldFix`).
--
-- `csubst` never lifts, so every fact needs closedness of what is
-- substituted. The binder cases recurse at `m + (L + k)` and transport along
-- `natPlusSwap`; arrays are compared pointwise (`extArr`) or rebuilt with
-- `mkArray` inside a `path`.
-- =============================================================================

-- ---------------------------------------------------------------------------
-- Arithmetic. Prelude `Nat.+` recurses on its SECOND argument.
-- ---------------------------------------------------------------------------

\func natPlus0L (y : Nat) : 0 Nat.+ y = y => NatSemiring.zro-left

\func natPlusSucL (x y : Nat) : suc x Nat.+ y = suc (x Nat.+ y) =>
  NatSemiring.+-comm {suc x} {y} *> pmap suc (NatSemiring.+-comm {y} {x})

\func natPlusSwap (l m k : Nat) : l Nat.+ (m Nat.+ k) = m Nat.+ (l Nat.+ k) =>
  inv (NatSemiring.+-assoc {l} {m} {k}) *> pmap (\lam x => x Nat.+ k) (NatSemiring.+-comm {l} {m})
    *> NatSemiring.+-assoc {m} {l} {k}

-- `natCompare` (Coq's `Nat.compare`), as `csubstVar` consumes it.

\func ncEq {k n : Nat} (e : natCompare k n = cEq) : k = n \elim k, n
  | 0, 0 => idp
  | 0, suc n => contradiction
  | suc k, 0 => contradiction
  | suc k, suc n => pmap suc (ncEq e)

\func ncGtPlus (m : Nat) {k n : Nat} (e : natCompare k n = cGt) : natCompare (m Nat.+ k) n = cGt \elim k, n
  | 0, 0 => contradiction
  | 0, suc n => contradiction
  | suc k, 0 => idp
  | suc k, suc n => ncGtPlus m e

\func ncGtSuc {k n : Nat} (e : natCompare k n = cGt) : natCompare (suc k) n = cGt \elim k, n
  | 0, 0 => contradiction
  | 0, suc n => contradiction
  | suc k, 0 => idp
  | suc k, suc n => ncGtSuc e

\func ncSucSelf (k : Nat) : natCompare (suc k) k = cGt \elim k
  | 0 => idp
  | suc k => ncSucSelf k

\func ncNotLt0 {k : Nat} (e : natCompare k 0 = cLt) : Empty \elim k
  | 0 => contradiction
  | suc k => contradiction

\func ncLtPlus (d : Nat) {k n : Nat} (e : natCompare (d Nat.+ k) n = cLt) : natCompare k n = cLt \elim k, n
  | 0, 0 => absurd (ncNotLt0 e)
  | 0, suc n => idp
  | suc k, 0 => contradiction
  | suc k, suc n => ncLtPlus d e

-- An array rebuilt pointwise is the array.
\func extArr {A : \Type} (l : Array A) (f : Fin l.len -> A) (p : \Pi (j : Fin l.len) -> f j = l j)
  : mkArray {A} {l.len} f = {Array A} l
  => path (\lam i => \new Array A l.len (\lam j => p j i))

-- ---------------------------------------------------------------------------
-- Scope (`LCf`, in `Semantics/LambdaBoxEval.ard`).
-- ---------------------------------------------------------------------------

-- Every entry of `s` is closed.
\func AllCf (s : Array LBTerm) : \Set0 \elim s
  | nil => \Sigma
  | t :: s => \Sigma (LCf 0 t) (AllCf s)

\func allCfOf {s : Array LBTerm} (h : \Pi (i : Fin s.len) -> LCf 0 (s i)) : AllCf s \elim s
  | nil => ()
  | t :: s => (h 0, allCfOf (\lam i => h (suc i)))

\func lcfWeaken (m : Nat) {k : Nat} (u : LBTerm) (lc : LCf k u) : LCf (m Nat.+ k) u \elim u
  | box => ()
  | bvar n => ncGtPlus m lc
  | fvar _ => lc
  | lambda _ b => lcfWeaken m {suc k} b lc
  | letIn _ b0 b1 => (lcfWeaken m b0 lc.1, lcfWeaken m {suc k} b1 lc.2)
  | app f a => (lcfWeaken m f lc.1, lcfWeaken m a lc.2)
  | const _ => ()
  | construct _ _ args => \lam i => lcfWeaken m (args i) (lc i)
  | case _ _ discr brs =>
    (lcfWeaken m discr lc.1,
     \lam i => transport (\lam D => LCf D (brs i).2) (inv (natPlusSwap (brs i).1.len m k))
                         (lcfWeaken m {(brs i).1.len Nat.+ k} (brs i).2 (lc.2 i)))
  | proj _ discr => lcfWeaken m discr lc
  | fix defs _ => \lam j => transport (\lam D => LCf D (defs j).defBody) (inv (natPlusSwap defs.len m k))
                                      (lcfWeaken m {defs.len Nat.+ k} (defs j).defBody (lc j))
  | prim _ => ()

\func lcfClosedAny {s : LBTerm} (cs : LCf 0 s) (j : Nat) : LCf j s => lcfWeaken j s cs

-- ---------------------------------------------------------------------------
-- A term in scope `k` is untouched by a substitution at `k` or above.
-- ---------------------------------------------------------------------------

\func csClosedF (s : LBTerm) (m : Nat) {k : Nat} (u : LBTerm) (lc : LCf k u) : csubst s (m Nat.+ k) u = u \elim u
  | box => idp
  | bvar n => pmap (csubstVar s n) (ncGtPlus m lc)
  | fvar _ => idp
  | lambda na b => pmap (lambda na) (csClosedF s m {suc k} b lc)
  | letIn na b0 b1 => path (\lam i => letIn na (csClosedF s m b0 lc.1 @ i) (csClosedF s m {suc k} b1 lc.2 @ i))
  | app f a => path (\lam i => app (csClosedF s m f lc.1 @ i) (csClosedF s m a lc.2 @ i))
  | const _ => idp
  | construct ind c args =>
    pmap (construct ind c) (extArr args (\lam i => csubst s (m Nat.+ k) (args i)) (\lam i => csClosedF s m (args i) (lc i)))
  | case ind np discr brs =>
    path (\lam i => case ind np (csClosedF s m discr lc.1 @ i)
      (extArr brs (\lam j => ((brs j).1, csubst s ((brs j).1.len Nat.+ (m Nat.+ k)) (brs j).2))
        (\lam j => pmap (\lam x => ((brs j).1, x))
          (transport (\lam D => csubst s D (brs j).2 = (brs j).2) (inv (natPlusSwap (brs j).1.len m k))
                     (csClosedF s m {(brs j).1.len Nat.+ k} (brs j).2 (lc.2 j)))) @ i))
  | proj p discr => pmap (proj p) (csClosedF s m discr lc)
  | fix defs idx =>
    path (\lam i => fix
      (extArr defs (\lam j => \new FixDef LBTerm (defs j).defName (csubst s (defs.len Nat.+ (m Nat.+ k)) (defs j).defBody)
                                                 (defs j).principalArgIdx)
        (\lam j => pmap (\lam x => \new FixDef LBTerm (defs j).defName x (defs j).principalArgIdx)
          (transport (\lam D => csubst s D (defs j).defBody = (defs j).defBody) (inv (natPlusSwap defs.len m k))
                     (csClosedF s m {defs.len Nat.+ k} (defs j).defBody (lc j)))) @ i)
      idx)
  | prim _ => idp

-- The form used: a closed term, any depth.
\func csClosedF0 {s u : LBTerm} (k : Nat) (cu : LCf 0 u) : csubst s k u = u => csClosedF s k u cu

-- ---------------------------------------------------------------------------
-- Substituting a closed term at `k` removes index `k` from the scope.
-- ---------------------------------------------------------------------------

\func csScopeVarF {s : LBTerm} (cs : LCf 0 s) (m k n : Nat) (lb : natCompare (suc (m Nat.+ k)) n = cGt)
                  (c : Comparison) (e : natCompare k n = c) : LCf (m Nat.+ k) (csubstVar s n c) \elim n, c
  | n, cEq => lcfClosedAny cs (m Nat.+ k)
  | n, cGt => ncGtPlus m e
  | 0, cLt => absurd (ncNotLt0 e)
  | suc n, cLt => lb

\func csScopeF {s : LBTerm} (cs : LCf 0 s) (m k : Nat) (b : LBTerm) (lb : LCf (suc (m Nat.+ k)) b)
  : LCf (m Nat.+ k) (csubst s k b) \elim b
  | box => ()
  | bvar n => csScopeVarF cs m k n lb (natCompare k n) idp
  | fvar _ => lb
  | lambda _ b => csScopeF cs m (suc k) b lb
  | letIn _ b0 b1 => (csScopeF cs m k b0 lb.1, csScopeF cs m (suc k) b1 lb.2)
  | app f a => (csScopeF cs m k f lb.1, csScopeF cs m k a lb.2)
  | const _ => ()
  | construct _ _ args => \lam i => csScopeF cs m k (args i) (lb i)
  | case _ _ discr brs =>
    (csScopeF cs m k discr lb.1,
     \lam i => transport (\lam D => LCf D (csubst s ((brs i).1.len Nat.+ k) (brs i).2)) (inv (natPlusSwap (brs i).1.len m k))
       (csScopeF cs m ((brs i).1.len Nat.+ k) (brs i).2
         (transport (\lam D => LCf (suc D) (brs i).2) (natPlusSwap (brs i).1.len m k) (lb.2 i))))
  | proj _ discr => csScopeF cs m k discr lb
  | fix defs _ =>
    \lam j => transport (\lam D => LCf D (csubst s (defs.len Nat.+ k) (defs j).defBody)) (inv (natPlusSwap defs.len m k))
      (csScopeF cs m (defs.len Nat.+ k) (defs j).defBody
        (transport (\lam D => LCf (suc D) (defs j).defBody) (natPlusSwap defs.len m k) (lb j)))
  | prim _ => ()

-- ---------------------------------------------------------------------------
-- Two closed substitutions at depths `k <= K` (`K = d + k`) commute.
-- ---------------------------------------------------------------------------

\func commGenLt {a s : LBTerm} (ca : LCf 0 a) (cs : LCf 0 s) (d k n : Nat) (e1 : natCompare k (suc n) = cLt)
                (c : Comparison) (e : natCompare (d Nat.+ k) n = c)
  : csubst a k (csubstVar s (suc n) c) = csubst s (d Nat.+ k) (csubstVar a (suc n) (natCompare k (suc n))) \elim c
  | cEq => csClosedF0 k cs *> inv (pmap (csubstVar s n) e)
             *> inv (pmap (\lam x => csubst s (d Nat.+ k) (csubstVar a (suc n) x)) e1)
  | cGt => pmap (csubstVar a (suc n)) e1 *> inv (pmap (csubstVar s n) e)
             *> inv (pmap (\lam x => csubst s (d Nat.+ k) (csubstVar a (suc n) x)) e1)
  | cLt => pmap (csubstVar a n) (ncLtPlus d e) *> inv (pmap (csubstVar s n) e)
             *> inv (pmap (\lam x => csubst s (d Nat.+ k) (csubstVar a (suc n) x)) e1)

\func commGenVar {a s : LBTerm} (ca : LCf 0 a) (cs : LCf 0 s) (d k n : Nat) (c : Comparison) (e : natCompare k n = c)
  : csubst a k (csubst s (suc (d Nat.+ k)) (bvar n)) = csubst s (d Nat.+ k) (csubst a k (bvar n)) \elim n, c
  | n, cEq =>
    \let gt : natCompare (suc (d Nat.+ k)) n = cGt =>
      transport (\lam x => natCompare (suc (d Nat.+ k)) x = cGt) (ncEq e) (ncGtPlus d (ncSucSelf k))
    \in pmap (\lam x => csubst a k (csubstVar s n x)) gt *> pmap (csubstVar a n) e
        *> inv (csClosedF0 (d Nat.+ k) ca) *> inv (pmap (\lam x => csubst s (d Nat.+ k) (csubstVar a n x)) e)
  | n, cGt =>
    pmap (\lam x => csubst a k (csubstVar s n x)) (ncGtSuc (ncGtPlus d e)) *> pmap (csubstVar a n) e
      *> inv (pmap (csubstVar s n) (ncGtPlus d e)) *> inv (pmap (\lam x => csubst s (d Nat.+ k) (csubstVar a n x)) e)
  | 0, cLt => absurd (ncNotLt0 e)
  | suc n, cLt => commGenLt ca cs d k n e (natCompare (d Nat.+ k) n) idp

\func csCommGen {a s : LBTerm} (ca : LCf 0 a) (cs : LCf 0 s) (d k : Nat) (b : LBTerm)
  : csubst a k (csubst s (suc (d Nat.+ k)) b) = csubst s (d Nat.+ k) (csubst a k b) \elim b
  | box => idp
  | bvar n => commGenVar ca cs d k n (natCompare k n) idp
  | fvar _ => idp
  | lambda na b => pmap (lambda na) (csCommGen ca cs d (suc k) b)
  | letIn na b0 b1 => path (\lam i => letIn na (csCommGen ca cs d k b0 @ i) (csCommGen ca cs d (suc k) b1 @ i))
  | app f g => path (\lam i => app (csCommGen ca cs d k f @ i) (csCommGen ca cs d k g @ i))
  | const _ => idp
  | construct ind c args => path (\lam i => construct ind c (mkArray (\lam j => csCommGen ca cs d k (args j) @ i)))
  | case ind np discr brs =>
    path (\lam i => case ind np (csCommGen ca cs d k discr @ i)
      (mkArray (\lam j => ((brs j).1,
        transport (\lam D => csubst a ((brs j).1.len Nat.+ k) (csubst s (suc D) (brs j).2)
                             = csubst s D (csubst a ((brs j).1.len Nat.+ k) (brs j).2))
                  (inv (natPlusSwap (brs j).1.len d k))
                  (csCommGen ca cs d ((brs j).1.len Nat.+ k) (brs j).2) @ i))))
  | proj p discr => pmap (proj p) (csCommGen ca cs d k discr)
  | fix defs idx =>
    path (\lam i => fix
      (mkArray (\lam j => \new FixDef LBTerm (defs j).defName
        (transport (\lam D => csubst a (defs.len Nat.+ k) (csubst s (suc D) (defs j).defBody)
                              = csubst s D (csubst a (defs.len Nat.+ k) (defs j).defBody))
                   (inv (natPlusSwap defs.len d k))
                   (csCommGen ca cs d (defs.len Nat.+ k) (defs j).defBody) @ i)
        (defs j).principalArgIdx))
      idx)
  | prim _ => idp

-- The adjacent case `K = k`.
\func csCommuteF {a s : LBTerm} (ca : LCf 0 a) (cs : LCf 0 s) (k : Nat) (b : LBTerm)
  : csubst a k (csubst s (suc k) b) = csubst s k (csubst a k b) =>
  transport (\lam D => csubst a k (csubst s (suc D) b) = csubst s D (csubst a k b)) (natPlus0L k) (csCommGen ca cs 0 k b)

-- ---------------------------------------------------------------------------
-- Substituting an environment (`substK`), constructor by constructor.
-- ---------------------------------------------------------------------------

\func skBoxF (k : Nat) (sg : Array LBTerm) : substK k sg box = box \elim sg
  | nil => idp
  | s :: sg => skBoxF k sg

\func skPrimF (k : Nat) (sg : Array LBTerm) (pv : PrimVal) : substK k sg (prim pv) = prim pv \elim sg
  | nil => idp
  | s :: sg => skPrimF k sg pv

\func skConstF (k : Nat) (sg : Array LBTerm) (kn : Kername) : substK k sg (const kn) = const kn \elim sg
  | nil => idp
  | s :: sg => skConstF k sg kn

\func skLamF (k : Nat) (sg : Array LBTerm) (na : BinderName) (b : LBTerm)
  : substK k sg (lambda na b) = lambda na (substK (suc k) sg b) \elim sg
  | nil => idp
  | s :: sg => skLamF k sg na (csubst s (suc k) b)

\func skAppF (k : Nat) (sg : Array LBTerm) (f a : LBTerm)
  : substK k sg (app f a) = app (substK k sg f) (substK k sg a) \elim sg
  | nil => idp
  | s :: sg => skAppF k sg (csubst s k f) (csubst s k a)

\func skLetF (k : Nat) (sg : Array LBTerm) (na : BinderName) (b0 b1 : LBTerm)
  : substK k sg (letIn na b0 b1) = letIn na (substK k sg b0) (substK (suc k) sg b1) \elim sg
  | nil => idp
  | s :: sg => skLetF k sg na (csubst s k b0) (csubst s (suc k) b1)

\func skProjF (k : Nat) (sg : Array LBTerm) (p : ProjectionInfo) (discr : LBTerm)
  : substK k sg (proj p discr) = proj p (substK k sg discr) \elim sg
  | nil => idp
  | s :: sg => skProjF k sg p (csubst s k discr)

\func skConstructF (k : Nat) (sg : Array LBTerm) (ind : InductiveId) (c : Nat) (args : Array LBTerm)
  : substK k sg (construct ind c args) = construct ind c (mkArray {LBTerm} {args.len} (\lam i => substK k sg (args i))) \elim sg
  | nil => idp
  | s :: sg => skConstructF k sg ind c (mkArray {LBTerm} {args.len} (\lam i => csubst s k (args i)))

\func skCaseF (k : Nat) (sg : Array LBTerm) (ind : InductiveId) (np : Nat) (discr : LBTerm)
              (brs : Array (\Sigma (Array BinderName) LBTerm))
  : substK k sg (case ind np discr brs)
  = case ind np (substK k sg discr)
      (mkArray {\Sigma (Array BinderName) LBTerm} {brs.len} (\lam i => ((brs i).1, substK ((brs i).1.len Nat.+ k) sg (brs i).2))) \elim sg
  | nil => idp
  | s :: sg => skCaseF k sg ind np (csubst s k discr)
      (mkArray {\Sigma (Array BinderName) LBTerm} {brs.len} (\lam i => ((brs i).1, csubst s ((brs i).1.len Nat.+ k) (brs i).2)))

\func skFixF (k : Nat) (sg : Array LBTerm) (defs : Array (FixDef LBTerm)) (idx : Nat)
  : substK k sg (fix defs idx)
  = fix (mkArray {FixDef LBTerm} {defs.len}
          (\lam j => \new FixDef LBTerm (defs j).defName (substK (defs.len Nat.+ k) sg (defs j).defBody) (defs j).principalArgIdx))
        idx \elim sg
  | nil => idp
  | s :: sg => skFixF k sg
      (mkArray {FixDef LBTerm} {defs.len}
        (\lam j => \new FixDef LBTerm (defs j).defName (csubst s (defs.len Nat.+ k) (defs j).defBody) (defs j).principalArgIdx))
      idx

\func skClosedF (k : Nat) (sg : Array LBTerm) {u : LBTerm} (cu : LCf 0 u) : substK k sg u = u \elim sg
  | nil => idp
  | s :: sg => pmap (substK k sg) (csClosedF0 k cu) *> skClosedF k sg cu

-- A closed environment substituted at depth `m` removes `|sg|` indices.
\func skScopeF (m : Nat) (sg : Array LBTerm) (csg : AllCf sg) (b : LBTerm) (lb : LCf (m Nat.+ sg.len) b)
  : LCf m (substK m sg b) \elim sg
  | nil => lb
  | s :: sg => skScopeF m sg csg.2 (csubst s m b)
      (transport (\lam D => LCf D (csubst s m b)) (NatSemiring.+-comm {sg.len} {m})
        (csScopeF csg.1 sg.len m b (transport (\lam D => LCf (suc D) b) (NatSemiring.+-comm {m} {sg.len}) lb)))

-- The beta step on a closure's substituted body is the closure's environment
-- extended with the argument.
\func substCommuteF {a : LBTerm} (ca : LCf 0 a) (sg : Array LBTerm) (csg : AllCf sg) (b : LBTerm) (lb : LCf (suc sg.len) b)
  : csubst a 0 (substK 1 sg b) = substK 0 (a :: sg) b \elim sg
  | nil => idp
  | s :: sg =>
    substCommuteF ca sg csg.2 (csubst s 1 b) (csScopeF csg.1 sg.len 1 b lb)
      *> pmap (substK 0 sg) (csCommuteF ca csg.1 0 b)

-- ---------------------------------------------------------------------------
-- Multi-substitution (`case` via `iotaRed`, `fix` via `cunfoldFix`).
-- ---------------------------------------------------------------------------

\func substlK (tau : Array LBTerm) (b : LBTerm) : substl tau b = substK 0 tau b \elim tau
  | nil => idp
  | d :: ds => substlK ds (csubst d 0 b)

-- `substK` is a left fold.
\func skAppend (k : Nat) (xs ys : Array LBTerm) (b : LBTerm) : substK k (xs ++ ys) b = substK k ys (substK k xs b) \elim xs
  | nil => idp
  | x :: xs => skAppend k xs ys (csubst x k b)

-- A closed substitution just above a closed environment passes through it.
\func skCsubstPast {s : LBTerm} (cs : LCf 0 s) (k : Nat) (tau : Array LBTerm) (ctau : AllCf tau) (b : LBTerm)
  : substK k tau (csubst s (k Nat.+ tau.len) b) = csubst s k (substK k tau b) \elim tau
  | nil => idp
  | a :: tau =>
    pmap (substK k tau)
      (transport (\lam D => csubst a k (csubst s (suc D) b) = csubst s D (csubst a k b)) (NatSemiring.+-comm {tau.len} {k})
                 (csCommGen ctau.1 cs tau.len k b))
      *> skCsubstPast cs k tau ctau.2 (csubst a k b)

\func skSwapEnv (tau sg : Array LBTerm) (ctau : AllCf tau) (csg : AllCf sg) (b : LBTerm)
  : substK 0 tau (substK tau.len sg b) = substK 0 sg (substK 0 tau b) \elim sg
  | nil => idp
  | s :: sg =>
    skSwapEnv tau sg ctau csg.2 (csubst s tau.len b)
      *> pmap (substK 0 sg)
           (transport (\lam D => substK 0 tau (csubst s D b) = csubst s 0 (substK 0 tau b)) (natPlus0L tau.len)
                      (skCsubstPast csg.1 0 tau ctau b))

-- Substituting `tau` below an already substituted `sg` is substituting `tau ++ sg`.
\func substKAppend (tau sg : Array LBTerm) (ctau : AllCf tau) (csg : AllCf sg) (b : LBTerm)
  : substK 0 tau (substK tau.len sg b) = substK 0 (tau ++ sg) b =>
  skSwapEnv tau sg ctau csg b *> inv (skAppend 0 tau sg b)

-- ---------------------------------------------------------------------------
-- Lengths.
-- ---------------------------------------------------------------------------

\func lenRevApp {A : \Type} (xs acc : Array A) : (revAppendArr xs acc).len = acc.len Nat.+ xs.len \elim xs
  | nil => idp
  | x :: xs => lenRevApp xs (x :: acc) *> natPlusSucL acc.len xs.len

\func lenRev {A : \Type} (xs : Array A) : (revArr xs).len = xs.len => lenRevApp xs nil *> natPlus0L xs.len

