-- =============================================================================
-- WHAT IS PROVED: the correctness statement of the λ□ -> Java backend.
--
-- Read this file first. `CorrectClosedFO` at the bottom is the headline claim;
-- `Proof/MainTheorem.ard` proves it (`correctClosedFO`). Everything it
-- mentions is defined here, in `Semantics/` (the models of λ□, Java and the
-- runtime) or in `Compiler/` (the compiler being verified).
-- =============================================================================

-- ---------------------------------------------------------------------------
-- When a λ□ value and a Java value "are the same" (first-order values only).
--
-- `box` is `Rt.BOX`, a literal is the `long` with that value (a 64-bit literal
-- is stored as its bit pattern and read signed), and a constructor is an
-- `Rt.Data` with the same tag and related fields. Functions are not related
-- here: the full proof relates closures by the code they were compiled from
-- (`Proof/CompileValue.ard`), and this relation is what that yields for data.
--
-- `intEqB` is equality on `Int` (`Proof/OracleArith.ard`: `intEqB-sound`); it
-- compares decimal strings, so that concrete instances with values near 2^63
-- are still decided by `idp`.
-- ---------------------------------------------------------------------------

-- `allWith n vs f`: `vs` has length `n` and `f i (vs i)` holds for every `i`.
\func allWith (n : Nat) (vs : Array Value) (f : Fin n -> Value -> Bool) : Bool \elim n, vs
  | 0, nil => true
  | suc n, v :: vs => f 0 v and allWith n vs (\lam i => f (suc i))
  | _, _ => false

\func agrees (t : LBTerm) (v : Value) : Bool \elim t, v
  | box, vBox => true
  | prim (primInt63, i), vLong j => intEqB (pos i) j
  | prim (primInt64, i), vLong j => intEqB (signed64 i) j
  | construct _ c args, vData tg fs => (c == tg) and allWith args.len fs (\lam i => agrees (args i))
  | _, _ => false

\func ValRel (t : LBTerm) (v : Value) : \Prop => agrees t v = true

-- ---------------------------------------------------------------------------
-- The two axiom oracles agree.
--
-- Both semantics take their axioms as a parameter: λ□ an `LBSpec` keyed by
-- `Kername`, Java an `RtSpec` keyed by the runtime constant's name. The
-- backend links them through its axiom table: `axiomRtName kn` is the `Rt`
-- constant the axiom `kn` compiles to, or `nothing` for a throwing stub.
-- `OracleAgree` asks, for every axiom:
--   * compiled to `Rt.nm`: `AxiomAgree` (arities match, results agree);
--   * compiled to a stub: λ□ cannot compute it either.
--
-- Proved for the shipped pair in `Proof/OracleShipped.ard` (`oracleShipped`).
-- ---------------------------------------------------------------------------

\func axiomRtName (kn : Kername) : Maybe JIdent => \case axiomImpl kn \with {
  | just (jField _ nm) => just nm
  | _ => nothing
}

-- Axiom `kn`, compiled to `Rt.nm`: the arities match, and on related
-- arguments both sides compute related results.
\func AxiomAgree (spec : LBSpec) (rt : RtSpec) (kn : Kername) (nm : JIdent) : \Type =>
  \Sigma
    (axiomArity {spec} kn = builtinArity {rt} nm)
    (\Pi (args : Array LBTerm) (jargs : Array Value args.len) (v : LBTerm)
      -> (\Pi (i : Fin args.len) -> ValRel (args i) (jargs i))
      -> axiomRun {spec} kn args = just v
      -> \Sigma (jv : Value) (builtinRun {rt} nm jargs = rOk jv) (ValRel v jv))

\func OracleAgree (spec : LBSpec) (rt : RtSpec) : \Type =>
  \Sigma
    (\Pi (kn : Kername) (nm : JIdent) -> axiomRtName kn = just nm -> AxiomAgree spec rt kn nm)
    (\Pi (kn : Kername) -> axiomRtName kn = nothing -> axiomArity {spec} kn = nothing)

-- ---------------------------------------------------------------------------
-- THE THEOREM.
--
-- For a program `p` whose body and constant bodies are closed: if λ□ (with
-- the shipped axioms `lbAxioms`) evaluates `p` to a first-order value `v`,
-- then the compiled class's `body()`, run in the Java model with the shipped
-- runtime model `rtInt63`, RETURNS (does not throw, does not get stuck) a
-- value related to `v`.
--
-- `JEval` is "some amount of fuel suffices". Both closedness hypotheses are
-- necessary: λ□'s substitution captures free variables, which no
-- scope-respecting compiler can imitate. Results that are functions are
-- covered too, by `backendShipped` in `Proof/MainTheorem.ard`.
-- ---------------------------------------------------------------------------

\func progClassName : JIdent => "Prog"

\func CorrectClosedFO : \Type =>
  \Pi {p : LBProgram} {v : LBTerm} -> GlobClosed p.1 -> LCf 0 p.2 -> EvalProgram lbAxioms p v -> FOVal v ->
    \Sigma (jv : Value)
           (JEval rtInt63 (compileClass progClassName p) bodyMethodName jv)
           (ValRel v jv)
