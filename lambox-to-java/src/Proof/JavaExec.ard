-- =============================================================================
-- RUNNING GENERATED CODE: the Java side of the backend proof.
--
-- Facts about the Java model (`Semantics/JavaEval.ard`) and about the shape of
-- `Compiler/ToJava.ard`'s output that do not mention λ□: statement sequences
-- compose, a `return` ends one, argument lists evaluate pointwise, a `case`'s
-- ternary chain selects the arm of the scrutinee's tag, calls and builtins
-- take one step, and `pushFixMethods` builds the compile-time environment in
-- the order the λ□ side's `fixEnv` predicts. The client is `Proof/EnvToJava.ard`.
--
-- FUEL. The evaluator counts fuel. Lemmas give SOME sufficient amount, and
-- `upE`/`upS`/`upA`/`upAp` move a successful run to any larger one
-- (monotonicity, `Proof/FuelMono.ard`).
-- =============================================================================

-- ---------------------------------------------------------------------------
-- Small general facts.
-- ---------------------------------------------------------------------------

\func bindOk {A B : \Type} {m : Res A} {k : A -> Res B} {a : A} {r : Res B}
             (p : m = rOk a) (q : k a = r) : bindRes m k = r =>
  rewrite p q

-- `==` of a `DecSet`, on equal and on distinct elements.
\func eqSelf {A : DecSet} (x : A) : (x == x) = true =>
  unfold (==) (rewrite (decideEq=_reduce {A} {x} {x} idp) idp)

\func eqOther {A : DecSet} {x y : A} (ne : x /= y) : (x == y) = false =>
  unfold (==) (rewrite (decideEq/=_reduce ne) idp)

-- One step of `StringUtil.lookupBy`: the entry is found, or skipped.
\func lookupStepHit {A : \Type} {K : DecSet} (x : A) {a b : K} (e : a = b) (rest : Maybe A)
  : lookupStep x (a == b) rest = just x =>
  rewrite e (pmap (\lam c => lookupStep x c rest) (eqSelf b))

\func lookupStepMiss {A : \Type} {K : DecSet} (x : A) {a b : K} (ne : a /= b) (rest : Maybe A)
  : lookupStep x (a == b) rest = rest =>
  pmap (\lam c => lookupStep x c rest) (eqOther ne)

\func unNormal (d : Env) (o : Res StmtOut) : Env \elim o
  | rOk (oNormal e) => e
  | _ => d

\func tailOr {A : \Type} (d : Array A) (l : Array A) : Array A \elim l
  | nil => d
  | _ :: t => t

\func unhead {A : \Type} {x y : A} {xs ys : Array A} (p : x :: xs = y :: ys) : xs = ys => pmap (tailOr xs) p

-- ---------------------------------------------------------------------------
-- Variables.
-- ---------------------------------------------------------------------------

-- The head binding is found; a head binding of a different name, in either
-- namespace, is skipped.
\func lookupKeyHead (k : Key) (v : Value) (env : Env) : lookupKey k ((k, v) :: env) = just v =>
  pmap (Maybe.map (\lam (e : \Sigma Key Value) => e.2))
       (lookupStepHit (k, v) idp (lookupBy (\lam (e : \Sigma Key Value) => e.1) k env))

\func lookupKeyCons {k k' : Key} (v : Value) (env : Env) (ne : keyName k /= keyName k')
  : lookupKey k' ((k, v) :: env) = lookupKey k' env =>
  pmap (Maybe.map (\lam (e : \Sigma Key Value) => e.2))
       (lookupStepMiss (k, v) (\lam (e : k = k') => ne (pmap keyName e)) (lookupBy (\lam (e : \Sigma Key Value) => e.1) k' env))

\func lookupHead (x : JIdent) (v : Value) (env : Env) : lookupVar ((kVar x, v) :: env) x = just v =>
  lookupKeyHead (kVar x) v env

\func lookupCons {k : Key} {y : JIdent} (v : Value) (env : Env) (ne : keyName k /= y)
  : lookupVar ((k, v) :: env) y = lookupVar env y =>
  lookupKeyCons {k} {kVar y} v env ne

\func lookupTypeHead (c : JIdent) (v : Value) (env : Env) : lookupType ((kType c, v) :: env) c = just v =>
  lookupKeyHead (kType c) v env

\func lookupTypeCons {k : Key} {c : JIdent} (v : Value) (env : Env) (ne : keyName k /= c)
  : lookupType ((k, v) :: env) c = lookupType env c =>
  lookupKeyCons {k} {kType c} v env ne

\func evalVar (rt : RtSpec) (cls : JClass) (n : Nat) {env : Env} {x : JIdent} {v : Value} (h : lookupVar env x = just v)
  : evalExpr {\new Machine rt cls} (suc n) env (jVar x) = rOk (eVal v) =>
  rewrite h idp

-- ---------------------------------------------------------------------------
-- Fuel.
-- ---------------------------------------------------------------------------

\func upE {rt : RtSpec} {cls : JClass} {env : Env} {e : JExpr} {r : ExprOut} {n m : Nat} (le : n <= m)
          (h : evalExpr {\new Machine rt cls} n env e = rOk r) : evalExpr {\new Machine rt cls} m env e = rOk r =>
  transport (\lam x => evalExpr {\new Machine rt cls} x env e = rOk r) (<=_exists le) (evalExprMonoPlus rt cls n (m -' n) env e r h)

\func upS {rt : RtSpec} {cls : JClass} {env : Env} {ss : Array JStmt} {r : StmtOut} {n m : Nat} (le : n <= m)
          (h : execStmts {\new Machine rt cls} n env ss = rOk r) : execStmts {\new Machine rt cls} m env ss = rOk r =>
  transport (\lam x => execStmts {\new Machine rt cls} x env ss = rOk r) (<=_exists le) (execStmtsMonoPlus rt cls n (m -' n) env ss r h)

\func upA {rt : RtSpec} {cls : JClass} {env : Env} {es : Array JExpr} {r : ArgsOut} {n m : Nat} (le : n <= m)
          (h : evalArgs {\new Machine rt cls} n env es = rOk r) : evalArgs {\new Machine rt cls} m env es = rOk r =>
  transport (\lam x => evalArgs {\new Machine rt cls} x env es = rOk r) (<=_exists le) (evalArgsMonoPlus rt cls n (m -' n) env es r h)

\func upAp {rt : RtSpec} {cls : JClass} {f a : Value} {r : ExprOut} {n m : Nat} (le : n <= m)
           (h : applyVal {\new Machine rt cls} n f a = rOk r) : applyVal {\new Machine rt cls} m f a = rOk r =>
  transport (\lam x => applyVal {\new Machine rt cls} x f a = rOk r) (<=_exists le) (applyValMonoPlus rt cls n (m -' n) f a r h)

\func evalArgsMonoPlus (rt : RtSpec) (cls : JClass) (n k : Nat) (env : Env) (es : Array JExpr)
  : Mono (evalArgs {\new Machine rt cls} n env es) (evalArgs {\new Machine rt cls} (n Nat.+ k) env es) \elim k
  | 0 => monoRefl
  | suc k => monoTrans (evalArgsMonoPlus rt cls n k env es) (evalArgsMono rt cls (n Nat.+ k) env es)

\func applyValMonoPlus (rt : RtSpec) (cls : JClass) (n k : Nat) (f a : Value)
  : Mono (applyVal {\new Machine rt cls} n f a) (applyVal {\new Machine rt cls} (n Nat.+ k) f a) \elim k
  | 0 => monoRefl
  | suc k => monoTrans (applyValMonoPlus rt cls n k f a) (applyValMono rt cls (n Nat.+ k) f a)

\func execStmtMonoPlus (rt : RtSpec) (cls : JClass) (n k : Nat) (env : Env) (s : JStmt)
  : Mono (execStmt {\new Machine rt cls} n env s) (execStmt {\new Machine rt cls} (n Nat.+ k) env s) \elim k
  | 0 => monoRefl
  | suc k => monoTrans (execStmtMonoPlus rt cls n k env s) (execStmtMono rt cls (n Nat.+ k) env s)

-- ---------------------------------------------------------------------------
-- Statements.
-- ---------------------------------------------------------------------------

-- Two statement sequences run one after the other. (`\case` does not reduce
-- under a hypothesis about its scrutinee, hence the `\as s, idp` idiom.)
\func execApp {rt : RtSpec} {cls : JClass} {n m : Nat} {env e1 : Env} {xs ys : Array JStmt} {r : StmtOut}
              (hx : execStmts {\new Machine rt cls} n env xs = rOk (oNormal e1)) (hy : execStmts {\new Machine rt cls} m e1 ys = rOk r)
  : execStmts {\new Machine rt cls} (n Nat.+ m) env (appendStmts xs ys) = rOk r \elim n, xs
  | 0, _ => contradiction
  | suc n, nil =>
    \let | pe : env = e1 => pmap (unNormal env) hx
    \in rewrite pe (upS (linarith : m <= suc n Nat.+ m) hy)
  | suc n, x :: xs =>
    \case execStmt {\new Machine rt cls} n env x \as s, idp : execStmt {\new Machine rt cls} n env x = s \with {
      | rOk (oNormal env'), q =>
        \let | h2 : execStmts {\new Machine rt cls} n env' xs = rOk (oNormal e1) => rewrite q at hx $ hx
        \in bindOk (execStmtMonoPlus rt cls n m env x (oNormal env') q) (execApp h2 hy)
      | rOk (oReturn v), q => rewrite q at hx $ contradiction
      | rOk (oExcS ev), q => rewrite q at hx $ contradiction
      | rStuck, q => rewrite q at hx $ contradiction
      | rOutOfFuel, q => rewrite q at hx $ contradiction
    }

\func execNilInv {rt : RtSpec} {cls : JClass} {n : Nat} {env E : Env} (h : execStmts {\new Machine rt cls} n env nil = rOk (oNormal E)) : env = E \elim n
  | 0 => \case h
  | suc n => pmap (unNormal env) h

\func execRet1 {rt : RtSpec} {cls : JClass} {n : Nat} {env : Env} {e : JExpr} {v : Value}
               (h : evalExpr {\new Machine rt cls} n env e = rOk (eVal v))
  : execStmts {\new Machine rt cls} (suc (suc n)) env (jReturn e :: nil) = rOk (oReturn v) =>
  rewrite h idp

-- The statements of a compiled node, then `return` of its value expression.
\func execRetApp {rt : RtSpec} {cls : JClass} {n m : Nat} {env e1 : Env} {ss : Array JStmt} {e : JExpr} {v : Value}
                 (hs : execStmts {\new Machine rt cls} n env ss = rOk (oNormal e1)) (he : evalExpr {\new Machine rt cls} m e1 e = rOk (eVal v))
  : \Sigma (N : Nat) (execStmts {\new Machine rt cls} N env (appendStmts ss (jReturn e :: nil)) = rOk (oReturn v)) =>
  (n Nat.+ suc (suc m), execApp {rt} {cls} {n} {suc (suc m)} hs (execRet1 he))

\func execLocal1 {rt : RtSpec} {cls : JClass} {n : Nat} {env : Env} (t : JType) (x : JIdent) {e : JExpr} {v : Value}
                 (h : evalExpr {\new Machine rt cls} n env e = rOk (eVal v))
  : execStmts {\new Machine rt cls} (suc (suc n)) env (jLocal t x e :: nil) = rOk (oNormal ((kVar x, v) :: env)) =>
  rewrite h idp

-- The two statements of a `fix` node: declare the local class, instantiate it.
\func fixExec (rt : RtSpec) (cls : JClass) (cn inst : JIdent) (ms : Array (\Sigma JIdent JIdent (Array JStmt))) (jenv : Env)
  : execStmts {\new Machine rt cls} 5 jenv (jLocalClass cn ms :: jLocal (tClass cn) inst (jNew (tClass cn) nil) :: nil)
  = rOk (oNormal ((kVar inst, vObj cn ms jenv) :: (kType cn, vObj cn ms jenv) :: jenv)) =>
  rewrite (lookupTypeHead cn (vObj cn ms jenv) jenv) idp

-- ---------------------------------------------------------------------------
-- Casts: a known class resolves to itself unless a local class shadows it.
-- ---------------------------------------------------------------------------

\func resolveKnown {env : Env} {q : JQIdent} {e : \Sigma JQIdent JIdent ClassId}
                   (hk : lookupBy (\lam (e : \Sigma JQIdent JIdent ClassId) => e.1) q knownClasses = just e)
                   (h1 : lookupType env q = nothing) (h2 : lookupType env e.2 = nothing)
  : resolveType env (tClass q) = just e.3 =>
  pmap (\lam l => resolveType.resolveWith env l (lookupBy (\lam (e : \Sigma JQIdent JIdent ClassId) => e.1) q knownClasses)) h1
  *> pmap (resolveType.resolveWith env nothing) hk
  *> pmap (\lam s => resolveType.unlessShadowed s e.3) h2

\func castResolved {env : Env} {t : JType} {d : ClassId} (rs : resolveType env t = just d) (v : Value)
  : castOk env t v = instanceOf v d =>
  pmap (\lam r => castOk.castTo r v) rs

-- A cast that succeeds is the identity.
\func castPasses {env : Env} {t : JType} {v : Value} (ok : castOk env t v = just true) : cast env t v = value v =>
  pmap (\lam o => cast.afterCast o v) ok

-- ---------------------------------------------------------------------------
-- Expressions.
-- ---------------------------------------------------------------------------

-- An argument list whose members each evaluate.
\func evalArgsAll {rt : RtSpec} {cls : JClass} {env : Env} (es : Array JExpr) (vs : Array Value es.len)
                  (h : \Pi (i : Fin es.len) -> \Sigma (n : Nat) (evalExpr {\new Machine rt cls} n env (es i) = rOk (eVal (vs i))))
  : \Sigma (n : Nat) (evalArgs {\new Machine rt cls} n env es = rOk (aVals vs)) \elim es, vs
  | nil, vs => (1, idp)
  | e :: es, v :: vs =>
    \let
      | (n1, h1) => h 0
      | (n2, h2) => evalArgsAll es vs (\lam i => h (suc i))
      | n => n1 Nat.+ n2 Nat.+ 1
    \in (suc n,
        \let
          | h1' => upE (linarith : n1 <= n) h1
          | h2' => upA (linarith : n2 <= n) h2
        \in rewrite (h1', h2') idp)

\lemma tagNe {n m k : Nat} (p : n = suc (m Nat.+ k)) : (n == m) = false =>
  eqOther (\lam (e : n = m) => \let q : m = suc (m Nat.+ k) => inv e *> p \in linarith)

-- The ternary chain of a `case` selects arm `j` when the tag is `tag + j`.
\func condChainEval {rt : RtSpec} {cls : JClass} {env : Env} {dv : JIdent} {c : Nat} {fs : Array Value}
                    (hd : lookupVar env dv = just (vData c fs)) (p : Path)
                    (arms : Array JExpr) (tag : Nat) (j : Fin arms.len) (e : c = tag Nat.+ j) {v : Value}
                    (ha : \Sigma (n : Nat) (evalExpr {\new Machine rt cls} n env (arms j) = rOk (eVal v)))
  : \Sigma (n : Nat) (evalExpr {\new Machine rt cls} n env (condChain (jVar dv) tag arms p) = rOk (eVal v)) \elim arms, j
  | a :: arms, 0 =>
    \let (n, h) => ha
         | n' => suc (suc (suc n))
    \in (n', rewrite (hd, e, eqSelf tag) (upE (linarith : n <= suc (suc n)) h))
  | a :: arms, suc j =>
    \let | (n, h) => condChainEval hd p arms (suc tag) j e ha
         | n' => suc (suc (suc n))
    \in (n', rewrite (hd, tagNe e) (upE (linarith : n <= suc (suc n)) h))

\func applyEval {rt : RtSpec} {cls : JClass} {N : Nat} {env : Env} {f a : JExpr} {jf ja : Value} {r : ExprOut}
                (hf : evalExpr {\new Machine rt cls} N env f = rOk (eVal jf)) (ok : castOk env tFn jf = just true)
                (ha : evalExpr {\new Machine rt cls} N env a = rOk (eVal ja)) (hap : applyVal {\new Machine rt cls} N jf ja = rOk r)
  : evalExpr {\new Machine rt cls} (suc N) env (jApply f a) = rOk r =>
  bindOk hf (bindOk (castPasses {env} {tFn} ok) (bindOk ha hap))

\func callConst {rt : RtSpec} {cls : JClass} {n : Nat} {q : JQIdent} {m : JMethod} {B : Array JStmt} {v : Value}
                (lk : lookupMethod cls q = just m) (bd : JMethod.mBody {m} = B)
                (ex : execStmts {\new Machine rt cls} n nil B = rOk (oReturn v)) (env : Env)
  : evalExpr {\new Machine rt cls} (suc (suc n)) env (jCallStatic q nil) = rOk (eVal v) =>
  rewrite lk (bindOk (transport (\lam B' => execStmts {\new Machine rt cls} n nil B' = rOk (oReturn v)) (inv bd) ex) idp)

\func fieldEval {rt : RtSpec} {cls : JClass} {nm : JIdent} {v : Value} (rf : rtField {rt} nm = just v) (env : Env)
  : evalExpr {\new Machine rt cls} 2 env (jField rtRef nm) = rOk (eVal v) =>
  rewrite rf idp

\func castDataEval {rt : RtSpec} {cls : JClass} {m : Nat} {env : Env} {e : JExpr} {c : Nat} {fs : Array Value}
                   (rs : resolveType env tData = just cRtData) (h : evalExpr {\new Machine rt cls} m env e = rOk (eVal (vData c fs)))
  : evalExpr {\new Machine rt cls} (suc m) env (jCast tData e) = rOk (eVal (vData c fs)) =>
  bindOk h (castPasses {env} {tData} (castResolved {env} {tData} rs (vData c fs)))

\func projEval {rt : RtSpec} {cls : JClass} {m : Nat} {env : Env} {e : JExpr} {c k : Nat} {fs : Array Value} {f : Value}
               (rs : resolveType env tData = just cRtData)
               (h : evalExpr {\new Machine rt cls} m env e = rOk (eVal (vData c fs))) (hk : nthArr k fs = just f)
  : evalExpr {\new Machine rt cls} (suc (suc m)) env (jDataField (jCast tData e) k) = rOk (eVal f) =>
  bindOk (castDataEval rs h) (rewrite hk idp)

\func fieldEvalV {rt : RtSpec} {cls : JClass} {env : Env} {x : JIdent} {c k : Nat} {fs : Array Value} {f : Value}
                 (hl : lookupVar env x = just (vData c fs)) (hk : nthArr k fs = just f)
  : evalExpr {\new Machine rt cls} 2 env (jDataField (jVar x) k) = rOk (eVal f) =>
  bindOk (evalVar rt cls 0 hl) (rewrite hk idp)

\func qualThisEval {rt : RtSpec} {cls : JClass} {env : Env} {q c : JIdent} {ms : Array (\Sigma JIdent JIdent (Array JStmt))} {ce : Env}
                   (h : lookupType env q = just (vObj c ms ce))
  : evalExpr {\new Machine rt cls} 1 env (jQualThis q) = rOk (eVal (vObj c ms ce)) => rewrite h idp

\func invokeEval {rt : RtSpec} {cls : JClass} {n0 : Nat} {env : Env} {recv : JExpr} {m x : JIdent} {a obj : Value} {r : ExprOut}
                 (hr : evalExpr {\new Machine rt cls} (suc (suc n0)) env recv = rOk (eVal obj)) (hx : lookupVar env x = just a)
                 (hi : invokeMethod {\new Machine rt cls} (suc (suc n0)) obj m (a :: nil) = rOk r)
  : evalExpr {\new Machine rt cls} (suc (suc (suc n0))) env (jInvoke recv m (jVar x :: nil)) = rOk r =>
  \let ha : evalArgs {\new Machine rt cls} (suc (suc n0)) env (jVar x :: nil) = rOk (aVals (a :: nil)) => rewrite hx idp
  \in bindOk hr (bindOk ha hi)

-- A method of a local class runs with its parameter, then the class name (a
-- type) bound to the instance, then the declaration's environment.
\func methodInvoke {rt : RtSpec} {cls : JClass} {n : Nat} {cn m : JIdent} {ms : Array (\Sigma JIdent JIdent (Array JStmt))} {E0 : Env}
                   {pb : \Sigma JIdent (Array JStmt)} {a v : Value}
                   (lk : lookupClassMethod ms m = just pb)
                   (ex : execStmts {\new Machine rt cls} n ((kVar pb.1, a) :: (kType cn, vObj cn ms E0) :: E0) pb.2 = rOk (oReturn v))
  : invokeMethod {\new Machine rt cls} (suc n) (vObj cn ms E0) m (a :: nil) = rOk (eVal v) =>
  rewrite lk (bindOk ex idp)

-- A builtin applied to its last argument fires; before that it collects.
\func builtinFire {rt : RtSpec} {cls : JClass} {nm : JIdent} {got : Array Value} {ja v : Value} {k : Nat}
                  (ba : builtinArity {rt} nm = just k) (lt : ((snocArr got ja).len == k) = true)
                  (bro : builtinRun {rt} nm (snocArr got ja) = rOk v)
  : applyVal {\new Machine rt cls} 1 (vBuiltin nm got) ja = rOk (eVal v) =>
  rewrite ba (rewrite lt (rewrite bro idp))

\func builtinCollect {rt : RtSpec} {cls : JClass} {nm : JIdent} {got : Array Value} {ja : Value} {k : Nat}
                     (ba : builtinArity {rt} nm = just k) (lf : ((snocArr got ja).len == k) = false)
  : applyVal {\new Machine rt cls} 1 (vBuiltin nm got) ja = rOk (eVal (vBuiltin nm (snocArr got ja))) =>
  rewrite ba (rewrite lf idp)

-- ---------------------------------------------------------------------------
-- First bytes of names (`headIs 82 s.bytes`: `s` starts with `R`).
-- ---------------------------------------------------------------------------

\func natEqB (a b : Nat) : Bool \elim a, b
  | 0, 0 => true
  | suc a, suc b => natEqB a b
  | _, _ => false

\func headIs (n : Nat) (bs : Array Byte) : Bool \elim bs
  | nil => false
  | b :: _ => natEqB b n

-- ---------------------------------------------------------------------------
-- Arrays and the compile-time environment.
-- ---------------------------------------------------------------------------

\func nthArrFin {A : \Type} {n : Nat} {xs : Array A} {x : A} (h : nthArr n xs = just x)
  : \Sigma (j : Fin xs.len) (j = {Nat} n) (xs j = x) \elim n, xs
  | 0, x' :: xs => (0, idp, just-injective h)
  | suc n, x' :: xs =>
    \let (j', p, q) => nthArrFin h
    \in (suc j', pmap suc p, q)
  | 0, nil => contradiction
  | suc _, nil => contradiction

\func nthArrAt {A : \Type} (xs : Array A) (j : Fin xs.len) : nthArr j xs = just (xs j) \elim xs, j
  | x :: xs, 0 => idp
  | x :: xs, suc j => nthArrAt xs j

\func nthVarAt {n : Nat} {cenv : Array JExpr} {e : JExpr} (h : nthArr n cenv = just e) (p : Path)
  : nthVar n cenv p = e \elim n, cenv
  | 0, x :: xs => just-injective h
  | suc n, x :: xs => nthVarAt h p
  | 0, nil => contradiction
  | suc _, nil => contradiction

\func revAppendArr_app {A : \Type} (xs ys zs : Array A) : revAppendArr xs ys ++ zs = revAppendArr xs (ys ++ zs) \elim xs
  | nil => idp
  | x :: xs => revAppendArr_app xs (x :: ys) zs

\func revArrApp {A : \Type} (xs ys : Array A) : revArr xs ++ ys = revAppendArr xs ys =>
  revAppendArr_app xs nil ys

-- The fix siblings as `pushFixMethods` pushes them: head = the LAST one.
\func fixRefs (recv : JExpr) (p : Path) (n : Nat) : Array JExpr \elim n
  | 0 => nil
  | suc n => fixMethodRef recv p n :: fixRefs recv p n

\func pushFixMethods_app {recv : JExpr} {p : Path} {j k : Nat} {env1 env2 : Array JExpr}
  : pushFixMethods recv p j k (env1 ++ env2) = pushFixMethods recv p j k env1 ++ env2 \elim k
  | 0 => idp
  | suc k => pushFixMethods_app {recv} {p} {suc j} {k} {fixMethodRef recv p j :: env1} {env2}

\func fixRefsJ (recv : JExpr) (p : Path) (j n : Nat) : Array JExpr \elim n
  | 0 => nil
  | suc n => fixMethodRef recv p (j Nat.+ n) :: fixRefsJ recv p j n

\func fixRefsJ_suc {recv : JExpr} {p : Path} (j n : Nat) : fixRefsJ recv p j (suc n) = fixRefsJ recv p (suc j) n ++ (fixMethodRef recv p j :: nil) \elim n
  | 0 => idp
  | suc n => pmap {Array JExpr} {Array JExpr} (fixMethodRef recv p (suc j Nat.+ n) :: __) (fixRefsJ_suc j n)

\func pushFixRefs_nil {recv : JExpr} {p : Path} (j n : Nat)
  : pushFixMethods recv p j n nil = fixRefsJ recv p j n \elim n
  | 0 => idp
  | suc n => pushFixMethods_app {recv} {p} {suc j} {n} {nil} {fixMethodRef recv p j :: nil}
             *> pmap (__ ++ (fixMethodRef recv p j :: nil)) (pushFixRefs_nil {recv} {p} (suc j) n)
             *> inv (fixRefsJ_suc j n)

\func fixRefsJ0 {recv : JExpr} {p : Path} (n : Nat) : fixRefsJ recv p 0 n = fixRefs recv p n \elim n
  | 0 => idp
  | suc n => pmap {Array JExpr} {Array JExpr} (fixMethodRef recv p n :: __) (fixRefsJ0 n)

\func pushFixRefs (recv : JExpr) (p : Path) (n : Nat) (env : Array JExpr)
  : pushFixMethods recv p 0 n env = fixRefs recv p n ++ env =>
  pushFixMethods_app {recv} {p} {0} {n} {nil} {env} *> pmap (__ ++ env) (pushFixRefs_nil {recv} {p} 0 n *> fixRefsJ0 n)

-- ---------------------------------------------------------------------------
-- Finding a method of a `fix` class.
-- ---------------------------------------------------------------------------

\lemma fixMethodName-inj {i j : Nat} (e : fixMethodName i = fixMethodName j) : i = j =>
  natToStr-inj (stringExt {natToStr i} {natToStr j} (unhead (pmap (\lam (s : String) => s.bytes) e)))

\func lookupBy_fix {k : Nat} (o : Nat) (f : Fin k -> \Sigma JIdent JIdent (Array JStmt)) (j : Fin k)
  (h : \Pi (i : Fin k) -> (f i).1 = fixMethodName (i Nat.+ o))
  : lookupBy (\lam (m : \Sigma JIdent JIdent (Array JStmt)) => m.1) (fixMethodName (j Nat.+ o)) (mkArray f) = just (f j) \elim k, j
  | suc k, 0 => lookupStepHit (f 0) (h 0) _
  | suc k, suc j =>
    lookupStepMiss (f 0) (\lam e => \let q : 0 Nat.+ o = suc j Nat.+ o => fixMethodName-inj (inv (h 0) *> e) \in linarith) _
    *> lookupBy_fix (suc o) (\lam i => f (suc i)) j (\lam i => h (suc i))

\func lookupFixMethod {k : Nat} (F : Fin k -> \Sigma JIdent (Array JStmt)) (j : Fin k)
  : lookupClassMethod (mkArray {\Sigma JIdent JIdent (Array JStmt)} {k} (\lam i => (fixMethodName i, (F i).1, (F i).2)))
                      (fixMethodName j) = just (F j) =>
  \let f (i : Fin k) : \Sigma JIdent JIdent (Array JStmt) => (fixMethodName i, (F i).1, (F i).2)
  \in pmap (Maybe.map (\lam (m : \Sigma JIdent JIdent (Array JStmt)) => (m.2, m.3))) (lookupBy_fix 0 f j (\lam i => idp))
