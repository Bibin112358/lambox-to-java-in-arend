\import Arith.Nat
\import Compiler.Int63
\import Compiler.JavaLong (wrap64)
\import Compiler.LambdaBox
\import Compiler.LongRewrite
\import Paths
\import Proof.Mod64 (signed-wrapu)
\import Proof.OracleArith (wrap64-pos)

-- What the Java-long pass (`Compiler/LongRewrite.ard`) preserves.
--
-- A literal keeps the number it denotes: a `Uint63` payload `i` becomes the
-- 64-bit pattern whose signed reading is `i` again. So the rewritten program
-- can only compute something different through an operation, and the
-- `Uint63` and `long` operations agree on results in [0, 2^63). That second
-- half is a property of a run, not of the program text; `ModelChecks/Sanity.ard`
-- checks a run where it holds and one where it does not (an addition crossing
-- 2^63).

-- The number a primitive literal denotes: a `Uint63` is its magnitude, a
-- `javaLong` the signed reading of its bits.
\func primValue (pv : PrimVal) : Int \elim pv
  | (rocqUint63, i) => pos i
  | (javaLong, i) => signed64 i

\lemma rewritePrim-value (pv : PrimVal) : primValue (rewritePrim pv) = primValue pv \elim pv
  | (rocqUint63, i) => signed-wrapu (pos i) *> wrap64-pos (fin_< i)
  | (javaLong, i) => idp
