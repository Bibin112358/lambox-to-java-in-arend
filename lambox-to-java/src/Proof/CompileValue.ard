\import Compiler.StringUtil
\import Compiler.ToJava

-- =============================================================================
-- THE VALUE RELATION of the second step: λ□ with environments => Java.
--
-- `Proof/SubstToEnv.ard` took λ□ from substitution to environments. Both
-- sides of this step now keep environments and closures, and the relation
-- between their values is, as in MetaRocq's `compile_value` step, "the Java
-- value is what the backend makes of that environment value":
--
--   * `evBox`, a primitive, a constructor value: `Rt.BOX`, the boxed long of
--     the literal (the same reading `int63Lit`/`int64Lit` take), `Rt.Data`
--     with related fields.
--   * `evClos na b rho`: the Java closure compiled from `b` at SOME path `p`
--     under SOME compile-time environment `cenv`, capturing a runtime
--     environment `E` that realizes `rho` along `cenv` (`EnvRel`). Which `p`
--     and `cenv` does not matter -- that is the whole point of relating by
--     construction (Leroy): the code is `compileExpr` of the body, whatever
--     the context.
--   * `evFix defs idx rho`: the forwarding closure of `fixMethodRef`, whose
--     receiver evaluates to the instance of the local class compiled from
--     `defs` at `p` under `cenv`, declared in a runtime environment `E0`
--     realizing `rho`. The receiver is `jVar inst` for the value a `fix`
--     node returns and `Fix.this` for a sibling reached from inside a method;
--     the relation only asks that it evaluate to that instance.
--   * `evAx kn args`: the runtime constant `Rt.<nm>` the backend realizes
--     `kn` by, holding the related arguments OLDEST FIRST (`RevCV`: the λ□
--     side collects newest first).
--
-- `EnvRel rho cenv E c`: index `i` compiles to the expression `cenv i`, and
-- that expression evaluates to a value related to `rho i` -- in `E`, and in
-- `E` extended by anything bound LATER at paths that are not strict ancestors
-- of the use site `c` (`NotAnc`, Proof/PathFresh.ard). Stating it for every
-- such extension, rather than for `E`, is what lets a variable survive the
-- statements of siblings and of its own subterm.
--
-- `SimOut`: the statements of the compiled node run and bind only names in the
-- node's subtree (`Within`), and the value expression then evaluates to a
-- related value in the resulting environment extended by anything from an
-- INDEPENDENT subtree (`IndepOf`) -- which is what the parent's later
-- statements bind before it evaluates the expression.
-- =============================================================================

-- ---------------------------------------------------------------------------
-- What a `fix` node declares.
-- ---------------------------------------------------------------------------

\func fixClassName (p : Path) : JIdent => renderName nFixClass p

\func fixCenv (cenv : Array JExpr) (p : Path) (defs : Array (FixDef LBTerm)) : Array JExpr =>
  pushFixMethods (jQualThis (fixClassName p)) p 0 defs.len cenv

-- The `fix` clause of `ToJava.compileExpr`, verbatim.
\func fixMethods (cenv : Array JExpr) (p : Path) (defs : Array (FixDef LBTerm))
  : Array (\Sigma JIdent JIdent (Array JStmt)) =>
  mkArray {\Sigma JIdent JIdent (Array JStmt)} {defs.len} (\lam j =>
    \let | m => compileFixMethod (fixCenv cenv p defs) (sMethod j :: p) (defs j).defBody
    \in (fixMethodName j, m.1, m.2))

\func fixObj (cenv : Array JExpr) (p : Path) (defs : Array (FixDef LBTerm)) (E0 : Env) : Value =>
  vObj (fixClassName p) (fixMethods cenv p defs) E0

-- The body of the closure compiled from `lambda _ b0` at `path` under `cenv`
-- (the `lambda` clause of `compileExpr`, verbatim).
\func lamBody (cenv : Array JExpr) (path : Path) (b0 : LBTerm) : Array JStmt =>
  appendStmts (compileExpr (jVar (renderName nParam path) :: cenv) (sLamBody :: path) b0).1
              (jReturn (compileExpr (jVar (renderName nParam path) :: cenv) (sLamBody :: path) b0).2 :: nil)

-- `fixMethodRef recv p j` is the closure `vClos (wrapName p j) (wrapBody recv p j) _`.
\func wrapName (p : Path) (j : Nat) : JIdent => renderName nParam (sWrap j :: p)

\func wrapBody (recv : JExpr) (p : Path) (j : Nat) : Array JStmt =>
  jReturn (jInvoke recv (fixMethodName j) (jVar (wrapName p j) :: nil)) :: nil

-- ---------------------------------------------------------------------------
-- The relations.
-- ---------------------------------------------------------------------------

\data CV (rt : RtSpec) (cls : JClass) (w : EV) (jv : Value) \elim w
  | evBox => cvBox (jv = vBox)
  | evPrim (primInt63, i) => cvP63 (jv = vLong (pos i))
  | evPrim (primInt64, i) => cvP64 (jv = vLong (signed64 i))
  | evCon ind c ws => cvCon {fs : Array Value} (jv = vData c fs) (AllCV rt cls ws fs)
  | evClos na b rho => cvClos {cenv : Array JExpr} {E : Env} {p : Path}
      (jv = vClos (renderName nParam p) (lamBody cenv p b) E)
      (EnvRel rt cls rho cenv E p)
  | evFix defs idx rho => cvFix {cenv : Array JExpr} {E0 E : Env} {p : Path} {recv : JExpr}
      (jv = vClos (wrapName p idx) (wrapBody recv p idx) E)
      (EnvRel rt cls rho cenv E0 p)
      (\Pi (a : Value) -> \Sigma (n : Nat)
                                 (evalExpr rt cls n ((wrapName p idx, a) :: E) recv = rOk (eVal (fixObj cenv p defs E0))))
  | evAx kn args => cvAx {nm : JIdent} {got : Array Value} {k : Nat}
      (jv = vBuiltin nm got) (axiomRtName kn = just nm) (builtinArity {rt} nm = just k)
      (RevCV rt cls args got)

\data AllCV (rt : RtSpec) (cls : JClass) (ws : Array EV) (fs : Array Value) \elim ws, fs
  | nil, nil => acNil
  | w :: ws, f :: fs => acCons (CV rt cls w f) (AllCV rt cls ws fs)

-- Newest first on the left, oldest first on the right.
\data RevCV (rt : RtSpec) (cls : JClass) (ws : Array EV) (got : Array Value) \elim ws
  | nil => rcNil (got = nil)
  | w :: ws => rcCons {got0 : Array Value} (j : Value) (CV rt cls w j) (RevCV rt cls ws got0) (got = snocArr got0 j)

\data EnvRel (rt : RtSpec) (cls : JClass) (rho : Array EV) (cenv : Array JExpr) (jenv : Env) (c : Path) \elim rho, cenv
  | nil, nil => erNil
  | w :: rho, e :: cenv => erCons
      (\Pi (X : Env) -> NotAnc X c ->
         \Sigma (jv : Value) (n : Nat) (evalExpr rt cls n (X ++ jenv) e = rOk (eVal jv)) (CV rt cls w jv))
      (EnvRel rt cls rho cenv jenv c)

-- ---------------------------------------------------------------------------
-- The simulation statements.
-- ---------------------------------------------------------------------------

-- For a compiled node `o = (statements, value expression)`.
\func SimOutO (rt : RtSpec) (cls : JClass) (jenv : Env) (p : Path) (o : Out) (w : EV) : \Type =>
  \Sigma (ext0 : Env) (Within ext0 p) (n : Nat)
         (execStmts rt cls n jenv o.1 = rOk (oNormal (ext0 ++ jenv)))
         (\Pi (X : Env) -> IndepOf X p ->
            \Sigma (jv : Value) (m : Nat) (evalExpr rt cls m (X ++ (ext0 ++ jenv)) o.2 = rOk (eVal jv))
                   (CV rt cls w jv))

\func SimOut (rt : RtSpec) (cls : JClass) (cenv : Array JExpr) (jenv : Env) (p : Path) (b : LBTerm) (w : EV) : \Type =>
  SimOutO rt cls jenv p (compileExpr cenv p b) w

\func AppOutJ (rt : RtSpec) (cls : JClass) (jf ja : Value) (w : EV) : \Type =>
  \Sigma (jv : Value) (n : Nat) (applyVal rt cls n jf ja = rOk (eVal jv)) (CV rt cls w jv)

-- ---------------------------------------------------------------------------
-- WHAT THE SIMULATION ASSUMES. Each field is discharged for the shipped
-- backend elsewhere: the class facts by `Proof/ClassLookup.ard` for every
-- compiled program, the runtime facts at `rtInt63`, the oracle facts at
-- `lbAxioms` (`Proof/OracleShipped.ard`).
-- ---------------------------------------------------------------------------

\func constBody (body : LBTerm) : Array JStmt =>
  appendStmts (compileExpr nil nil body).1 (jReturn (compileExpr nil nil body).2 :: nil)

\record SimHyps (spec : LBSpec) (rt : RtSpec) (cls : JClass) (genv : GlobalDeclarations)
  -- A declared constant is the method compiled from its body.
  | hConst (kn : Kername) (cb : ConstantBody) (body : LBTerm) : lookupConstant genv kn = just cb -> cb.cstBody = just body
      -> \Sigma (m : JMethod) (lookupMethod cls (mangleKername kn) = just m) (JMethod.mBody {m} = constBody body)
  -- A declared axiom the backend realizes is the method returning its constant.
  | hAxiom (kn : Kername) (cb : ConstantBody) (impl : JExpr) : lookupConstant genv kn = just cb -> cb.cstBody = nothing
      -> axiomImpl kn = just impl
      -> \Sigma (m : JMethod) (lookupMethod cls (mangleKername kn) = just m) (JMethod.mBody {m} = jReturn impl :: nil)
  | hValueOf : lookupMethod cls "Long.valueOf" = nothing
  -- The runtime.
  | hRtValueOf (x : Int) : rtStaticCall {rt} "Long.valueOf" (vLong x :: nil) = just (rOk (eVal (vLong x)))
  | hRtField (nm : JIdent) (k : Nat) : builtinArity {rt} nm = just k -> rtField {rt} nm = just (vBuiltin nm nil)
  -- The axiom table.
  | hImpl (kn : Kername) (impl : JExpr) : axiomImpl kn = just impl -> \Sigma (nm : JIdent) (impl = jField rtRef nm)
  -- The oracles.
  | hAgree : OracleAgree spec rt
  | hFO : OracleFO spec
  | hArgsFO (kn : Kername) (xs : Array LBTerm) (r : LBTerm) : axiomRun {spec} kn xs = just r -> \Pi (i : Fin xs.len) -> FOVal (xs i)
