\import Arith.Nat
\import Semantics.LambdaBoxEval
\import Compiler.LambdaBox
\import Logic
\import Logic.Meta
\import Paths
\import Paths.Meta

-- =============================================================================
-- The substitution algebra of λ□'s `csubst`, on the λ-FRAGMENT (`box`, `bvar`,
-- `lambda`, `app`).
--
-- λ□ evaluates by substitution and the generated Java by environment, so a
-- simulation proof has to relate "a term with closed values substituted" to
-- "code plus an environment" (`Proof/CorrectLam.ard`). What that needs from
-- the λ□ side is here, and it is exactly three facts:
--
--   * `LC k t`: `t` is in the fragment and its free indices are below `k`. A
--     CLOSED term is `LC 0`. `csubst` never lifts, so every fact below needs
--     closedness of what is substituted -- and without it the backend is not
--     correct at all (`Proof/CorrectRefuted.ard`, capture).
--   * `substK k sg b`: substitute the closed values `sg` for the indices
--     `k, k+1, ..`, head first -- `substl` generalized to a depth, so that it
--     goes under a binder (`skLam`).
--   * `substCommute`: substituting the argument of a beta redex into a body
--     that already has its environment substituted is the same as extending
--     the environment -- `csubst av 0 (substK 1 sg b) = substK 0 (av :: sg) b`.
--     This is the lemma the first attempt's `SubstLemma` was reaching for, now
--     on TERMS, where it is true, rather than on generated Java.
-- =============================================================================

-- ---------------------------------------------------------------------------
-- `natCompare`.
-- ---------------------------------------------------------------------------

\func ncRefl (k : Nat) : natCompare k k = cEq \elim k
  | 0 => idp
  | suc k => ncRefl k

\func ncEq {k n : Nat} (e : natCompare k n = cEq) : k = n \elim k, n
  | 0, 0 => idp
  | 0, suc n => contradiction
  | suc k, 0 => contradiction
  | suc k, suc n => pmap suc (ncEq e)

\func ncGtPlus (m : Nat) {k n : Nat} (e : natCompare k n = cGt) : natCompare (m Nat.+ k) n = cGt \elim k, n
  | 0, 0 => contradiction
  | 0, suc n => contradiction
  | suc k, 0 => idp
  | suc k, suc n => ncGtPlus m e

\func ncGtSuc {k n : Nat} (e : natCompare k n = cGt) : natCompare (suc k) n = cGt \elim k, n
  | 0, 0 => contradiction
  | 0, suc n => contradiction
  | suc k, 0 => idp
  | suc k, suc n => ncGtSuc e

\func ncSucSelf (k : Nat) : natCompare (suc k) k = cGt \elim k
  | 0 => idp
  | suc k => ncSucSelf k

\func ncNotLt0 {k : Nat} (e : natCompare k 0 = cLt) : Empty \elim k
  | 0 => contradiction
  | suc k => contradiction

\func ncLtGt {k n : Nat} (e : natCompare k (suc n) = cLt) (e' : natCompare k n = cGt) : Empty \elim k, n
  | 0, 0 => contradiction
  | 0, suc n => contradiction
  | suc k, 0 => ncNotLt0 e
  | suc k, suc n => ncLtGt e e'

-- ---------------------------------------------------------------------------
-- Scope.
-- ---------------------------------------------------------------------------

\func LC (k : Nat) (t : LBTerm) : \Set0 \elim t
  | box => \Sigma
  | bvar n => natCompare k n = cGt
  | lambda _ b => LC (suc k) b
  | app f a => \Sigma (LC k f) (LC k a)
  | fvar _ => Empty
  | letIn _ _ _ => Empty
  | const _ => Empty
  | construct _ _ _ => Empty
  | case _ _ _ _ => Empty
  | proj _ _ => Empty
  | fix _ _ => Empty
  | prim _ => Empty

-- Every value of `sg` closed.
\func AllC (sg : Array LBTerm) : \Set0 \elim sg
  | nil => \Sigma
  | s :: sg => \Sigma (LC 0 s) (AllC sg)

\func lcWeaken (m : Nat) {k : Nat} (u : LBTerm) (lc : LC k u) : LC (m Nat.+ k) u \elim u
  | box => ()
  | bvar n => ncGtPlus m lc
  | lambda _ b => lcWeaken m {suc k} b lc
  | app f a => (lcWeaken m f lc.1, lcWeaken m a lc.2)
  | fvar _ => \case lc
  | letIn _ _ _ => \case lc
  | const _ => \case lc
  | construct _ _ _ => \case lc
  | case _ _ _ _ => \case lc
  | proj _ _ => \case lc
  | fix _ _ => \case lc
  | prim _ => \case lc

\func lcClosedAny {s : LBTerm} (cs : LC 0 s) (j : Nat) : LC j s => lcWeaken j s cs

-- ---------------------------------------------------------------------------
-- A term in scope `k` is untouched by a substitution at `k` or above.
-- ---------------------------------------------------------------------------

\func csClosed (s : LBTerm) (m : Nat) {k : Nat} (u : LBTerm) (lc : LC k u) : csubst s (m Nat.+ k) u = u \elim u
  | box => idp
  | bvar n => pmap (csubstVar s n) (ncGtPlus m lc)
  | lambda na b => pmap (lambda na) (csClosed s m {suc k} b lc)
  | app f a => path (\lam i => app (csClosed s m f lc.1 @ i) (csClosed s m a lc.2 @ i))
  | fvar _ => \case lc
  | letIn _ _ _ => \case lc
  | const _ => \case lc
  | construct _ _ _ => \case lc
  | case _ _ _ _ => \case lc
  | proj _ _ => \case lc
  | fix _ _ => \case lc
  | prim _ => \case lc

-- The form used: a closed term, any depth.
\func csClosed0 {s u : LBTerm} (k : Nat) (cu : LC 0 u) : csubst s k u = u => csClosed s k u cu

-- ---------------------------------------------------------------------------
-- Substituting a closed term at `k` removes index `k` from the scope.
-- ---------------------------------------------------------------------------

\func csScopeVar {s : LBTerm} (cs : LC 0 s) (m k n : Nat) (lb : natCompare (suc (m Nat.+ k)) n = cGt)
                 (c : Comparison) (e : natCompare k n = c) : LC (m Nat.+ k) (csubstVar s n c) \elim n, c
  | n, cEq => lcClosedAny cs (m Nat.+ k)
  | n, cGt => ncGtPlus m e
  | 0, cLt => absurd (ncNotLt0 e)
  | suc n, cLt => lb

\func csScope {s : LBTerm} (cs : LC 0 s) (m k : Nat) (b : LBTerm) (lb : LC (suc (m Nat.+ k)) b)
  : LC (m Nat.+ k) (csubst s k b) \elim b
  | box => ()
  | bvar n => csScopeVar cs m k n lb (natCompare k n) idp
  | lambda _ b => csScope cs m (suc k) b lb
  | app f a => (csScope cs m k f lb.1, csScope cs m k a lb.2)
  | fvar _ => \case lb
  | letIn _ _ _ => \case lb
  | const _ => \case lb
  | construct _ _ _ => \case lb
  | case _ _ _ _ => \case lb
  | proj _ _ => \case lb
  | fix _ _ => \case lb
  | prim _ => \case lb

-- ---------------------------------------------------------------------------
-- Two closed substitutions at adjacent depths commute.
-- ---------------------------------------------------------------------------

\func commLt {a s : LBTerm} (ca : LC 0 a) (cs : LC 0 s) (k n : Nat) (e : natCompare k (suc n) = cLt)
             (c : Comparison) (e' : natCompare k n = c)
  : csubst a k (csubstVar s (suc n) c) = csubst s k (csubstVar a (suc n) (natCompare k (suc n))) \elim c
  | cEq => csClosed0 k cs *> inv (pmap (csubstVar s n) e') *> inv (pmap (\lam x => csubst s k (csubstVar a (suc n) x)) e)
  | cGt => absurd (ncLtGt e e')
  | cLt => pmap (csubstVar a n) e' *> inv (pmap (csubstVar s n) e') *> inv (pmap (\lam x => csubst s k (csubstVar a (suc n) x)) e)

\func commVar {a s : LBTerm} (ca : LC 0 a) (cs : LC 0 s) (k n : Nat) (c : Comparison) (e : natCompare k n = c)
  : csubst a k (csubst s (suc k) (bvar n)) = csubst s k (csubst a k (bvar n)) \elim n, c
  | n, cEq =>
    \let gt : natCompare (suc k) n = cGt => transport (\lam x => natCompare (suc k) x = cGt) (ncEq e) (ncSucSelf k)
    \in pmap (\lam x => csubst a k (csubstVar s n x)) gt *> pmap (csubstVar a n) e
        *> inv (csClosed0 k ca) *> inv (pmap (\lam x => csubst s k (csubstVar a n x)) e)
  | n, cGt =>
    pmap (\lam x => csubst a k (csubstVar s n x)) (ncGtSuc e) *> pmap (csubstVar a n) e
      *> inv (pmap (csubstVar s n) e) *> inv (pmap (\lam x => csubst s k (csubstVar a n x)) e)
  | 0, cLt => absurd (ncNotLt0 e)
  | suc n, cLt => commLt ca cs k n e (natCompare k n) idp

\func csCommute {a s : LBTerm} (ca : LC 0 a) (cs : LC 0 s) (k : Nat) {j : Nat} (b : LBTerm) (lb : LC j b)
  : csubst a k (csubst s (suc k) b) = csubst s k (csubst a k b) \elim b
  | box => idp
  | bvar n => commVar ca cs k n (natCompare k n) idp
  | lambda na b => pmap (lambda na) (csCommute ca cs (suc k) {suc j} b lb)
  | app f g => path (\lam i => app (csCommute ca cs k f lb.1 @ i) (csCommute ca cs k g lb.2 @ i))
  | fvar _ => \case lb
  | letIn _ _ _ => \case lb
  | const _ => \case lb
  | construct _ _ _ => \case lb
  | case _ _ _ _ => \case lb
  | proj _ _ => \case lb
  | fix _ _ => \case lb
  | prim _ => \case lb

-- ---------------------------------------------------------------------------
-- Substituting an environment.
-- ---------------------------------------------------------------------------

\func substK (k : Nat) (sg : Array LBTerm) (b : LBTerm) : LBTerm \elim sg
  | nil => b
  | s :: sg => substK k sg (csubst s k b)

\func skBox (k : Nat) (sg : Array LBTerm) : substK k sg box = box \elim sg
  | nil => idp
  | s :: sg => skBox k sg

\func skApp (k : Nat) (sg : Array LBTerm) (f a : LBTerm)
  : substK k sg (app f a) = app (substK k sg f) (substK k sg a) \elim sg
  | nil => idp
  | s :: sg => skApp k sg (csubst s k f) (csubst s k a)

\func skLam (k : Nat) (sg : Array LBTerm) (na : BinderName) (b : LBTerm)
  : substK k sg (lambda na b) = lambda na (substK (suc k) sg b) \elim sg
  | nil => idp
  | s :: sg => skLam k sg na (csubst s (suc k) b)

\func skClosed (k : Nat) (sg : Array LBTerm) {u : LBTerm} (cu : LC 0 u) : substK k sg u = u \elim sg
  | nil => idp
  | s :: sg => pmap (substK k sg) (csClosed0 k cu) *> skClosed k sg cu

-- A closed environment substituted into a body in scope `1 + |sg|` leaves scope 1.
\func skScope1 (sg : Array LBTerm) (csg : AllC sg) (b : LBTerm) (lb : LC (suc sg.len) b) : LC 1 (substK 1 sg b) \elim sg
  | nil => lb
  | s :: sg => skScope1 sg csg.2 (csubst s 1 b) (csScope csg.1 sg.len 1 b lb)

-- THE LEMMA: the beta step on a closure's substituted body is the closure's
-- environment extended with the argument.
\func substCommute {a : LBTerm} (ca : LC 0 a) (sg : Array LBTerm) (csg : AllC sg) (b : LBTerm) (lb : LC (suc sg.len) b)
  : csubst a 0 (substK 1 sg b) = substK 0 (a :: sg) b \elim sg
  | nil => idp
  | s :: sg =>
    substCommute ca sg csg.2 (csubst s 1 b) (csScope csg.1 sg.len 1 b lb)
      *> pmap (substK 0 sg) (csCommute ca csg.1 0 b lb)
