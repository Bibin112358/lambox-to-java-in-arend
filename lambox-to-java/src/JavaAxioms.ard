\import Data.Bool
\import Data.Maybe
\import Data.String
\import JavaAst
\import Int63
\import NodePath
\import Set
\import StringUtil

-- What lambda-box needs from the hand-written runtime (`runtime/Rt.java`) besides
-- its ABI: the realization of axioms, the representation of primitive ints, and
-- the reporters for input that has no Java value.
--
-- Separate from `ToJava.ard` because it is a different kind of thing. That file
-- is the translation a correctness proof would be ABOUT; this is data such a proof
-- takes as a HYPOTHESIS -- each realization is ASSUMED to implement its axiom, and
-- nothing here is derivable, `Rt.java` being hand-written. (JavaAst.ard owns the
-- ABI core for the opposite reason: a proof interprets application rather than
-- assuming it.) The split leaves `ToJava.ard` naming no runtime member at all.

-- ---------------------------------------------------------------------------
-- REPRESENTATION OF λ□ PRIMITIVE INTS.
--
-- A representation is two things that must agree: how a literal is emitted, and
-- which `Rt.PRIM_*_<suffix>` family realizes the operations. Pairing them
-- wrongly is not a type error but a runtime ClassCastException (the `_INT`
-- family takes `BigInteger`), which is why they travel together in one record
-- rather than as two loose constants.
--
-- THIS IS NOT A GENERATOR OPTION. `compileClass` takes no target parameter and
-- the examples have no variants -- the `JavaTarget` record that used to thread
-- one through the generator is gone and is not coming back. `primRepr` below is
-- a NAMED CONSTANT with a documented alternative: changing it is a one-line
-- edit to this file, not a knob a caller can turn.
-- ---------------------------------------------------------------------------

\record PrimRepr
  -- How `prim (primInt, i)` is emitted.
  | reprLit : Int -> JExpr
  -- Which family realizes `prim_add_int` and friends.
  | reprSuffix : String

-- THE FAITHFUL ONE, and the default. A λ□ primitive int IS a `Uint63`
-- (`Int63.ard` has the citations), and `Rt.PRIM_*_INT63` implements exactly
-- that: a `long` restricted to [0, 2^63) with a mask after each operation.
--
-- It costs one AND instruction per operation -- values stay in a `long`, and
-- nothing is boxed differently from `longRepr` -- so unlike the `BigInteger`
-- family this is faithfulness at no representational cost. That is what makes
-- it the default rather than a documented aspiration.
--
-- The literal is normalized, so the emitted constant is the value λ□ means.
\func int63Repr : PrimRepr \cowith
  | reprLit i => jCallStatic "Long.valueOf" (jLit (litLong (norm63 i)) :: nil)
  | reprSuffix => "INT63"

-- THE FAST DEVIATION, kept and named rather than deleted. Java's built-in
-- integers: no mask, so arithmetic wraps at 2^64 and signed, where λ□ wraps at
-- 2^63 and unsigned.
--
-- It is WRONG, and was provably so while it was the default: `prim_sub_int 1 2`
-- is 2^63-1 in λ□ and -1 on a `long`, which refuted the correctness statement
-- outright. `Formal/Agreement.ard` keeps both answers
-- (`longWouldHaveSaid`/`int63Agrees`) so the fix reads as a difference between
-- two modelled runtimes rather than as an edited constant.
--
-- It stays selectable because it costs nothing to keep and because a deviation
-- that is named and modelled is worth more than one that was deleted. It is
-- also NOT free to choose: `Formal/RtLong.ard` models it, and the value
-- relation that goes with it is `agreesLong`, which reads one bit pattern two
-- ways. Measured on `matmul250`, picking it buys nothing -- 36.9 s against
-- 37.2 s for `int63Repr`, inside the noise -- because the mask is one AND.
\func longRepr : PrimRepr \cowith
  | reprLit i => jCallStatic "Long.valueOf" (jLit (litLong i) :: nil)
  | reprSuffix => "LONG"

\func primRepr : PrimRepr => int63Repr

-- A λ□ primitive-int literal.
--
-- ONE NODE KIND, ONE NUMBER KIND, so there is nothing here to tell apart.
-- Lean's `Nat` literals are `prim (primInt, n)` too, and that is not a leak:
-- lean-to-lambdabox emits them as i63 and panics rather than exceeding the
-- range, so normalizing is the right thing for every literal that can arrive.
-- (This comment used to say the opposite, and pointed at a limitation that
-- `Formal/LbAxioms.ard` now withdraws.)
--
-- It also fixes a failure mode the old `longRepr` had: a literal at or above
-- 2^63 used to be emitted verbatim as a `long` literal, which javac REJECTS.
\func intLit (i : Int) : JExpr => reprLit {primRepr} i

-- Suffix selecting the runtime family for the λ□ PRIMITIVE-INT operations only.
\func primOpSuffix : String => reprSuffix {primRepr}

-- Suffix for the LEAN-DERIVED operations that CANNOT leave i63's range, which
-- is why it can differ from `primRepr` without being wrong.
--
-- Lean's `Nat` IS an i63 in the λ□ we receive -- lean-to-lambdabox erases a
-- `Nat` literal to `prim ⟨.primInt, _⟩` and panics rather than exceeding 63
-- bits (see the correction at the top of `Formal/LbAxioms.ard`, which withdraws
-- the limitation this comment used to assert). So the question for each `Nat`
-- operation is not "which representation" but "can the result leave [0, 2^63)":
--
--   * `add` and `mul` CAN, so they go through `primOp` and land on
--     `PRIM_*_INT63` with the rest of the i63 arithmetic.
--   * `sub` truncates downwards, `div`/`mod` shrink, and the comparisons return
--     a `Bool`. None can overflow, so on arguments already in range the `_LONG`
--     constants compute the same answers the i63 ones would -- and they are
--     kept, rather than duplicated into the INT63 family, because `long` and
--     i63 arithmetic differ ONLY on overflow.
--
-- `sub` in particular must NOT be routed with the others: Lean's subtraction
-- truncates at zero, which is Lean's convention and not i63's, so it keeps
-- `NAT_SUB_*`. `Rt.java` records that sharing the wrapping `PRIM_SUB_*`
-- produced a real wrong answer (`const_fold` returned 2048 instead of 4772).
\func leanOpSuffix : String => "LONG"

-- `Rt`, as the receiver of a static member. `runtimeClassName` comes from
-- JavaAst.ard, which is where the runtime's name is decided (once).
\func rtRef : JExpr => jStatic runtimeClassName

-- λ□ axiom (a constant with no body) -> the runtime constant realizing it;
-- anything absent compiles to a throwing stub. Peregrine does this per run via
-- `--attributes`; a fixed table works here because the runtime is ours. Keys are
-- FULLY MANGLED kernames, module path included -- the Lean frontend puts
-- machine-Nat primitives under `Nat` while the hand-written examples use root
-- names, and the path stops an unrelated `Foo.add` matching `Nat.add`.
\func javaAxioms : Array (\Sigma String JExpr) =>
  \let -- A λ□ PRIMITIVE-INT operation: follows `primRepr`.
       | primOp (nm : String) => jField rtRef ("PRIM_" ++ nm ++ "_" ++ primOpSuffix)
       -- A LEAN machine operation. Spelled with the same `PRIM_` prefix because
       -- that is what the runtime constant is called, but selected by
       -- `leanOpSuffix` -- these are a different family answering a different
       -- question, and sharing one helper is what conflated them before.
       | leanOp (nm : String) => jField rtRef ("PRIM_" ++ nm ++ "_" ++ leanOpSuffix)
       -- An operation that neither takes nor returns a λ□ primitive int is the
       -- same in every representation, so it has ONE runtime constant.
       | fixed (nm : String) => jField rtRef nm
  \in ("c___prim_add_int", primOp "ADD") ::
      ("c___prim_mul_int", primOp "MUL") ::
      ("c___prim_sub_int", primOp "SUB") ::
      ("c___prim_eqb_int", primOp "EQB") ::
      ("c__Nat__add", primOp "ADD") ::
      ("c__Nat__mul", primOp "MUL") ::
      -- NOT `leanOp "SUB"`: Lean's Nat subtraction truncates at zero, while
      -- `prim_sub_int` is Peregrine's wrapping int63 subtraction.
      ("c__Nat__sub", jField rtRef ("NAT_SUB_" ++ leanOpSuffix)) ::
      ("c__Nat__beq", leanOp "EQB") ::
      -- The rest of the machine-Nat operations lean-to-lambdabox leaves as
      -- axioms. `div`/`mod` follow Lean's total conventions and
      -- `decEq`/`decLe`/`decLt` return `Decidable`, not `Bool` (see Rt.java).
      ("c__Nat__div", leanOp "DIV") ::
      ("c__Nat__mod", leanOp "MOD") ::
      ("c__Nat__pow", leanOp "POW") ::
      ("c__Nat__ble", leanOp "BLE") ::
      ("c__Nat__blt", leanOp "BLT") ::
      ("c__Nat__decEq", leanOp "DEC_EQ") ::
      ("c__Nat__decLe", leanOp "DEC_LE") ::
      ("c__Nat__decLt", leanOp "DEC_LT") ::
      -- Lean's machine-`Int` operations. `Int` erases to the same λ□ primitive
      -- int as `Nat`, so `ofNat` is the identity in both representations.
      ("c__Int__ofNat", fixed "INT_OF_NAT") ::
      ("c__Int__negSucc", jField rtRef ("INT_NEG_SUCC_" ++ leanOpSuffix)) ::
      ("c__Int__neg", jField rtRef ("INT_NEG_" ++ leanOpSuffix)) ::
      ("c__Int__add", jField rtRef ("INT_ADD_" ++ leanOpSuffix)) ::
      ("c__Int__mul", jField rtRef ("INT_MUL_" ++ leanOpSuffix)) ::
      ("c__Int__ediv", jField rtRef ("INT_EDIV_" ++ leanOpSuffix)) ::
      ("c__Int__emod", jField rtRef ("INT_EMOD_" ++ leanOpSuffix)) ::
      ("c__Int__decEq", jField rtRef ("INT_DEC_EQ_" ++ leanOpSuffix)) ::
      -- Lean's `Array` operations (`@[extern]`, so erasure keeps no body). Only
      -- `size` returns a Nat, hence only it depends on the representation. The
      -- Lean frontend writes `!` in a name as `_u33`.
      ("c__Array__mk", fixed "ARRAY_MK") ::
      ("c__Array__emptyWithCapacity", fixed "ARRAY_EMPTY_WITH_CAPACITY") ::
      ("c__Array__push", fixed "ARRAY_PUSH") ::
      ("c__Array__getInternal", fixed "ARRAY_GET_INTERNAL") ::
      ("c__Array__get_u33Internal", fixed "ARRAY_GET_BANG_INTERNAL") ::
      ("c__Array__set_u33", fixed "ARRAY_SET_BANG") ::
      ("c__Array__swap", fixed "ARRAY_SWAP") ::
      ("c__Array__size", jField rtRef ("ARRAY_SIZE_" ++ leanOpSuffix)) ::
      -- Rewriting along an equality is the identity at runtime.
      ("c__Eq__rec", fixed "EQ_REC") ::
      ("c__Eq__ndrec", fixed "EQ_REC") ::
      nil

-- The entry point callers use, so the table stays internal to this file. Lookup
-- is by FULLY MANGLED kername, module path included, and is `StringUtil`'s one
-- association walk rather than a copy of it.
\func axiomImpl (name : String) : Maybe JExpr => lookupKey name javaAxioms

-- Three situations have no λ□ value: a `bvar` whose index exceeds the enclosing
-- binders, an `fvar`, and a `case` whose scrutinee matches no branch. Erasure
-- output produces none of them, so these are unreachable for well-formed input --
-- which is why they must not be a silent `null`, which fails far away or
-- propagates as a value. Each fails at once and names the offending node: the id
-- is the node's `Path` (NodePath.ard), rendered HERE rather than passed in as
-- text, so a diagnostic cannot drift from the names that same path produces.

\func rtUnbound (index : Nat) (path : Path) : JExpr =>
  jCallStatic (runtimeQual ++ "unbound") (jLit (litInt index) :: jLit (litStr (renderPath path)) :: nil)

\func rtFreeVar (name : String) (path : Path) : JExpr =>
  jCallStatic (runtimeQual ++ "freeVar") (jLit (litStr name) :: jLit (litStr (renderPath path)) :: nil)

-- The final alternative of the ternary chain a `case` becomes. It takes the
-- SCRUTINEE, not its tag, which is what lets the AST drop a read-the-tag node and
-- keep tag reads confined to `jTagEq`.
\func rtNoBranch (scrut : JExpr) (path : Path) : JExpr =>
  jCallStatic (runtimeQual ++ "noBranch") (scrut :: jLit (litStr (renderPath path)) :: nil)
