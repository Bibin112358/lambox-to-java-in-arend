\import Data.Array (map)
\import Data.Bool
\import Data.Maybe
\import Data.String
\import JavaAst
\import Int63
\import LambdaBox
\import Mangle
\import NodePath
\import Set
\import StringUtil

-- What lambda-box needs from the hand-written runtime (`runtime/Rt.java`) besides
-- its ABI: the realization of axioms, the representation of primitive ints, and
-- the reporters for input that has no Java value.
--
-- Separate from `ToJava.ard` because it is a different kind of thing. That file
-- is the translation a correctness proof would be ABOUT; this is data such a proof
-- takes as a HYPOTHESIS -- each realization is ASSUMED to implement its axiom, and
-- nothing here is derivable, `Rt.java` being hand-written. (JavaAst.ard owns the
-- ABI core for the opposite reason: a proof interprets application rather than
-- assuming it.) The split leaves `ToJava.ard` naming no runtime member at all.

-- ---------------------------------------------------------------------------
-- LITERALS, one per primitive kind.
--
-- THE `PrimRepr` RECORD IS GONE, and its disappearance is the point of putting
-- the kind in the term. It paired "how a literal is emitted" with "which
-- runtime family realizes the operations", and let the two be chosen by a
-- backend constant. The first half is now answered by the TAG -- a
-- `primInt63` literal and a `primInt64` literal are different terms and emit
-- differently, with nothing to configure. What survives below is the second
-- half, the operation family, which the tag cannot reach -- carried instead by
-- per-kind axiom names (see `primOpSuffix` and `Int64Rewrite.ard`).
--
-- Both kinds are `java.lang.Long` at runtime. That is not a conflation: a
-- `Uint63` lives in [0, 2^63), exactly `long`'s non-negative half, so one JVM
-- type carries both and the difference is in the ARITHMETIC, which is what
-- `Rt.PRIM_*_INT63` versus `Rt.PRIM_*_LONG` is for.
-- ---------------------------------------------------------------------------

-- A `Uint63` literal. The payload is already normalized -- `PrimModel
-- primInt63` is `Fin int63Mod` -- so this is a plain injection, and an
-- out-of-range literal is not something a caller could hand us.
\func int63Lit (i : Fin int63Mod) : JExpr =>
  jCallStatic "Long.valueOf" (jLit (litLong (pos i)) :: nil)

-- A 64-bit literal. The payload is the unsigned BIT PATTERN, and a JVM `long`
-- reads the top half of that range as negative, so the signed reading is taken
-- here -- the same reinterpretation `Formal/RtLong.ard`'s `wrap64` performs,
-- and the reason `litLong` is handed an `Int` rather than a `Nat`.
\func int64Lit (i : Fin int64Mod) : JExpr =>
  jCallStatic "Long.valueOf" (jLit (litLong (signed64 i)) :: nil)

-- Suffix for the i63 operations. NOT a choice any more -- it is simply the
-- name of the family that implements `Uint63`, and the i64 operations have
-- their own entries below rather than being reached by changing this.
--
-- That is what step 2 bought. The kind cannot reach an operation on its own (a
-- `const` node is compiled before any operand is in sight), so per-kind axiom
-- NAMES carry it, and `Int64Rewrite.ard` rewrites the tags and the names
-- together. The representation choice is a program transformation with a
-- statement (`Formal/Int64RewriteSpec.ard`) instead of a constant in this file
-- with none.
\func primOpSuffix : String => "INT63"

-- Suffix for the LEAN-DERIVED operations that CANNOT leave i63's range, which
-- is why it can differ from `primRepr` without being wrong.
--
-- Lean's `Nat` IS an i63 in the λ□ we receive -- lean-to-lambdabox erases a
-- `Nat` literal to `prim ⟨.primInt, _⟩` and panics rather than exceeding 63
-- bits (see the correction at the top of `Formal/LbAxioms.ard`, which withdraws
-- the limitation this comment used to assert). So the question for each `Nat`
-- operation is not "which representation" but "can the result leave [0, 2^63)":
--
--   * `add` and `mul` CAN, so they go through `primOp` and land on
--     `PRIM_*_INT63` with the rest of the i63 arithmetic.
--   * `sub` truncates downwards, `div`/`mod` shrink, and the comparisons return
--     a `Bool`. None can overflow, so on arguments already in range the `_LONG`
--     constants compute the same answers the i63 ones would -- and they are
--     kept, rather than duplicated into the INT63 family, because `long` and
--     i63 arithmetic differ ONLY on overflow.
--
-- `sub` in particular must NOT be routed with the others: Lean's subtraction
-- truncates at zero, which is Lean's convention and not i63's, so it keeps
-- `NAT_SUB_*`. `Rt.java` records that sharing the wrapping `PRIM_SUB_*`
-- produced a real wrong answer (`const_fold` returned 2048 instead of 4772).
\func leanOpSuffix : String => "LONG"

-- `Rt`, as the receiver of a static member. `runtimeClassName` comes from
-- JavaAst.ard, which is where the runtime's name is decided (once).
\func rtRef : JExpr => jStatic runtimeClassName

-- The two shapes of axiom name the table uses: a root name (peregrine's
-- `prim_*`, `mpFile nil`) and a name inside a Lean namespace (`Nat.add` is
-- `mpDot (mpFile nil) "Nat"`, the way lean-to-lambdabox writes it).
\func axKnRoot (nm : String) : Kername => \new Kername (mpFile nil) nm

\func axKnIn (ns nm : String) : Kername => \new Kername (mpDot (mpFile nil) ns) nm

-- λ□ axiom (a constant with no body) -> the runtime constant realizing it;
-- anything absent compiles to a throwing stub. Peregrine does this per run via
-- `--attributes`; a fixed table works here because the runtime is ours.
--
-- KEYED BY THE STRUCTURED `Kername`, module path included -- the Lean frontend
-- puts machine-Nat primitives under `Nat` while the hand-written examples use
-- root names, and the path stops an unrelated `Foo.add` matching `Nat.add`. The
-- keys used to be hand-written MANGLED strings, and since the old mangling was
-- not injective an axiom at `_Nat.add` (module `_Nat`) was silently realized as
-- Lean's `Nat.add`.
\func javaAxioms : Array (\Sigma Kername JExpr) =>
  \let -- A λ□ PRIMITIVE-INT operation: follows `primRepr`.
       | primOp (nm : String) => jField rtRef ("PRIM_" ++ nm ++ "_" ++ primOpSuffix)
       -- A LEAN machine operation. Spelled with the same `PRIM_` prefix because
       -- that is what the runtime constant is called, but selected by
       -- `leanOpSuffix` -- these are a different family answering a different
       -- question, and sharing one helper is what conflated them before.
       | leanOp (nm : String) => jField rtRef ("PRIM_" ++ nm ++ "_" ++ leanOpSuffix)
       -- An operation that neither takes nor returns a λ□ primitive int is the
       -- same in every representation, so it has ONE runtime constant.
       | fixed (nm : String) => jField rtRef nm
  -- THE i63 OPERATIONS, under the names peregrine emits. These are what an
  -- imported program says, and they land on the family that implements
  -- `Uint63`.
  \in (axKnRoot "prim_add_int", primOp "ADD") ::
      (axKnRoot "prim_mul_int", primOp "MUL") ::
      (axKnRoot "prim_sub_int", primOp "SUB") ::
      (axKnRoot "prim_eqb_int", primOp "EQB") ::
      -- THE i64 OPERATIONS, which nothing imports and only `Int64Rewrite.ard`
      -- produces. Separate NAMES rather than a separate backend setting,
      -- because that is the only way the kind can reach an operation: a `const`
      -- node is compiled before any operand is in sight, so the tag on the
      -- values cannot select a family here. The program has to say it.
      --
      -- They land on `PRIM_*_LONG`, i.e. Java's built-in arithmetic with no
      -- mask -- which is now CORRECT rather than a deviation, because the terms
      -- reaching them mean 64-bit two's complement.
      (axKnRoot "prim_add_int64", leanOp "ADD") ::
      (axKnRoot "prim_mul_int64", leanOp "MUL") ::
      (axKnRoot "prim_sub_int64", leanOp "SUB") ::
      (axKnRoot "prim_eqb_int64", leanOp "EQB") ::
      (axKnIn "Nat" "add", primOp "ADD") ::
      (axKnIn "Nat" "mul", primOp "MUL") ::
      -- NOT `leanOp "SUB"`: Lean's Nat subtraction truncates at zero, while
      -- `prim_sub_int` is Peregrine's wrapping int63 subtraction.
      (axKnIn "Nat" "sub", jField rtRef ("NAT_SUB_" ++ leanOpSuffix)) ::
      (axKnIn "Nat" "beq", leanOp "EQB") ::
      -- The rest of the machine-Nat operations lean-to-lambdabox leaves as
      -- axioms. `div`/`mod` follow Lean's total conventions and
      -- `decEq`/`decLe`/`decLt` return `Decidable`, not `Bool` (see Rt.java).
      (axKnIn "Nat" "div", leanOp "DIV") ::
      (axKnIn "Nat" "mod", leanOp "MOD") ::
      (axKnIn "Nat" "pow", leanOp "POW") ::
      (axKnIn "Nat" "ble", leanOp "BLE") ::
      (axKnIn "Nat" "blt", leanOp "BLT") ::
      (axKnIn "Nat" "decEq", leanOp "DEC_EQ") ::
      (axKnIn "Nat" "decLe", leanOp "DEC_LE") ::
      (axKnIn "Nat" "decLt", leanOp "DEC_LT") ::
      -- Lean's machine-`Int` operations. `Int` erases to the same λ□ primitive
      -- int as `Nat`, so `ofNat` is the identity in both representations.
      (axKnIn "Int" "ofNat", fixed "INT_OF_NAT") ::
      (axKnIn "Int" "negSucc", jField rtRef ("INT_NEG_SUCC_" ++ leanOpSuffix)) ::
      (axKnIn "Int" "neg", jField rtRef ("INT_NEG_" ++ leanOpSuffix)) ::
      (axKnIn "Int" "add", jField rtRef ("INT_ADD_" ++ leanOpSuffix)) ::
      (axKnIn "Int" "mul", jField rtRef ("INT_MUL_" ++ leanOpSuffix)) ::
      (axKnIn "Int" "ediv", jField rtRef ("INT_EDIV_" ++ leanOpSuffix)) ::
      (axKnIn "Int" "emod", jField rtRef ("INT_EMOD_" ++ leanOpSuffix)) ::
      (axKnIn "Int" "decEq", jField rtRef ("INT_DEC_EQ_" ++ leanOpSuffix)) ::
      -- Lean's `Array` operations (`@[extern]`, so erasure keeps no body). Only
      -- `size` returns a Nat, hence only it depends on the representation. The
      -- Lean frontend writes `!` in a name as `_u33`.
      (axKnIn "Array" "mk", fixed "ARRAY_MK") ::
      (axKnIn "Array" "emptyWithCapacity", fixed "ARRAY_EMPTY_WITH_CAPACITY") ::
      (axKnIn "Array" "push", fixed "ARRAY_PUSH") ::
      (axKnIn "Array" "getInternal", fixed "ARRAY_GET_INTERNAL") ::
      (axKnIn "Array" "get_u33Internal", fixed "ARRAY_GET_BANG_INTERNAL") ::
      (axKnIn "Array" "set_u33", fixed "ARRAY_SET_BANG") ::
      (axKnIn "Array" "swap", fixed "ARRAY_SWAP") ::
      (axKnIn "Array" "size", jField rtRef ("ARRAY_SIZE_" ++ leanOpSuffix)) ::
      -- Rewriting along an equality is the identity at runtime.
      (axKnIn "Eq" "rec", fixed "EQ_REC") ::
      (axKnIn "Eq" "ndrec", fixed "EQ_REC") ::
      nil

-- The entry point callers use, so the table stays internal to this file. The
-- comparison is on MANGLED names, which is exact because `mangleKername` is
-- injective (see `Mangle.ard`); it is `StringUtil`'s one association
-- walk rather than a copy of it.
\func axiomImpl (kn : Kername) : Maybe JExpr =>
  lookupKey (mangleKername kn) (map (\lam (e : \Sigma Kername JExpr) => (mangleKername e.1, e.2)) javaAxioms)

-- Three situations have no λ□ value: a `bvar` whose index exceeds the enclosing
-- binders, an `fvar`, and a `case` whose scrutinee matches no branch. Erasure
-- output produces none of them, so these are unreachable for well-formed input --
-- which is why they must not be a silent `null`, which fails far away or
-- propagates as a value. Each fails at once and names the offending node: the id
-- is the node's `Path` (NodePath.ard), rendered HERE rather than passed in as
-- text, so a diagnostic cannot drift from the names that same path produces.

\func rtUnbound (index : Nat) (path : Path) : JExpr =>
  jCallStatic (runtimeQual ++ "unbound") (jLit (litInt index) :: jLit (litStr (renderPath path)) :: nil)

\func rtFreeVar (name : String) (path : Path) : JExpr =>
  jCallStatic (runtimeQual ++ "freeVar") (jLit (litStr name) :: jLit (litStr (renderPath path)) :: nil)

-- The final alternative of the ternary chain a `case` becomes. It takes the
-- SCRUTINEE, not its tag, which is what lets the AST drop a read-the-tag node and
-- keep tag reads confined to `jTagEq`.
\func rtNoBranch (scrut : JExpr) (path : Path) : JExpr =>
  jCallStatic (runtimeQual ++ "noBranch") (scrut :: jLit (litStr (renderPath path)) :: nil)
