\import Arith.Nat
\import Data.Bool
\import Data.String
\import Compiler.LambdaBox
\import Set
\import Compiler.StringUtil

-- =============================================================================
-- Kername -> Java method name, INJECTIVELY.
--
-- A λ□ constant becomes a `public static Object <name>()` of the generated
-- class, and both `const` (a call by that name) and the axiom table (a lookup
-- by that name) identify a constant by it. So two distinct kernames with one
-- name are a miscompile, and the previous encoding had them: it joined path
-- components with `_` and let `_` through unescaped, so `mpFile ["A_B"]` and
-- `mpFile ["A","B"]` mangled equal (javac: duplicate method), and a module
-- literally named `_Nat` landed on `Nat.add`'s entry in `javaAxioms` (a silent
-- wrong answer). It also ignored WHICH `ModPath` constructor produced a
-- component, so `mpDot (mpFile ["A"]) "B"` met `mpFile ["A","B"]` as well.
--
-- THE ENCODING IS A PREFIX CODE, and that is the whole injectivity argument
-- (mechanized: `Proof/MangleInj.ard`'s `mangleKername-inj`, by a parser that
-- inverts the encoding):
--
--   * inside a component, a letter or digit stands for itself, `_` is written
--     `__`, and every other byte is `$<decimal>$`;
--   * so a SINGLE `_` never occurs inside a component, and every structural
--     token is `_` followed by a tag letter that says what comes next:
--       `_d` a directory of an `mpFile`/`mpBound` path,
--       `_b` the functor name of an `mpBound`, then `_i` and its index,
--       `_o` one `mpDot` step,
--       `_n` the constant's own name, last.
--
-- The name starts with `c`, so it is never `body` (`ToJava.bodyMethodName`) and
-- never the bare `_` Java reserves. Examples: Lean's `Nat.add` is
-- `c_oNat_nadd`, peregrine's `prim_add_int` is `c_nprim__add__int`.
-- =============================================================================

\func isUnderscore (n : Nat) : Bool => n == 95

-- One byte of a component. The two tests are PARAMETERS rather than `\case`s,
-- so that a proof can rewrite them (see Proof/NodePathUnique.ard's header on
-- why a `\case` does not reduce under a hypothesis about its scrutinee).
\func mangleByteK (b : Byte) (ident us : Bool) : String \elim ident, us
  | true, true => "__"
  | true, false => oneByteString b
  | false, _ => "$" ++ natToStr b ++ "$"

\func mangleBytes (bs : Array Byte) : String \elim bs
  | nil => ""
  | b :: bs => mangleByteK b (isJavaIdentByte b) (isUnderscore b) ++ mangleBytes bs

\func manglePart (s : String) : String => mangleBytes s.bytes

\func mangleDirs (ds : Array String) : String \elim ds
  | nil => ""
  | d :: ds => "_d" ++ manglePart d ++ mangleDirs ds

\func mangleModPath (mp : ModPath) : String \elim mp
  | mpFile dp => mangleDirs dp
  | mpBound dp id n => mangleDirs dp ++ "_b" ++ manglePart id ++ "_i" ++ natToStr n
  | mpDot mp id => mangleModPath mp ++ "_o" ++ manglePart id

\func mangleKername (k : Kername) : String =>
  "c" ++ mangleModPath k.kerModPath ++ "_n" ++ manglePart k.kerName
