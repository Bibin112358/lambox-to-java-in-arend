\import Data.Array (mkArray)
\import Data.Bool
\import Data.Maybe
\import Data.String
\import Compiler.Int63
\import Compiler.LambdaBox
\import Set

-- Choosing 64-bit arithmetic, as a source-to-source pass on λ□ programs.
--
-- `rewriteProgram` turns `rocqUint63` literals and operations into `javaLong` ones; the
-- result is an ordinary λ□ program for the ordinary backend and semantics, so
-- "use Java `long` for speed" becomes a comparison of two programs.
--
-- Literals and operations are rewritten together in one traversal: a `prim`
-- tag fixes what a literal means, but an operation is a `const` kername that
-- the compiler translates without seeing its operands.
--
-- This does NOT preserve semantics in general: the programs agree as long as
-- no operation overflows 2^63. `Proof/LongRewriteSpec.ard` states that side
-- condition; `ModelChecks/CorrectInstances.ard` has one example where the
-- value is preserved and one where it is not. The pass is one-way, and its
-- output cannot be exported by `Compiler/Serialize.ard` (no `javaLong` there).

-- The four axioms whose meaning depends on the width; all others (Lean's
-- `Nat.*`, `Int.*`, `Array.*`, `Eq.rec`) are left alone.
\func i64Name (n : String) : Maybe String =>
  \case n == "prim_add_int" \with { | true => just "prim_add_long" | false =>
  \case n == "prim_sub_int" \with { | true => just "prim_sub_long" | false =>
  \case n == "prim_mul_int" \with { | true => just "prim_mul_long" | false =>
  \case n == "prim_eqb_int" \with { | true => just "prim_eqb_long" | false =>
    nothing } } } }

-- A root-module kername renamed to its i64 counterpart, or left as it is. The
-- module path is checked too, so `Foo.prim_add_int` is not caught. Matched
-- structurally: the compiler does not depend on `Semantics/`.
\func rewriteKername (kn : Kername) : Kername =>
  \case kn.kerModPath \with {
    | mpFile nil => \case i64Name kn.kerName \with {
      | nothing => kn
      | just n => \new Kername (mpFile nil) n
    }
    | _ => kn
  }

-- An i63 payload becomes the i64 bit pattern denoting the same number (it is
-- in [0, 2^63)), so literals never change meaning; only operations can.
\func rewritePrim (pv : PrimVal) : PrimVal \elim pv
  | (rocqUint63, i) => (javaLong, wrap64u (pos i))
  | (javaLong, i) => (javaLong, i)

-- Array children are recursed on inline via `xs i` inside `mkArray`: Arend's
-- termination checker does not see through a higher-order `map`.
\func rewriteTerm (t : LBTerm) : LBTerm \elim t
  | box => box
  | bvar n => bvar n
  | fvar x => fvar x
  | prim pv => prim (rewritePrim pv)
  | const kn => const (rewriteKername kn)
  | lambda na b => lambda na (rewriteTerm b)
  | letIn na v b => letIn na (rewriteTerm v) (rewriteTerm b)
  | app f a => app (rewriteTerm f) (rewriteTerm a)
  | construct ind c args => construct ind c (mkArray (\lam i => rewriteTerm (args i)))
  | case ind np d brs =>
    case ind np (rewriteTerm d) (mkArray (\lam i => ((brs i).1, rewriteTerm (brs i).2)))
  | proj p d => proj p (rewriteTerm d)
  | fix defs idx =>
    fix (mkArray (\lam i => \new FixDef LBTerm (defs i).defName
                              (rewriteTerm (defs i).defBody) (defs i).principalArgIdx)) idx

-- A constant's name is rewritten along with its body, so that a renamed use
-- (`prim_add_long`) still refers to a declared constant.
\func rewriteDecl (d : GlobalDecl) : GlobalDecl \elim d
  | constantDecl cb => constantDecl (\new ConstantBody (\case cb.cstBody \with {
      | nothing => nothing
      | just b => just (rewriteTerm b)
    }))
  | inductiveDecl mib => inductiveDecl mib

\func rewriteProgram (p : LBProgram) : LBProgram =>
  (mkArray (\lam i => (rewriteKername (p.1 i).1, rewriteDecl (p.1 i).2)), rewriteTerm p.2)
