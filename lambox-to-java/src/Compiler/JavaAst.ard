-- The target language: the small Java fragment `Compiler/ToJava.ard`
-- generates, as an AST. The Java semantics (`Semantics/JavaEval.ard`) and the
-- correctness theorem are stated for this AST; turning it into text is the job
-- of the (trusted, unverified) printer `Compiler/JavaPrint.ard`.
--
-- Scope: exactly what the generator emits. No arithmetic, comparisons, loops,
-- `if`, generics or arrays; every value has static type `Object` and is cast
-- where needed. The only operator is `?:` (`jCond`), which is the whole of
-- λ□'s `case`. Statements only NAME values (`jLocal`) or tie a `fix` knot
-- (`jLocalClass`); a statement list is a sequence of bindings ending in
-- `jReturn`. Binders are names derived from node paths (`Compiler/NodePath.ard`).
--
-- The runtime `runtime/Rt.java` is hand-written. Its core (application,
-- closures, constructors, tag/field reads) has dedicated AST nodes, which the
-- semantics interprets; everything else is referenced by name from
-- `Compiler/JavaAxioms.ard` and is assumed.
--
-- `jClosure`/`jLocalClass` use arrays of `\Sigma`, not of records: a record
-- with a `JStmt` field would join the JExpr/JStmt `\data` cycle, which Arend
-- rejects.
--
-- Related designs: Malfunction.v (`Ident.t`/`Longident.t` ~ `JIdent`/`JQIdent`,
-- `Mvar`/`Mglobal` ~ `jVar`/`jStatic`), CompCert's `Clight.v` (two sorts,
-- printer outside the proof), Featherweight Java (the expression core).

\import Data.String
\import Compiler.JavaLong (JLong)

-- A simple and a possibly dotted Java identifier (`Rt.Fn`, `Long.valueOf`).
-- Both are already valid Java: mangling happens once, in `mangleKername`.
\func JIdent => String

\func JQIdent => String

-- The runtime's class name, used when printing the ABI nodes below.
\func runtimeClassName : JIdent => "Rt"

\func runtimeQual : String => runtimeClassName ++ "."

-- A reference type, by its name as written: `Object`, `Rt.Data`, a local class
-- `C12`. As in Java, the name is resolved by the semantics (a local class in
-- scope first, JLS 6.5.5), not by the AST: `Object` and `java.lang.Object`
-- are two spellings of one class (`resolveType` in Semantics/JavaEval.ard).
\data JType | tClass JQIdent

\func tObject : JType => tClass "Object"

-- The runtime's one-method function interface: λ□'s function space.
\func tFn : JType => tClass "Rt.Fn"

-- The runtime's constructor representation: a tag plus fields.
\func tData : JType => tClass "Rt.Data"

\data JExpr
  | jVar JIdent  -- a local or parameter as a value: `p3`, `l7`
  -- A qualified name, as a value or a static receiver. Apart from `jVar` because
  -- it is resolved globally, not in the environment.
  | jStatic JQIdent
  | jField JExpr JIdent  -- `e.f`: `Rt.BOX`, `Rt.PRIM_ADD_LONG`
  -- Printed fully parenthesized (see Compiler/JavaPrint.ard).
  | jCast JType JExpr
  | jInvoke JExpr JIdent (Array JExpr)  -- `e.m(args)`
  | jCallStatic JQIdent (Array JExpr)  -- `c_foo()`, `Long.valueOf(5L)`
  | jNew JType (Array JExpr)  -- an exception, or a `fix` local class

  -- --- Runtime ABI ---------------------------------------------------------
  -- λ□'s `box`, `app`, `lambda`, `construct` and the tag/field reads of `case`
  -- and `proj`. They are nodes (rather than calls of the general nodes above
  -- on hard-coded member names) so that the semantics can interpret them.
  | jBox  -- `Rt.BOX`: an erased proof or type
  | jApply JExpr JExpr  -- `((Rt.Fn)(f)).apply(x)`; the cast is how application is spelled
  -- `new Rt.Fn(){ public Object apply(Object <p>){ <body> } }`: an anonymous
  -- class with one method, given as (parameter, body).
  | jClosure JIdent (Array JStmt)
  | jDataNew Nat (Array JExpr)  -- `new Rt.Data(tag, new Object[]{ .. })`
  -- `d.tag == n`: is this value the n-th constructor? (One node, so the
  -- fragment needs no comparison operator.)
  | jTagEq JExpr Nat
  -- `d.fields[i]`, with a constant index: `proj`'s `npars + idx` is folded at
  -- compile time.
  | jDataField JExpr Nat
  -- --- end of runtime ABI --------------------------------------------------

  -- `(c ? a : b)`. A chain of these implements λ□'s iota rule for `case`.
  | jCond JExpr JExpr JExpr

  -- `C.this`: the instance of local class `C` (a `fix` block), referenced from
  -- inside a nested closure. Prints like `jStatic "C.this"` but is resolved in
  -- the enclosing class, not globally.
  | jQualThis JQIdent
  | jLit JLit

-- `litStr`: quoted but not escaped by the printer. `litLong`: a `long` such
-- as `5L`, λ□'s primitive int; in range by construction (`Compiler/JavaLong.ard`).
\data JLit
  | litStr String
  | litLong JLong

\data JStmt
  -- `final Object l3 = e;`: names a value used more than once.
  | jLocal JType JIdent JExpr
  -- A local class whose methods (name, parameter, body) may call each other:
  -- the encoding of λ□ `fix`. The knot is tied by the declaration, so there
  -- are no mutable cells.
  | jLocalClass JIdent (Array (\Sigma JIdent JIdent (Array JStmt)))
  | jThrow JExpr
  | jReturn JExpr
  | jComment String

-- A λ□ constant (`c_foo`) or the program's value (`body`), printed as
-- `public static Object <name>()`. Zero arguments: a λ□ function is a closure
-- value.
\record JMethod
  (mName : JIdent)
  (mBody : Array JStmt)

\data JMember
  | jMethod JMethod
  | jMemberComment String  -- what an erased inductive produces

-- `public final class <className> { .. }`. A library: `body()` returns the
-- program's value and `runtime/Main.java.in` supplies `main`.
\record JClass (className : JIdent) (classMembers : Array JMember)
