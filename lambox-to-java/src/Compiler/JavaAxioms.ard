\import Data.Array (map)
\import Data.Bool
\import Data.Maybe
\import Data.String
\import Compiler.JavaAst
\import Compiler.Int63
\import Compiler.LambdaBox
\import Compiler.Mangle
\import Compiler.NodePath
\import Set
\import Compiler.StringUtil

-- What the compiler needs from the hand-written runtime `runtime/Rt.java`
-- beyond the ABI nodes of `Compiler/JavaAst.ard`: literals for primitive ints,
-- the table realizing λ□ axioms (constants without a body) as runtime
-- constants, and the reporters for input that has no Java value.
--
-- The axiom table is a trust boundary: each runtime constant is ASSUMED to
-- implement its axiom (see `Semantics/LambdaBoxAxioms.ard` for the λ□ side and
-- `Semantics/RtInt63.ard`/`RtLong.ard` for models of the runtime).
--
-- Both primitive kinds are `java.lang.Long` at runtime: a `Uint63` value lies
-- in `long`'s non-negative half. They differ in arithmetic, `Rt.PRIM_*_INT63`
-- versus `Rt.PRIM_*_LONG`. A `const` node is compiled without seeing its
-- operands, so the kind reaches an operation through its axiom NAME
-- (`prim_add_int` vs `prim_add_long`, see `Compiler/LongRewrite.ard`).

-- A `Uint63` literal (the payload is already normalized).
\func int63Lit (i : Fin int63Mod) : JExpr =>
  jCallStatic "Long.valueOf" (jLit (litLong (pos i)) :: nil)

-- A 64-bit literal: the payload is the unsigned bit pattern, emitted with the
-- signed reading a JVM `long` gives it.
\func longLit (i : Fin int64Mod) : JExpr =>
  jCallStatic "Long.valueOf" (jLit (litLong (signed64 i)) :: nil)

-- Runtime family implementing λ□'s `Uint63` operations.
\func primOpSuffix : String => "INT63"

-- Runtime family for the int64 operations and for the Lean-derived operations
-- that cannot leave [0, 2^63) (Lean's `Nat` is an i63 in λ□: lean-to-lambdabox
-- refuses larger literals). `Nat.add`/`Nat.mul` can overflow, so they use the
-- INT63 family instead. `Nat.sub` truncates at zero (Lean's convention), so it
-- has its own `NAT_SUB_*` rather than the wrapping `PRIM_SUB_*`.
\func leanOpSuffix : String => "LONG"

-- `Rt`, as the receiver of a static member.
\func rtRef : JExpr => jStatic runtimeClassName

-- Axiom names: at the root (peregrine's `prim_*`) or in a Lean namespace
-- (`Nat.add` is `mpDot (mpFile nil) "Nat"`, as lean-to-lambdabox writes it).
\func axKnRoot (nm : String) : Kername => \new Kername (mpFile nil) nm

\func axKnIn (ns nm : String) : Kername => \new Kername (mpDot (mpFile nil) ns) nm

-- λ□ axiom -> the runtime constant realizing it; anything absent compiles to a
-- throwing stub. (Peregrine does this per run via `--attributes`; a fixed
-- table suffices because the runtime is ours.) Keyed by the full `Kername`, so
-- an unrelated `Foo.add` does not match `Nat.add`.
\func javaAxioms : Array (\Sigma Kername JExpr) =>
  \let | primOp (nm : String) => jField rtRef ("PRIM_" ++ nm ++ "_" ++ primOpSuffix)
       | leanOp (nm : String) => jField rtRef ("PRIM_" ++ nm ++ "_" ++ leanOpSuffix)
       -- Operations that neither take nor return a primitive int.
       | fixed (nm : String) => jField rtRef nm
  -- λ□'s int63 operations, under the names peregrine emits.
  \in (axKnRoot "prim_add_int", primOp "ADD") ::
      (axKnRoot "prim_mul_int", primOp "MUL") ::
      (axKnRoot "prim_sub_int", primOp "SUB") ::
      (axKnRoot "prim_eqb_int", primOp "EQB") ::
      -- int64 operations, produced only by `Compiler/LongRewrite.ard`: Java's
      -- unmasked `long` arithmetic.
      (axKnRoot "prim_add_long", leanOp "ADD") ::
      (axKnRoot "prim_mul_long", leanOp "MUL") ::
      (axKnRoot "prim_sub_long", leanOp "SUB") ::
      (axKnRoot "prim_eqb_long", leanOp "EQB") ::
      (axKnIn "Nat" "add", primOp "ADD") ::
      (axKnIn "Nat" "mul", primOp "MUL") ::
      -- Truncating subtraction, see `leanOpSuffix`.
      (axKnIn "Nat" "sub", jField rtRef ("NAT_SUB_" ++ leanOpSuffix)) ::
      (axKnIn "Nat" "beq", leanOp "EQB") ::
      -- The rest of the machine-Nat operations lean-to-lambdabox leaves as
      -- axioms. `div`/`mod` follow Lean's total conventions and
      -- `decEq`/`decLe`/`decLt` return `Decidable`, not `Bool` (see Rt.java).
      (axKnIn "Nat" "div", leanOp "DIV") ::
      (axKnIn "Nat" "mod", leanOp "MOD") ::
      (axKnIn "Nat" "pow", leanOp "POW") ::
      (axKnIn "Nat" "ble", leanOp "BLE") ::
      (axKnIn "Nat" "blt", leanOp "BLT") ::
      (axKnIn "Nat" "decEq", leanOp "DEC_EQ") ::
      (axKnIn "Nat" "decLe", leanOp "DEC_LE") ::
      (axKnIn "Nat" "decLt", leanOp "DEC_LT") ::
      -- Lean's machine-`Int` operations. `Int` erases to the same λ□ primitive
      -- int as `Nat`, so `ofNat` is the identity in both representations.
      (axKnIn "Int" "ofNat", fixed "INT_OF_NAT") ::
      (axKnIn "Int" "negSucc", jField rtRef ("INT_NEG_SUCC_" ++ leanOpSuffix)) ::
      (axKnIn "Int" "neg", jField rtRef ("INT_NEG_" ++ leanOpSuffix)) ::
      (axKnIn "Int" "add", jField rtRef ("INT_ADD_" ++ leanOpSuffix)) ::
      (axKnIn "Int" "mul", jField rtRef ("INT_MUL_" ++ leanOpSuffix)) ::
      (axKnIn "Int" "ediv", jField rtRef ("INT_EDIV_" ++ leanOpSuffix)) ::
      (axKnIn "Int" "emod", jField rtRef ("INT_EMOD_" ++ leanOpSuffix)) ::
      (axKnIn "Int" "decEq", jField rtRef ("INT_DEC_EQ_" ++ leanOpSuffix)) ::
      -- Lean's `Array` operations (`@[extern]`, so erasure keeps no body). Only
      -- `size` returns a Nat, hence only it depends on the representation. The
      -- Lean frontend writes `!` in a name as `_u33`.
      (axKnIn "Array" "mk", fixed "ARRAY_MK") ::
      (axKnIn "Array" "emptyWithCapacity", fixed "ARRAY_EMPTY_WITH_CAPACITY") ::
      (axKnIn "Array" "push", fixed "ARRAY_PUSH") ::
      (axKnIn "Array" "getInternal", fixed "ARRAY_GET_INTERNAL") ::
      (axKnIn "Array" "get_u33Internal", fixed "ARRAY_GET_BANG_INTERNAL") ::
      (axKnIn "Array" "set_u33", fixed "ARRAY_SET_BANG") ::
      (axKnIn "Array" "swap", fixed "ARRAY_SWAP") ::
      (axKnIn "Array" "size", jField rtRef ("ARRAY_SIZE_" ++ leanOpSuffix)) ::
      -- Rewriting along an equality is the identity at runtime.
      (axKnIn "Eq" "rec", fixed "EQ_REC") ::
      (axKnIn "Eq" "ndrec", fixed "EQ_REC") ::
      nil

-- Lookup in the table, comparing mangled names (exact, since `mangleKername`
-- is injective, see `Compiler/Mangle.ard`).
\func axiomImpl (kn : Kername) : Maybe JExpr =>
  lookupKey (mangleKername kn) (map (\lam (e : \Sigma Kername JExpr) => (mangleKername e.1, e.2)) javaAxioms)

-- Three situations have no λ□ value: a `bvar` beyond the enclosing binders, an
-- `fvar`, and a `case` whose scrutinee matches no branch. They do not occur for
-- well-formed erasure output; the generated code fails immediately (rather
-- than returning `null`) and names the node by its `Path` (Compiler/NodePath.ard).

\func rtUnbound (index : Nat) (path : Path) : JExpr =>
  jCallStatic (runtimeQual ++ "unbound") (jLit (litInt index) :: jLit (litStr (renderPath path)) :: nil)

\func rtFreeVar (name : String) (path : Path) : JExpr =>
  jCallStatic (runtimeQual ++ "freeVar") (jLit (litStr name) :: jLit (litStr (renderPath path)) :: nil)

-- The last alternative of the ternary chain for a `case`; takes the scrutinee,
-- so tag reads stay confined to `jTagEq`.
\func rtNoBranch (scrut : JExpr) (path : Path) : JExpr =>
  jCallStatic (runtimeQual ++ "noBranch") (scrut :: jLit (litStr (renderPath path)) :: nil)
