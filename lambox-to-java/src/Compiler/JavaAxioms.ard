\import Data.Array (map)
\import Data.Bool
\import Data.Maybe
\import Data.String
\import Compiler.JavaAst
\import Compiler.Int63
\import Compiler.JavaLong (longOfUint63, longOfBits)
\import Compiler.LambdaBox
\import Compiler.Mangle
\import Compiler.NodePath
\import Set
\import Compiler.StringUtil

-- What the compiler needs from the hand-written runtime `runtime/Rt.java`
-- beyond the ABI nodes of `Compiler/JavaAst.ard`: literals for primitive ints,
-- the table realizing λ□ axioms (constants without a body) as runtime
-- constants, and the reporters for input that has no Java value.
--
-- The axiom table is a trust boundary: each runtime constant is ASSUMED to
-- implement its axiom (see `Semantics/LambdaBoxAxioms.ard` for the λ□ side and
-- `Semantics/RtInt63.ard`/`RtLong.ard` for models of the runtime).
--
-- Both primitive kinds are `java.lang.Long` at runtime: a `Uint63` value lies
-- in `long`'s non-negative half. They differ in arithmetic: `Rt.PRIM_*_INT63`
-- wraps modulo 2^63, `Rt.PRIM_*_LONG` is Java's `long` arithmetic. A `const`
-- node is compiled without seeing its operands, so the kind reaches an
-- operation through its axiom name (`prim_add_int` vs `prim_add_long`, see
-- `Compiler/LongRewrite.ard`).

-- A `Uint63` literal (the payload is already normalized).
\func int63Lit (i : Fin int63Mod) : JExpr =>
  jCallStatic "Long.valueOf" (jLit (litLong (longOfUint63 i)) :: nil)

-- A 64-bit literal: the payload is the unsigned bit pattern, emitted with the
-- signed reading a JVM `long` gives it.
\func longLit (i : Fin int64Mod) : JExpr =>
  jCallStatic "Long.valueOf" (jLit (litLong (longOfBits i)) :: nil)

-- `Rt`, as the receiver of a static member.
\func rtRef : JExpr => jStatic runtimeClassName

-- Axiom names: at the root (peregrine's `prim_*`) or in a Lean namespace
-- (`Nat.add` is `mpDot (mpFile nil) "Nat"`, as lean-to-lambdabox writes it).
\func axKnRoot (nm : String) : Kername => \new Kername (mpFile nil) nm

\func axKnIn (ns nm : String) : Kername => \new Kername (mpDot (mpFile nil) ns) nm

-- λ□ axiom -> the runtime constant realizing it; anything absent compiles to a
-- throwing stub. (Peregrine does this per run via `--attributes`; a fixed
-- table suffices because the runtime is ours.) Keyed by the full `Kername`, so
-- an unrelated `Foo.add` does not match `Nat.add`.
\func javaAxioms : Array (\Sigma Kername JExpr) =>
  \let rt (nm : String) => jField rtRef nm
  -- λ□'s `Uint63` operations, under the names peregrine emits: wrap mod 2^63.
  \in (axKnRoot "prim_add_int", rt "PRIM_ADD_INT63") ::
      (axKnRoot "prim_mul_int", rt "PRIM_MUL_INT63") ::
      (axKnRoot "prim_sub_int", rt "PRIM_SUB_INT63") ::
      (axKnRoot "prim_eqb_int", rt "PRIM_EQB_INT63") ::
      -- Java `long` operations, produced by `Compiler/LongRewrite.ard`.
      (axKnRoot "prim_add_long", rt "PRIM_ADD_LONG") ::
      (axKnRoot "prim_mul_long", rt "PRIM_MUL_LONG") ::
      (axKnRoot "prim_sub_long", rt "PRIM_SUB_LONG") ::
      (axKnRoot "prim_eqb_long", rt "PRIM_EQB_LONG") ::
      -- Lean's machine `Nat` (an int63 in λ□: lean-to-lambdabox refuses larger
      -- literals). `add`/`mul` can overflow, so they wrap like `Uint63`;
      -- operations that cannot leave [0, 2^63) use the `long` ones. `sub`
      -- truncates at zero, `div`/`mod` follow Lean's `n / 0 = 0`, `n % 0 = n`.
      (axKnIn "Nat" "add", rt "PRIM_ADD_INT63") ::
      (axKnIn "Nat" "mul", rt "PRIM_MUL_INT63") ::
      (axKnIn "Nat" "sub", rt "NAT_SUB_LONG") ::
      (axKnIn "Nat" "beq", rt "PRIM_EQB_LONG") ::
      (axKnIn "Nat" "div", rt "PRIM_DIV_LONG") ::
      (axKnIn "Nat" "mod", rt "PRIM_MOD_LONG") ::
      (axKnIn "Nat" "pow", rt "PRIM_POW_LONG") ::
      (axKnIn "Nat" "ble", rt "PRIM_BLE_LONG") ::
      (axKnIn "Nat" "blt", rt "PRIM_BLT_LONG") ::
      -- These return `Decidable`, not `Bool` (see Rt.java).
      (axKnIn "Nat" "decEq", rt "PRIM_DEC_EQ_LONG") ::
      (axKnIn "Nat" "decLe", rt "PRIM_DEC_LE_LONG") ::
      (axKnIn "Nat" "decLt", rt "PRIM_DEC_LT_LONG") ::
      -- Lean's machine `Int`. It erases to the same λ□ primitive as `Nat`, so
      -- `ofNat` is the identity.
      (axKnIn "Int" "ofNat", rt "INT_OF_NAT") ::
      (axKnIn "Int" "negSucc", rt "INT_NEG_SUCC_LONG") ::
      (axKnIn "Int" "neg", rt "INT_NEG_LONG") ::
      (axKnIn "Int" "add", rt "INT_ADD_LONG") ::
      (axKnIn "Int" "mul", rt "INT_MUL_LONG") ::
      (axKnIn "Int" "ediv", rt "INT_EDIV_LONG") ::
      (axKnIn "Int" "emod", rt "INT_EMOD_LONG") ::
      (axKnIn "Int" "decEq", rt "INT_DEC_EQ_LONG") ::
      -- Lean's `Array` operations (`@[extern]`, so erasure keeps no body). The
      -- Lean frontend writes `!` in a name as `_u33`.
      (axKnIn "Array" "mk", rt "ARRAY_MK") ::
      (axKnIn "Array" "emptyWithCapacity", rt "ARRAY_EMPTY_WITH_CAPACITY") ::
      (axKnIn "Array" "push", rt "ARRAY_PUSH") ::
      (axKnIn "Array" "getInternal", rt "ARRAY_GET_INTERNAL") ::
      (axKnIn "Array" "get_u33Internal", rt "ARRAY_GET_BANG_INTERNAL") ::
      (axKnIn "Array" "set_u33", rt "ARRAY_SET_BANG") ::
      (axKnIn "Array" "swap", rt "ARRAY_SWAP") ::
      (axKnIn "Array" "size", rt "ARRAY_SIZE_LONG") ::
      -- Rewriting along an equality is the identity at runtime.
      (axKnIn "Eq" "rec", rt "EQ_REC") ::
      (axKnIn "Eq" "ndrec", rt "EQ_REC") ::
      nil

-- Lookup in the table, comparing mangled names (exact, since `mangleKername`
-- is injective, see `Compiler/Mangle.ard`).
\func axiomImpl (kn : Kername) : Maybe JExpr =>
  lookupKey (mangleKername kn) (map (\lam (e : \Sigma Kername JExpr) => (mangleKername e.1, e.2)) javaAxioms)

-- Three situations have no λ□ value: a `bvar` beyond the enclosing binders, an
-- `fvar`, and a `case` whose scrutinee matches no branch. They do not occur for
-- well-formed erasure output; the generated code fails immediately (rather
-- than returning `null`) and names the node by its `Path` (Compiler/NodePath.ard).

\func rtUnbound (path : Path) : JExpr =>
  jCallStatic (runtimeQual ++ "unbound") (jLit (litStr (renderPath path)) :: nil)

\func rtFreeVar (name : String) (path : Path) : JExpr =>
  jCallStatic (runtimeQual ++ "freeVar") (jLit (litStr name) :: jLit (litStr (renderPath path)) :: nil)

-- The last alternative of the ternary chain for a `case`; takes the scrutinee,
-- so tag reads stay confined to `jTagEq`.
\func rtNoBranch (scrut : JExpr) (path : Path) : JExpr =>
  jCallStatic (runtimeQual ++ "noBranch") (scrut :: jLit (litStr (renderPath path)) :: nil)
