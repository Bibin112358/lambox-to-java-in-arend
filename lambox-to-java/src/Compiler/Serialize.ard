\import Compiler.StringUtil
\import Compiler.LambdaBox
-- Only `mkArray`: importing Data.Array wholesale would shadow String's `++`.
\import Data.Array (mkArray)
\import Data.Bool
\import Data.Maybe
\import Data.String

-- Export of λ□ programs as S-expressions in peregrine's format, translated by
-- hand from lean-to-lambdabox's Serialize.lean. Not used by the compiler; the
-- test tooling reads this format back (test/tools/ast-to-arend).
--
-- Lean's `Serialize` type class becomes one `toSExpr<Type>` function per type;
-- polymorphic instances (`List α`, `Option α`) become helpers taking the
-- element serializer (`toSExprArray`, `toSExprMaybe`). `toSExprLBTerm`
-- recurses on its own array children inline (`\lam i => toSExprLBTerm (args i)`)
-- for the termination checker, as in `Compiler/ToJava.ard`; the generic helpers
-- are only used for non-recursive element types.
--
-- Our `ModPath` keeps MetaRocq's `mpBound`, which Lean's has not; its case is
-- an extension. `primInt64` has no wire format (see `toSExprPrimTag`).


-- ---------------------------------------------------------------------------
-- Sexpr and its rendering to String.
-- ---------------------------------------------------------------------------

\data Sexpr
  | atomS String
  | listS (Array Sexpr)

-- Children are rendered inline via `xs i` (not `Data.Array.map`), for termination.
\func sexprToString (e : Sexpr) : String \elim e
  | atomS c => c
  | listS xs =>
    "(" ++ joinStr " " (mkArray {String} {xs.len} (\lam i => sexprToString (xs i))) ++ ")"

\func quoteAtom (c : String) : String => "\"" ++ c ++ "\""

-- Peregrine's build has `cstr_as_blocks = false` (EWellformed.all_env_flags),
-- so `tConstruct` must carry an empty argument list ("Constructor args
-- non-empty", CheckWf.v); constructor arguments are exported as curried `tApp`s
-- instead. (This is why λ□'s semantics differs from its export, see
-- Semantics/LambdaBoxEval.ard.)
\func wrapTApp (base : Sexpr) (args : Array Sexpr) : Sexpr \elim args
  | nil => base
  | a :: rest => wrapTApp (listS (atomS ("tApp") :: base :: a :: nil)) rest


-- ---------------------------------------------------------------------------
-- Generic helpers, replacing Lean's polymorphic `Serialize` instances.
-- ---------------------------------------------------------------------------

\func toSExprArray {A : \Type} (f : A -> Sexpr) (xs : Array A) : Sexpr =>
  listS (mkArray {Sexpr} {xs.len} (\lam i => f (xs i)))

\func toSExprMaybe {A : \Type} (f : A -> Sexpr) (m : Maybe A) : Sexpr \elim m
  | nothing => atomS ("None")
  | just a => listS (atomS ("Some") :: f a :: nil)


-- ---------------------------------------------------------------------------
-- Base types.
-- ---------------------------------------------------------------------------

\func toSExprNat (n : Nat) : Sexpr => atomS (natToStr n)

\func toSExprIdent (s : Ident) : Sexpr => atomS (quoteAtom (s))

\func toSExprBool (b : Bool) : Sexpr \elim b
  | false => atomS ("false")
  | true => atomS ("true")

\func toSExprBinderName (b : BinderName) : Sexpr \elim b
  | named fv => listS (atomS ("nNamed") :: toSExprIdent fv.varName :: nil)
  | anon => atomS ("nAnon")

\func toSExprModPath (mp : ModPath) : Sexpr \elim mp
  | mpFile dp => listS (atomS ("MPfile") :: toSExprArray toSExprIdent dp :: nil)
  | mpBound dp id n =>  -- extension, no Lean counterpart
    listS (atomS ("MPbound") :: toSExprArray toSExprIdent dp :: toSExprIdent id :: toSExprNat n :: nil)
  | mpDot mp' id => listS (atomS ("MPdot") :: toSExprModPath mp' :: toSExprIdent id :: nil)

\func toSExprKername (k : Kername) : Sexpr =>
  listS (toSExprModPath k.kerModPath :: toSExprIdent k.kerName :: nil)

\func toSExprInductiveId (ind : InductiveId) : Sexpr =>
  listS (atomS ("inductive") :: toSExprKername ind.indMutualBlock :: toSExprNat ind.indIdx :: nil)

\func toSExprProjectionInfo (p : ProjectionInfo) : Sexpr =>
  listS (atomS ("projection") :: toSExprInductiveId p.projIndType
                                        :: toSExprNat p.projParamCount :: toSExprNat p.projFieldIdx :: nil)

-- Our `primInt63` is peregrine's `primInt`. `primInt64` is our extension and
-- has no wire name: it is exported as an atom peregrine rejects (like
-- `tVar_UNREACHABLE`), rather than silently as a `primInt` of another meaning.
\func toSExprPrimTag (t : PrimTag) : Sexpr \elim t
  | primInt63 => atomS ("primInt")
  | primInt64 => atomS ("primInt64_NOT_REPRESENTABLE")

-- The payload is a bare number atom, as in peregrine's Ceres serializer
-- (CeresSerialize.v); a quoted "1" (as Serialize.lean writes it) is rejected
-- by peregrine's deserializer.
\func toSExprPrimVal (pv : PrimVal) : Sexpr \elim pv
  | (primInt63, i) => listS (toSExprPrimTag primInt63 :: atomS (natToStr i) :: nil)
  | (primInt64, i) => listS (toSExprPrimTag primInt64 :: atomS (natToStr i) :: nil)


-- ---------------------------------------------------------------------------
-- LBTerm (Lean's mutual `LBTerm.to_sexpr`/`edef.to_sexpr`, with `FixDef`
-- inlined).
-- ---------------------------------------------------------------------------

\func toSExprLBTerm (t : LBTerm) : Sexpr \elim t
  | box => atomS ("tBox")
  | bvar n => listS (atomS ("tRel") :: toSExprNat n :: nil)
  | fvar _ => atomS ("tVar_UNREACHABLE")     -- Lean: `unreachable!`; no free variables after de Bruijn conversion
  | lambda na body => listS (atomS ("tLambda") :: toSExprBinderName na :: toSExprLBTerm body :: nil)
  | letIn na val body =>
    listS (atomS ("tLetIn") :: toSExprBinderName na :: toSExprLBTerm val :: toSExprLBTerm body :: nil)
  | app u v => listS (atomS ("tApp") :: toSExprLBTerm u :: toSExprLBTerm v :: nil)
  | const k => listS (atomS ("tConst") :: toSExprKername k :: nil)
  | construct ind n args =>
    wrapTApp (listS (atomS ("tConstruct") :: toSExprInductiveId ind :: toSExprNat n :: listS nil :: nil))
        (mkArray {Sexpr} {args.len} (\lam i => toSExprLBTerm (args i)))
  | case ind npars scrut brs =>
    listS (atomS ("tCase")
      :: listS (toSExprInductiveId ind :: toSExprNat npars :: nil)
           :: toSExprLBTerm scrut
                :: listS (mkArray {Sexpr} {brs.len} (\lam i =>
        listS (toSExprArray toSExprBinderName (brs i).1 :: toSExprLBTerm (brs i).2 :: nil)))
                     :: nil)
  | proj p c => listS (atomS ("tProj") :: toSExprProjectionInfo p :: toSExprLBTerm c :: nil)
  | fix defs idx =>
    listS (atomS ("tFix")
      :: listS (mkArray {Sexpr} {defs.len} (\lam j =>
        listS (atomS ("def") :: toSExprBinderName (defs j).defName
                                       :: toSExprLBTerm (defs j).defBody :: toSExprNat (defs j).principalArgIdx :: nil)))
           :: toSExprNat idx :: nil)
  | prim pv => listS (atomS ("tPrim") :: toSExprPrimVal pv :: nil)


-- ---------------------------------------------------------------------------
-- Declaration-level types.
-- ---------------------------------------------------------------------------

\func toSExprConstructorBody (c : ConstructorBody) : Sexpr =>
  listS (atomS ("constructor_body") :: toSExprIdent c.cstrName :: toSExprNat c.cstrNargs :: nil)

\func toSExprProjectionBody (p : ProjectionBody) : Sexpr =>
  listS (atomS ("projection_body") :: toSExprIdent p.projBodyName :: nil)

\func toSExprAllowedEliminations (a : AllowedEliminations) : Sexpr \elim a
  | IntoSProp => atomS ("IntoSProp")
  | IntoPropSProp => atomS ("IntoPropSProp")
  | IntoSetPropSProp => atomS ("IntoSetPropSProp")
  | IntoAny => atomS ("IntoAny")

\func toSExprOneInductiveBody (o : OneInductiveBody) : Sexpr =>
  listS (atomS ("one_inductive_body") :: toSExprIdent o.indName :: toSExprBool o.indPropositional
                                                                          :: toSExprAllowedEliminations o.indKelim :: toSExprArray toSExprConstructorBody o.indCtors
                                                                                                                        :: toSExprArray toSExprProjectionBody o.indProjs :: nil)

\func toSExprRecursivityKind (r : RecursivityKind) : Sexpr \elim r
  | finite => atomS ("Finite")
  | cofinite => atomS ("CoFinite")
  | bifinite => atomS ("BiFinite")

\func toSExprMutualInductiveBody (m : MutualInductiveBody) : Sexpr =>
  listS (atomS ("mutual_inductive_body") :: toSExprRecursivityKind m.indFinite :: toSExprNat m.indNpars
                                                                                         :: toSExprArray toSExprOneInductiveBody m.indBodies :: nil)

\func toSExprConstantBody (c : ConstantBody) : Sexpr =>
  listS (atomS ("constant_body") :: toSExprMaybe toSExprLBTerm c.cstBody :: nil)

\func toSExprGlobalDecl (g : GlobalDecl) : Sexpr \elim g
  | constantDecl cb => listS (atomS ("ConstantDecl") :: toSExprConstantBody cb :: nil)
  | inductiveDecl mib => listS (atomS ("InductiveDecl") :: toSExprMutualInductiveBody mib :: nil)

\func toSExprGlobalDeclEntry (p : \Sigma Kername GlobalDecl) : Sexpr =>
  listS (toSExprKername p.1 :: toSExprGlobalDecl p.2 :: nil)

\func toSExprGlobalDeclarations (ds : GlobalDeclarations) : Sexpr =>
  toSExprArray toSExprGlobalDeclEntry ds

\func toSExprASTType (a : ASTType) : Sexpr \elim a
  | untyped ds term => listS (atomS ("Untyped") :: toSExprGlobalDeclarations ds :: toSExprMaybe toSExprLBTerm term :: nil)


-- ---------------------------------------------------------------------------
-- Extraction-attribute-remapping types (tail of Basic.lean / Serialize.lean).
-- ---------------------------------------------------------------------------

\func toSExprRemappedInductive (r : RemappedInductive) : Sexpr =>
  listS (atomS ("remapped_inductive") :: toSExprIdent r.reIndName
                                                :: toSExprArray toSExprIdent r.reIndCtors :: toSExprMaybe toSExprIdent r.reIndMatch :: nil)

\func toSExprExtractInductive (e : ExtractInductive) : Sexpr =>
  listS (atomS ("extract_inductive") :: toSExprArray toSExprKername e.extractCstrs :: toSExprKername e.extractElim :: nil)

\func toSExprRemapInductive (r : RemapInductive) : Sexpr \elim r
  | knIndRemap re => listS (atomS ("KnIndRemap") :: toSExprExtractInductive re :: nil)
  | stringIndRemap re => listS (atomS ("StringIndRemap") :: toSExprRemappedInductive re :: nil)

\func toSExprInductiveMapping (m : InductiveMapping) : Sexpr =>
  listS (atomS ("inductive_mapping") :: toSExprKername m.indMapKn
                                               :: toSExprIdent m.indMapS :: toSExprArray toSExprNat m.indMapN :: nil)

\func toSExprRemappedConstant (r : RemappedConstant) : Sexpr =>
  listS (atomS ("remapped_constant") :: toSExprMaybe toSExprIdent r.reConstExt
                                               :: toSExprNat r.reConstArity :: toSExprBool r.reConstGC :: toSExprBool r.reConstInl
                                                                                                            :: toSExprIdent r.reConstS :: nil)

\func toSExprAttributesConfig (a : AttributesConfig) : Sexpr =>
  listS (atomS ("attributes_config")
    :: toSExprArray toSExprKername a.acInlinings
         :: toSExprArray (\lam p => listS (toSExprKername p.1 :: toSExprRemappedConstant p.2 :: nil)) a.acConstRemappings
              :: toSExprArray (\lam p => listS (toSExprInductiveId p.1 :: toSExprRemapInductive p.2 :: nil)) a.acIndRemappings
                   :: toSExprArray toSExprInductiveMapping a.acCstrReorders
                        :: toSExprArray (\lam p => listS (toSExprKername p.1 :: toSExprIdent p.2 :: nil)) a.acCustomAttributes
                             :: nil)


-- ---------------------------------------------------------------------------
-- Entry point.
-- ---------------------------------------------------------------------------

-- A program, as peregrine's `Untyped` AST with its entry term.
\func LambdaBoxToString (p : LBProgram) =>
  sexprToString (toSExprASTType (untyped p.1 (just p.2)))

-- Renders a Peregrine `--attributes` config file (axiom realizations etc.).
\func AttributesToString (a : AttributesConfig) : String =>
  sexprToString (toSExprAttributesConfig a)
