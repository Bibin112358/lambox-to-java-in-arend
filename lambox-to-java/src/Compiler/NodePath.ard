\import Data.String
\import Compiler.StringUtil

-- Node paths, and the generated Java names derived from them.
--
-- The generator has no fresh-name counter: a name is derived from WHERE its
-- node sits in the λ□ term. A `Path` lists the selectors from the node up to
-- the root, so distinct nodes have distinct paths, and a name is a pair
-- (`NameKind`, `Path`) rendered by `renderName`. Uniqueness of names thus
-- reduces to injectivity of `renderName`, proved in `Proof/NodePathUnique.ard`.
--
-- Rendering is a prefix code: a kind is one letter; a selector is one letter,
-- followed for indexed selectors by digits terminated by `_`. `_` is used for
-- nothing else, and a name starts with its kind letter, so no name is the
-- bare `_` (reserved in Java since 9).

-- One step from a node to a child. There is one constructor per (node kind, child
-- slot) in `compileExpr`, so a child's path determines which sub-term it is; the
-- indexed ones number the children of a node that has an array of them.
\data Sel
  | sFun               -- app: the function
  | sArg               -- app: the argument
  | sLamBody           -- lambda: the body
  | sLetVal            -- letIn: the bound value
  | sLetBody           -- letIn: the body
  | sScrut             -- case: the scrutinee
  | sProj              -- proj: the record
  -- A fix body that is not a lambda (compileFixMethod's second clause), which
  -- gets its own step so its names cannot clash with the method's parameter.
  | sEta
  | sCtorArg Nat       -- construct: the i-th argument
  | sBranch Nat        -- case: the i-th branch
  | sMethod Nat        -- fix: the j-th mutually defined function
  | sWrap Nat          -- fix: the closure forwarding to the j-th function

-- A node address: the selectors from the node to the root, nearest first. It is
-- passed down (never threaded), which keeps the generator structurally recursive.
\func Path : \Type => Array Sel

-- One kind per naming site in the generator; a node mints at most one name of
-- each kind.
\data NameKind
  | nParam             -- a lambda's, method's or forwarding closure's parameter
  | nLet               -- a letIn's local
  | nScrut             -- a case's scrutinee local
  | nThunk             -- a case arm's thunk parameter
  | nFixInst           -- a fix's local-class instance
  | nFixClass          -- a fix's local class (capitalized, as Java classes are)

-- Distinct letters.
\func renderKind (k : NameKind) : String
  | nParam => "p"
  | nLet => "l"
  | nScrut => "d"
  | nThunk => "t"
  | nFixInst => "z"
  | nFixClass => "C"

-- A letter per selector; an index becomes digits delimited by `_`, so a selector
-- cannot run into the path behind it whatever that path starts with.
\func renderSel (s : Sel) : String
  | sFun => "F"
  | sArg => "A"
  | sLamBody => "L"
  | sLetVal => "V"
  | sLetBody => "B"
  | sScrut => "S"
  | sProj => "P"
  | sEta => "E"
  | sCtorArg i => "c" ++ natToStr i ++ "_"
  | sBranch i => "b" ++ natToStr i ++ "_"
  | sMethod j => "y" ++ natToStr j ++ "_"
  | sWrap j => "w" ++ natToStr j ++ "_"

-- The path as text; also the node id in runtime diagnostics (`Rt.unbound` etc.,
-- see Compiler/JavaAxioms.ard). The root is the empty string.
\func renderPath (p : Path) : String \elim p
  | nil => ""
  | s :: p => renderSel s ++ renderPath p

-- The only way a name becomes text.
\func renderName (k : NameKind) (p : Path) : String => renderKind k ++ renderPath p
