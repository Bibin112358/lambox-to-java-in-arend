\import Compiler.LambdaBox
-- Not all of Data.Array (its `++` would clash with String's); array append is
-- imported as `++A`.
\import Data.Array (map, mkArray, Big, ++ \as \infixr 5 ++A)
\import Data.Maybe
\import Data.String
\import Compiler.JavaAst
\import Compiler.JavaAxioms
\import Compiler.JavaPrint
\import Compiler.Mangle
\import Compiler.NodePath
\import Compiler.StringUtil

-- The compiler: λ□ (`Compiler/LambdaBox.ard`) -> Java AST (`Compiler/JavaAst.ard`).
-- `compileProgram` composes it with the printer (`Compiler/JavaPrint.ard`).
--
-- Encoding: values are `Object`; closures are anonymous `Rt.Fn` classes;
-- constructors are `Rt.Data(tag, fields)`; `case` is a chain of `?:` on the
-- tag; constants are zero-argument static methods; `fix` is a local class with
-- one method per mutually defined function; the program's term is `body()`.
-- Every λ□ node denotes an expression: the statement prelude in `Out` only
-- names values (a `letIn`, a `case` scrutinee, a `fix` instance).
--
-- There are no options, and no runtime member is named here: the runtime core
-- is reached through the AST's ABI nodes, the rest through `Compiler/JavaAxioms.ard`.
--
-- Names come from a structural `path : Path` passed down per child
-- (`Compiler/NodePath.ard`), so there is no fresh-name state to thread.
--
-- Termination: Arend's termination checker rejects a separate helper over
-- `Array LBTerm` that calls `compileExpr`, and loses the structural link
-- through `\case`-bound variables and `Data.Array.map`. So `compileExpr`
-- recurses on array children inline: `mkArray {..} {xs.len} (\lam i => .. (xs i))`
-- or a direct projection like `(brs i).2` (as in arend-lib's HRS.ard).
-- Combining results with `++`/`Big`/`map` afterwards is fine.

-- Compilation result: (statements to run first, value expression).
\func Out : \Type => \Sigma (Array JStmt) JExpr

-- The environment maps a de Bruijn index (head = 0) to the expression denoting
-- it: usually a variable (`jVar "p3"`), for a `fix` sibling a forwarding
-- closure (`fixMethodRef`). An index beyond the environment compiles to
-- `rtUnbound`.
\func nthVar (n : Nat) (env : Array JExpr) (path : Path) : JExpr \elim n, env
  | _, nil => rtUnbound path
  | 0, x :: _ => x
  | suc n, _ :: env => nthVar n env path

-- Array append and flattening of per-child results.
\func appendStmts (xs ys : Array JStmt) : Array JStmt => xs ++A ys

\func concatStmtBlocks (bs : Array (Array JStmt)) : Array JStmt => Big appendStmts nil bs

-- The statements of a sequence of child results, in order.
\func concatStmts (rs : Array Out) : Array JStmt => concatStmtBlocks (map (\lam r => r.1) rs)

-- Push a branch's field binders onto the environment, starting at field index
-- `fieldIx` (= npars, to skip inductive parameters).
--
-- A binder is bound to the expression `d.fields[i]` itself, not to a local, so
-- a branch body needs no statements (and hence no thunk, see `armExpr`). This
-- is fine because the read is pure and constant-size. Pushing left to right
-- makes the LAST binder de Bruijn index 0 (as in λ□'s `iota_red`).
\func pushFields (dv : JExpr) (fieldIx : Nat) (bs : Array BinderName) (env : Array JExpr)
  : Array JExpr \elim bs
  | nil => env
  | _ :: bs => pushFields dv (suc fieldIx) bs (jDataField dv fieldIx :: env)

-- ---------------------------------------------------------------------------
-- The ternary-chain `case` encoding; see the `case` clause of `compileExpr`.
-- ---------------------------------------------------------------------------

-- One branch as an arm of the chain. A body that needs statements (a nested
-- `letIn`, `case` or `fix`) must not run unless selected, so it becomes a
-- thunk applied at once: `((Rt.Fn)(new Rt.Fn(){ .. })).apply(Rt.BOX)`. Only the
-- selected arm's thunk is allocated.
\func armExpr (stmts : Array JStmt) (val : JExpr) (path : Path) : JExpr \elim stmts
  | nil => val
  | s :: ss =>
    jApply (jClosure (renderName nThunk path) (appendStmts (s :: ss) (jReturn val :: nil))) jBox

-- The arms, as one nested conditional: `d.tag == 0 ? a0 : d.tag == 1 ? a1 : ..`.
-- `tag` counts up with the position, since a branch's index IS its constructor's
-- tag.
--
-- The chain ends in `Rt.noBranch` rather than in the last arm, so that a
-- scrutinee with an impossible tag fails immediately instead of silently
-- taking the last branch.
\func condChain (scrut : JExpr) (tag : Nat) (arms : Array JExpr) (path : Path) : JExpr \elim arms
  | nil => rtNoBranch scrut path
  | a :: arms => jCond (jTagEq scrut tag) a (condChain scrut (suc tag) arms path)

-- ---------------------------------------------------------------------------
-- The local-class `fix` encoding; see the `fix` clause of `compileExpr`.
-- ---------------------------------------------------------------------------

-- The j-th method of a fix's local class. Not path-derived: method names live
-- in the (fresh) class's own namespace.
\func fixMethodName (j : Nat) : String => "f" ++ natToStr j

-- The j-th sibling as a value: a closure forwarding to the method (a method is
-- not an `Rt.Fn`). One `new` per occurrence, deliberately: caching it in a
-- field would need an initialization order; the common self-recursive use does
-- not escape, so the JIT's escape analysis can remove it. `recv` is
-- `C<path>.this` inside the class and the instance local outside. The
-- parameter's path `sWrap j` names nothing else.
\func fixMethodRef (recv : JExpr) (path : Path) (j : Nat) : JExpr =>
  \let wp => renderName nParam (sWrap j :: path)
  \in jClosure wp (jReturn (jInvoke recv (fixMethodName j) (jVar wp :: nil)) :: nil)

-- Push the k siblings onto env as forwarding closures; head = f(k-1) = de
-- Bruijn 0 (the order of λ□'s `fix_subst`).
\func pushFixMethods (recv : JExpr) (path : Path) (j k : Nat) (env : Array JExpr)
  : Array JExpr \elim k
  | 0 => env
  | suc k => pushFixMethods recv path (suc j) k (fixMethodRef recv path j :: env)

-- Core compiler. `path` uniquely identifies this node; binder names and child
-- paths are derived from it, so no state threading is needed.
\func compileExpr (env : Array JExpr) (path : Path) (t : LBTerm) : Out \elim t
  | box => (nil, jBox)

  | bvar n => (nil, nthVar n env path)

  -- A free variable has no Java counterpart; see `rtFreeVar`.
  | fvar v => (nil, rtFreeVar v.varName path)

  -- The payload is already bounded; the tag decides how it is emitted.
  | prim (rocqUint63, i) => (nil, int63Lit i)
  | prim (javaLong, i) => (nil, longLit i)

  | const k => (nil, jCallStatic (mangleKername k) nil)

  | app f a =>
    \let | of => compileExpr env (sFun :: path) f
         | oa => compileExpr env (sArg :: path) a
    \in (appendStmts of.1 oa.1, jApply of.2 oa.2)

  | lambda _ body =>
    \let | pv => renderName nParam path
         | ob => compileExpr (jVar pv :: env) (sLamBody :: path) body
    \in (nil, jClosure pv (appendStmts ob.1 (jReturn ob.2 :: nil)))

  | letIn _ value body =>
    \let | ov => compileExpr env (sLetVal :: path) value
         | lv => renderName nLet path
         | ob => compileExpr (jVar lv :: env) (sLetBody :: path) body
    \in (appendStmts ov.1 (jLocal tObject lv ov.2 :: ob.1), ob.2)

  | construct _ cidx args =>
    \let | results => mkArray {Out} {args.len} (\lam i => compileExpr env (sCtorArg i :: path) (args i))
    \in (concatStmts results, jDataNew cidx (map (\lam r => r.2) results))

  -- case: one statement naming the (cast) scrutinee, then the expression
  -- `d.tag == 0 ? <branch 0> : d.tag == 1 ? ... : Rt.noBranch(d, ..)`, which is
  -- λ□'s iota rule. The scrutinee is named because the chain and the field
  -- reads mention it many times. A match with no branches still evaluates and
  -- casts the scrutinee.
  | case _ npars scrut brs =>
    \let | os => compileExpr env (sScrut :: path) scrut
         | dv => renderName nScrut path
         | d  => jVar dv
         -- Recurse on the direct projection `(brs i).2` (see Termination).
         | arms => mkArray {JExpr} {brs.len} (\lam i =>
             \let | bp => sBranch i :: path
                  | ob => compileExpr (pushFields d npars (brs i).1 env) bp (brs i).2
             \in armExpr ob.1 ob.2 bp)
    \in (appendStmts os.1 (jLocal tData dv (jCast tData os.2) :: nil),
         condChain d 0 arms path)

  -- proj: the AST has no arithmetic node, so `npars + idx` is added here.
  | proj pinfo scrut =>
    \let | os => compileExpr env (sProj :: path) scrut
    \in (os.1,
         jDataField (jCast tData os.2) (pinfo.projParamCount Nat.+ pinfo.projFieldIdx))

  -- fix: a local class with one method per mutually defined function; the
  -- knot is tied by the class declaration (no mutable cells). Inside a method,
  -- siblings are reached through `C<path>.this`, since inside a forwarding
  -- closure `this` is the closure.
  | fix defs idx =>
    \let | k     => defs.len
         | cls   => renderName nFixClass path
         | inst  => renderName nFixInst path
         | env'  => pushFixMethods (jQualThis cls) path 0 k env
         | methods => mkArray {\Sigma JIdent JIdent (Array JStmt)} {k} (\lam j =>
             \let | m => compileFixMethod env' (sMethod j :: path) (defs j).defBody
             \in (fixMethodName j, m.1, m.2))
    \in (jLocalClass cls methods ::
         jLocal (tClass cls) inst (jNew (tClass cls) nil) ::
         nil,
         fixMethodRef (jVar inst) path idx)

-- One method of a `fix` local class: (parameter name, body).
--
-- The body's guarding lambda becomes the method's parameter, so a recursive
-- call is a method call rather than a closure application. (A separate
-- `\elim`, not an inner `\case`, for termination.) The second clause
-- eta-expands a body that is not a lambda (`fix [f => f] 0`, never produced by
-- erasure): the λ□ term diverges and so does the Java, so the encoding needs no
-- well-formedness side condition.
\func compileFixMethod (env : Array JExpr) (path : Path) (t : LBTerm)
  : \Sigma JIdent (Array JStmt) \elim t
  | lambda _ inner =>
    \let | pv => renderName nParam path
         | ob => compileExpr (jVar pv :: env) (sLamBody :: path) inner
    \in (pv, appendStmts ob.1 (jReturn ob.2 :: nil))
  | t =>
    \let | pv => renderName nParam path
         -- At `sEta :: path`, so its names cannot clash with `pv`.
         | ot => compileExpr env (sEta :: path) t
    \in (pv, jComment "unguarded fix body: eta-expanded (diverges instead of reading an unassigned slot)" ::
             appendStmts ot.1 (jReturn (jApply ot.2 (jVar pv)) :: nil))


-- ---------------------------------------------------------------------------
-- Program assembly.
-- ---------------------------------------------------------------------------

\func constMethod (name : String) (body : Array JStmt) : JMember =>
  jMethod (\new JMethod name body)

\func compileDecl (kd : \Sigma Kername GlobalDecl) : JMember =>
  \let | name => mangleKername kd.1
  \in \case kd.2 \with {
    | constantDecl cb => \case cb.cstBody \with {
      | just body =>
        \let | o => compileExpr nil nil body
        \in constMethod name (appendStmts o.1 (jReturn o.2 :: nil))
      | nothing => \case axiomImpl kd.1 \with {
        | just impl => constMethod name (jReturn impl :: nil)
        | nothing =>
          constMethod name
            (jThrow (jNew (tClass "RuntimeException")
                          (jLit (litStr ("axiom " ++ name ++ " not implemented")) :: nil)) :: nil)
      }
    }
    | inductiveDecl _ =>
      jMemberComment ("inductive " ++ name ++ ": erased; values use Data(tag, fields)")
  }

\func compileDecls (ds : GlobalDeclarations) : Array JMember =>
  map (\lam d => compileDecl d) ds

-- Cannot collide with a compiled constant: `mangleKername` names start with `c`.
\func bodyMethodName : JIdent => "body"

-- The program's term as `public static Object body(){ .. }`. No `main` is
-- generated: what to do with the value is the caller's choice (see
-- `runtime/Main.java.in`), and several generated classes can share a program.
\func compileBody (t : LBTerm) : Array JMember =>
  \let | o => compileExpr nil nil t
  \in constMethod bodyMethodName (appendStmts o.1 (jReturn o.2 :: nil)) :: nil

-- The generated class; `Fn`, `Data` and `BOX` come from `runtime/Rt.java`. A
-- `const` compiles to an unqualified `c_foo()`, so two generated classes can
-- coexist but not call each other's constants (that would need a
-- `Kername -> Maybe JQIdent` resolver, generalizing the axiom table).
\func compileClass (name : JIdent) (p : LBProgram) : JClass =>
  \new JClass name (compileDecls p.1 ++A compileBody p.2)

-- The generator and the printer, composed: the whole backend.
\func compileProgram (name : JIdent) (p : LBProgram) : String =>
  printClass (compileClass name p)
