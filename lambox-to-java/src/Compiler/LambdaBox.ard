-- The λ□ (lambda-box) language: terms (`LBTerm`) and programs (`LBProgram`).
--
-- This is the input of the compiler (`Compiler/ToJava.ard`) and of every
-- semantics in `Semantics/`. It follows lean-to-lambdabox's `LBTerm`
-- (LeanToLambdaBox/Basic.lean), itself an adaptation of MetaRocq's λ□
-- (erasure/theories/EAst.v):
--   * `fvar` (a locally-nameless free variable) is kept next to `bvar`
--     (de Bruijn); EAst has only `bvar`.
--   * `tVar`, `tEvar`, `tCoFix`, `tLazy`, `tForce` are dropped: they are not
--     needed for a strict, non-coinductive fragment.
--   * primitives carry a width tag (`PrimTag`) and a bounded payload.
-- Links:
--   https://github.com/peregrine-project/lean-to-lambdabox/blob/main/LeanToLambdaBox/Basic.lean
--   https://metarocq.github.io/html/MetaRocq.Erasure.EAst.html
--   https://github.com/MetaRocq/metarocq/blob/coq-8.20/erasure/theories/EAst.v

\import Data.Bool
\import Compiler.Int63 (int63Mod, int64Mod)
\import Data.Maybe
\import Data.String
-- All sequences are Prelude `Array`s (no `Data.List`), so the compiler can
-- recurse on elements via `xs i`.

\func Ident => String
\func DirPath => Array String

\class FreeVarId
  | varName : String

\data BinderName
  | named FreeVarId
  | anon  -- Identifiers that are allowed to be anonymous (i.e. "_" in concrete syntax).

\data ModPath
  | mpFile DirPath
  | mpBound DirPath Ident Nat
  | mpDot ModPath Ident

\record Kername (kerModPath : ModPath) (kerName : Ident)

\record InductiveId (indMutualBlock : Kername) (indIdx : Nat)
-- Q (Lean) : Which of the mutually inductive types defined in this block is used here?

\record ProjectionInfo
  (projIndType : InductiveId)
  (projParamCount : Nat)  -- number of (non-let) parameters
  (projFieldIdx : Nat)  -- argument to project

\record FixDef (term : \Type)
  | defName : BinderName
  | defBody : term
  | principalArgIdx : Nat  -- Principal/structural argument for recursion

-- Primitive integers. Upstream λ□ has one kind, MetaRocq's `primInt63`
-- (`EPrimitive.v`, model `PrimInt63.int`; lean-to-lambdabox: `BitVec 63`).
-- Only `tPrim` is affected: Rocq's `nat`/`Z` and Lean's Peano mode erase to
-- ordinary constructors.
--
-- The width is part of the TERM, not a backend choice: a backend computing
-- with JVM `long`s on an int63 term would simply be wrong. Choosing a
-- different representation is instead a source-to-source rewrite on terms
-- (see `Compiler/Int64Rewrite.ard`), mirroring how lean-to-lambdabox's
-- `config.nat` emits different λ□ terms.
--
-- `primInt64` has no peregrine counterpart, so `Compiler/Serialize.ard`
-- cannot export it (export is allowed to be partial). Its operations are
-- selected by kername at `const` nodes (see `Compiler/JavaAxioms.ard`).
\data PrimTag
  | primInt63  -- MetaRocq/peregrine's `Uint63`: unsigned, cyclic mod 2^63
  | primInt64  -- two's-complement 64-bit, i.e. a JVM `long`
-- | primFloat
-- | primList

-- Payloads are bounded by construction (`Fin`); they are built with
-- `Int63.wrap63`/`wrap64u`, so an out-of-range primitive cannot be written.
\func PrimModel (t : PrimTag) : \Set0
  | primInt63 => Fin int63Mod
  | primInt64 => Fin int64Mod

\func PrimVal : \Type => \Sigma (t : PrimTag) (PrimModel t)


-- ---------------------------------------------------------------------------
-- The Lambda Box Term
--  https://metarocq.github.io/html/MetaRocq.Erasure.EAst.html#term
--  https://github.com/peregrine-project/lean-to-lambdabox/blob/main/LeanToLambdaBox/Basic.lean#L90
-- ---------------------------------------------------------------------------

\data LBTerm
  | box  -- represents computation irrelevant things, like proofs and types
  | bvar Nat  -- bound variable, accessed as a de Bruijn index
  | fvar FreeVarId  -- free variables (e.g. in a goal)
  -- tEvar  (not part of Lean pipeline?)
  | lambda BinderName LBTerm  -- \lam x => x + 1
  | letIn BinderName LBTerm LBTerm  -- \let | x => 1 \in x + 1
  | app LBTerm LBTerm  -- f x
  | const Kername  --  a constant living in the environment
  -- The array contains exactly all constructor fields (constructor-block form),
  -- as produced for external programs by Peregrine's `ast box` pass.
  | construct InductiveId Nat {- index of the constructor used -} (Array LBTerm)  -- \data ...  (Array so ToJava can recurse inline via `args i`)
  | case InductiveId Nat {- number of parameters -} LBTerm (Array (\Sigma (Array BinderName) LBTerm))
  -- \case {Type, number of parameters} expr \with ...
  | proj ProjectionInfo LBTerm
  | fix (Array (FixDef LBTerm)) Nat {- index of the one mutually defined function we want to access -}
  -- | tCoFix  (not part of Lean pipeline?)
  | prim PrimVal
-- | lazy  -- lazy evaltiation? (not part of Lean pipeline?)
-- | force  -- eager evaltiation? (not part of Lean pipeline?)


-- ---------------------------------------------------------------------------
-- The Lambda Box Program
--  https://metarocq.github.io/html/MetaRocq.Erasure.EAst.html#program
--  https://github.com/peregrine-project/lean-to-lambdabox/blob/main/LeanToLambdaBox/Basic.lean#L182
-- ---------------------------------------------------------------------------

\record ConstructorBody (cstrName : Ident) (cstrNargs : Nat)

\record ProjectionBody (projBodyName : Ident)

\data AllowedEliminations  -- TODO : adjust for Arend?
  | IntoSProp
  | IntoPropSProp
  | IntoSetPropSProp
  | IntoAny

\record OneInductiveBody
  (indName : Ident)
  (indPropositional : Bool)   -- Should always be false? since erasure should remove anything which ends up in Prop
  (indKelim : AllowedEliminations)
  (indCtors : Array ConstructorBody)
  (indProjs : Array ProjectionBody)  -- This is only about giving user-visible names to projections, but `peregrine` complains about wellformedness if it is empty.

\data RecursivityKind
  | finite
  | cofinite  -- Lean doesn't have primitive coinductive types, but including this here anyway to match the MetaCoq side.
  | bifinite

\record MutualInductiveBody
  (indFinite : RecursivityKind)  -- Should always be finite ?
  (indNpars : Nat)  -- Number of parameters to this family of mutually inductive types.
  (indBodies : Array OneInductiveBody)

\record ConstantBody (cstBody : Maybe LBTerm)

\data GlobalDecl
  | constantDecl ConstantBody
  | inductiveDecl MutualInductiveBody

-- Order: newest first, i.e. dependents before their dependencies. MetaRocq's
-- `EWellformed.wf_glob` (and peregrine's `CheckWf.v`) checks each entry only
-- against the tail of the list. Our generator does not care, but a program in
-- the wrong order is rejected by peregrine after export.
\func GlobalDeclarations : \Type => Array (\Sigma Kername GlobalDecl)

\func LBProgram : \Type => \Sigma GlobalDeclarations LBTerm


-- ---------------------------------------------------------------------------
-- The rest of Basic.lean (`ASTType` and the extraction-attribute remapping
-- types): not used by the compiler, only by Compiler/Serialize.ard.
-- ---------------------------------------------------------------------------

-- Basic.lean's `Program := ASTType`; `term` is `Option LBTerm` there (unlike
-- LBProgram above, which requires one) -- a program can be a bare library
-- with no distinguished entry term.
\data ASTType
  | untyped GlobalDeclarations (Maybe LBTerm)

\record RemappedInductive
  (reIndName : Ident)
  (reIndCtors : Array Ident)
  (reIndMatch : Maybe Ident)

\record ExtractInductive
  (extractCstrs : Array Kername)
  (extractElim : Kername)

\record RemappedConstant
  (reConstExt : Maybe Ident)
  (reConstArity : Nat)
  (reConstGC : Bool)
  (reConstInl : Bool)
  (reConstS : Ident)

\data RemapInductive
  | knIndRemap ExtractInductive
  | stringIndRemap RemappedInductive

\record InductiveMapping
  (indMapKn : Kername)
  (indMapS : Ident)
  (indMapN : Array Nat)

\record AttributesConfig
  (acInlinings : Array Kername)
  (acConstRemappings : Array (\Sigma Kername RemappedConstant))
  (acIndRemappings : Array (\Sigma InductiveId RemapInductive))
  (acCstrReorders : Array InductiveMapping)
  (acCustomAttributes : Array (\Sigma Kername Ident))
