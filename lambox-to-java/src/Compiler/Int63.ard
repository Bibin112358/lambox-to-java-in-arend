\import Arith.Nat
\import Arith.Int (iabs)

-- The primitive integer widths and their normal forms.
--
-- A λ□ `rocqUint63` is MetaRocq's `Uint63` (EPrimitive.v; lean-to-lambdabox:
-- `BitVec 63`): an unsigned 63-bit integer, i.e. a residue mod 2^63. A
-- `javaLong` payload is a 64-bit bit pattern in [0, 2^64), read as a signed
-- JVM `long` by `signed64`.
--
-- One shared definition is used by the compiler (`Compiler/JavaAxioms.ard`,
-- to emit literals), the λ□ oracle (`Semantics/LambdaBoxAxioms.ard`) and the
-- model of the Java runtime (`Semantics/RtInt63.ard`), so that "mod 2^63"
-- means the same thing on both sides of the translation. `Compiler/JavaLong.ard`
-- has its own `wrap64`, on purpose: it models the JVM's rule (JLS 4.2.2).

-- Named for its role: `Compiler/JavaLong.ard`'s `pow2_63` is the same number.
\func int63Mod : Nat => 9223372036854775808

\func int64Mod : Nat => 18446744073709551616

-- The signed reading of a 64-bit bit pattern: the top half of [0, 2^64) is the
-- negatives, which is what a JVM `long` means by the same bits.
\func signed64 (i : Fin int64Mod) : Int =>
  \case (i : Nat) Nat.- int63Mod \with {
    | pos _ => (i : Nat) Nat.- int64Mod   -- i >= 2^63, equality included
    | neg (suc _) => pos i
  }

\func wrap64u (x : Int) : Fin int64Mod \elim x
  | pos n => finMod n
  | neg n => finMod (iabs (int64Mod Nat.- (n Nat.mod int64Mod)))

-- `x` reduced into [0, 2^63), the `Uint63` normal form. It returns a `Fin`,
-- so this is the only way to build a `rocqUint63` payload. No sign
-- reinterpretation: that is the int63/int64 difference. The `neg` clause is
-- reduced mod 2^63 again so that `neg 0` (= `pos 0` definitionally) gives 0.
-- (`finMod` needs no positivity proof: the modulus is a literal.)
\func wrap63 (x : Int) : Fin int63Mod \elim x
  | pos n => finMod n
  | neg n => finMod (iabs (int63Mod Nat.- (n Nat.mod int63Mod)))
