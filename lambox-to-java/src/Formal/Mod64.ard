\import Algebra.Group
\import Algebra.Meta
\import Algebra.Monoid
\import Algebra.Ring
\import Arith.Int
\import Arith.Nat
\import Formal.RtLong (pow2_63, pow2_64, wrap64, readS64, readSigned, negModU64, modU64)
\import Int63 (int63Mod, int64Mod, signed64, wrap64u)
\import Logic
\import Meta
\import Order.Biordered
\import Order.LinearOrder
\import Order.PartialOrder
\import Order.StrictOrder
\import Paths
\import Paths.Meta

-- =============================================================================
-- Arithmetic modulo 2^64, for the i64 entries of `Formal/OracleShipped.ard`.
--
-- The JVM (`Formal/RtLong.ard`'s `wrap64`) and λ□ (`Int63.signed64` of a
-- `wrap64u` bit pattern) both read an integer modulo 2^64, by DIFFERENT
-- functions. That they agree -- and that `wrap64` ignores multiples of 2^64,
-- which is what makes `(signed a) + (signed b)` wrap to the same `long` as
-- `a + b` -- is the content of this file.
--
-- THE MODULUS IS ABSTRACT until the very end. A symbolic `x + 2^64` on `Nat`
-- (or `pos x + pos 2^64` on `Int`, which reduces to it) normalizes by peeling
-- 2^64 `suc`s, which is what exhausted the checker's memory in an earlier
-- version of `Formal/OracleArith.ard`. So the theory is developed for any
-- modulus `suc m`, over `modU`, and `modU64` is identified with its instance
-- only in the last section, where the literal appears nowhere but as an
-- argument.
-- =============================================================================

-- ---------------------------------------------------------------------------
-- Reduction modulo `M`, and its two defining properties.
-- ---------------------------------------------------------------------------

\func negMod (M r : Nat) : Nat \elim r
  | 0 => 0
  | suc k => iabs (M Nat.- suc k)

\func modU (M : Nat) (x : Int) : Nat \elim x
  | pos n => n Nat.mod M
  | neg (suc n) => negMod M (suc n Nat.mod M)

\lemma negMod< (m r : Nat) (hr : r < suc m) : negMod (suc m) r < suc m \elim r
  | 0 => NatOrder.zero<suc
  | suc k =>
    \let | ex : k Nat.+ (m -' k) = m => <=_exists (<=-less (NatOrder.unsuc< hr))
         | ei : iabs (suc m Nat.- suc k) = m -' k => pmap iabs (inv (-'=- (<=-less hr)))
    \in transportInv (__ < suc m) ei (transport (\lam z => m -' k < suc z) ex
          (transport (\lam z => m -' k < suc z) NatSemiring.+-comm (NatSemiring.<=_+ <=-refl zero<=_ <∘r id<suc)))

\lemma modU< (m : Nat) (x : Int) : modU (suc m) x < suc m \elim x
  | pos n => fin_< (n Nat.mod suc m)
  | neg (suc n) => negMod< m _ (fin_< (suc n Nat.mod suc m))

\func negDecomp (M N r d : Nat) (e : M Nat.* d Nat.+ r = N) (hr : r <= M)
  : \Sigma (q : Int) (neg N = pos (negMod M r) + q * pos M) \elim r
  | 0 =>
    (negative (pos d),
     pmap negative (inv (pmap pos e) : pos N = pos M * pos d) *>
     (equation : negative (pos M * pos d) = pos 0 + negative (pos d) * pos M))
  | suc k =>
    \let eM : pos (negMod M (suc k)) = pos M - pos (suc k) => pos_iabs hr
    \in (negative (pos d + 1),
         pmap negative (inv (pmap pos e) : pos N = pos M * pos d + pos (suc k)) *>
         (equation : negative (pos M * pos d + pos (suc k)) = (pos M - pos (suc k)) + negative (pos d + 1) * pos M) *>
         pmap (__ + negative (pos d + 1) * pos M) (inv eM))

\func decomp (m : Nat) (x : Int) : \Sigma (q : Int) (x = pos (modU (suc m) x) + q * pos (suc m)) \elim x
  | pos n =>
    (pos (n Nat.div suc m),
     (inv (pmap pos (Nat.divModProp n (suc m))) : pos n = pos (suc m) * pos (n Nat.div suc m) + pos (n Nat.mod suc m)) *>
     equation)
  | neg (suc n) => negDecomp (suc m) (suc n) (suc n Nat.mod suc m) (suc n Nat.div suc m) (Nat.divModProp (suc n) (suc m))
                             (<=-less (fin_< (suc n Nat.mod suc m)))

-- Two residues in [0, M) that differ by a multiple of `M` are equal: the
-- multiple is 0, since a nonzero one is at least `M` in size.
\lemma resUniq (m : Nat) {r1 r2 : Nat} (h1 : r1 < suc m) (h2 : r2 < suc m) {q1 q2 : Int}
               (e : pos r1 + q1 * pos (suc m) = pos r2 + q2 * pos (suc m)) : r1 = r2 =>
  \let | M => pos (suc m)
       | E : pos r2 - pos r1 = (q1 - q2) * M =>
         (equation : pos r2 - pos r1 = (pos r2 + q2 * M) - q2 * M - pos r1) *>
         pmap (\lam z => z - q2 * M - pos r1) (inv e) *>
         (equation : (pos r1 + q1 * M) - q2 * M - pos r1 = (q1 - q2) * M)
       | i1 : pos r1 IntRing.< M => pos<pos h1
       | i2 : pos r2 IntRing.< M => pos<pos h2
       | z1 : 0 IntRing.<= pos r1 => IntRing.pos>=0
       | z2 : 0 IntRing.<= pos r2 => IntRing.pos>=0
  \in \case q1 - q2 \as d, idp : q1 - q2 = d \with {
    | pos 0, p =>
      \let E0 : pos r2 - pos r1 = pos 0 => E *> pmap (__ * M) p *> (equation : pos 0 * M = pos 0)
      \in pmap iabs (inv (equation : pos r2 - (pos r2 - pos r1) = pos r1) *> pmap (pos r2 -) E0 *> (equation : pos r2 - pos 0 = pos r2))
    | pos (suc j), p =>
      \let | T : (q1 - q2) * M = M + pos j * M => pmap (__ * M) p *> (equation : (pos j + 1) * M = M + pos j * M)
           | nn : 0 IntRing.<= pos j * M => IntRing.pos>=0
      \in absurd linarith
    | neg (suc j), p =>
      \let | T : (q1 - q2) * M = negative (M + pos j * M) =>
             pmap (__ * M) p *> (equation : negative (pos j + 1) * M = negative (M + pos j * M))
           | nn : 0 IntRing.<= pos j * M => IntRing.pos>=0
      \in absurd linarith
  }

-- Adding a multiple of `M` does not change the residue.
\lemma modU-cong (m : Nat) (x k : Int) : modU (suc m) (x + k * pos (suc m)) = modU (suc m) x =>
  \let | d1 => decomp m x
       | d2 => decomp m (x + k * pos (suc m))
       | e : pos (modU (suc m) (x + k * pos (suc m))) + d2.1 * pos (suc m)
           = pos (modU (suc m) x) + (d1.1 + k) * pos (suc m) =>
         inv d2.2 *> pmap (__ + k * pos (suc m)) d1.2 *> equation
  \in resUniq m (modU< m _) (modU< m x) e

-- A value read signed modulo `M` is itself plus a multiple of `M`.
\func readOff (M a : Nat) (d : Int) : \Sigma (k : Int) (readSigned M a d = pos a + k * pos M) \elim d
  | pos _ => (negative (pos 1), equation)
  | neg (suc _) => (0, equation)

-- ---------------------------------------------------------------------------
-- At 2^64.
--
-- `m64` is 2^64 - 1, so that the lemmas above, stated for `suc m`, apply;
-- `suc m64` and `pow2_64` are the same literal to the checker.
-- ---------------------------------------------------------------------------

\func m64 : Nat => 18446744073709551615

\lemma negModU64-eq (r : Nat) : negModU64 r = negMod pow2_64 r \elim r
  | 0 => idp
  | suc k => idp

\lemma modU64-eq (x : Int) : modU64 x = modU pow2_64 x \elim x
  | pos n => idp
  | neg (suc n) => negModU64-eq _

-- `wrap64` ignores multiples of 2^64: the JVM's arithmetic IS modular.
\lemma wrap64-cong (x k : Int) : wrap64 (x + k * pos pow2_64) = wrap64 x =>
  pmap (\lam r => readS64 r (r Nat.- pow2_63)) (modU64-eq _ *> modU-cong m64 x k *> inv (modU64-eq x))

\lemma modU64-cong (x k : Int) : modU64 (x + k * pos pow2_64) = modU64 x =>
  modU64-eq _ *> modU-cong m64 x k *> inv (modU64-eq x)

-- `signed64` with its `\case` turned into `readSigned`, so it can be rewritten.
\lemma signed64-read (i : Fin int64Mod) : signed64 i = readSigned pow2_64 i ((i : Nat) Nat.- int63Mod) =>
  unfold signed64 (cases ((i : Nat) Nat.- int63Mod) \with {
    | pos _ => idp
    | neg (suc _) => idp
  })

\lemma wuNeg (r : Nat) (hr : r < pow2_64) : (finMod {m64} (iabs (int64Mod Nat.- r)) : Nat) = negModU64 r \elim r
  | 0 => id_mod {suc m64}
  | suc k => mod_< (negMod< m64 (suc k) hr)

-- λ□'s bit pattern is the JVM's residue.
\lemma wrap64u-eq (z : Int) : (wrap64u z : Nat) = modU64 z \elim z
  | pos n => idp
  | neg (suc n) => wuNeg (suc n Nat.mod int64Mod) (mod<right {suc n} {suc m64} suc/=0)

-- THE BRIDGE: λ□'s signed reading of its bit pattern is the JVM's `long`.
\lemma signed-wrapu (z : Int) : signed64 (wrap64u z) = wrap64 z =>
  signed64-read (wrap64u z) *> pmap (\lam (r : Nat) => readSigned pow2_64 r (r Nat.- int63Mod)) (wrap64u-eq z)

\lemma wu-id (a : Fin int64Mod) : (wrap64u (pos a) : Nat) = a => fin_mod_id a

\lemma signed-wrap (a : Fin int64Mod) : signed64 a = wrap64 (pos a) =>
  signed64-read a *> pmap (\lam (r : Nat) => readSigned pow2_64 r (r Nat.- int63Mod)) (inv (mod_< (fin_< a)))

\func signed-off (a : Fin int64Mod) : \Sigma (k : Int) (signed64 a = pos a + k * pos pow2_64) =>
  \let o => readOff pow2_64 a ((a : Nat) Nat.- int63Mod)
  \in (o.1, signed64-read a *> o.2)

-- `wrap64` is the identity on a signed reading...
\lemma wrap-signed (a : Fin int64Mod) : wrap64 (signed64 a) = signed64 a =>
  pmap wrap64 (signed-off a).2 *> wrap64-cong (pos a) (signed-off a).1 *> inv (signed-wrap a)

-- ... and the reading loses nothing.
\lemma modU64-signed (a : Fin int64Mod) : modU64 (signed64 a) = a =>
  pmap modU64 (signed-off a).2 *> modU64-cong (pos a) (signed-off a).1 *> mod_< (fin_< a)

\lemma signed64-inj {a b : Fin int64Mod} (e : signed64 a = signed64 b) : (a : Nat) = b =>
  inv (modU64-signed a) *> pmap modU64 e *> modU64-signed b

\lemma signed64-nat {a b : Fin int64Mod} (e : (a : Nat) = b) : signed64 a = signed64 b =>
  signed64-read a *> pmap (\lam (r : Nat) => readSigned pow2_64 r (r Nat.- int63Mod)) e *> inv (signed64-read b)

-- The ring rearrangements the three arithmetic entries need.
\lemma addRe (a b ka kb M : Int) : (a + ka * M) + (b + kb * M) = (a + b) + (ka + kb) * M => equation

\lemma subRe (a b ka kb M : Int) : (a + ka * M) - (b + kb * M) = (a - b) + (ka - kb) * M => equation

\lemma mulRe (a b ka kb M : Int) : (a + ka * M) * (b + kb * M) = a * b + (ka * b + kb * a + ka * kb * M) * M => equation
