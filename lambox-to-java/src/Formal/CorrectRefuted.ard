\import Arith.Nat
\import Data.Bool
\import Data.Maybe
\import Data.String
\import Formal.Correct
\import Formal.CorrectErased (plusComm)
\import Formal.FuelMono
\import Formal.JavaEval
\import Formal.JavaValue
\import Formal.LambdaBoxEval
\import Formal.Res
\import JavaAst
\import LambdaBox
\import Logic
\import Logic.Meta
\import Paths
\import Paths.Meta
\import ToJava

-- =============================================================================
-- `CorrectGeneric` (Formal/Correct.ard) IS FALSE, twice over, and neither
-- counterexample is about the backend.
--
-- Both refute it at the SMALLEST oracle pair -- `lbNone` and a runtime that
-- knows no constant -- where `OracleAgree` holds trivially, so the hypothesis
-- the statement leans on is not what fails. What fails is the statement's
-- claim about EVERY program λ□ can evaluate:
--
--   (A) A PROGRAM WHOSE RESULT IS A FUNCTION. `ValRel` is first-order by design
--       (`agrees` is `false` on every `lambda`), so `\lam x => x` -- which λ□
--       evaluates to itself -- has no related Java value at all, whatever the
--       backend does. The header of `Correct.ard` names this boundary; the
--       theorem did not respect it.
--
--   (B) AN OPEN PROGRAM. `csubst` never lifts (it is the CLOSED substitution,
--       see LambdaBoxEval.ard), so substituting an open value under a binder
--       CAPTURES. In
--
--         ((\x. \z. x box) (\w. #1)) box       -- `#1` a dangling index
--
--       λ□ substitutes `\w. #1` under `\z`, where `#1` now means `z`, and the
--       program evaluates to `box`. The generated Java compiles `#1` in its own
--       scope, where it is unbound (`Rt.unbound`), and calling it throws. No
--       compiler that respects scope can match capture, and MetaRocq's
--       correctness theorems all assume a closed program for this reason.
--
-- The repaired statement is `Formal/CorrectLam.ard`'s: closed programs, and a
-- value relation that also relates closures (so that (A) has a right answer
-- and first-order `ValRel` is recovered for first-order results).
-- =============================================================================

-- A runtime with no constants; `Rt.unbound` & co. throw, as the real ones do.
\func rtThrow : RtSpec \cowith
  | rtField _ => nothing
  | builtinArity _ => nothing
  | builtinRun _ _ => rStuck
  | rtStaticCall _ _ => just (rOk (eExc (vExcObj "java.lang.RuntimeException" "rt")))

-- Nothing on either side, so they agree vacuously.
\func noneAgree : OracleAgree lbNone rtThrow =>
  (\lam kn nm _ => idp, \lam kn nm args jargs v _ _ (p : nothing = just v) => contradiction)

-- ---------------------------------------------------------------------------
-- (A) A higher-order result.
-- ---------------------------------------------------------------------------

\func agreesLambda (n : Nat) (na : BinderName) (b : LBTerm) (jv : Value) : agrees n (lambda na b) jv = false \elim n
  | 0 => idp
  | suc n => idp

\func idProgram : LBProgram => (nil, lambda anon (bvar 0))

\func higherOrderRefutes (h : CorrectGeneric) : Empty =>
  \let r => h lbNone rtThrow noneAgree {idProgram} {lambda anon (bvar 0)} (evalAtomLambda idp)
  \in \case inv (agreesLambda r.3.1 anon (bvar 0) r.1) *> r.3.2 \with {}

-- ---------------------------------------------------------------------------
-- (B) An open program: capture.
-- ---------------------------------------------------------------------------

\func captureProgram : LBProgram =>
  (nil, app (app (lambda anon (lambda anon (app (bvar 1) box))) (lambda anon (bvar 1))) box)

\func captureEvalsToBox : EvalProgram lbNone captureProgram box =>
  evalBeta (evalBeta (evalAtomLambda idp) (evalAtomLambda idp) (evalAtomLambda idp))
           (evalAtomBox idp)
           (evalBeta (evalAtomLambda idp) (evalAtomBox idp) (evalAtomBox idp))

-- The generated class THROWS: the captured `#1` is `Rt.unbound(..)` in Java.
\func captureThrows
  : runClass rtThrow (compileClass progClassName captureProgram) bodyMethodName 30
    = rOk (rvThrown (vExcObj "java.lang.RuntimeException" "rt")) => idp

\func captureRefutes (h : CorrectGeneric) : Empty =>
  \let | r => h lbNone rtThrow noneAgree captureEvalsToBox
       | cls => compileClass progClassName captureProgram
       | n => r.2.1
       -- Both runs, raised to the common clock `n + 30`.
       | pv : runClass rtThrow cls bodyMethodName (n Nat.+ 30) = rOk (rvValue r.1) =>
         runClassMonoPlus rtThrow cls bodyMethodName n 30 _ r.2.2
       | pt : runClass rtThrow cls bodyMethodName (n Nat.+ 30) = rOk (rvThrown (vExcObj "java.lang.RuntimeException" "rt")) =>
         transport (\lam m => runClass rtThrow cls bodyMethodName m = rOk (rvThrown (vExcObj "java.lang.RuntimeException" "rt")))
                   (plusComm 30 n)
                   (runClassMonoPlus rtThrow cls bodyMethodName 30 n _ captureThrows)
  \in \case inv pv *> pt \with {}
