\import Arith.Int
\import Arith.Nat
\import Data.Array (map, ++ \as \infixr 5 ++A)
\import Data.Bool (Bool, true, false, and, if)
\import Data.Maybe
\import Data.String (String, Byte, ++ \as ++S)
\import JavaAst
\import JavaAxioms
\import LambdaBox
\import Mangle
\import NodePath
\import Set
\import StringUtil (lookupKey, lookupBy, lookupStep)
\import ToJava
\import Formal.JavaEval
\import Formal.JavaValue
\import Formal.Res
\import Formal.LambdaBoxEval
\import Formal.RtInt63
\import Formal.RtLong
\import Formal.OracleShipped (kernameEq-sound, noJust)
\import Formal.MangleInj (mangleKername-inj, kn_bytes)
\import Formal.CorrectLam (eqSelf, eqOther)
\import Paths
\import Paths.Meta
\import Meta
\import Logic
\import Function.Meta ($)

-- =============================================================================
-- WHAT A COMPILED CLASS CONTAINS, as the Java evaluator looks it up -- and the
-- facts about the shipped runtime and axiom table that a correctness proof for
-- `const` needs besides.
--
-- `Formal/JavaEval.ard` resolves a static call by `lookupMethod` (the FIRST
-- method of that name, comments skipped); λ□ resolves a `const` by
-- `lookupConstant` (the FIRST declaration whose kername passes `kernameEq`).
-- `ClassOK` says the two scans agree on `compileClass`:
--
--   * a constant with a body is found under its mangled name, and its method
--     body is the compiled body (`ConstMethodBody`);
--   * an axiom the backend realizes is found, and returns its `axiomImpl`;
--   * nothing is called `Long.valueOf`, so that static call falls through to
--     the runtime (`RtSpec.rtStaticCall`) rather than to a generated method.
--
-- `classOK` is one induction on the declaration list. A head entry that fails
-- `kernameEq` MANGLES DIFFERENTLY (`kernameEq` is reflexive, and
-- `mangleKername-inj` from Formal/MangleInj.ard), so `lookupMethodIn` skips
-- it; an inductive compiles to a comment, which it skips too; and the entry
-- that passes is -- by `kernameEq-sound` -- the very kername looked up.
-- `bodyLookup` is the same walk, landing on the trailing `body` method.
--
-- The trailing `body` method never shadows or is shadowed by a constant, and
-- neither it nor any constant is `Long.valueOf`, by FIRST BYTES: a mangled name
-- starts with `c` (99, `kn_bytes`), `body` with `b` (98), `Long.valueOf` with
-- `L` (76). This is `ToJava.bodyMethodName`'s comment, mechanized.
--
-- The remaining two are facts about the SHIPPED instances, stated as
-- contracts (`RtOK`, `AxImplShape`) so that a proof can take them as
-- hypotheses and be discharged here:
--
--   * `rtOKShipped`: `rtInt63` answers `Long.valueOf` as the identity, and
--     every name with an arity is an unapplied builtin (`rtFieldInt63` is
--     DEFINED from `builtinArityShipped`, so this holds as stated);
--   * `axImplShape`: every `axiomImpl` is a field `Rt.<nm>` -- whatever
--     `lookupBy` returns is a table entry (`lookupByAll`), and all 38 entries
--     of `javaAxioms` are `jField rtRef _` (`tableShape`).
--
-- `\case` does not reduce under a hypothesis about its scrutinee, so each
-- tested value is either handed to a helper as a parameter together with its
-- equation (`foundStep`), or rewritten after `unfold`.
-- =============================================================================

\func ConstMethodBody (body : LBTerm) : Array JStmt =>
  appendStmts (compileExpr nil nil body).1 (jReturn (compileExpr nil nil body).2 :: nil)

\func ClassOK (cls : JClass) (genv : GlobalDeclarations) : \Type => \Sigma
  (\Pi (kn : Kername) (cb : ConstantBody) (body : LBTerm) -> lookupConstant genv kn = just cb -> cb.cstBody = just body
     -> \Sigma (m : JMethod) (lookupMethod cls (mangleKername kn) = just m) (JMethod.mBody {m} = ConstMethodBody body))
  (\Pi (kn : Kername) (cb : ConstantBody) (impl : JExpr) -> lookupConstant genv kn = just cb -> cb.cstBody = nothing
     -> axiomImpl kn = just impl
     -> \Sigma (m : JMethod) (lookupMethod cls (mangleKername kn) = just m) (JMethod.mBody {m} = jReturn impl :: nil))
  (lookupMethod cls "Long.valueOf" = nothing)

-- ---------------------------------------------------------------------------
-- `kernameEq` is reflexive, so a kername that fails it mangles differently.
-- ---------------------------------------------------------------------------

\func dirPathEq-refl (a : DirPath) : dirPathEq a a = true \elim a
  | nil => idp
  | x :: a => pmap2 (\lam u v => u and v) (eqSelf x) (dirPathEq-refl a)

\func modPathEq-refl (a : ModPath) : modPathEq a a = true \elim a
  | mpFile p => dirPathEq-refl p
  | mpBound p x n => pmap2 (\lam u v => u and v) (pmap2 (\lam u v => u and v) (dirPathEq-refl p) (eqSelf x)) (eqSelf n)
  | mpDot p x => pmap2 (\lam u v => u and v) (modPathEq-refl p) (eqSelf x)

\func kernameEq-refl (a : Kername) : kernameEq a a = true =>
  pmap2 (\lam u v => u and v) (modPathEq-refl a.kerModPath) (eqSelf a.kerName)

\func mangleMiss {k kn : Kername} (eb : kernameEq k kn = false) : mangleKername k /= mangleKername kn =>
  \lam p => \case inv eb *> transport (\lam z => kernameEq z kn = true) (inv (mangleKername-inj p)) (kernameEq-refl kn) \with {}

-- ---------------------------------------------------------------------------
-- First bytes: a mangled name starts with `c`, `body` with `b`, and
-- `Long.valueOf` with `L`.
-- ---------------------------------------------------------------------------

\func natEqB (a b : Nat) : Bool \elim a, b
  | 0, 0 => true
  | suc a, suc b => natEqB a b
  | _, _ => false

\func headIs (n : Nat) (bs : Array Byte) : Bool \elim bs
  | nil => false
  | b :: _ => natEqB b n

\func mangleNoC (kn : Kername) (s : String) (hs : headIs 99 s.bytes = false) : mangleKername kn /= s =>
  \lam p => \case inv (pmap (headIs 99) (kn_bytes kn)) *> pmap (\lam (t : String) => headIs 99 t.bytes) p *> hs \with {}

\func bodyNeLV : bodyMethodName /= "Long.valueOf" =>
  \lam p => \case (pmap (\lam (t : String) => headIs 98 t.bytes) p : true = false) \with {}

-- ---------------------------------------------------------------------------
-- One step of `lookupMethodIn`: a member named differently (or a comment) is
-- skipped, a method with the name is found.
-- ---------------------------------------------------------------------------

\func NamedAs (x : JMember) (nm : JIdent) : \Set0 \elim x
  | jMethod m => JMethod.mName {m} = nm
  | jMemberComment _ => \Sigma

\func skipMember (x : JMember) (rest : Array JMember) {n2 nm : JIdent} (h : NamedAs x n2) (ne : n2 /= nm)
  : lookupMethodIn (x :: rest) nm = lookupMethodIn rest nm \elim x
  | jMethod m => rewrite (eqOther {_} {JMethod.mName {m}} {nm} (\lam p => ne (inv h *> p))) idp
  | jMemberComment _ => idp

\func hitMember (m : JMethod) (rest : Array JMember) (nm : JIdent) (h : JMethod.mName {m} = nm)
  : lookupMethodIn (jMethod m :: rest) nm = just m =>
  rewrite (transport (\lam z => (z == nm) = true) (inv h) (eqSelf nm)) idp

-- ---------------------------------------------------------------------------
-- What one declaration compiles to.
-- ---------------------------------------------------------------------------

\func axDecl (k : Kername) (impl : JExpr) (e : axiomImpl k = just impl)
  : compileDecl (k, constantDecl (\new ConstantBody nothing)) = constMethod (mangleKername k) (jReturn impl :: nil) =>
  unfold compileDecl (rewrite e idp)

\func axNamed (k : Kername) (ai : Maybe JExpr) (e : axiomImpl k = ai)
  : NamedAs (compileDecl (k, constantDecl (\new ConstantBody nothing))) (mangleKername k) \elim ai
  | just impl => unfold compileDecl (rewrite e idp)
  | nothing => unfold compileDecl (rewrite e idp)

\func constNamed (k : Kername) (mb : Maybe LBTerm)
  : NamedAs (compileDecl (k, constantDecl (\new ConstantBody mb))) (mangleKername k) \elim mb
  | just b => idp
  | nothing => axNamed k (axiomImpl k) idp

\func declNamed (k : Kername) (g : GlobalDecl) : NamedAs (compileDecl (k, g)) (mangleKername k) \elim g
  | constantDecl cb => constNamed k cb.cstBody
  | inductiveDecl _ => ()

\func declBody (k : Kername) (cb : ConstantBody) (body : LBTerm) (e : cb.cstBody = just body)
  : compileDecl (k, constantDecl cb) = constMethod (mangleKername k) (ConstMethodBody body) =>
  transport (\lam z => compileDecl (k, constantDecl (\new ConstantBody z)) = constMethod (mangleKername k) (ConstMethodBody body))
    (inv e) idp

\func declAx (k : Kername) (cb : ConstantBody) (impl : JExpr) (e1 : cb.cstBody = nothing) (e2 : axiomImpl k = just impl)
  : compileDecl (k, constantDecl cb) = constMethod (mangleKername k) (jReturn impl :: nil) =>
  transport (\lam z => compileDecl (k, constantDecl (\new ConstantBody z)) = constMethod (mangleKername k) (jReturn impl :: nil))
    (inv e1) (axDecl k impl e2)

-- ---------------------------------------------------------------------------
-- One step of `lookupEnv` / `lookupConstant`.
-- ---------------------------------------------------------------------------

\func envMiss (e : \Sigma Kername GlobalDecl) (env : GlobalDeclarations) (kn : Kername) (h : kernameEq e.1 kn = false)
  : lookupEnv (e :: env) kn = lookupEnv env kn =>
  rewrite h idp

\func envHit (e : \Sigma Kername GlobalDecl) (env : GlobalDeclarations) (kn : Kername) (h : kernameEq e.1 kn = true)
  : lookupEnv (e :: env) kn = just e.2 =>
  rewrite h idp

\func lcMiss (e : \Sigma Kername GlobalDecl) (env : GlobalDeclarations) (kn : Kername) (h : kernameEq e.1 kn = false)
  : lookupConstant (e :: env) kn = lookupConstant env kn =>
  unfold lookupConstant (rewrite (envMiss e env kn h) idp)

\func lcHitC (k : Kername) (cb : ConstantBody) (env : GlobalDeclarations) (kn : Kername) (h : kernameEq k kn = true)
  : lookupConstant ((k, constantDecl cb) :: env) kn = just cb =>
  unfold lookupConstant (rewrite (envHit (k, constantDecl cb) env kn h) idp)

\func lcHitI (k : Kername) (mi : MutualInductiveBody) (env : GlobalDeclarations) (kn : Kername) (h : kernameEq k kn = true)
  : lookupConstant ((k, inductiveDecl mi) :: env) kn = nothing =>
  unfold lookupConstant (rewrite (envHit (k, inductiveDecl mi) env kn h) idp)

-- ---------------------------------------------------------------------------
-- The members of a compiled program.
-- ---------------------------------------------------------------------------

-- Where `lookupConstant` finds `cb`, `lookupMethodIn` reaches the compiled
-- declaration of `cb`: every earlier member is skipped.
\func FoundAt (ms : Array JMember) (kn : Kername) (cb : ConstantBody) : \Type =>
  \Sigma (rest : Array JMember)
         (lookupMethodIn ms (mangleKername kn) = lookupMethodIn (compileDecl (kn, constantDecl cb) :: rest) (mangleKername kn))

\func foundStep (k : Kername) (g : GlobalDecl) (ds : GlobalDeclarations) (tl : Array JMember) (kn : Kername) (cb : ConstantBody)
  (h1 : lookupConstant ((k, g) :: ds) kn = just cb)
  (ih : lookupConstant ds kn = just cb -> FoundAt (compileDecls ds ++A tl) kn cb)
  (b : Bool) (eb : kernameEq k kn = b)
  : FoundAt (compileDecl (k, g) :: (compileDecls ds ++A tl)) kn cb \elim g, b
  | g, false =>
    \let r => ih (inv (lcMiss (k, g) ds kn eb) *> h1)
    \in (r.1, skipMember (compileDecl (k, g)) (compileDecls ds ++A tl) (declNamed k g) (mangleMiss eb) *> r.2)
  | constantDecl cb', true =>
    (compileDecls ds ++A tl,
     pmap (\lam x => lookupMethodIn (x :: (compileDecls ds ++A tl)) (mangleKername kn))
       (pmap2 (\lam k' c => compileDecl (k', constantDecl c)) (kernameEq-sound eb) (just-injective (inv (lcHitC k cb' ds kn eb) *> h1))))
  | inductiveDecl mi, true => absurd (noJust (inv (lcHitI k mi ds kn eb) *> h1))

\func foundC (ds : GlobalDeclarations) (tl : Array JMember) (kn : Kername) (cb : ConstantBody)
  (h1 : lookupConstant ds kn = just cb) : FoundAt (compileDecls ds ++A tl) kn cb \elim ds
  | nil => absurd (noJust h1)
  | (k, g) :: ds => foundStep k g ds tl kn cb h1 (foundC ds tl kn cb) (kernameEq k kn) idp

-- No compiled declaration is called `nm` when no mangled name is.
\func skipDecls (ds : GlobalDeclarations) (tl : Array JMember) (nm : JIdent) (ne : \Pi (k : Kername) -> mangleKername k /= nm)
  : lookupMethodIn (compileDecls ds ++A tl) nm = lookupMethodIn tl nm \elim ds
  | nil => idp
  | (k, g) :: ds => skipMember (compileDecl (k, g)) (compileDecls ds ++A tl) (declNamed k g) (ne k) *> skipDecls ds tl nm ne

\func classOK (name : JIdent) (p : LBProgram) : ClassOK (compileClass name p) p.1 =>
  (\lam kn cb body h1 h2 =>
     \let r => foundC p.1 (compileBody p.2) kn cb h1
     \in (\new JMethod (mangleKername kn) (ConstMethodBody body),
          r.2 *> pmap (\lam x => lookupMethodIn (x :: r.1) (mangleKername kn)) (declBody kn cb body h2)
              *> hitMember (\new JMethod (mangleKername kn) (ConstMethodBody body)) r.1 (mangleKername kn) idp,
          idp),
   \lam kn cb impl h1 h2 h3 =>
     \let r => foundC p.1 (compileBody p.2) kn cb h1
     \in (\new JMethod (mangleKername kn) (jReturn impl :: nil),
          r.2 *> pmap (\lam x => lookupMethodIn (x :: r.1) (mangleKername kn)) (declAx kn cb impl h2 h3)
              *> hitMember (\new JMethod (mangleKername kn) (jReturn impl :: nil)) r.1 (mangleKername kn) idp,
          idp),
   skipDecls p.1 (compileBody p.2) "Long.valueOf" (\lam k => mangleNoC k "Long.valueOf" idp)
     *> skipMember (constMethod bodyMethodName (ConstMethodBody p.2)) nil {bodyMethodName} idp bodyNeLV)

\func bodyLookup (name : JIdent) (p : LBProgram)
  : \Sigma (m : JMethod) (lookupMethod (compileClass name p) bodyMethodName = just m) (JMethod.mBody {m} = ConstMethodBody p.2) =>
  (\new JMethod bodyMethodName (ConstMethodBody p.2),
   skipDecls p.1 (compileBody p.2) bodyMethodName (\lam k => mangleNoC k bodyMethodName idp)
     *> hitMember (\new JMethod bodyMethodName (ConstMethodBody p.2)) nil bodyMethodName idp,
   idp)

\func RtOK (rt : RtSpec) : \Type => \Sigma
  (\Pi (x : Int) -> rtStaticCall {rt} "Long.valueOf" (vLong x :: nil) = just (rOk (eVal (vLong x))))
  (\Pi (nm : JIdent) (k : Nat) -> builtinArity {rt} nm = just k -> rtField {rt} nm = just (vBuiltin nm nil))

\func fieldOK (nm : JIdent) (k : Nat) (h : builtinArityShipped nm = just k) : rtFieldInt63 nm = just (vBuiltin nm nil) =>
  unfold rtFieldInt63 (rewrite h idp)

\func valueOfOK (x : Int) : rtStaticCallLong "Long.valueOf" (vLong x :: nil) = just (rOk (eVal (vLong x))) => idp

\func rtOKShipped : RtOK rtInt63 =>
  (valueOfOK, fieldOK)

\func AxImplShape : \Type => \Pi (kn : Kername) (impl : JExpr) -> axiomImpl kn = just impl -> \Sigma (nm : JIdent) (impl = jField rtRef nm)

-- Whatever `lookupBy` returns is a table entry, so it has every property all
-- entries have.
\func lookupStepAll {A : \Type} (P : A -> \Type) (x : A) (b : Bool) (rest : Maybe A) (px : P x)
  (ih : \Pi (e : A) -> rest = just e -> P e) (e : A) (h : lookupStep x b rest = just e) : P e \elim b
  | true => transport P (just-injective h) px
  | false => ih e h

\func lookupByAll {K : DecSet} {A : \Type} (P : A -> \Type) (key : A -> K) (k : K) (tbl : Array A)
  (all : \Pi (i : Fin tbl.len) -> P (tbl i)) (e : A) (h : lookupBy key k tbl = just e) : P e \elim tbl
  | nil => absurd (noJust h)
  | x :: tbl => lookupStepAll P x (key x == k) (lookupBy key k tbl) (all 0)
                  (lookupByAll P key k tbl (\lam i => all (suc i))) e h

\func mapSndAll {A B : \Type} (P : B -> \Type) (m : Maybe (\Sigma A B)) (all : \Pi (e : \Sigma A B) -> m = just e -> P e.2)
  (v : B) (h : Maybe.map (\lam (e : \Sigma A B) => e.2) m = just v) : P v \elim m
  | nothing => absurd (noJust h)
  | just e => transport P (just-injective h) (all e idp)

\func FieldShape (ex : JExpr) : \Type => \Sigma (nm : JIdent) (ex = jField rtRef nm)

\func tableShape (i : Fin javaAxioms.len) : FieldShape (javaAxioms i).2 \elim i
  | 0 => (_, idp) | 1 => (_, idp) | 2 => (_, idp) | 3 => (_, idp) | 4 => (_, idp)
  | 5 => (_, idp) | 6 => (_, idp) | 7 => (_, idp) | 8 => (_, idp) | 9 => (_, idp)
  | 10 => (_, idp) | 11 => (_, idp) | 12 => (_, idp) | 13 => (_, idp) | 14 => (_, idp)
  | 15 => (_, idp) | 16 => (_, idp) | 17 => (_, idp) | 18 => (_, idp) | 19 => (_, idp)
  | 20 => (_, idp) | 21 => (_, idp) | 22 => (_, idp) | 23 => (_, idp) | 24 => (_, idp)
  | 25 => (_, idp) | 26 => (_, idp) | 27 => (_, idp) | 28 => (_, idp) | 29 => (_, idp)
  | 30 => (_, idp) | 31 => (_, idp) | 32 => (_, idp) | 33 => (_, idp) | 34 => (_, idp)
  | 35 => (_, idp) | 36 => (_, idp) | 37 => (_, idp)

\func axImplShape : AxImplShape => \lam kn impl h =>
  mapSndAll FieldShape
    (lookupBy (\lam (e : \Sigma String JExpr) => e.1) (mangleKername kn)
      (map (\lam (e : \Sigma Kername JExpr) => (mangleKername e.1, e.2)) javaAxioms))
    (\lam e he => lookupByAll (\lam (e : \Sigma String JExpr) => FieldShape e.2) (\lam (e : \Sigma String JExpr) => e.1)
                    (mangleKername kn) (map (\lam (e : \Sigma Kername JExpr) => (mangleKername e.1, e.2)) javaAxioms)
                    (\lam i => tableShape i) e he)
    impl h
