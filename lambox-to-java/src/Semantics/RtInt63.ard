\import Arith.Nat
\import Data.Bool
\import Data.Maybe
\import Data.String
\import Semantics.JavaValue
\import Semantics.Res
\import Semantics.RtLong (mkBool, rtStaticCallLong, builtinArityLong, builtinRunLong)
\import Compiler.Int63
\import Compiler.JavaAst
\import Compiler.JavaLong (longOfUint63)
\import Set
\import Compiler.StringUtil (intEqB)

-- `rtInt63`, the runtime model (instance of `RtSpec`) of the correctness
-- theorem: the `Rt.PRIM_*_INT63` family, layered over `Semantics/RtLong.ard`
-- for all other constants.
--
-- It normalizes with `Compiler/Int63.ard`'s `wrap63`, the same function the λ□
-- oracle (`Semantics/LambdaBoxAxioms.ard`) uses for `prim_*_int`, so the
-- runtime computes what the source language says. `Proof/OracleShipped.ard`
-- proves that `lbAxioms` and `rtInt63` agree on every axiom the backend emits.
--
-- In `Rt.java` a `Uint63` is a `long` in [0, 2^63); `long` arithmetic is
-- mod 2^64, and masking with 2^63-1 makes it mod 2^63 (one AND per operation).
-- The Lean-derived operations stay on the `_LONG` constants: they cannot leave
-- [0, 2^63) on in-range arguments (`Nat.add`/`Nat.mul`, which can, use INT63).

-- The four operations `Rt.PRIM_*_INT63` provides, all binary.
\func builtinArityInt63 (f : JIdent) : Maybe Nat =>
  \case f == "PRIM_ADD_INT63" \with { | true => just 2 | false =>
  \case f == "PRIM_SUB_INT63" \with { | true => just 2 | false =>
  \case f == "PRIM_MUL_INT63" \with { | true => just 2 | false =>
  \case f == "PRIM_EQB_INT63" \with { | true => just 2 | false => nothing } } } }

-- The whole runtime: the int63 family first, then everything `rtLong` models
-- (the generator emits both families, see `Compiler/JavaAxioms.ard`).
\func builtinArityShipped (f : JIdent) : Maybe Nat =>
  \case builtinArityInt63 f \with {
    | just k => just k
    | nothing => builtinArityLong f
  }

\func builtinRunShipped (f : JIdent) (vs : Array Value) : Res Value =>
  \case builtinArityInt63 f \with {
    | just _ => builtinRunInt63 f vs
    | nothing => builtinRunLong f vs
  }

\func rtFieldInt63 (f : JIdent) : Maybe Value =>
  \case builtinArityShipped f \with {
    | just _ => just (vBuiltin f nil)
    | nothing => nothing
  }

-- Arguments and result are normalized, mirroring `u63()` and the trailing mask
-- in `Rt.java`: a negative `long` is read modulo 2^63.
\func builtinRunInt63 (f : JIdent) (vs : Array Value) : Res Value =>
  \case vs \with {
    | vLong x :: vLong y :: nil =>
      \let | a => wrap63 x.1
           | b => wrap63 y.1
      \in
      \case f == "PRIM_ADD_INT63" \with {
        | true => rOk (vLong (longOfUint63 (wrap63 (pos (a Nat.+ b))))) | false =>
      \case f == "PRIM_MUL_INT63" \with {
        | true => rOk (vLong (longOfUint63 (wrap63 (pos (a Nat.* b))))) | false =>
      -- Unsigned wraparound: 1 - 2 is 2^63-1.
      \case f == "PRIM_SUB_INT63" \with {
        | true => rOk (vLong (longOfUint63 (wrap63 (a Nat.- b)))) | false =>
      \case f == "PRIM_EQB_INT63" \with {
        | true => rOk (mkBool (intEqB (pos a) (pos b))) | false => rStuck
      } } } }
    | _ => rStuck
  }

-- The static methods are shared with `rtLong`.
\instance rtInt63 : RtSpec
  | rtField => rtFieldInt63
  | builtinArity => builtinArityShipped
  | builtinRun => builtinRunShipped
  | rtStaticCall => rtStaticCallLong
