\import Data.Bool
-- Only the append, aliased: Data.Array's `++` would clash with String's.
\import Data.Array (++ \as \infixr 5 ++A)
\import Data.Maybe
\import Data.String
\import Semantics.Res
\import Compiler.JavaAst
\import Compiler.JavaLong (JLong)
\import Set
\import Compiler.StringUtil

-- Values, outcomes and the runtime interface of the Java fragment's semantics.
-- `Semantics/JavaEval.ard` is the evaluator; this is split off because the
-- runtime interface `RtSpec`, a parameter of every rule, mentions `Value`.
--
-- There is no store: the generated code never mutates anything (`fix` is a
-- local class, and `JStmt` has no assignment), so values are immutable, a
-- `Data`'s fields are values, and the semantics is an environment semantics.
--
-- Sources: ClightBigstep.v (`outcome` ~ `StmtOut`); CompCert's `Events.v`
-- `external_call` (the semantics quantifies over the runtime, `RtSpec`,
-- instead of defining it); the fuel discipline of `Semantics/Res.ard`.

-- Every value the fragment can produce, and nothing else. Every static type in
-- the fragment is `Object`, so this is one flat sum rather than a hierarchy.
\data Value
  -- `Rt.BOX`, an erased proof or type. Identity-based in Java (`new Object()`),
  -- but nothing in the fragment tests identity, so one atom is faithful.
  | vBox
  -- `new Rt.Data(tag, new Object[]{ .. })`: a constructor application.
  | vData (tag : Nat) (fields : Array Value)
  -- `new Rt.Fn(){ public Object apply(Object p){ body } }`. The environment is
  -- captured by value at creation (JLS 15.9.5, 4.12.4). `Env` cannot be named
  -- yet (it is defined below, in terms of `Value`), so it is spelled out.
  | vClos (param : JIdent) (body : Array JStmt) (cenv : Array (\Sigma JIdent Value))
  -- A `fix` local class: its name, its methods (name, parameter, body) and
  -- the environment captured at the declaration. The same value stands for
  -- the class (bound by `jLocalClass`) and its instances (`new C()`): they
  -- have no state and nothing compares references. See `jInvoke` in
  -- Semantics/JavaEval.ard.
  | vObj (cname : JQIdent)
         (methods : Array (\Sigma JIdent JIdent (Array JStmt)))
         (cenv : Array (\Sigma JIdent Value))
  -- A runtime constant of `Rt` that is an `Fn`, with the arguments it has
  -- collected so far. `Rt.PRIM_ADD_LONG` is an `Fn` returning an `Fn`, so
  -- applying it accumulates arguments until `builtinArity` is reached.
  | vBuiltin (name : JIdent) (got : Array Value)
  -- The class `Rt` as a receiver (`jStatic "Rt"`). Not a first-class value in
  -- Java either -- it only ever appears to the left of a field access.
  | vStaticRef JQIdent
  -- `Long.valueOf(5L)`: a boxed `long`, in [-2^63, 2^63) by construction
  -- (`Compiler/JavaLong.ard`). The fragment never computes on longs; all
  -- arithmetic is in the runtime model, which wraps like Java.
  | vLong JLong
  | vStr String
  -- `d.tag == n` (JLS 15.21.1). The fragment's only boolean, and it exists only
  -- to be the condition of a `jCond`.
  | vBool Bool
  -- An exception OBJECT, not a thrown state: `new RuntimeException("..")`.
  -- Throwing it is a `StmtOut`.
  | vExcObj (excClass : JQIdent) (msg : String)

-- What a literal denotes.
\func litValue (l : JLit) : Value
  | litStr s => vStr s
  | litLong i => vLong i

\func Env => Array (\Sigma JIdent Value)

-- How an expression finished: with a value, or by throwing.
\data ExprOut | eVal Value | eExc Value

-- How an argument list finished: all values, or the first throw.
\data ArgsOut | aVals (Array Value) | aExc Value

-- How a statement finished (ClightBigstep's `outcome`, Java-specialised: no
-- break, no continue -- `JStmt` has no loop and no switch -- plus a throw).
--
-- `oNormal` carries the environment out, because `jLocal` extends the scope of
-- the statements after it.
\data StmtOut | oNormal Env | oReturn Value | oExcS Value

-- ---------------------------------------------------------------------------
-- Small helpers (lookups from `Compiler/StringUtil.ard`).
-- ---------------------------------------------------------------------------

\func snocArr {A : \Type} (xs : Array A) (y : A) : Array A => xs ++A (y :: nil)

\func lookupVar (env : Env) (x : JIdent) : Maybe Value => lookupKey x env

-- The newest binding wins. (Generated code never shadows, see
-- Proof/NodePathUnique.ard, but the semantics does not rely on it.)
\func bindVar (env : Env) (x : JIdent) (v : Value) : Env => (x, v) :: env

-- A method of a `fix` local class by name: its (parameter, body).
\func lookupClassMethod (ms : Array (\Sigma JIdent JIdent (Array JStmt))) (nm : JIdent)
  : Maybe (\Sigma JIdent (Array JStmt)) =>
  Maybe.map (\lam m => (m.2, m.3)) (lookupBy (\lam m => m.1) nm ms)

-- ---------------------------------------------------------------------------
-- The runtime interface
--
-- `runtime/Rt.java` uses far more Java than the fragment (interfaces, loops,
-- arithmetic, `Thread`), so it is not interpreted: it is a PARAMETER, and this
-- class is its contract (as CompCert treats `external_call`, and Malfunction
-- OCaml primitives). Its correctness is thus a hypothesis of the theorem; the
-- instances are models in `Semantics/RtInt63.ard` and `Semantics/RtLong.ard`.
-- Anything an instance does not cover is `nothing`, hence stuck.
\class RtSpec
  -- The value of the field `Rt.<name>`: `PRIM_ADD_LONG`, `NAT_SUB_LONG`, ...
  -- (`Rt.BOX` is not here: `jBox` is a node of its own.)
  | rtField : JIdent -> Maybe Value
  -- How many arguments `Rt.<name>` collects before it computes.
  | builtinArity : JIdent -> Maybe Nat
  -- Run a saturated builtin; the array has length `builtinArity name`.
  | builtinRun : JIdent -> Array Value -> Res Value
  -- A static method of the runtime called by name: `Rt.unbound`, `Rt.freeVar`,
  -- `Rt.noBranch` (each throws, by construction), `Long.valueOf` (the identity
  -- on a boxed long). An `ExprOut`, so that an instance can say "this throws"
  -- without the evaluator naming runtime members.
  | rtStaticCall : JQIdent -> Array Value -> Maybe (Res ExprOut)
