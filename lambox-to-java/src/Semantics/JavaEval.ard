\import Arith.Nat   -- the `DecSet Nat` instance behind `==` on tags and arities
\import Data.Bool
\import Data.Maybe
\import Data.String
\import Compiler.JavaAst
\import Semantics.Res
\import Semantics.JavaValue
\import Set
\import Compiler.StringUtil

-- The semantics of the Java fragment (`Compiler/JavaAst.ard`): a functional
-- big-step evaluator with fuel, the target side of the correctness theorem.
-- Values and the runtime interface `RtSpec` are in `Semantics/JavaValue.ard`.
--
-- A function rather than a relation, so it can be run on generated programs
-- (and compared with `javac` + `java`): the functional big-step style of
-- Owens et al. (ESOP 2016, as in CakeML), where divergence is "out of fuel for
-- every fuel". `JEval` at the end recovers a relation. Java fixes evaluation
-- order left to right (JLS 15.7), so the evaluator is deterministic; rules
-- cite the JLS.
--
-- Every constructor of `JExpr`/`JStmt`/`JType`/`JMember` has a clause, and the
-- fragment is closed, so no unmodelled Java can appear. Outside this model
-- are the trusted printer `Compiler/JavaPrint.ard` (e.g. `litStr` is not
-- escaped) and the runtime `runtime/Rt.java` (the parameter `RtSpec`).
--
-- Names are resolved as in Java (JLS 6.5): variables and types live in
-- separate namespaces of one environment (`Key` in Semantics/JavaValue.ard),
-- and a type name means a local class in scope before a top-level class.
--
-- The observable is the value returned by the entry method (`body`) or the
-- exception it throws. Programs `javac` rejects (an unknown name, a cast of a
-- non-object, `throw` of a non-`Throwable`) are `rStuck`, and so are four
-- shapes the generator never emits, marked at their clauses: `jField` on a
-- non-`Rt` receiver, `jNew` of anything but a local class or an exception,
-- `jInvoke` with other than one argument, and a call of a generated method
-- with arguments.

-- ---------------------------------------------------------------------------
-- Class-level lookup: one flat method table (cf. Featherweight Java's `CT`).
-- ---------------------------------------------------------------------------

-- Not `StringUtil.lookupBy`: a member is a method or a comment, so there is no
-- key function.
\func lookupMethodIn (ms : Array JMember) (nm : JIdent) : Maybe JMethod \elim ms
  | nil => nothing
  | jMethod m :: ms => \case JMethod.mName {m} == nm \with {
    | true => just m
    | false => lookupMethodIn ms nm
  }
  | jMemberComment _ :: ms => lookupMethodIn ms nm

\func lookupMethod (cls : JClass) (nm : JIdent) : Maybe JMethod =>
  lookupMethodIn (JClass.classMembers {cls}) nm

-- ---------------------------------------------------------------------------
-- Classes: name resolution (JLS 6.5.5), the class table, casts (JLS 5.5.3).
--
-- The class table below must match the JDK and `runtime/Rt.java`; like
-- `RtSpec`, it is trusted.
-- ---------------------------------------------------------------------------

-- The top-level classes the fragment may name, under each spelling: the
-- source name, the simple name that a local class of that name would shadow
-- (`Rt.Fn` is resolved as `Rt`, then its member `Fn`: JLS 6.5.5.2), the class.
\func knownClasses : Array (\Sigma JQIdent JIdent ClassId) =>
  ("Object", "Object", cObject) :: ("java.lang.Object", "java", cObject) ::
  ("Long", "Long", cLong) :: ("java.lang.Long", "java", cLong) ::
  ("String", "String", cString) :: ("java.lang.String", "java", cString) ::
  ("Rt.Fn", "Rt", cRtFn) :: ("Rt.Data", "Rt", cRtData) ::
  ("Throwable", "Throwable", cThrowable) :: ("java.lang.Throwable", "java", cThrowable) ::
  ("Exception", "Exception", cException) :: ("java.lang.Exception", "java", cException) ::
  ("RuntimeException", "RuntimeException", cRuntimeException) ::
  ("java.lang.RuntimeException", "java", cRuntimeException) ::
  ("IllegalStateException", "IllegalStateException", cIllegalState) ::
  ("java.lang.IllegalStateException", "java", cIllegalState) ::
  ("ClassCastException", "ClassCastException", cClassCast) ::
  ("java.lang.ClassCastException", "java", cClassCast) ::
  ("IndexOutOfBoundsException", "IndexOutOfBoundsException", cIndexOutOfBounds) ::
  ("java.lang.IndexOutOfBoundsException", "java", cIndexOutOfBounds) ::
  ("ArrayIndexOutOfBoundsException", "ArrayIndexOutOfBoundsException", cArrayIndexOutOfBounds) ::
  ("java.lang.ArrayIndexOutOfBoundsException", "java", cArrayIndexOutOfBounds) :: nil

-- What a type name denotes here: a local class in scope, else a known class
-- that no local class shadows. `nothing` is a name `javac` would reject.
\func resolveType (env : Env) (t : JType) : Maybe ClassId \elim t
  | tClass q => resolveWith env (lookupType env q) (lookupBy (\lam e => e.1) q knownClasses)
  \where {
    -- The lookups are parameters rather than `\case`s, so that a proof holding
    -- their results can rewrite with them.
    \func resolveWith (env : Env) (local : Maybe Value) (known : Maybe (\Sigma JQIdent JIdent ClassId))
      : Maybe ClassId \elim local, known
      | just (vObj c _ _), _ => just (cLocal c)
      | just _, _ => nothing                    -- only `jLocalClass` binds a type
      | nothing, just e => unlessShadowed (lookupType env e.2) e.3
      | nothing, nothing => nothing

    \func unlessShadowed (shadow : Maybe Value) (c : ClassId) : Maybe ClassId \elim shadow
      | nothing => just c
      | just _ => nothing
  }

-- The supertypes of a class, itself included (JLS 4.10.2): `Rt.Fn` is an
-- interface that closures, `Rt.BOX` and the runtime constants implement;
-- `Rt.Data`, `Long` and `String` are final; local classes extend `Object`.
\func supertypes (c : ClassId) : Array ClassId
  | cObject => cObject :: nil
  | cLong => cLong :: cObject :: nil
  | cString => cString :: cObject :: nil
  | cRtFn => cRtFn :: cObject :: nil
  | cRtData => cRtData :: cObject :: nil
  | cAnonFn => cAnonFn :: cRtFn :: cObject :: nil
  | cThrowable => cThrowable :: cObject :: nil
  | cException => cException :: cThrowable :: cObject :: nil
  | cRuntimeException => cRuntimeException :: cException :: cThrowable :: cObject :: nil
  | cIllegalState => cIllegalState :: cRuntimeException :: cException :: cThrowable :: cObject :: nil
  | cClassCast => cClassCast :: cRuntimeException :: cException :: cThrowable :: cObject :: nil
  | cIndexOutOfBounds => cIndexOutOfBounds :: cRuntimeException :: cException :: cThrowable :: cObject :: nil
  | cArrayIndexOutOfBounds =>
    cArrayIndexOutOfBounds :: cIndexOutOfBounds :: cRuntimeException :: cException :: cThrowable :: cObject :: nil
  | cLocal x => cLocal x :: cObject :: nil

\func sameClass (c d : ClassId) : Bool
  | cLocal x, cLocal y => x == y
  | cLocal _, _ => false
  | _, cLocal _ => false
  | c, d => classCode c == classCode d
  \where
    \func classCode (c : ClassId) : Nat
      | cObject => 0 | cLong => 1 | cString => 2 | cRtFn => 3 | cRtData => 4 | cAnonFn => 5
      | cThrowable => 6 | cException => 7 | cRuntimeException => 8 | cIllegalState => 9
      | cClassCast => 10 | cIndexOutOfBounds => 11 | cArrayIndexOutOfBounds => 12 | cLocal _ => 13

\func subclassOf (c d : ClassId) : Bool => anyClass (supertypes c) d
  \where
    \func anyClass (cs : Array ClassId) (d : ClassId) : Bool \elim cs
      | nil => false
      | c :: cs => sameClass c d or anyClass cs d

-- The class of a value. `nothing` for what is not an object: the class `Rt`
-- as a receiver, and a `boolean`.
\func runtimeClass (v : Value) : Maybe ClassId
  | vBox => just cAnonFn
  | vData _ _ => just cRtData
  | vClos _ _ _ => just cAnonFn
  | vObj c _ _ => just (cLocal c)
  | vBuiltin _ _ => just cAnonFn
  | vStaticRef _ => nothing
  | vLong _ => just cLong
  | vStr _ => just cString
  | vBool _ => nothing
  | vExcObj c _ => just c

-- `v instanceof d`, for an object `v`.
\func instanceOf (v : Value) (d : ClassId) : Maybe Bool => Maybe.map (\lam c => subclassOf c d) (runtimeClass v)

-- `(T) v` succeeds iff the class of `v` is a subtype of the class `T` names
-- (JLS 5.5.3; the JVM's `checkcast`), and throws `ClassCastException` if not.
-- `nothing`: `T` names no class, or `v` is no object -- `javac` rejects both.
\func castOk (env : Env) (t : JType) (v : Value) : Maybe Bool => castTo (resolveType env t) v
  \where
    \func castTo (target : Maybe ClassId) (v : Value) : Maybe Bool \elim target
      | just d => instanceOf v d
      | nothing => nothing

\func excCCE : Value => vExcObj cClassCast "cast failed"

-- What follows a cast, given `castOk`: go on with `k`, throw, or stuck. A
-- function rather than a `\case`, so that proofs can rewrite `castOk`.
\func afterCast (ok : Maybe Bool) (k : Res ExprOut) : Res ExprOut \elim ok
  | just true => k
  | just false => rOk (eExc excCCE)
  | nothing => rStuck

\func excAIOOBE : Value => vExcObj cArrayIndexOutOfBounds "index"

-- ---------------------------------------------------------------------------
-- The evaluator.
--
-- Fuel (`n`) is the first `\elim` argument and decreases at every call of the
-- mutual cycle, so termination is structural on it (and, unlike in the
-- compiler, array helpers such as `evalArgs` are fine).
-- ---------------------------------------------------------------------------

\func evalExpr (rt : RtSpec) (cls : JClass) (n : Nat) (env : Env) (e : JExpr)
  : Res ExprOut \elim n, e
  | 0, _ => rOutOfFuel

  -- Literals (JLS 3.10) and the erased-value atom.
  | suc _, jLit l => rOk (eVal (litValue l))
  | suc _, jBox => rOk (eVal vBox)

  -- A local or a parameter. Unbound is `rStuck` (`javac` would reject it).
  | suc _, jVar x => \case lookupVar env x \with {
    | nothing => rStuck
    | just v => rOk (eVal v)
  }

  -- `Rt` as a receiver. The generator only emits `jStatic runtimeClassName`.
  | suc _, jStatic q => rOk (eVal (vStaticRef q))

  -- A closure; the environment is captured by value (JLS 15.9.5, 4.12.4).
  | suc _, jClosure p body => rOk (eVal (vClos p body env))

  -- `C.this` from inside a nested anonymous class (JLS 15.8.4). `C` is a type
  -- name; `jLocalClass` bound it to the instance, and a method call re-binds
  -- it (see `jInvoke`), so this is a lookup rather than a rule about
  -- enclosing instances.
  | suc _, jQualThis q => \case lookupType env q \with {
    | just (vObj c ms cenv) => rOk (eVal (vObj c ms cenv))
    | _ => rStuck
  }

  -- `e.f`: only ever a field of `Rt` (`Rt.PRIM_ADD_LONG`, ...); any other
  -- receiver is never generated, hence stuck.
  | suc n, jField recv f =>
    bindRes (evalExpr rt cls n env recv) (\lam o => \case o \with {
      | eExc ev => rOk (eExc ev)
      | eVal (vStaticRef _) => \case rtField {rt} f \with {
        | nothing => rStuck                      -- an Rt member no instance covers
        | just v => rOk (eVal v)
      }
      | eVal _ => rStuck
    })

  -- `(T)e`. JLS 5.5.
  | suc n, jCast t e =>
    bindRes (evalExpr rt cls n env e) (\lam o => \case o \with {
      | eExc ev => rOk (eExc ev)
      | eVal v => afterCast (castOk env t v) (rOk (eVal v))
    })

  -- `((Rt.Fn)(f)).apply(x)`: λ□ application; the cast is part of the node.
  | suc n, jApply f a =>
    bindRes (evalExpr rt cls n env f) (\lam of => \case of \with {
      | eExc ev => rOk (eExc ev)
      | eVal fv => afterCast (castOk env tFn fv)
        (bindRes (evalExpr rt cls n env a) (\lam oa => \case oa \with {
          | eExc ev => rOk (eExc ev)
          | eVal av => applyVal rt cls n fv av
        }))
    })

  -- `recv.m(arg)`: a call to a method of a `fix` local class, the fragment's
  -- only non-`apply` virtual call. Exactly one argument, by construction.
  | suc n, jInvoke recv m args =>
    bindRes (evalExpr rt cls n env recv) (\lam orv => \case orv \with {
      | eExc ev => rOk (eExc ev)
      | eVal rv =>
        bindRes (evalArgs rt cls n env args) (\lam oas => \case oas \with {
          | aExc ev => rOk (eExc ev)
          | aVals vs => invokeMethod rt cls n rv m vs
        })
    })

  -- `q(args)`: a method of the generated class, or a static of the runtime.
  | suc n, jCallStatic q args =>
    bindRes (evalArgs rt cls n env args) (\lam oas => \case oas \with {
      | aExc ev => rOk (eExc ev)
      | aVals vs => callStatic rt cls n q vs
    })

  -- `new T(args)`.
  | suc n, jNew t args =>
    bindRes (evalArgs rt cls n env args) (\lam oas => \case oas \with {
      | aExc ev => rOk (eExc ev)
      | aVals vs => newObject env t vs
    })

  -- `new Rt.Data(tag, new Object[]{ .. })`: fields are values (no store).
  | suc n, jDataNew tag args =>
    bindRes (evalArgs rt cls n env args) (\lam oas => \case oas \with {
      | aExc ev => rOk (eExc ev)
      | aVals vs => rOk (eVal (vData tag vs))
    })

  -- `d.tag == k` (JLS 15.21.1): is this value the k-th constructor? The
  -- receiver is always the `Rt.Data`-typed local a `case` binds, so a
  -- non-`Data` cannot arise.
  | suc n, jTagEq d k =>
    bindRes (evalExpr rt cls n env d) (\lam o => \case o \with {
      | eExc ev => rOk (eExc ev)
      | eVal (vData tg _) => rOk (eVal (vBool (tg == k)))
      | eVal _ => rStuck
    })

  -- `d.fields[i]`. An out-of-range index throws (JLS 10.4); unreachable for
  -- well-formed λ□, but modelled since a generator bug would land here.
  | suc n, jDataField d i =>
    bindRes (evalExpr rt cls n env d) (\lam o => \case o \with {
      | eExc ev => rOk (eExc ev)
      | eVal (vData _ fs) => \case nthArr i fs \with {
        | just v => rOk (eVal v)
        | nothing => rOk (eExc excAIOOBE)
      }
      | eVal _ => rStuck
    })

  -- `(c ? a : b)`: the condition, then exactly one arm (JLS 15.25).
  | suc n, jCond c a b =>
    bindRes (evalExpr rt cls n env c) (\lam o => \case o \with {
      | eExc ev => rOk (eExc ev)
      | eVal (vBool true) => evalExpr rt cls n env a
      | eVal (vBool false) => evalExpr rt cls n env b
      | eVal _ => rStuck
    })

-- Arguments, left to right (JLS 15.12.4.2); the first throw stops the list.
\func evalArgs (rt : RtSpec) (cls : JClass) (n : Nat) (env : Env) (es : Array JExpr)
  : Res ArgsOut \elim n, es
  | 0, _ => rOutOfFuel
  | suc _, nil => rOk (aVals nil)
  | suc n, e :: es =>
    bindRes (evalExpr rt cls n env e) (\lam o => \case o \with {
      | eExc ev => rOk (aExc ev)
      | eVal v =>
        bindRes (evalArgs rt cls n env es) (\lam os => \case os \with {
          | aExc ev => rOk (aExc ev)
          | aVals vs => rOk (aVals (v :: vs))
        })
    })

-- `apply`. A closure runs its body in the captured environment extended with
-- its parameter; a runtime constant accumulates arguments until
-- `builtinArity` is reached and then computes; `Rt.BOX` applied to anything is
-- `Rt.BOX` (λ□'s `evalBox`). Other values were excluded by the cast.
\func applyVal (rt : RtSpec) (cls : JClass) (n : Nat) (f a : Value)
  : Res ExprOut \elim n
  | 0 => rOutOfFuel
  | suc n => \case f \with {
    | vClos p body cenv =>
      bindRes (execStmts rt cls n (bindVar cenv p a) body) (\lam o => \case o \with {
        | oReturn v => rOk (eVal v)
        | oExcS ev => rOk (eExc ev)
        -- `apply` returns `Object`, so falling off the end is not a well-formed
        -- method body (JLS 8.4.7); cf. ClightBigstep's `outcome_result_value`.
        | oNormal _ => rStuck
      })
    | vBuiltin nm got => \case builtinArity {rt} nm \with {
      | nothing => rStuck
      | just k => \case snocArr got a \with {
        | got' => \case got'.len == k \with {
          | false => rOk (eVal (vBuiltin nm got'))
          | true => bindRes (builtinRun {rt} nm got') (\lam v => rOk (eVal v))
        }
      }
    }
    | vBox => rOk (eVal vBox)
    | _ => rStuck
  }

-- `recv.f<j>(arg)` on a `fix` local class instance.
--
-- This is where the `fix` knot is tied (the letrec rule): the body runs in the
-- environment captured at the class declaration, extended with the class name
-- (a type) bound to the receiver, then with the parameter. So `C.this.f<i>`
-- finds the same instance at any depth, with no mutable cell.
\func invokeMethod (rt : RtSpec) (cls : JClass) (n : Nat) (recv : Value) (m : JIdent) (vs : Array Value)
  : Res ExprOut \elim n
  | 0 => rOutOfFuel
  | suc n => \case recv \with {
    | vObj c ms cenv => \case lookupClassMethod ms m \with {
      | nothing => rStuck
      | just pb => \case vs \with {
        | a :: nil =>
          bindRes (execStmts rt cls n (bindVar (bindType cenv c (vObj c ms cenv)) pb.1 a) pb.2)
                  (\lam o => \case o \with {
            | oReturn v => rOk (eVal v)
            | oExcS ev => rOk (eExc ev)
            | oNormal _ => rStuck
          })
        -- Every method of a `fix` class is `Object f<j>(Object)`: unreachable.
        | _ => rStuck
      }
    }
    | _ => rStuck
  }

-- `q(args)`: a method of the generated class, else a static of the runtime.
--
-- A generated method runs in the empty environment: it has no parameters and a
-- λ□ constant is closed.
\func callStatic (rt : RtSpec) (cls : JClass) (n : Nat) (q : JQIdent) (vs : Array Value)
  : Res ExprOut \elim n
  | 0 => rOutOfFuel
  | suc n => \case lookupMethod cls q \with {
    | just mth => \case vs \with {
      | nil =>
        bindRes (execStmts rt cls n nil (JMethod.mBody {mth})) (\lam o => \case o \with {
          | oReturn v => rOk (eVal v)
          | oExcS ev => rOk (eExc ev)
          -- An `Object` method may not fall off the end (JLS 8.4.7).
          | oNormal _ => rStuck
        })
      | _ => rStuck                              -- zero-argument by construction
    }
    -- Not ours: `Rt.unbound`, `Rt.freeVar`, `Rt.noBranch`, `Long.valueOf`; the
    -- `RtSpec` instance decides.
    | nothing => \case rtStaticCall {rt} q vs \with {
      | nothing => rStuck
      | just r => r
    }
  }

-- `new T(args)` for the two things the generator instantiates: a `fix` local
-- class, and the `RuntimeException` of an unimplemented axiom's stub. Other
-- constructors (`new Object()`, `new Rt.Data(..)` -- `jDataNew` is its own
-- node) are never emitted and not modelled.
--
-- A local class is looked up rather than built: `jLocalClass` bound its name to
-- the (stateless) instance, see `vObj` in Semantics/JavaValue.ard.
\func newObject (env : Env) (t : JType) (vs : Array Value) : Res ExprOut \elim t
  | tClass q => newWith (lookupType env q) (resolveType env (tClass q)) vs
  \where
    \func newWith (local : Maybe Value) (c : Maybe ClassId) (vs : Array Value) : Res ExprOut \elim local, c, vs
      -- A local class has only the default constructor.
      | just (vObj c ms cenv), _, nil => rOk (eVal (vObj c ms cenv))
      | just _, _, _ => rStuck
      -- An exception class: its `(String message)` constructor.
      | nothing, just c, vStr msg :: nil => \case subclassOf c cThrowable \with {
        | true => rOk (eVal (vExcObj c msg))
        | false => rStuck
      }
      | nothing, _, _ => rStuck

-- ---------------------------------------------------------------------------
-- Statements. A statement list is a sequence of bindings ending in a
-- `jReturn`, i.e. a let-chain with two abrupt outcomes.
-- ---------------------------------------------------------------------------

\func execStmt (rt : RtSpec) (cls : JClass) (n : Nat) (env : Env) (s : JStmt)
  : Res StmtOut \elim n, s
  | 0, _ => rOutOfFuel

  -- No effect at all; it exists so the printer can put a comment on a line.
  | suc _, jComment _ => rOk (oNormal env)

  -- `final T x = e;`: a binding. The declared type is not checked (`javac`
  -- does, JLS 5.2).
  | suc n, jLocal _ x e =>
    bindRes (evalExpr rt cls n env e) (\lam o => \case o \with {
      | eExc ev => rOk (oExcS ev)
      | eVal v => rOk (oNormal (bindVar env x v))
    })

  -- A local class `C` (a `fix` block): binds the type `C` to the instance,
  -- capturing the environment, so `new C()` and every `C.this` mean the same
  -- object.
  | suc _, jLocalClass c ms => rOk (oNormal (bindType env c (vObj c ms env)))

  -- `throw e;` (JLS 14.18): `e` must be a `Throwable`.
  | suc n, jThrow e =>
    bindRes (evalExpr rt cls n env e) (\lam o => \case o \with {
      | eExc ev => rOk (oExcS ev)
      | eVal v => \case instanceOf v cThrowable \with {
        | just true => rOk (oExcS v)
        | _ => rStuck
      }
    })

  | suc n, jReturn e =>
    bindRes (evalExpr rt cls n env e) (\lam o => \case o \with {
      | eExc ev => rOk (oExcS ev)
      | eVal v => rOk (oReturn v)
    })

-- An abrupt outcome stops the sequence and propagates; a normal one carries its
-- (possibly extended) environment to the next statement. Falling off the end is
-- `oNormal`, which every caller rejects -- see `applyVal`.
\func execStmts (rt : RtSpec) (cls : JClass) (n : Nat) (env : Env) (ss : Array JStmt)
  : Res StmtOut \elim n, ss
  | 0, _ => rOutOfFuel
  | suc _, nil => rOk (oNormal env)
  | suc n, s :: ss =>
    bindRes (execStmt rt cls n env s) (\lam o => \case o \with {
      | oReturn v => rOk (oReturn v)
      | oExcS ev => rOk (oExcS ev)
      | oNormal env' => execStmts rt cls n env' ss
    })

-- ---------------------------------------------------------------------------
-- Running a program
--
-- The result of calling the entry method (`Compiler/ToJava.ard`'s
-- `bodyMethodName`, passed as a parameter).
-- ---------------------------------------------------------------------------

\data RunOut | rvValue Value | rvThrown Value

\func runClass (rt : RtSpec) (cls : JClass) (entry : JIdent) (n : Nat) : Res RunOut =>
  bindRes (callStatic rt cls n entry nil) (\lam o => \case o \with {
    | eVal v => rOk (rvValue v)
    | eExc ev => rOk (rvThrown ev)
  })

-- The relation recovered from the function: `cls` runs to `v` for some fuel.
\func JEval (rt : RtSpec) (cls : JClass) (entry : JIdent) (v : Value) : \Type =>
  \Sigma (n : Nat) (runClass rt cls entry n = rOk (rvValue v))
