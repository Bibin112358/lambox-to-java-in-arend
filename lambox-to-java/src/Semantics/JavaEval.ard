\import Arith.Nat   -- the `DecSet Nat` instance behind `==` on tags and arities
\import Data.Bool
\import Data.Maybe
\import Data.String
\import Compiler.JavaAst
\import Semantics.Res
\import Semantics.JavaValue
\import Set
\import Compiler.StringUtil

-- The semantics of the Java fragment (`Compiler/JavaAst.ard`): a functional
-- big-step evaluator with fuel, the target side of the correctness theorem.
-- Values and the runtime interface `RtSpec` are in `Semantics/JavaValue.ard`.
--
-- A function rather than a relation, so it can be run on generated programs
-- (and compared with `javac` + `java`): the functional big-step style of
-- Owens et al. (ESOP 2016, as in CakeML), where divergence is "out of fuel for
-- every fuel". `JEval` at the end recovers a relation. Java fixes evaluation
-- order left to right (JLS 15.7), so the evaluator is deterministic; rules
-- cite the JLS.
--
-- Every constructor of `JExpr`/`JStmt`/`JType`/`JMember` has a clause, and the
-- fragment is closed, so no unmodelled Java can appear. Outside this model
-- are the trusted printer `Compiler/JavaPrint.ard` (e.g. `litStr` is not
-- escaped) and the runtime `runtime/Rt.java` (the parameter `RtSpec`).
--
-- The observable is the value returned by the entry method (`body`) or the
-- exception it throws. Four shapes the generator never emits are `rStuck`,
-- marked at their clauses: `jField` on a non-`Rt` receiver, `jNew` of
-- `tObject`/`tFn`/`tData`, `jInvoke` with other than one argument, and a call
-- of a generated method with arguments.

-- ---------------------------------------------------------------------------
-- Class-level lookup: one flat method table (cf. Featherweight Java's `CT`).
-- ---------------------------------------------------------------------------

-- Not `StringUtil.lookupBy`: a member is a method or a comment, so there is no
-- key function.
\func lookupMethodIn (ms : Array JMember) (nm : JIdent) : Maybe JMethod \elim ms
  | nil => nothing
  | jMethod m :: ms => \case JMethod.mName {m} == nm \with {
    | true => just m
    | false => lookupMethodIn ms nm
  }
  | jMemberComment _ :: ms => lookupMethodIn ms nm

\func lookupMethod (cls : JClass) (nm : JIdent) : Maybe JMethod =>
  lookupMethodIn (JClass.classMembers {cls}) nm

-- ---------------------------------------------------------------------------
-- Casts (JLS 5.5, 15.16): checked at run time, `ClassCastException` on
-- failure. The fragment only casts to `Rt.Fn` (in `jApply`), to `Rt.Data` and
-- to local classes.
-- ---------------------------------------------------------------------------

\func excCCE : Value => vExcObj "java.lang.ClassCastException" "cast failed"

\func excAIOOBE : Value => vExcObj "java.lang.ArrayIndexOutOfBoundsException" "index"

\func castOk (t : JType) (v : Value) : Bool \elim t
  -- Every value of the fragment is an `Object`.
  | tObject => true
  -- `Rt.Fn`: a closure, a runtime constant that is one, or `Rt.BOX` -- which
  -- is an `Fn` returning itself, because λ□ applies erased values (`evalBox`).
  | tFn => \case v \with {
    | vClos _ _ _ => true
    | vBuiltin _ _ => true
    | vBox => true
    | _ => false
  }
  | tData => \case v \with {
    | vData _ _ => true
    | _ => false
  }
  -- A named class: a `fix` local class instance, or an exception object.
  | tClass q => \case v \with {
    | vObj c _ _ => c == q
    | vExcObj c _ => c == q
    | _ => false
  }

-- ---------------------------------------------------------------------------
-- The evaluator.
--
-- Fuel (`n`) is the first `\elim` argument and decreases at every call of the
-- mutual cycle, so termination is structural on it (and, unlike in the
-- compiler, array helpers such as `evalArgs` are fine).
-- ---------------------------------------------------------------------------

\func evalExpr (rt : RtSpec) (cls : JClass) (n : Nat) (env : Env) (e : JExpr)
  : Res ExprOut \elim n, e
  | 0, _ => rOutOfFuel

  -- Literals (JLS 3.10) and the erased-value atom.
  | suc _, jLit l => rOk (eVal (litValue l))
  | suc _, jBox => rOk (eVal vBox)

  -- A local or a parameter. Unbound is `rStuck` (`javac` would reject it).
  | suc _, jVar x => \case lookupVar env x \with {
    | nothing => rStuck
    | just v => rOk (eVal v)
  }

  -- `Rt` as a receiver. The generator only emits `jStatic runtimeClassName`.
  | suc _, jStatic q => rOk (eVal (vStaticRef q))

  -- A closure; the environment is captured by value (JLS 15.9.5, 4.12.4).
  | suc _, jClosure p body => rOk (eVal (vClos p body env))

  -- `C.this` from inside a nested anonymous class. `jLocalClass` bound `C` to
  -- the instance, and a method call re-binds it (see `jInvoke`), so this is a
  -- lookup rather than a rule about enclosing instances.
  | suc _, jQualThis q => \case lookupVar env q \with {
    | just (vObj c ms cenv) => rOk (eVal (vObj c ms cenv))
    | _ => rStuck
  }

  -- `e.f`: only ever a field of `Rt` (`Rt.PRIM_ADD_LONG`, ...); any other
  -- receiver is never generated, hence stuck.
  | suc n, jField recv f =>
    bindRes (evalExpr rt cls n env recv) (\lam o => \case o \with {
      | eExc ev => rOk (eExc ev)
      | eVal (vStaticRef _) => \case rtField {rt} f \with {
        | nothing => rStuck                      -- an Rt member no instance covers
        | just v => rOk (eVal v)
      }
      | eVal _ => rStuck
    })

  -- `(T)e`. JLS 5.5.
  | suc n, jCast t e =>
    bindRes (evalExpr rt cls n env e) (\lam o => \case o \with {
      | eExc ev => rOk (eExc ev)
      | eVal v => \case castOk t v \with {
        | true => rOk (eVal v)
        | false => rOk (eExc excCCE)
      }
    })

  -- `((Rt.Fn)(f)).apply(x)`: λ□ application; the cast is part of the node.
  | suc n, jApply f a =>
    bindRes (evalExpr rt cls n env f) (\lam of => \case of \with {
      | eExc ev => rOk (eExc ev)
      | eVal fv => \case castOk tFn fv \with {
        | false => rOk (eExc excCCE)
        | true =>
          bindRes (evalExpr rt cls n env a) (\lam oa => \case oa \with {
            | eExc ev => rOk (eExc ev)
            | eVal av => applyVal rt cls n fv av
          })
      }
    })

  -- `recv.m(arg)`: a call to a method of a `fix` local class, the fragment's
  -- only non-`apply` virtual call. Exactly one argument, by construction.
  | suc n, jInvoke recv m args =>
    bindRes (evalExpr rt cls n env recv) (\lam orv => \case orv \with {
      | eExc ev => rOk (eExc ev)
      | eVal rv =>
        bindRes (evalArgs rt cls n env args) (\lam oas => \case oas \with {
          | aExc ev => rOk (eExc ev)
          | aVals vs => invokeMethod rt cls n rv m vs
        })
    })

  -- `q(args)`: a method of the generated class, or a static of the runtime.
  | suc n, jCallStatic q args =>
    bindRes (evalArgs rt cls n env args) (\lam oas => \case oas \with {
      | aExc ev => rOk (eExc ev)
      | aVals vs => callStatic rt cls n q vs
    })

  -- `new T(args)`.
  | suc n, jNew t args =>
    bindRes (evalArgs rt cls n env args) (\lam oas => \case oas \with {
      | aExc ev => rOk (eExc ev)
      | aVals vs => newObject env t vs
    })

  -- `new Rt.Data(tag, new Object[]{ .. })`: fields are values (no store).
  | suc n, jDataNew tag args =>
    bindRes (evalArgs rt cls n env args) (\lam oas => \case oas \with {
      | aExc ev => rOk (eExc ev)
      | aVals vs => rOk (eVal (vData tag vs))
    })

  -- `d.tag == k` (JLS 15.21.1): is this value the k-th constructor? The
  -- receiver is always the `Rt.Data`-typed local a `case` binds, so a
  -- non-`Data` cannot arise.
  | suc n, jTagEq d k =>
    bindRes (evalExpr rt cls n env d) (\lam o => \case o \with {
      | eExc ev => rOk (eExc ev)
      | eVal (vData tg _) => rOk (eVal (vBool (tg == k)))
      | eVal _ => rStuck
    })

  -- `d.fields[i]`. An out-of-range index throws (JLS 10.4); unreachable for
  -- well-formed λ□, but modelled since a generator bug would land here.
  | suc n, jDataField d i =>
    bindRes (evalExpr rt cls n env d) (\lam o => \case o \with {
      | eExc ev => rOk (eExc ev)
      | eVal (vData _ fs) => \case nthArr i fs \with {
        | just v => rOk (eVal v)
        | nothing => rOk (eExc excAIOOBE)
      }
      | eVal _ => rStuck
    })

  -- `(c ? a : b)`: the condition, then exactly one arm (JLS 15.25).
  | suc n, jCond c a b =>
    bindRes (evalExpr rt cls n env c) (\lam o => \case o \with {
      | eExc ev => rOk (eExc ev)
      | eVal (vBool true) => evalExpr rt cls n env a
      | eVal (vBool false) => evalExpr rt cls n env b
      | eVal _ => rStuck
    })

-- Arguments, left to right (JLS 15.12.4.2); the first throw stops the list.
\func evalArgs (rt : RtSpec) (cls : JClass) (n : Nat) (env : Env) (es : Array JExpr)
  : Res ArgsOut \elim n, es
  | 0, _ => rOutOfFuel
  | suc _, nil => rOk (aVals nil)
  | suc n, e :: es =>
    bindRes (evalExpr rt cls n env e) (\lam o => \case o \with {
      | eExc ev => rOk (aExc ev)
      | eVal v =>
        bindRes (evalArgs rt cls n env es) (\lam os => \case os \with {
          | aExc ev => rOk (aExc ev)
          | aVals vs => rOk (aVals (v :: vs))
        })
    })

-- `apply`. A closure runs its body in the captured environment extended with
-- its parameter; a runtime constant accumulates arguments until
-- `builtinArity` is reached and then computes; `Rt.BOX` applied to anything is
-- `Rt.BOX` (λ□'s `evalBox`). Other values were excluded by the cast.
\func applyVal (rt : RtSpec) (cls : JClass) (n : Nat) (f a : Value)
  : Res ExprOut \elim n
  | 0 => rOutOfFuel
  | suc n => \case f \with {
    | vClos p body cenv =>
      bindRes (execStmts rt cls n (bindVar cenv p a) body) (\lam o => \case o \with {
        | oReturn v => rOk (eVal v)
        | oExcS ev => rOk (eExc ev)
        -- `apply` returns `Object`, so falling off the end is not a well-formed
        -- method body (JLS 8.4.7); cf. ClightBigstep's `outcome_result_value`.
        | oNormal _ => rStuck
      })
    | vBuiltin nm got => \case builtinArity {rt} nm \with {
      | nothing => rStuck
      | just k => \case snocArr got a \with {
        | got' => \case got'.len == k \with {
          | false => rOk (eVal (vBuiltin nm got'))
          | true => bindRes (builtinRun {rt} nm got') (\lam v => rOk (eVal v))
        }
      }
    }
    | vBox => rOk (eVal vBox)
    | _ => rStuck
  }

-- `recv.f<j>(arg)` on a `fix` local class instance.
--
-- This is where the `fix` knot is tied (the letrec rule): the body runs in the
-- environment captured at the class declaration, extended with the class name
-- bound to the receiver, then with the parameter. So `C.this.f<i>` finds the
-- same instance at any depth, with no mutable cell.
\func invokeMethod (rt : RtSpec) (cls : JClass) (n : Nat) (recv : Value) (m : JIdent) (vs : Array Value)
  : Res ExprOut \elim n
  | 0 => rOutOfFuel
  | suc n => \case recv \with {
    | vObj c ms cenv => \case lookupClassMethod ms m \with {
      | nothing => rStuck
      | just pb => \case vs \with {
        | a :: nil =>
          bindRes (execStmts rt cls n (bindVar (bindVar cenv c (vObj c ms cenv)) pb.1 a) pb.2)
                  (\lam o => \case o \with {
            | oReturn v => rOk (eVal v)
            | oExcS ev => rOk (eExc ev)
            | oNormal _ => rStuck
          })
        -- Every method of a `fix` class is `Object f<j>(Object)`: unreachable.
        | _ => rStuck
      }
    }
    | _ => rStuck
  }

-- `q(args)`: a method of the generated class, else a static of the runtime.
--
-- A generated method runs in the empty environment: it has no parameters and a
-- λ□ constant is closed.
\func callStatic (rt : RtSpec) (cls : JClass) (n : Nat) (q : JQIdent) (vs : Array Value)
  : Res ExprOut \elim n
  | 0 => rOutOfFuel
  | suc n => \case lookupMethod cls q \with {
    | just mth => \case vs \with {
      | nil =>
        bindRes (execStmts rt cls n nil (JMethod.mBody {mth})) (\lam o => \case o \with {
          | oReturn v => rOk (eVal v)
          | oExcS ev => rOk (eExc ev)
          -- An `Object` method may not fall off the end (JLS 8.4.7).
          | oNormal _ => rStuck
        })
      | _ => rStuck                              -- zero-argument by construction
    }
    -- Not ours: `Rt.unbound`, `Rt.freeVar`, `Rt.noBranch`, `Long.valueOf`; the
    -- `RtSpec` instance decides.
    | nothing => \case rtStaticCall {rt} q vs \with {
      | nothing => rStuck
      | just r => r
    }
  }

-- `new T(args)` for the two things the generator instantiates: a `fix` local
-- class, and the `RuntimeException` of an unimplemented axiom's stub.
--
-- A local class is looked up rather than built: `jLocalClass` bound its name to
-- the (stateless) instance, see `vObj` in Semantics/JavaValue.ard.
\func newObject (env : Env) (t : JType) (vs : Array Value) : Res ExprOut =>
  \case t \with {
    | tClass q => \case lookupVar env q \with {
      | just (vObj c ms cenv) => \case vs \with {
        | nil => rOk (eVal (vObj c ms cenv))
        | _ => rStuck                            -- the class has no constructor
      }
      | _ => \case vs \with {
        | vStr msg :: nil => rOk (eVal (vExcObj q msg))
        | _ => rStuck
      }
    }
    -- `new Object()`/`new Rt.Fn()`/`new Rt.Data()` as such: never emitted
    -- (`jClosure` and `jDataNew` are their own nodes).
    | _ => rStuck
  }

-- ---------------------------------------------------------------------------
-- Statements. A statement list is a sequence of bindings ending in a
-- `jReturn`, i.e. a let-chain with two abrupt outcomes.
-- ---------------------------------------------------------------------------

\func execStmt (rt : RtSpec) (cls : JClass) (n : Nat) (env : Env) (s : JStmt)
  : Res StmtOut \elim n, s
  | 0, _ => rOutOfFuel

  -- No effect at all; it exists so the printer can put a comment on a line.
  | suc _, jComment _ => rOk (oNormal env)

  -- `final T x = e;`: a binding. The declared type is not checked (`javac`
  -- does, JLS 5.2).
  | suc n, jLocal _ x e =>
    bindRes (evalExpr rt cls n env e) (\lam o => \case o \with {
      | eExc ev => rOk (oExcS ev)
      | eVal v => rOk (oNormal (bindVar env x v))
    })

  -- A local class `C` (a `fix` block): binds `C` to the instance, capturing
  -- the environment, so `new C()` and every `C.this` mean the same object.
  | suc _, jLocalClass c ms => rOk (oNormal (bindVar env c (vObj c ms env)))

  | suc n, jThrow e =>
    bindRes (evalExpr rt cls n env e) (\lam o => \case o \with {
      | eExc ev => rOk (oExcS ev)
      | eVal v => rOk (oExcS v)
    })

  | suc n, jReturn e =>
    bindRes (evalExpr rt cls n env e) (\lam o => \case o \with {
      | eExc ev => rOk (oExcS ev)
      | eVal v => rOk (oReturn v)
    })

-- An abrupt outcome stops the sequence and propagates; a normal one carries its
-- (possibly extended) environment to the next statement. Falling off the end is
-- `oNormal`, which every caller rejects -- see `applyVal`.
\func execStmts (rt : RtSpec) (cls : JClass) (n : Nat) (env : Env) (ss : Array JStmt)
  : Res StmtOut \elim n, ss
  | 0, _ => rOutOfFuel
  | suc _, nil => rOk (oNormal env)
  | suc n, s :: ss =>
    bindRes (execStmt rt cls n env s) (\lam o => \case o \with {
      | oReturn v => rOk (oReturn v)
      | oExcS ev => rOk (oExcS ev)
      | oNormal env' => execStmts rt cls n env' ss
    })

-- ---------------------------------------------------------------------------
-- Running a program
--
-- The result of calling the entry method (`Compiler/ToJava.ard`'s
-- `bodyMethodName`, passed as a parameter).
-- ---------------------------------------------------------------------------

\data RunOut | rvValue Value | rvThrown Value

\func runClass (rt : RtSpec) (cls : JClass) (entry : JIdent) (n : Nat) : Res RunOut =>
  bindRes (callStatic rt cls n entry nil) (\lam o => \case o \with {
    | eVal v => rOk (rvValue v)
    | eExc ev => rOk (rvThrown ev)
  })

-- The relation recovered from the function: `cls` runs to `v` for some fuel.
\func JEval (rt : RtSpec) (cls : JClass) (entry : JIdent) (v : Value) : \Type =>
  \Sigma (n : Nat) (runClass rt cls entry n = rOk (rvValue v))
