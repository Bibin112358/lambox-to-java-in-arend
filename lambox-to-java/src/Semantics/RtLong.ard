\import Algebra.Group
\import Algebra.Monoid
\import Arith.Int
\import Arith.Nat
\import Data.Bool
\import Data.Maybe
\import Data.String
\import Compiler.JavaAst
\import Compiler.JavaLong
\import Order.Biordered
\import Order.PartialOrder
\import Order.StrictOrder
\import Semantics.Res
\import Semantics.JavaValue
\import Set
\import Compiler.StringUtil

-- `rtLong`, a model (instance of `RtSpec`, Semantics/JavaValue.ard) of the
-- `long`-based part of `runtime/Rt.java`: the `PRIM_*_LONG` and `NAT_SUB_LONG`
-- constants, `Rt.TRUE`/`Rt.FALSE`, and the static reporters (`Rt.unbound`, ...).
-- `Semantics/RtInt63.ard` layers the `PRIM_*_INT63` family on top of it; that
-- combination is the runtime model of the correctness theorem.
--
-- Not modelled (stuck): the `ARRAY_*`, `DEC_*`, `INT_*` and `EQ_REC` families.
--
-- Longs are `JLong`s (`Compiler/JavaLong.ard`): in range by construction, so
-- `lng(x)` is just the value `x.1`, and every result is built by `wrapLong`
-- (64-bit wraparound, JLS 4.2.2) or shown to stay in range.
--
-- Performance: Arend computes `Nat.+`/`-`/`*` and `Nat.divMod` natively on big
-- literals, but never compare by peeling `suc`s (2^63 steps here); signs are
-- tested via `Nat.-` (an `Int`) and equality via `intEqB`.
--
-- Small helpers take the value they test as a parameter (rather than a
-- `\case`), so that proofs (`Proof/OracleShipped.ard`) can rewrite with it.

-- `Rt.FALSE`/`Rt.TRUE` are `Data(0, {})`/`Data(1, {})`. They are not in
-- `rtField`: generated code only receives them from comparisons.
\func mkBool (b : Bool) : Value =>
  vData (\case b \with { | true => 1 | false => 0 }) nil

-- ---------------------------------------------------------------------------
-- Division, remainder and comparison on `long`.
--
-- JLS 15.17.2: `/` rounds toward zero (`-7 / 2` is `-3`); the one overflow is
-- `Long.MIN_VALUE / -1`, which wraps back to `Long.MIN_VALUE`. JLS 15.17.3:
-- `%` has the dividend's sign (`-7 % 2` is `-1`) and cannot overflow. Both are
-- computed on magnitudes with Arend's `Nat.div`/`Nat.mod`, then signed.
-- Division by zero would throw in Java; `Rt.java` guards it with Lean's
-- convention (`y == 0 ? 0 : x / y`, `y == 0 ? x : x % y`), and so does the model.
-- ---------------------------------------------------------------------------

-- Strictly negative. `neg 0` is `pos 0`, and the two clauses agree there.
\func isNegL (x : Int) : Bool
  | pos _ => false
  | neg 0 => false
  | neg (suc _) => true

\func isZeroL (x : Int) : Bool
  | pos 0 => true
  | pos (suc _) => false
  | neg 0 => true
  | neg (suc _) => false

-- A magnitude with a sign attached.
\func signedL (negative : Bool) (n : Nat) : Int \elim negative
  | true => neg n
  | false => pos n

-- The sign of a quotient: negative iff exactly one operand is.
\func xorL (a b : Bool) : Bool \elim a, b
  | true, true => false
  | true, false => true
  | false, b => b

-- JLS 15.17.2 on mathematical integers; the caller wraps (for MIN / -1).
\func javaDiv (x y : Int) : Int => signedL (xorL (isNegL x) (isNegL y)) (iabs x Nat.div iabs y)

-- JLS 15.17.3: the dividend's sign, the magnitudes' remainder.
\func javaRem (x y : Int) : Int => signedL (isNegL x) (iabs x Nat.mod iabs y)

-- `%` is no larger than its dividend, so it stays a `long`.
\func remLong (x : JLong) (y : Int) : JLong => (javaRem x.1 y, range-inLong (remIn y (inLong-range x.2)))
  \where {
    \lemma remIn {a : Int} (b : Int) (h : InRange pow2_63 a) : InRange pow2_63 (javaRem a b) \elim a
      | pos n => mod<=left <∘r h
      | neg (suc n) => negIn (mod<=left <=∘ h)

    \lemma negIn {m : Nat} (h : m <= pow2_63) : InRange pow2_63 (neg m) \elim m
      | 0 => NatOrder.zero<suc
      | suc m => h
  }

-- `Rt.java`'s zero guard: `y == 0 ? onZero : other`.
\func ifZeroL {A : \Type} (isZero : Bool) (onZero other : A) : A \elim isZero
  | true => onZero
  | false => other

-- `0 <= d`, as the sign of an `Int`: after the `neg 0 = pos 0` identification
-- the negatives are exactly `neg (suc _)`.
\func nonNegL (d : Int) : Bool
  | pos _ => true
  | neg (suc _) => false

-- Lean's truncating `Nat.sub` on a `long` difference: negatives become 0.
\func clampL (d : Int) : Int
  | pos k => pos k
  | neg (suc _) => 0

\func clampLong (d : JLong) : JLong => (clampL d.1, clampIn d.1 d.2)
  \where
    \lemma clampIn (d : Int) (h : InLong d) : InLong (clampL d) \elim d
      | pos k => h
      | neg (suc k) => ()

-- Every one of these is binary in `Rt.java` (`Fn -> Fn -> result`).
\func builtinArityLong (f : JIdent) : Maybe Nat =>
  \case f == "PRIM_ADD_LONG" \with { | true => just 2 | false =>
  \case f == "PRIM_SUB_LONG" \with { | true => just 2 | false =>
  \case f == "PRIM_MUL_LONG" \with { | true => just 2 | false =>
  \case f == "PRIM_EQB_LONG" \with { | true => just 2 | false =>
  \case f == "NAT_SUB_LONG"  \with { | true => just 2 | false =>
  \case f == "PRIM_DIV_LONG" \with { | true => just 2 | false =>
  \case f == "PRIM_MOD_LONG" \with { | true => just 2 | false =>
  \case f == "PRIM_BLE_LONG" \with { | true => just 2 | false =>
  \case f == "PRIM_BLT_LONG" \with { | true => just 2 | false => nothing } } } } } } } } }

-- Any name with a declared arity is an `Fn` constant, unapplied. (`Rt.BOX` is
-- the AST node `jBox`, never read as a field.)
\func rtFieldLong (f : JIdent) : Maybe Value =>
  \case builtinArityLong f \with {
    | just _ => just (vBuiltin f nil)
    | nothing => nothing
  }

\func builtinRunLong (f : JIdent) (vs : Array Value) : Res Value =>
  \case vs \with {
    | vLong x :: vLong y :: nil =>
      -- `lng(x)` and `lng(y)`.
      \let | a => x.1
           | b => y.1
      \in
      -- `long` arithmetic wraps modulo 2^64 (JLS 4.2.2).
      \case f == "PRIM_ADD_LONG" \with { | true => rOk (vLong (wrapLong (a + b))) | false =>
      \case f == "PRIM_SUB_LONG" \with { | true => rOk (vLong (wrapLong (a - b))) | false =>
      \case f == "PRIM_MUL_LONG" \with { | true => rOk (vLong (wrapLong (a * b))) | false =>
      \case f == "PRIM_EQB_LONG" \with { | true => rOk (mkBool (intEqB a b)) | false =>
      -- Lean's truncating `Nat.sub`. `Rt.java` is
      --     long d = lng(x) - lng(y);  return d < 0L ? 0L : d;
      -- so the wrap comes BEFORE the sign test; the orders differ, e.g. at
      -- x = -2^63, y = 1 (0 versus 2^63-1).
      \case f == "NAT_SUB_LONG" \with {
        | true => rOk (vLong (clampLong (wrapLong (a - b)))) | false =>
      -- `lng(y) == 0L ? 0L : lng(x) / lng(y)`, wrapped for `Long.MIN_VALUE / -1`.
      \case f == "PRIM_DIV_LONG" \with {
        | true => rOk (vLong (ifZeroL (isZeroL b) zeroLong (wrapLong (javaDiv a b)))) | false =>
      -- `lng(y) == 0L ? lng(x) : lng(x) % lng(y)`. No wrap: `%` cannot overflow.
      \case f == "PRIM_MOD_LONG" \with {
        | true => rOk (vLong (ifZeroL (isZeroL b) x (remLong x b))) | false =>
      -- Signed `lng(x) <= lng(y)` and `lng(x) < lng(y)`, by the sign of an exact
      -- difference (`x < y` iff `x + 1 <= y`).
      \case f == "PRIM_BLE_LONG" \with {
        | true => rOk (mkBool (nonNegL (b - a))) | false =>
      \case f == "PRIM_BLT_LONG" \with {
        | true => rOk (mkBool (nonNegL (b - (a + 1)))) | false => rStuck
      } } } } } } } } }
    | _ => rStuck
  }

-- The runtime's static methods, as `Compiler/JavaAxioms.ard` calls them:
-- `unbound`/`freeVar`/`noBranch` report ill-formed λ□ by throwing;
-- `Long.valueOf` is the identity on a boxed long.
\func rtStaticCallLong (q : JQIdent) (vs : Array Value) : Maybe (Res ExprOut) =>
  \case q == "Rt.unbound" \with {
    | true => just (rOk (eExc (vExcObj "java.lang.IllegalStateException" "unbound de Bruijn index")))
    | false => \case q == "Rt.freeVar" \with {
      | true => just (rOk (eExc (vExcObj "java.lang.IllegalStateException" "free variable")))
      | false => \case q == "Rt.noBranch" \with {
        | true => just (rOk (eExc (vExcObj "java.lang.IllegalStateException" "matches no branch")))
        | false => \case q == "Long.valueOf" \with {
          | true => \case vs \with {
            | vLong i :: nil => just (rOk (eVal (vLong i)))
            | _ => just rStuck
          }
          | false => nothing
        }
      }
    }
  }

\instance rtLong : RtSpec
  | rtField => rtFieldLong
  | builtinArity => builtinArityLong
  | builtinRun => builtinRunLong
  | rtStaticCall => rtStaticCallLong
