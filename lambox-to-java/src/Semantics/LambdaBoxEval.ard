-- The semantics of λ□: weak call-by-value big-step evaluation `Eval`, by
-- substitution. This is the source side of the correctness theorem
-- (`Proof/Statement.ard`); `Semantics/LambdaBoxRun.ard` is a fuelled runner
-- for it and `Semantics/LambdaBoxEnv.ard` an environment-based variant used by
-- the proof. Nothing in the compiler imports it.
--
-- It is a transcription of MetaRocq's erasure/theories/EWcbvEval.v (`eval`),
-- with ECSubst.v (`csubst`, `substl`) and EGlobalEnv.v (`lookup_env`,
-- `iota_red`, `fix_subst`, `cunfold_fix`):
--   https://github.com/MetaRocq/metarocq/blob/coq-8.20/erasure/theories/EWcbvEval.v
--
-- One extension: an axiom oracle `LBSpec` (see its section). Upstream λ□ is
-- stuck on axioms (bodyless constants such as `Nat.add`); CertiRocq's
-- LambdaANF/eval.v and peregrine's EvalBox.v take primitives as a parameter
-- `prims`, and `LBSpec` follows them (and CompCert's `external_call`).
--
-- Upstream's `WcbvFlags` are fixed rather than parameters:
--   * `with_constructor_as_block := true`: `construct` carries all fields (as
--     produced by peregrine's `ast box` pass), so the `*_block` rules apply.
--     (The export in `Compiler/Serialize.ard` un-blocks them, because
--     peregrine's checker uses `cstr_as_blocks = false`.)
--   * `with_prop_case := false` (MetaRocq's `target_wcbv_flags`): erasure has
--     removed propositional inductives; `evalIota`/`evalProj` require
--     `indPropositional = false` instead of evaluating differently.
--   * `with_guarded_fix := false`: the compiled `fix` unfolds as soon as a
--     sibling is applied (Compiler/ToJava.ard), which is `eval_fix'`. So
--     `principalArgIdx` is carried but never constrains a reduction.
-- Rules for absent syntax (`tCoFix`, `tLazy`/`tForce`, `tEvar`) are dropped.
-- `bvar` and `fvar` have no rule: `Eval spec env (bvar n) v` is empty, as for
-- upstream `tRel`/`tVar`.
--
-- Arend has no indexed inductive families, so `Eval` is defined by `\elim` on
-- the term (every upstream rule is keyed by it; inversion comes for free); the
-- result `v` is a parameter, fixed by explicit `v = ...` premises. Functions
-- recursing into `Array LBTerm` children do it inline via `xs i` inside
-- `mkArray`, for the termination checker (see `csubst`).

\import Compiler.LambdaBox
\import Arith.Nat   -- the `DecSet Nat` instance behind `==`
-- Only `mkArray`: importing Data.Array wholesale would shadow String's `++`.
\import Data.Array (mkArray)
\import Data.Bool
\import Data.Maybe
\import Data.String
\import Set
\import Compiler.StringUtil (nthArr)


-- ---------------------------------------------------------------------------
-- Nat and Array helpers: Coq's `Nat.compare`, `List.skipn`, `List.rev`
-- (`List.nth_error` is `StringUtil.nthArr`). arend-lib's array `drop` is not
-- used because its type carries `ndrop n l.len`, which would put length
-- arithmetic into every rule that mentions it; arend-lib has no array reverse.
-- ---------------------------------------------------------------------------

-- Coq's `Nat.compare`, used by `csubst` as upstream does.
\data Comparison | cLt | cEq | cGt

\func natCompare (k n : Nat) : Comparison \elim k, n
  | 0, 0 => cEq
  | 0, suc _ => cLt
  | suc _, 0 => cGt
  | suc k, suc n => natCompare k n

\func natPred (n : Nat) : Nat \elim n
  | 0 => 0
  | suc n => n

-- `List.skipn`.
\func dropArr {A : \Type} (n : Nat) (xs : Array A) : Array A \elim n, xs
  | 0, xs => xs
  | suc _, nil => nil
  | suc n, _ :: xs => dropArr n xs

\func revAppendArr {A : \Type} (xs acc : Array A) : Array A \elim xs
  | nil => acc
  | x :: xs => revAppendArr xs (x :: acc)

-- `List.rev`.
\func revArr {A : \Type} (xs : Array A) : Array A => revAppendArr xs nil


-- ---------------------------------------------------------------------------
-- Substitution (ECSubst.v).
--
-- `csubst t k u` replaces de Bruijn index `k` by `t` inside `u` and decrements
-- the indices above `k`. It never lifts `t`: in weak cbv everything
-- substituted is a closed value, so this is the only substitution needed.
-- ---------------------------------------------------------------------------

-- What `csubst` does at a `bvar n`, given how `k` compares with `n`. The
-- comparison is a parameter rather than a `\case` inside `csubst`, so that a
-- proof holding `natCompare k n = c` can rewrite with it (a `\case` does not
-- reduce under a hypothesis about its scrutinee).
\func csubstVar (t : LBTerm) (n : Nat) (c : Comparison) : LBTerm \elim c
  | cEq => t
  | cGt => bvar n
  | cLt => bvar (natPred n)

\func csubst (t : LBTerm) (k : Nat) (u : LBTerm) : LBTerm \elim u
  | box => box
  | bvar n => csubstVar t n (natCompare k n)
  | fvar x => fvar x
  | lambda na m => lambda na (csubst t (suc k) m)
  | letIn na b b' => letIn na (csubst t k b) (csubst t (suc k) b')
  | app u v => app (csubst t k u) (csubst t k v)
  | const kn => const kn
  | construct ind c args =>
    construct ind c (mkArray {LBTerm} {args.len} (\lam i => csubst t k (args i)))
  | case ind npars discr brs =>
    case ind npars (csubst t k discr)
      (mkArray {\Sigma (Array BinderName) LBTerm} {brs.len}
        (\lam i => ((brs i).1, csubst t ((brs i).1.len Nat.+ k) (brs i).2)))
  | proj p discr => proj p (csubst t k discr)
  | fix defs idx =>
    fix (mkArray {FixDef LBTerm} {defs.len}
          (\lam j => \new FixDef LBTerm (defs j).defName
                                        (csubst t (defs.len Nat.+ k) (defs j).defBody)
                                        (defs j).principalArgIdx))
        idx
  | prim pv => prim pv

-- `substl defs body = fold_left (fun bod t => csubst t 0 bod) defs body`:
-- substitute the whole array, LEFTMOST FIRST, each time for index 0. So the
-- head of `defs` becomes index 0 of `body`.
\func substl (defs : Array LBTerm) (body : LBTerm) : LBTerm \elim defs
  | nil => body
  | d :: ds => substl ds (csubst d 0 body)

-- Substitute the whole array at the same index `k`, head first: how an
-- environment of closed values is turned back into a term
-- (`Semantics/LambdaBoxEnv.ard`).
\func substK (k : Nat) (sg : Array LBTerm) (b : LBTerm) : LBTerm \elim sg
  | nil => b
  | s :: sg => substK k sg (csubst s k b)


-- ---------------------------------------------------------------------------
-- The global environment (EGlobalEnv.v).
--
-- `lookup_env` needs a Bool-valued equality on `Kername`; `ModPath` is
-- recursive, so it is spelled out. Strings and Nats use `Set.==`.
-- ---------------------------------------------------------------------------

\func dirPathEq (a b : DirPath) : Bool \elim a, b
  | nil, nil => true
  | nil, _ :: _ => false
  | _ :: _, nil => false
  | x :: a, y :: b => (x == y) and dirPathEq a b

\func modPathEq (a b : ModPath) : Bool \elim a, b
  | mpFile p, mpFile q => dirPathEq p q
  | mpFile _, mpBound _ _ _ => false
  | mpFile _, mpDot _ _ => false
  | mpBound _ _ _, mpFile _ => false
  | mpBound p x m, mpBound q y n => dirPathEq p q and (x == y) and (m == n)
  | mpBound _ _ _, mpDot _ _ => false
  | mpDot _ _, mpFile _ => false
  | mpDot _ _, mpBound _ _ _ => false
  | mpDot p x, mpDot q y => modPathEq p q and (x == y)

\func kernameEq (a b : Kername) : Bool =>
  modPathEq a.kerModPath b.kerModPath and (a.kerName == b.kerName)

-- `lookup_env`: scan from the head, the newest declaration (see
-- `GlobalDeclarations` in `Compiler/LambdaBox.ard`).
\func lookupEnv (env : GlobalDeclarations) (kn : Kername) : Maybe GlobalDecl \elim env
  | nil => nothing
  | e :: env => \case kernameEq e.1 kn \with {
    | true => just e.2
    | false => lookupEnv env kn
  }

\func lookupConstant (env : GlobalDeclarations) (kn : Kername) : Maybe ConstantBody =>
  \case lookupEnv env kn \with {
    | nothing => nothing
    | just (constantDecl cb) => just cb
    | just (inductiveDecl _) => nothing
  }

\func lookupInductive (env : GlobalDeclarations) (ind : InductiveId)
  : Maybe (\Sigma MutualInductiveBody OneInductiveBody) =>
  \case lookupEnv env ind.indMutualBlock \with {
    | nothing => nothing
    | just (constantDecl _) => nothing
    | just (inductiveDecl mib) => \case nthArr ind.indIdx mib.indBodies \with {
      | nothing => nothing
      | just oib => just (mib, oib)
    }
  }

\func lookupConstructor (env : GlobalDeclarations) (ind : InductiveId) (c : Nat)
  : Maybe (\Sigma MutualInductiveBody OneInductiveBody ConstructorBody) =>
  \case lookupInductive env ind \with {
    | nothing => nothing
    | just (mib, oib) => \case nthArr c oib.indCtors \with {
      | nothing => nothing
      | just cb => just (mib, oib, cb)
    }
  }

-- `constructor_isprop_pars_decl`, with the constructor body replaced by the one
-- number the rules read from it (`cstr_nargs`): is the inductive propositional,
-- how many parameters does the block have, how many fields does constructor `c`
-- have.
\func constructorInfo (env : GlobalDeclarations) (ind : InductiveId) (c : Nat)
  : Maybe (\Sigma Bool Nat Nat) =>
  \case lookupConstructor env ind c \with {
    | nothing => nothing
    | just (mib, oib, cb) => just (oib.indPropositional, mib.indNpars, cb.cstrNargs)
  }

-- `cstr_arity mdecl cdecl = ind_npars + cstr_nargs`: in constructor-block form
-- a `construct` node carries the parameters too, so this is the length its
-- argument array must have.
\func constructorArity (env : GlobalDeclarations) (ind : InductiveId) (c : Nat) : Maybe Nat =>
  \case lookupConstructor env ind c \with {
    | nothing => nothing
    | just (mib, _, cb) => just (mib.indNpars Nat.+ cb.cstrNargs)
  }


-- ---------------------------------------------------------------------------
-- Reduction helpers (EGlobalEnv.v).
-- ---------------------------------------------------------------------------

-- `iota_red npar args br = substl (rev (skipn npar args)) br.2`: drop the
-- inductive parameters, then substitute the remaining fields for the branch's
-- binders. The `rev` makes the LAST binder de Bruijn index 0, as
-- `Compiler/ToJava.ard`'s `pushFields` does.
\func iotaRed (npars : Nat) (args : Array LBTerm) (br : \Sigma (Array BinderName) LBTerm) : LBTerm =>
  substl (revArr (dropArr npars args)) br.2

-- `fix_subst mfix = [tFix mfix (n-1), ..., tFix mfix 0]` (n = #|mfix|), i.e. the
-- knot: inside a body, de Bruijn 0 is the LAST definition of the block (the
-- order `Compiler/ToJava.ard`'s `pushFixMethods` also uses).
\func fixSubstAux (defs : Array (FixDef LBTerm)) (n : Nat) : Array LBTerm \elim n
  | 0 => nil
  | suc n => fix defs n :: fixSubstAux defs n

\func fixSubst (defs : Array (FixDef LBTerm)) : Array LBTerm => fixSubstAux defs defs.len

-- `cunfold_fix`: the body of definition `idx` with the whole block substituted
-- for its recursive references, together with that definition's principal
-- argument index (carried, never compared: fix is unguarded).
-- The lookup result is a parameter of `cunfoldAt` (not a `\case`), so that a
-- proof holding `nthArr idx defs = m` can rewrite with it. `nthArr`'s element
-- type is explicit: inferred, it is solved at this definition's level
-- variables and `defBody` then has a type `substl` does not accept.
\func cunfoldAt (defs : Array (FixDef LBTerm)) (m : Maybe (FixDef LBTerm)) : Maybe (\Sigma Nat LBTerm) \elim m
  | nothing => nothing
  | just d => just (d.principalArgIdx, substl (fixSubst defs) d.defBody)

\func cunfoldFix (defs : Array (FixDef LBTerm)) (idx : Nat) : Maybe (\Sigma Nat LBTerm) =>
  cunfoldAt defs (nthArr {FixDef LBTerm} idx defs)


-- ---------------------------------------------------------------------------
-- The axiom oracle.
--
-- An axiom is a constant with no body (`Nat.add`, `prim_add_int`, everything
-- `Compiler/JavaAxioms.ard` realizes). `LBSpec` maps a name to an arity and a
-- partial function on argument values, as a parameter of the semantics (like
-- CertiRocq's `prims`). The arity is needed because λ□ applies an axiom
-- curried, one `app` per argument, just as the Java side applies `Rt.Fn`;
-- `RtSpec` (`Semantics/JavaValue.ard`) has the same two fields.
-- `Semantics/LambdaBoxAxioms.ard` is the instance used for the shipped runtime.
--
-- Anything the oracle leaves `nothing` is stuck. Assumed, not enforced, of an
-- instance (as for CompCert's `external_call`): `axiomRun` returns values, and
-- (being a function) is deterministic, which keeps `Eval` deterministic.
\class LBSpec
  -- How many arguments the axiom collects before it computes (`nothing`: an
  -- axiom this oracle does not know).
  | axiomArity : Kername -> Maybe Nat
  -- What it computes, given exactly that many argument VALUES, left to right.
  | axiomRun : Kername -> Array LBTerm -> Maybe LBTerm

-- No oracle: every axiom is stuck, as in upstream λ□.
\func lbNone : LBSpec \cowith
  | axiomArity _ => nothing
  | axiomRun _ _ => nothing

-- Walk an application spine to a `const` head, collecting the arguments in
-- left-to-right order: `app (app (const kn) a1) a2` gives
-- `(kn, a1 :: a2 :: nil)`. `nothing` for any other head.
\func axiomSpine (t : LBTerm) (acc : Array LBTerm) : Maybe (\Sigma Kername (Array LBTerm))
  \elim t
  | const kn => just (kn, acc)
  | app f a => axiomSpine f (a :: acc)
  | _ => nothing

-- A saturated call to an axiom the oracle knows: `const` head with a declared
-- arity, and exactly that many arguments (as `applyVal` in
-- `Semantics/JavaEval.ard` checks on the Java side). Tested on the whole
-- application `app fv av`. Under- and over-applications give `nothing` and
-- are values by `evalAppCong`, like a Java `vBuiltin` that has not fired. An
-- arity-0 axiom never computes, on either side.
\func axiomSat (spec : LBSpec) (t : LBTerm) : Maybe (\Sigma Kername (Array LBTerm)) =>
  \case axiomSpine t nil \with {
    | nothing => nothing
    | just (kn, args) => \case axiomArity {spec} kn \with {
      | nothing => nothing
      | just arity => \case args.len == arity \with {
        | false => nothing
        | true => just (kn, args)
      }
    }
  }


-- ---------------------------------------------------------------------------
-- The side condition of the application congruence rule.
--
-- Upstream (`eval_app_cong`), an application whose function part evaluated to
-- `f'` is a value only when `f'` cannot start a redex:
--   ~~ (isLambda f' || isFix f' || isBox f' || isConstructApp f' || isPrimApp f')
-- (`isFix`, not `isFixApp`, since fix is unguarded; no `tLazy`). The first
-- three look at `f'` itself, the last two at the head of its application
-- spine: hence `appCongOk` and `appCongOkSpine`.
-- ---------------------------------------------------------------------------

\func appCongOkSpine (g : LBTerm) : Bool \elim g
  | app g' _ => appCongOkSpine g'
  | construct _ _ _ => false
  | prim _ => false
  | box => true
  | bvar _ => true
  | fvar _ => true
  | lambda _ _ => true
  | letIn _ _ _ => true
  | const _ => true
  | case _ _ _ _ => true
  | proj _ _ => true
  | fix _ _ => true

\func appCongOk (f : LBTerm) : Bool \elim f
  | box => false
  | lambda _ _ => false
  | fix _ _ => false
  | construct _ _ _ => false
  | prim _ => false
  | app g _ => appCongOkSpine g
  | bvar _ => true
  | fvar _ => true
  | letIn _ _ _ => true
  | const _ => true
  | case _ _ _ _ => true
  | proj _ _ => true


-- ---------------------------------------------------------------------------
-- The evaluation relation (EWcbvEval.v, `eval`).
--
-- `Eval spec env t v`: in global environment `env`, with axiom oracle `spec`,
-- the closed term `t` evaluates to the value `v`. One clause per `LBTerm`
-- constructor; comments give the upstream rule names.
-- ---------------------------------------------------------------------------

\data Eval (spec : LBSpec) (env : GlobalDeclarations) (t v : LBTerm) \elim t
  -- `atom`: box, abstractions and (unguarded) fixpoints are already values.
  | box => evalAtomBox (v = box)
  | lambda na b => evalAtomLambda (v = lambda na b)
  | fix defs idx => evalAtomFix (v = fix defs idx)

  -- `eval_prim`: a primitive integer evaluates to itself (there are no
  -- primitive arrays).
  | prim pv => evalPrim (v = prim pv)

  | const kn => {
    -- `eval_delta`: unfold a constant to its body.
    | evalDelta {cb : ConstantBody} {body : LBTerm}
        (lookupConstant env kn = just cb)
        (cb.cstBody = just body)
        (Eval spec env body v)

    -- (Extension) An axiom known to the oracle is a value: declared, without
    -- a body (disjoint from `evalDelta`) and with an arity. It computes only
    -- when saturated (`evalAxiomApp`), so it collects curried arguments through
    -- `evalAppCong`; the Java side splits the same way (`rtField`/`builtinRun`).
    | evalAxiom {cb : ConstantBody} {arity : Nat}
        (lookupConstant env kn = just cb)
        (cb.cstBody = nothing)
        (axiomArity {spec} kn = just arity)
        (v = const kn)
  }

  -- `eval_zeta`: let-binding, call-by-value.
  | letIn _ b0 b1 => evalZeta {b0v : LBTerm}
      (Eval spec env b0 b0v)
      (Eval spec env (csubst b0v 0 b1) v)

  | app f a => {
    -- `eval_box`: applying a proof/erased value stays erased. The argument is
    -- still evaluated (to some `av`), so `app` is strict in both positions.
    | evalBox {av : LBTerm}
        (v = box)
        (Eval spec env f box)
        (Eval spec env a av)

    -- `eval_beta`
    | evalBeta {na : BinderName} {b av : LBTerm}
        (Eval spec env f (lambda na b))
        (Eval spec env a av)
        (Eval spec env (csubst av 0 b) v)

    -- `eval_fix'` (unguarded): the fixpoint unfolds on application, without
    -- inspecting the principal argument (`narg` is unused).
    | evalFix {defs : Array (FixDef LBTerm)} {idx narg : Nat} {fn av : LBTerm}
        (Eval spec env f (fix defs idx))
        (cunfoldFix defs idx = just (narg, fn))
        (Eval spec env a av)
        (Eval spec env (app fn av) v)

    -- (Extension) The oracle computes a saturated axiom call; cf. `BStep_prim`
    -- in CertiRocq's LambdaANF/eval.v. The spine is tested on `app fv av`, so
    -- every collected argument is already a value. `kn` and `args` are
    -- explicit: left implicit, they would have to be solved from `axiomSat`'s
    -- nested `\case`s, and the elaborator reports them unsolved.
    | evalAxiomApp {fv av : LBTerm} (kn : Kername) (args : Array LBTerm)
        (Eval spec env f fv)
        (Eval spec env a av)
        (axiomSat spec (app fv av) = just (kn, args))
        (axiomRun {spec} kn args = just v)

    -- `eval_app_cong`: any other value applied to a value is a (stuck) value,
    -- e.g. a partially applied axiom. (`eval_construct` does not exist in
    -- block form, and `appCongOk` rejects construct-headed spines.)
    -- The `axiomSat ... = nothing` premise keeps the relation deterministic
    -- (disjoint from `evalAxiomApp`). It is a separate premise, not part of
    -- `appCongOk`, so that proofs can pass the equation along, and it comes
    -- after the argument's premise so that `av` is solved when it is checked.
    | evalAppCong {f' av : LBTerm}
        (Eval spec env f f')
        (appCongOk f' = true)
        (Eval spec env a av)
        (axiomSat spec (app f' av) = nothing)
        (v = app f' av)
  }

  -- `eval_construct_block`: evaluate every field and rebuild the node. `vs`
  -- has length `args.len`, which says "same length, pointwise" without `All2`.
  | construct ind c args => evalConstruct {arity : Nat} {vs : Array LBTerm args.len}
      (constructorArity env ind c = just arity)
      (args.len = arity)
      (\Pi (i : Fin args.len) -> Eval spec env (args i) (vs i))
      (v = construct ind c vs)

  -- `eval_iota_block`: evaluate the scrutinee to a constructor of this `ind`,
  -- select the branch by constructor index, drop the parameters, substitute
  -- the fields.
  | case ind npars discr brs => evalIota
      {c nargs : Nat} {args : Array LBTerm} {br : \Sigma (Array BinderName) LBTerm}
      (Eval spec env discr (construct ind c args))
      (constructorInfo env ind c = just (false, npars, nargs))
      (nthArr c brs = just br)
      (args.len = npars Nat.+ nargs)
      ((dropArr npars args).len = (br.1).len)
      (Eval spec env (iotaRed npars args br) v)

  -- `eval_proj_block`: primitive projection out of a single-constructor
  -- (constructor 0) block; the field index is offset by the parameters.
  | proj p discr => evalProj {nargs : Nat} {args : Array LBTerm} {a : LBTerm}
      (Eval spec env discr (construct p.projIndType 0 args))
      (constructorInfo env p.projIndType 0 = just (false, p.projParamCount, nargs))
      (args.len = p.projParamCount Nat.+ nargs)
      (nthArr (p.projParamCount Nat.+ p.projFieldIdx) args = just a)
      (Eval spec env a v)


-- ---------------------------------------------------------------------------
-- Program evaluation.
-- ---------------------------------------------------------------------------

-- Running a program: evaluating its term in its declarations.
\func EvalProgram (spec : LBSpec) (p : LBProgram) (v : LBTerm) : \Type =>
  Eval spec p.1 p.2 v


-- ---------------------------------------------------------------------------
-- Sanity checks: derivations for small closed programs. Every side condition
-- is discharged by `idp`, so they also test that the helpers compute.
-- ---------------------------------------------------------------------------

\func idTerm : LBTerm => lambda anon (bvar 0)

-- These take the oracle as a parameter: a parameter of class type is a local
-- instance, from which the nested constructors infer their `spec` (with
-- `lbNone` written in, `evalIdFix` fails to infer).

-- (\lam x => x) box ==> box
\func evalId (spec : LBSpec) : Eval spec nil (app idTerm box) box =>
  evalBeta (evalAtomLambda idp) (evalAtomBox idp) (evalAtomBox idp)

-- \let x := box \in x ==> box
\func evalLet (spec : LBSpec) : Eval spec nil (letIn anon box (bvar 0)) box =>
  evalZeta (evalAtomBox idp) (evalAtomBox idp)

-- A primitive integer is its own value.
\func evalPrimSelf (spec : LBSpec)
  : Eval spec nil (prim (primInt63, 7)) (prim (primInt63, 7)) => evalPrim idp

-- `fix { f := \lam x => x } 0` applied to `box`: exercises `fixSubst`,
-- `substl` and `csubst`.
\func idFixDefs : Array (FixDef LBTerm) => (\new FixDef LBTerm anon idTerm 0) :: nil

\func evalIdFix (spec : LBSpec) : Eval spec nil (app (fix idFixDefs 0) box) box =>
  evalFix (evalAtomFix idp) idp (evalAtomBox idp)
          (evalBeta (evalAtomLambda idp) (evalAtomBox idp) (evalAtomBox idp))


-- ---------------------------------------------------------------------------
-- The oracle rules, against a toy oracle (the real one is
-- `Semantics/LambdaBoxAxioms.ard`).
-- ---------------------------------------------------------------------------

\func sndKn : Kername => \new Kername (mpFile nil) "snd"

-- A binary axiom returning its second argument: exercises partial application
-- and pins the order in which `axiomSpine` collects arguments.
\func lbSnd : LBSpec \cowith
  | axiomArity kn => \case kernameEq kn sndKn \with { | true => just 2 | false => nothing }
  | axiomRun kn args => \case kernameEq kn sndKn, args \with {
    | true, _ :: y :: nil => just y
    | _, _ => nothing
  }

\func sndEnv : GlobalDeclarations =>
  (sndKn, constantDecl (\new ConstantBody nothing)) :: nil

-- Unapplied, the axiom is a value.
\func evalAxiomIsValue : Eval lbSnd sndEnv (const sndKn) (const sndKn) =>
  evalAxiom idp idp idp idp

-- Applied to one argument it is a stuck value (congruence).
\func evalAxiomPartial
  : Eval lbSnd sndEnv (app (const sndKn) (prim (primInt63, 1)))
                      (app (const sndKn) (prim (primInt63, 1))) =>
  evalAppCong evalAxiomIsValue idp (evalPrim idp) idp idp

-- Applied to both, the oracle computes the second argument.
\func evalAxiomFires
  : Eval lbSnd sndEnv (app (app (const sndKn) (prim (primInt63, 1))) (prim (primInt63, 2)))
                      (prim (primInt63, 2)) =>
  evalAxiomApp sndKn (prim (primInt63, 1) :: prim (primInt63, 2) :: nil)
               evalAxiomPartial (evalPrim idp) idp idp
