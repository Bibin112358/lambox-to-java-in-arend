\import Arith.Nat
\import Data.Array (++, mkArray)
\import Data.Bool
\import Data.Maybe
\import Semantics.LambdaBoxEval
\import Compiler.LambdaBox
\import Logic
\import Paths
\import Set
\import Compiler.StringUtil (nthArr)

-- =============================================================================
-- λ□ WITH ENVIRONMENTS: the middle language of the two-step correctness proof.
--
-- MetaRocq does not prove its backends against the substitution semantics of
-- `EWcbvEval` directly. It first proves that semantics equivalent to an
-- ENVIRONMENT semantics on the same terms (`EWcbvEvalNamed.v`,
-- `eval_to_eval_named`), and only then compiles that to Malfunction, where
-- both sides keep environments and closures and the value relation is almost a
-- function (`compile_value`). This file is our `EWcbvEvalNamed`:
--
--   * `EV`: the values of the environment semantics -- closures (`evClos`,
--     `evFix`) carry the environment they were built in, and data/primitive
--     values are what they are. `evAx kn args` is an axiom still collecting its
--     arguments, NEWEST FIRST (so extending it is `::`, no snoc).
--   * `quote`: the READ-BACK of an `EV` as the λ□ term it stands for -- a
--     closure is its body with its environment SUBSTITUTED (`substK`). This one
--     function is the whole relation between the two λ□ semantics, the role
--     `represents_value` plays upstream; it is a function here because a value
--     determines the term it stands for.
--   * `EvalE`/`ApplyE`: big-step, call-by-value, one rule per rule of
--     `LambdaBoxEval.Eval`, with the environment in place of substitution.
--
-- The step "λ□ (substitution) => λ□ (environments)" is
-- `Proof/SubstToEnv.ard`; the step "λ□ (environments) => Java" is the
-- backend proof proper, and there both sides keep environments.
--
-- THE ORACLE. An axiom is consulted on the READ-BACK of its arguments, in λ□'s
-- own terms (`axiomSat`/`axiomRun` of `LBSpec`, unchanged), so the oracle is
-- the same object in both semantics -- nothing to prove about it at this step.
-- What it returns is a λ□ term, embedded back by `ofFO`; that is faithful for
-- first-order results (`FOVal`), which is what the shipped oracle returns and
-- what `EvalEnvSound` assumes of the oracle it is given.
-- =============================================================================

\data EV
  | evBox
  | evClos BinderName LBTerm (Array EV)
  | evFix (Array (FixDef LBTerm)) Nat (Array EV)
  | evCon InductiveId Nat (Array EV)
  | evPrim PrimVal
  | evAx Kername (Array EV)

-- An axiom applied to arguments, NEWEST FIRST: `quoteAx kn (a2 :: a1 :: nil)`
-- is `app (app (const kn) a1) a2`.
\func quoteAx (kn : Kername) (qs : Array LBTerm) : LBTerm \elim qs
  | nil => const kn
  | q :: qs => app (quoteAx kn qs) q

\func quote (w : EV) : LBTerm \elim w
  | evBox => box
  | evClos na b rho => substK 0 (mkArray {LBTerm} {rho.len} (\lam i => quote (rho i))) (lambda na b)
  | evFix defs idx rho => substK 0 (mkArray {LBTerm} {rho.len} (\lam i => quote (rho i))) (fix defs idx)
  | evCon ind c args => construct ind c (mkArray {LBTerm} {args.len} (\lam i => quote (args i)))
  | evPrim pv => prim pv
  | evAx kn args => quoteAx kn (mkArray {LBTerm} {args.len} (\lam i => quote (args i)))

\func quoteEnv (rho : Array EV) : Array LBTerm => mkArray {LBTerm} {rho.len} (\lam i => quote (rho i))

-- Definitional, and used everywhere: the read-back of an extended environment.
\func quoteEnvCons (w : EV) (rho : Array EV) : quoteEnv (w :: rho) = quote w :: quoteEnv rho => idp

-- ---------------------------------------------------------------------------
-- First-order values, and their embedding (for what the oracle returns).
-- ---------------------------------------------------------------------------

\func FOVal (t : LBTerm) : \Prop \elim t
  | box => \Sigma
  | prim _ => \Sigma
  | construct _ _ args => \Pi (i : Fin args.len) -> FOVal (args i)
  | bvar _ => Empty
  | fvar _ => Empty
  | lambda _ _ => Empty
  | letIn _ _ _ => Empty
  | app _ _ => Empty
  | const _ => Empty
  | case _ _ _ _ => Empty
  | proj _ _ => Empty
  | fix _ _ => Empty

\func ofFO (t : LBTerm) : EV \elim t
  | box => evBox
  | prim pv => evPrim pv
  | construct ind c args => evCon ind c (mkArray {EV} {args.len} (\lam i => ofFO (args i)))
  | _ => evBox

-- ---------------------------------------------------------------------------
-- The fix environment: `fixSubst`, as closures.
-- ---------------------------------------------------------------------------

-- `[evFix defs (n-1) rho, ..., evFix defs 0 rho]`, the order of `fixSubstAux`.
\func fixEnvAux (defs : Array (FixDef LBTerm)) (rho : Array EV) (n : Nat) : Array EV \elim n
  | 0 => nil
  | suc n => evFix defs n rho :: fixEnvAux defs rho n

\func fixEnv (defs : Array (FixDef LBTerm)) (rho : Array EV) : Array EV => fixEnvAux defs rho defs.len

-- ---------------------------------------------------------------------------
-- THE EVALUATION RELATION. `EvalE spec genv rho t w`: under the global
-- declarations `genv`, the term `t` with its free indices bound by `rho`
-- (index `i` is `rho i`) evaluates to `w`. `ApplyE wf wa w`: the value `wf`
-- applied to `wa` gives `w`.
-- ---------------------------------------------------------------------------

\data EvalE (spec : LBSpec) (genv : GlobalDeclarations) (rho : Array EV) (t : LBTerm) (w : EV) \elim t
  | box => eeBox (w = evBox)
  | bvar n => eeVar (nthArr n rho = just w)
  | lambda na b => eeLam (w = evClos na b rho)
  | fix defs idx => eeFix (w = evFix defs idx rho)
  | prim pv => eePrim (w = evPrim pv)
  | const kn => {
    -- A constant's body is closed: it is evaluated in the EMPTY environment.
    | eeDelta {cb : ConstantBody} {body : LBTerm}
        (lookupConstant genv kn = just cb)
        (cb.cstBody = just body)
        (EvalE spec genv nil body w)
    | eeAxiom {cb : ConstantBody} {arity : Nat}
        (lookupConstant genv kn = just cb)
        (cb.cstBody = nothing)
        (axiomArity {spec} kn = just arity)
        (w = evAx kn nil)
  }
  | letIn _ b0 b1 => eeLet {w0 : EV}
      (EvalE spec genv rho b0 w0)
      (EvalE spec genv (w0 :: rho) b1 w)
  | app f a => eeApp {wf wa : EV}
      (EvalE spec genv rho f wf)
      (EvalE spec genv rho a wa)
      (ApplyE spec genv wf wa w)
  | construct ind c args => eeCon {arity : Nat} {ws : Array EV args.len}
      (constructorArity genv ind c = just arity)
      (args.len = arity)
      (\Pi (i : Fin args.len) -> EvalE spec genv rho (args i) (ws i))
      (w = evCon ind c ws)
  -- The fields are bound the way `iotaRed` substitutes them: parameters
  -- dropped, the LAST field index 0.
  | case ind npars discr brs => eeCase
      {c nargs : Nat} {args : Array EV} {br : \Sigma (Array BinderName) LBTerm}
      (EvalE spec genv rho discr (evCon ind c args))
      (constructorInfo genv ind c = just (false, npars, nargs))
      (nthArr c brs = just br)
      (args.len = npars Nat.+ nargs)
      ((dropArr npars args).len = (br.1).len)
      (EvalE spec genv (revArr (dropArr npars args) ++ rho) br.2 w)
  | proj p discr => eeProj {nargs : Nat} {args : Array EV}
      (EvalE spec genv rho discr (evCon p.projIndType 0 args))
      (constructorInfo genv p.projIndType 0 = just (false, p.projParamCount, nargs))
      (args.len = p.projParamCount Nat.+ nargs)
      (nthArr (p.projParamCount Nat.+ p.projFieldIdx) args = just w)

\data ApplyE (spec : LBSpec) (genv : GlobalDeclarations) (wf wa w : EV) \elim wf
  -- `eval_box`
  | evBox => apBox (w = evBox)
  -- `eval_beta`: the closure's environment, extended with the argument.
  | evClos _ b rho => apBeta (EvalE spec genv (wa :: rho) b w)
  -- `eval_fix'` (unguarded): the body of definition `idx`, in the closure's
  -- environment extended with the whole block, is evaluated and then applied.
  | evFix defs idx rho => apFix {d : FixDef LBTerm} {wfn : EV}
      (nthArr {FixDef LBTerm} idx defs = just d)
      (EvalE spec genv (fixEnv defs rho ++ rho) d.defBody wfn)
      (ApplyE spec genv wfn wa w)
  | evAx kn args => {
    -- The oracle fires, on the read-back of the saturated spine.
    | apAxRun (kn' : Kername) (xs : Array LBTerm) {r : LBTerm}
        (axiomSat spec (app (quote (evAx kn args)) (quote wa)) = just (kn', xs))
        (axiomRun {spec} kn' xs = just r)
        (w = ofFO r)
    -- Not saturated: one more argument collected.
    | apAxPart
        (axiomSat spec (app (quote (evAx kn args)) (quote wa)) = nothing)
        (w = evAx kn (wa :: args))
  }

\func EvalEProgram (spec : LBSpec) (p : LBProgram) (w : EV) : \Type => EvalE spec p.1 nil p.2 w

-- ---------------------------------------------------------------------------
-- Sanity checks.
-- ---------------------------------------------------------------------------

-- (\x. x) box
\func eeId (spec : LBSpec) : EvalE spec nil nil (app (lambda anon (bvar 0)) box) evBox =>
  eeApp (eeLam idp) (eeBox idp) (apBeta (eeVar idp))

-- let x := box in (\y. x) box
\func eeLetCapture (spec : LBSpec)
  : EvalE spec nil nil (letIn anon box (app (lambda anon (bvar 1)) box)) evBox =>
  eeLet (eeBox idp) (eeApp (eeLam idp) (eeBox idp) (apBeta (eeVar idp)))
