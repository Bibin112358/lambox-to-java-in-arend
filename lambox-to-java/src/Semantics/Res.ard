-- The result of running a semantics with fuel: a value, stuck, or out of fuel.
-- Shared by the Java runner (`Semantics/JavaEval.ard`) and the λ□ runner
-- (`Semantics/LambdaBoxRun.ard`).
--
-- `rStuck` (the semantics does not define this) is kept apart from
-- `rOutOfFuel` (the budget was too small): when comparing two runs, only the
-- first is a real disagreement. The fuel discipline follows Owens et al.,
-- "Functional Big-Step Semantics" (ESOP 2016).

\data Res (A : \Type)
  | rOk A
  | rStuck
  | rOutOfFuel

\func bindRes {A B : \Type} (r : Res A) (f : A -> Res B) : Res B \elim r
  | rOk a => f a
  | rStuck => rStuck
  | rOutOfFuel => rOutOfFuel
