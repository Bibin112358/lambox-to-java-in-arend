\import Data.Maybe
\import Data.String
\import Compiler.Int63 (wrap63)
\import Compiler.LambdaBox
\import Semantics.RtInt63
\import Semantics.RtLong
\import ExamplePeano
\import Compiler.JavaAst
\import Semantics.JavaEval
\import Semantics.Res
\import Semantics.JavaValue
\import Paths
\import Compiler.ToJava

-- The Java-fragment semantics (`Semantics/JavaEval.ard`) run on compiled
-- programs: λ□ program -> `compileClass` -> `runClass`, compared with the
-- expected value. Each check is `idp`, so typechecking this module runs it.
--
-- `peanoEvaluates` checks against what the real JVM prints for the corpus
-- program `peano` (`test/corpora/handwritten/peano/meta`: `1(1(1(1(0))))`).
-- The other programs are minimal, one feature each: the runtime interface
-- (an axiom), wraparound at 2^63, `proj` (with and without parameters) and a
-- `case` that throws. They carry no inductive declarations, so they are
-- Java-only (see `ModelChecks/Agreement.ard` for two-sided checks).
--
-- These live in the examples project because they need committed λ□ programs
-- (`test/arend/src/Imported/` is generated and gitignored).

-- A runtime that covers nothing: enough for peano, which has no axioms and no
-- integer literals, so that run is about the fragment alone.
\func rtNone : RtSpec \cowith
  | rtField _ => nothing
  | builtinArity _ => nothing
  | builtinRun _ _ => rStuck
  | rtStaticCall _ _ => nothing

\func peanoClass : JClass => compileClass "Prog" addProgram

-- suc^4 zero, as a value of the fragment: `Nat`'s constructors are zero = tag 0
-- and suc = tag 1, and an erased inductive's parameters are not stored.
\func sucV (v : Value) : Value => vData 1 (v :: nil)

\func zeroV : Value => vData 0 nil

\func four : Value => sucV (sucV (sucV (sucV zeroV)))

-- 1 + 3 = 4, computed by the semantics of the generated Java.
-- (a `\func`, not a `\lemma`: `Res RunOut` is a type, not a proposition.)
\func peanoEvaluates : runClass rtNone peanoClass bodyMethodName 2000 = rOk (rvValue four)
  => idp

-- The same under `rtLong`: a runtime that can answer does not change a program
-- that never asks.
\func peanoUnderRtLong : runClass rtLong peanoClass bodyMethodName 2000 = rOk (rvValue four)
  => idp

-- ---------------------------------------------------------------------------
-- What peano does not reach: the runtime interface (`jField` -> `rtField` ->
-- a `vBuiltin` collecting arguments until `builtinRun`), `proj` (which no
-- corpus program exercises), and a throw.
-- ---------------------------------------------------------------------------

-- An axiom (a constant with no body), which `compileDecl` resolves through
-- `javaAxioms` to `Rt.PRIM_ADD_INT63`.
\func primAddKn : Kername => \new Kername (mpFile nil) "prim_add_int"

\func axiomDecls : GlobalDeclarations =>
  (primAddKn, constantDecl (\new ConstantBody nothing)) :: nil

-- An int63 literal (payloads are built with `wrap63`).
\func litT (i : Int) : LBTerm => prim (primInt63, wrap63 i)

\func addT (a b : LBTerm) : LBTerm => app (app (const primAddKn) a) b

-- 2 + 3 = 5: reads `Rt.PRIM_ADD_INT63` as a field and applies it twice (one
-- argument leaves a `vBuiltin` holding it, the second saturates). Run against
-- `rtInt63`, which models the `_INT63` family (under `rtLong` it is stuck).
\func addClass : JClass => compileClass "Prog" (axiomDecls, addT (litT 2) (litT 3))

\func addEvaluates : runClass rtInt63 addClass bodyMethodName 100 = rOk (rvValue (vLong 5))
  => idp

-- At the edge of the range: (2^63-1) + 1 is 0, since a λ□ primitive int is a
-- `Uint63` (as `Semantics/LambdaBoxAxioms.ard`'s `int63Run` also says).
\func wrapClass : JClass =>
  compileClass "Prog" (axiomDecls, addT (litT 9223372036854775807) (litT 1))

\func wrapEvaluates
  : runClass rtInt63 wrapClass bodyMethodName 100 = rOk (rvValue (vLong 0))
  => idp

-- For contrast: JVM `long` addition (`PRIM_ADD_LONG`) wraps signed at 2^64
-- and gives -2^63.
\func longWouldHaveSaid
  : builtinRunLong "PRIM_ADD_LONG" (vLong 9223372036854775807 :: vLong 1 :: nil)
  = rOk (vLong (neg 9223372036854775808))
  => idp

-- `proj`: field 0 of a one-field constructor, with no inductive parameters.
-- Compiles to `((Rt.Data)(e)).fields[0]`.
\func boxInd : InductiveId => \new InductiveId (\new Kername (mpFile nil) "Box") 0

\func projClass : JClass =>
  compileClass "Prog"
    (nil, proj (\new ProjectionInfo boxInd 0 0) (construct boxInd 0 (litT 7 :: nil)))

\func projEvaluates : runClass rtLong projClass bodyMethodName 100 = rOk (rvValue (vLong 7))
  => idp

-- With one inductive parameter stored ahead of the fields, field 0 is physical
-- field 1 (`npars + idx`, folded by the compiler): reading 5 instead of 7
-- would mean the offset is missing.
\func projParamClass : JClass =>
  compileClass "Prog"
    (nil, proj (\new ProjectionInfo boxInd 1 0) (construct boxInd 0 (litT 5 :: litT 7 :: nil)))

\func projParamEvaluates
  : runClass rtLong projParamClass bodyMethodName 100 = rOk (rvValue (vLong 7))
  => idp

-- A `case` with no branches (an erased `Empty`): the scrutinee is evaluated
-- and cast, and `Rt.noBranch` throws, which `runClass` reports as `rvThrown`.
\func emptyCaseClass : JClass =>
  compileClass "Prog" (nil, case boxInd 0 (construct boxInd 0 nil) nil)

\func emptyCaseThrows
  : runClass rtLong emptyCaseClass bodyMethodName 100
  = rOk (rvThrown (vExcObj "java.lang.IllegalStateException" "matches no branch"))
  => idp
