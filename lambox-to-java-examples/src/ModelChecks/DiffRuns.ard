\import Data.Maybe
\import Data.String
\import Debug (putStrLn)
\import ExamplePeano (addProgram)
\import ExampleSort (sortProgram)
\import ModelChecks.Agreement (twoProgram, predProgram, zeroCaseProgram, litProgram, addAxiomProgram,
                               natAddProgram, boolCaseProgram, boolProgram, natSubProgram, int63Program,
                               natDivProgram, axiomKn, subAxiomKn)
\import Compiler.Int63 (signed64)
\import Compiler.LambdaBox
\import Compiler.StringUtil (natToStr, intToStr, joinStr)
\import Compiler.ToJava (compileProgram, compileClass, bodyMethodName)
\import Proof.Statement (progClassName)
\import Semantics.JavaEval
\import Semantics.JavaValue
\import Semantics.LambdaBoxAxioms (lbAxioms)
\import Semantics.LambdaBoxRun (runProgram)
\import Semantics.Res
\import Semantics.RtInt63 (rtInt63)

-- =============================================================================
-- Differential test: the Arend models against the real JVM.
--
-- Each `\func` below prints, for one small λ□ program,
--   * the generated Java (`compileProgram`),
--   * the value the λ□ semantics computes (`runProgram lbAxioms`),
--   * the value the Java-fragment semantics computes for the compiled class
--     (`runClass rtInt63`),
-- the two values in the format `Rt.runMain` prints them on the JVM (`tag(f,..)`,
-- decimal longs, `BOX`). `test/check diff` compiles and runs the Java for real
-- and compares the three values (whitespace ignored). `ModelChecks/Agreement.ard`
-- checks the two models against EACH OTHER by `idp`; this adds the JVM.
-- =============================================================================

\func wrapFields (tag : String) (fs : Array String) : String \elim fs
  | nil => tag
  | f :: fs => tag ++ "(" ++ joinStr "," (f :: fs) ++ ")"

-- λ□ values, laid out as `Proof.Statement.agrees` relates them to Java values.
\func showLB (n : Nat) (t : LBTerm) : String \elim n
  | 0 => "<too deep>"
  | suc n => \case t \with {
    | box => "BOX"
    | prim (rocqUint63, i) => natToStr i
    | prim (javaLong, i) => intToStr (signed64 i)
    | construct _ c args => wrapFields (natToStr c) (showLBs n args)
    | _ => "<not first-order>"
  }

\func showLBs (n : Nat) (ts : Array LBTerm) : Array String \elim ts
  | nil => nil
  | t :: ts => showLB n t :: showLBs n ts

-- Java-fragment values, as `Rt.Data.render` / `String.valueOf` print them.
\func showV (n : Nat) (v : Value) : String \elim n
  | 0 => "<too deep>"
  | suc n => \case v \with {
    | vBox => "BOX"
    | vLong j => intToStr j.1
    | vData tg fs => wrapFields (natToStr tg) (showVs n fs)
    | _ => "<not first-order>"
  }

\func showVs (n : Nat) (vs : Array Value) : Array String \elim vs
  | nil => nil
  | v :: vs => showV n v :: showVs n vs

\func showLBRes (r : Res LBTerm) : String \elim r
  | rOk t => showLB 1000 t
  | rStuck => "<stuck>"
  | rOutOfFuel => "<out of fuel>"

\func showJRes (r : Res RunOut) : String \elim r
  | rOk (rvValue v) => showV 1000 v
  | rOk (rvThrown _) => "<exception>"
  | rStuck => "<stuck>"
  | rOutOfFuel => "<out of fuel>"

\func diffFuel : Nat => 5000

\func dump (name : String) (p : LBProgram) : String =>
  "===== " ++ name ++ " java =====\n" ++ compileProgram "Prog" p ++
  "\n===== " ++ name ++ " lambdabox-model =====\n" ++ showLBRes (runProgram lbAxioms p diffFuel) ++
  "\n===== " ++ name ++ " java-model =====\n" ++
  showJRes (runClass rtInt63 (compileClass progClassName p) bodyMethodName diffFuel) ++
  "\n===== " ++ name ++ " end ====="

-- The same without the λ□ model, for programs with deeper recursion: the
-- substitution-based runner is evaluated by Arend's normalizer without
-- sharing, and runs out of memory after two or three `fix` unfoldings
-- (`add 2 1` already does), while `runClass` handles them in seconds.
\func dumpJavaOnly (name : String) (p : LBProgram) : String =>
  "===== " ++ name ++ " java =====\n" ++ compileProgram "Prog" p ++
  "\n===== " ++ name ++ " lambdabox-model =====\n<skipped>" ++
  "\n===== " ++ name ++ " java-model =====\n" ++
  showJRes (runClass rtInt63 (compileClass progClassName p) bodyMethodName diffFuel) ++
  "\n===== " ++ name ++ " end ====="

-- Two int63 edge cases the JVM must wrap exactly like λ□'s `Uint63`.
\func subZeroProgram : LBProgram =>
  ((subAxiomKn, constantDecl (\new ConstantBody nothing)) :: nil,
   app (app (const subAxiomKn) (prim (rocqUint63, 0))) (prim (rocqUint63, 1)))

\func addNearOverflowProgram : LBProgram =>
  ((axiomKn, constantDecl (\new ConstantBody nothing)) :: nil,
   app (app (const axiomKn) (prim (rocqUint63, 9223372036854775806))) (prim (rocqUint63, 1)))

\func diffPeano => putStrLn (dump "peano" addProgram)
\func diffSort => putStrLn (dumpJavaOnly "insertion-sort" sortProgram)
\func diffTwo => putStrLn (dump "two" twoProgram)
\func diffPred => putStrLn (dump "pred" predProgram)
\func diffZeroCase => putStrLn (dump "zero-case" zeroCaseProgram)
\func diffLit => putStrLn (dump "lit" litProgram)
\func diffPrimAdd => putStrLn (dump "prim-add" addAxiomProgram)
\func diffNatAdd => putStrLn (dump "nat-add" natAddProgram)
\func diffBoolCase => putStrLn (dump "bool-case" boolCaseProgram)
\func diffBool => putStrLn (dump "bool" boolProgram)
\func diffNatSub => putStrLn (dump "nat-sub" natSubProgram)
\func diffInt63Sub => putStrLn (dump "int63-sub" int63Program)
\func diffNatDiv => putStrLn (dump "nat-div" natDivProgram)
\func diffSubZero => putStrLn (dump "sub-zero" subZeroProgram)
\func diffAddNearOverflow => putStrLn (dump "add-near-overflow" addNearOverflowProgram)
