\import Arith.Nat
\import Data.Bool
\import Data.Maybe
\import Data.String
\import ExamplePeano
\import ModelChecks.Agreement
\import Proof.Statement
\import Semantics.JavaEval
\import Semantics.JavaValue
\import Semantics.LambdaBoxEval
\import Semantics.LambdaBoxRun
\import Proof.LambdaBoxSound
\import Proof.LongRewriteSpec
\import Semantics.LambdaBoxAxioms
\import Compiler.Int63 (wrap63, wrap64u)
\import Compiler.LongRewrite
\import Semantics.Res
\import Semantics.RtInt63
\import Semantics.RtLong
\import Compiler.JavaAst
\import Compiler.LambdaBox
\import Compiler.Mangle
\import Logic
\import Paths
\import Set
\import Compiler.StringUtil (intEqB)
\import Compiler.ToJava

-- Concrete instances of the correctness statement, checked by computation.
--
-- The general theorem is proved (`Proof/MainTheorem.ard`); these are cheap
-- executable sanity checks of the models and the compiler on small programs,
-- one per λ□ construct. Each instance lines up three things: a λ□ derivation
-- `EvalProgram lbAxioms p v` (by hand, or via the runner's soundness proof
-- `evalT-sound`), the compiled Java run by `Semantics/JavaEval.ard` against
-- `rtInt63`, and `agrees` between the two results. Most come with a NEGATIVE
-- check that a wrong value is rejected, without which the positive one would
-- prove little.
--
-- Also here: integer overflow at 2^63 (λ□ and Java both wrap), and the
-- int64 rewrite (`Compiler/LongRewrite.ard`): one program whose value it
-- preserves and one where it does not.

-- The compiled program returns a value related to `v`. A throw, being stuck
-- or running out of fuel are all failures.
\func relatedTo (p : LBProgram) (n : Nat) (v : LBTerm) : Bool =>
  \case runClass rtInt63 (compileClass progClassName p) bodyMethodName n \with {
    | rOk (rvValue jv) => agrees v jv
    | _ => false
  }

-- ---------------------------------------------------------------------------
-- 1. `box` -- the erased proof. Compiles to `Rt.BOX`.
-- ---------------------------------------------------------------------------

\func boxProgram : LBProgram => (nil, box)

\func lbBox (spec : LBSpec) : EvalProgram spec boxProgram box => evalAtomBox idp

\func jBox : relatedTo boxProgram 20 box = true => idp

-- ---------------------------------------------------------------------------
-- 2. `letIn` -- exercises `jLocal` with an initialiser.
--
--   \let x := box \in x            ==>   final Object l = Rt.BOX; ... l
-- ---------------------------------------------------------------------------

\func letProgram : LBProgram => (nil, letIn anon box (bvar 0))

\func lbLet (spec : LBSpec) : EvalProgram spec letProgram box =>
  evalZeta (evalAtomBox idp) (evalAtomBox idp)

\func jLet : relatedTo letProgram 20 box = true => idp

-- ---------------------------------------------------------------------------
-- 3. beta -- a closure applied to an argument. Exercises `jClosure`, the
-- `.apply` call and `jVar` on a parameter.
--
--   (\lam x => x) box
-- ---------------------------------------------------------------------------

\func idTerm : LBTerm => lambda anon (bvar 0)

\func betaProgram : LBProgram => (nil, app idTerm box)

\func lbBeta (spec : LBSpec) : EvalProgram spec betaProgram box =>
  evalBeta (evalAtomLambda idp) (evalAtomBox idp) (evalAtomBox idp)

\func jBeta : relatedTo betaProgram 20 box = true => idp

-- ---------------------------------------------------------------------------
-- 3b. `eval_box` -- applying an erased value (erasure produces this whenever a
-- type former or proof is applied). Compiles to `((Rt.Fn)Rt.BOX).apply(Rt.BOX)`,
-- which works because `Rt.BOX` is an `Fn` returning itself.
-- ---------------------------------------------------------------------------

\func boxAppProgram : LBProgram => (nil, app box box)

\func lbBoxApp (spec : LBSpec) : EvalProgram spec boxAppProgram box =>
  evalBox idp (evalAtomBox idp) (evalAtomBox idp)

\func jBoxApp : relatedTo boxAppProgram 20 box = true => idp

-- And through a closure: `(\lam f => f box) box` is still `box`.
\func boxAppViaProgram : LBProgram => (nil, app (lambda anon (app (bvar 0) box)) box)

\func jBoxAppVia : relatedTo boxAppViaProgram 20 box = true => idp

-- ---------------------------------------------------------------------------
-- 3c. Names. `const` and the axiom table identify a constant by its mangled
-- name, so distinct kernames must mangle differently (`Compiler/Mangle.ard`).
-- These pairs would collide under a naive `_`-joined encoding.
-- ---------------------------------------------------------------------------

\func knAB : Kername => \new Kername (mpFile ("A_B" :: nil)) "x"
\func knA_B : Kername => \new Kername (mpFile ("A" :: "B" :: nil)) "x"
\func knDotAB : Kername => \new Kername (mpDot (mpFile ("A" :: nil)) "B") "x"

\func mangleSplitsDirs : (mangleKername knAB == mangleKername knA_B) = false => idp
\func mangleSplitsDot : (mangleKername knDotAB == mangleKername knA_B) = false => idp

-- A module named `_Nat` is not Lean's `Nat`: its `add` is an unknown axiom,
-- while the real `Nat.add` resolves.
\func underscoreNatIsNotNat
  : axiomRtName (\new Kername (mpDot (mpFile nil) "_Nat") "add") = nothing => idp

\func natAddStillResolves
  : axiomRtName (\new Kername (mpDot (mpFile nil) "Nat") "add") = just "PRIM_ADD_INT63" => idp

-- ---------------------------------------------------------------------------
-- 4. `prim` -- a primitive integer, i.e. `Long.valueOf(7L)` and `agrees`'s
-- `vLong`/`prim` case, neither of which the Peano program touches (Peano
-- numerals are constructors, not primitives).
-- ---------------------------------------------------------------------------

\func primProgram : LBProgram => (nil, prim (rocqUint63, 7))

\func lbPrim (spec : LBSpec) : EvalProgram spec primProgram (prim (rocqUint63, 7)) => evalPrim idp

\func jPrim : relatedTo primProgram 20 (prim (rocqUint63, 7)) = true => idp

-- The relation must distinguish integers, or `jPrim` is vacuous.
\func jPrimRejects : relatedTo primProgram 20 (prim (rocqUint63, 8)) = false => idp

-- ---------------------------------------------------------------------------
-- 5. `proj` -- the offset guard.
--
-- A projection compiles to `((Rt.Data)(s)).fields[npars + idx]`. The inductive
-- has one parameter and one constructor with two fields, so projecting field 1
-- must read index 2; the three arguments are distinguishable so that dropping
-- the `npars` offset changes the answer.
-- ---------------------------------------------------------------------------

\func pairKername : Kername => \new Kername (mpFile nil) "Pair"

\func pairInd : InductiveId => \new InductiveId pairKername 0

\func pairCtors : Array ConstructorBody => (\new ConstructorBody "mk" 2) :: nil

\func pairMutual : MutualInductiveBody =>
  \new MutualInductiveBody finite 1
    ((\new OneInductiveBody "Pair" false IntoAny pairCtors
        ((\new ProjectionBody "fst") :: (\new ProjectionBody "snd") :: nil)) :: nil)

\func pairDecls : GlobalDeclarations => (pairKername, inductiveDecl pairMutual) :: nil

-- `mk <param> 20 21`, the parameter erased to `box`.
\func pairTerm : LBTerm =>
  construct pairInd 0 (box :: prim (rocqUint63, 20) :: prim (rocqUint63, 21) :: nil)

-- Project field 1 (the second field), i.e. index `npars + 1 = 2`, value 21.
\func projInfo1 : ProjectionInfo => \new ProjectionInfo pairInd 1 1

\func projProgram : LBProgram => (pairDecls, proj projInfo1 pairTerm)

-- The λ□ derivation; `evalProj`'s side conditions pin the offset arithmetic.
\func lbPair (spec : LBSpec) : Eval spec pairDecls pairTerm pairTerm =>
  evalConstruct idp idp
    (\lam i => \case \elim i \with {
      | 0 => evalAtomBox idp
      | 1 => evalPrim idp
      | 2 => evalPrim idp
    })
    idp

\func lbProj (spec : LBSpec) : EvalProgram spec projProgram (prim (rocqUint63, 21)) =>
  evalProj (lbPair spec) idp idp idp (evalPrim idp)

\func jProj : relatedTo projProgram 40 (prim (rocqUint63, 21)) = true => idp

-- The off-by-one guard: without the offset the result would be 20.
\func jProjNotFieldZero : relatedTo projProgram 40 (prim (rocqUint63, 20)) = false => idp

-- ---------------------------------------------------------------------------
-- 6. A `fix` block with two definitions: is the right one selected?
-- Definition 0 returns `box`, definition 1 is the identity; index 1 applied to
-- 5 must give 5.
-- ---------------------------------------------------------------------------

\func constBoxTerm : LBTerm => lambda anon box

\func twoDefs : Array (FixDef LBTerm) =>
  (\new FixDef LBTerm anon constBoxTerm 0) ::
  (\new FixDef LBTerm anon idTerm 0) :: nil

\func fix2Program : LBProgram => (nil, app (fix twoDefs 1) (prim (rocqUint63, 5)))

\func lbFix2 (spec : LBSpec) : EvalProgram spec fix2Program (prim (rocqUint63, 5)) =>
  evalFix (evalAtomFix idp) idp (evalPrim idp)
          (evalBeta (evalAtomLambda idp) (evalPrim idp) (evalPrim idp))

\func jFix2 : relatedTo fix2Program 40 (prim (rocqUint63, 5)) = true => idp

-- The selection guard: had either side taken definition 0, the result is `box`.
\func jFix2NotSlotZero : relatedTo fix2Program 40 box = false => idp

-- ---------------------------------------------------------------------------
-- 7. Peano: `const` unfolding, `case`, and a one-definition `fix`, on a real
-- two-declaration program. The λ□ derivation comes from the runner via
-- `evalT-sound` (it is too big to write by hand).
-- ---------------------------------------------------------------------------

\func lbPeano : EvalProgram lbAxioms addProgram (suc' (suc' (suc' (suc' zero'))))
  => evalT-sound lbAxioms 2000 idp

\func jPeano : relatedTo addProgram 2000 (suc' (suc' (suc' (suc' zero')))) = true => idp

-- 3 is not 4: the relation distinguishes unary numerals.
\func jPeanoRejects : relatedTo addProgram 2000 three = false => idp

-- ---------------------------------------------------------------------------
-- 8. An axiom: `prim_add_int 2 3`, computed by the oracle on the λ□ side and
-- by the runtime model on the Java side.
-- ---------------------------------------------------------------------------

\func lbAxiom : EvalProgram lbAxioms addAxiomProgram (prim (rocqUint63, 5))
  => evalT-sound lbAxioms 200 idp

\func jAxiom : relatedTo addAxiomProgram 200 (prim (rocqUint63, 5)) = true => idp

\func jAxiomRejects : relatedTo addAxiomProgram 200 (prim (rocqUint63, 6)) = false => idp

-- ---------------------------------------------------------------------------
-- 9. Unsigned int63 arithmetic: `prim_sub_int 1 2` (`int63Program`, from
-- `ModelChecks/Agreement.ard`) is 2^63-1 in λ□ (`Uint63`) and in the compiled
-- Java (`Rt.PRIM_SUB_INT63`). (A plain JVM `long` would say -1.)
-- ---------------------------------------------------------------------------

\func int63Value : LBTerm => prim (rocqUint63, 9223372036854775807)

\func lbInt63 : EvalProgram lbAxioms int63Program int63Value
  => evalT-sound lbAxioms 200 idp

-- Stated as three facts (what λ□ derives, what the compiled program returns,
-- and that they correspond), so that the λ□ side is not just a hand-written
-- value.
\func int63NowAgrees
  : \Sigma (EvalProgram lbAxioms int63Program int63Value)
           (runClass rtInt63 (compileClass progClassName int63Program) bodyMethodName 200
            = rOk (rvValue (vLong (9223372036854775807, ()))))
           (agrees int63Value (vLong (9223372036854775807, ())) = true)
  => (lbInt63, int63InJava, idp)

-- ---------------------------------------------------------------------------
-- 10. Lean's `Nat` is i63 too (lean-to-lambdabox erases `Nat` literals to
-- `primInt`), so `Nat.add (2^63-1) 1` wraps to 0 on both sides.
-- ---------------------------------------------------------------------------

\func natOverflowProgram : LBProgram =>
  ((natAddKn, constantDecl (\new ConstantBody nothing)) :: nil,
   app (app (const natAddKn) (prim (rocqUint63, 9223372036854775807))) (prim (rocqUint63, 1)))

-- 2^63-1 plus 1 is 0, in BOTH semantics: i63 wraps at 2^63.
\func natOverflowValue : LBTerm => prim (rocqUint63, 0)

\func lbNatOverflow : EvalProgram lbAxioms natOverflowProgram natOverflowValue
  => evalT-sound lbAxioms 200 idp

\func natOverflowInJava
  : runClass rtInt63 (compileClass progClassName natOverflowProgram) bodyMethodName 200
  = rOk (rvValue (vLong (0, ())))
  => idp

-- The three facts, as for the int63 case above.
\func natOverflowNowAgrees
  : \Sigma (EvalProgram lbAxioms natOverflowProgram natOverflowValue)
           (runClass rtInt63 (compileClass progClassName natOverflowProgram) bodyMethodName 200
            = rOk (rvValue (vLong (0, ()))))
           (agrees natOverflowValue (vLong (0, ())) = true)
  => (lbNatOverflow, natOverflowInJava, idp)

-- `Nat.add` is realized by the int63 family.
\func natAddHasRuntimeName : axiomRtName natAddKn = just "PRIM_ADD_INT63" => idp

\func natAddArityAgrees
  : axiomArity {lbAxioms} natAddKn = builtinArity {rtInt63} "PRIM_ADD_INT63" => idp

-- `Nat.sub` truncates at zero (Lean) where i63 wraps, so it has its own
-- runtime constant.
\func natSubKeepsItsOwnConstant : axiomRtName natSubKn = just "NAT_SUB_LONG" => idp

\func natSubStillTruncates
  : runProgram lbAxioms natSubProgram 200 = rOk (prim (rocqUint63, 0)) => idp

-- ---------------------------------------------------------------------------
-- 11. The int64 rewrite (`Compiler/LongRewrite.ard`): it renames the axioms
-- and retags the literals, and the result is an ordinary λ□ program.
-- ---------------------------------------------------------------------------

-- It preserves the value while the arithmetic stays in range.
\func rewriteKeepsSmall : rewritePreserves addAxiomProgram 200 = true => idp

-- The rewritten program computes on the i64 family ...
\func rewrittenRuns
  : runProgram lbAxioms (rewriteProgram addAxiomProgram) 200
  = rOk (prim (javaLong, wrap64u 5))
  => idp

-- ... and so does its compiled Java, through `Rt.PRIM_ADD_LONG`.
\func rewrittenCompiles
  : runClass rtInt63 (compileClass progClassName (rewriteProgram addAxiomProgram))
      bodyMethodName 200
  = rOk (rvValue (vLong (5, ())))
  => idp

-- It does not preserve the value once an operation crosses 2^63:
-- `(2^63-1) + 1` is 0 under i63 and 2^63 under i64.
\func overflowProgram : LBProgram =>
  ((axiomKn, constantDecl (\new ConstantBody nothing)) :: nil,
   app (app (const axiomKn) (prim (rocqUint63, wrap63 (pos 9223372036854775807))))
       (prim (rocqUint63, wrap63 1)))

\func overflowInI63
  : runProgram lbAxioms overflowProgram 200 = rOk (prim (rocqUint63, 0)) => idp

\func overflowInI64
  : runProgram lbAxioms (rewriteProgram overflowProgram) 200
  = rOk (prim (javaLong, wrap64u (pos 9223372036854775808)))
  => idp

\func rewriteChangesOverflow : rewritePreserves overflowProgram 200 = false => idp

-- So the rewrite is not sound without a side condition (the one stated in
-- `Proof/LongRewriteSpec.ard`).
\lemma longRewriteIsNotSound (s : LongRewriteSound) : Empty =>
  true/=false (inv (s overflowProgram 200) *> rewriteChangesOverflow)

-- ---------------------------------------------------------------------------
-- Coverage: λ□ constructors reached by an instance above.
--
--   box        1, 3b, and as the erased parameter in 5
--   bvar       2, 3
--   lambda     3
--   app        3, 7, 8
--   letIn      2
--   const      7 (`evalDelta`), 8 (`evalAxiom`)
--   construct  5, 7
--   case       7 (and `ModelChecks/Agreement.ard`'s `boolCaseProgram`, on a
--              value produced by the oracle)
--   proj       5
--   fix        6 (two definitions), 7 (one)
--   prim       4
--   fvar       none: it has no `Eval` rule (the compiled code throws via
--              `Rt.freeVar`, see `ModelChecks/JavaEvalRuns.ard`)
-- Not covered as an agreement: a `case` matching no branch (`Rt.noBranch`, λ□
-- has no rule either) and the axioms neither model covers (`Array.*`, the
-- `Decidable`-returning comparisons; census in `ModelChecks/Agreement.ard`).
-- ---------------------------------------------------------------------------
