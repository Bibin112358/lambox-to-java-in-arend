\import Arith.Nat
\import Data.Bool
\import Data.Maybe
\import Data.String
\import ExamplePeano
\import Formal.Agreement
\import Formal.Correct
\import Formal.JavaEval
\import Formal.JavaValue
\import Formal.LambdaBoxEval
\import Formal.LambdaBoxRun
\import Formal.LambdaBoxSound
\import Formal.LbAxioms
\import Formal.Res
\import Formal.RtInt63
\import Formal.RtLong
\import JavaAst
\import LambdaBox
\import Logic
\import Paths
\import Set
\import StringUtil (intEqB)
\import ToJava

-- =============================================================================
-- What is KNOWN about `Formal/Correct.ard`'s statement: instances, and one
-- refutation.
--
-- Two kinds of content, and the second is the surprise:
--
--   * INSTANCES. `Correct` at a particular program, discharged by computation.
--     Each is three things lining up: a λ□ derivation `Eval decls t v` -- by
--     hand, so `v` is pinned by the SOURCE semantics rather than by whatever
--     the backend produced -- the real `compileClass` output run by
--     `Formal/JavaEval.ard`, and `agrees` between the two results, plus a
--     NEGATIVE check that the relation rejects a wrong value (without which the
--     positive one proves nothing).
--
--   * A REFUTATION, and a retired one. `prim_sub_int` used to refute the
--     statement; `Rt.PRIM_*_INT63` fixed that, and `int63NowAgrees` is the
--     same witness discharging the conclusion instead. What refutes it TODAY
--     is Lean's `Nat` (`natOverflowRefutesCorrect`,
--     `oracleStillDisagreesOnNat`) -- a defect the old value relation absorbed
--     and the new one exposes.
--
-- The instance set is ported from branch `lambox-formal-semantics`
-- (`CorrectnessInstances.ard`), which chose these programs to cover the λ□
-- constructors `ExamplePeano.addProgram` does not reach. What is new here is
-- everything involving an axiom -- that branch's coverage table ended with "the
-- `Rt` axiom table: unreachable by construction (λ□ has no rule for an axiom)",
-- which the oracle has made false.
-- =============================================================================

-- "The compiled program returns a VALUE related to `v`" -- the conclusion of
-- `Correct`, as one computable proposition.
--
-- A THROW IS A FAILURE, not a pass: λ□ produced a value, so the theorem demands
-- the Java side produce one too. `rvThrown` and both `Res` failures are `false`.
\func relatedTo (p : LBProgram) (n : Nat) (v : LBTerm) : Bool =>
  \case runClass rtInt63 (compileClass progClassName p) bodyMethodName n \with {
    | rOk (rvValue jv) => agrees 20 v jv
    | _ => false
  }

-- ---------------------------------------------------------------------------
-- 1. `box` -- the erased proof. Compiles to `Rt.BOX`.
-- ---------------------------------------------------------------------------

\func boxProgram : LBProgram => (nil, box)

\func lbBox (spec : LBSpec) : EvalProgram spec boxProgram box => evalAtomBox idp

\func jBox : relatedTo boxProgram 20 box = true => idp

-- ---------------------------------------------------------------------------
-- 2. `letIn` -- exercises `jLocal` with an initialiser.
--
--   \let x := box \in x            ==>   final Object l = Rt.BOX; ... l
-- ---------------------------------------------------------------------------

\func letProgram : LBProgram => (nil, letIn anon box (bvar 0))

\func lbLet (spec : LBSpec) : EvalProgram spec letProgram box =>
  evalZeta (evalAtomBox idp) (evalAtomBox idp)

\func jLet : relatedTo letProgram 20 box = true => idp

-- ---------------------------------------------------------------------------
-- 3. beta -- a closure applied to an argument. Exercises `jClosure`, the
-- `.apply` call and `jVar` on a parameter.
--
--   (\lam x => x) box
-- ---------------------------------------------------------------------------

\func idTerm : LBTerm => lambda anon (bvar 0)

\func betaProgram : LBProgram => (nil, app idTerm box)

\func lbBeta (spec : LBSpec) : EvalProgram spec betaProgram box =>
  evalBeta (evalAtomLambda idp) (evalAtomBox idp) (evalAtomBox idp)

\func jBeta : relatedTo betaProgram 20 box = true => idp

-- ---------------------------------------------------------------------------
-- 4. `prim` -- a primitive integer, i.e. `Long.valueOf(7L)` and `agrees`'s
-- `vLong`/`prim` case, neither of which the Peano program touches (Peano
-- numerals are constructors, not primitives).
-- ---------------------------------------------------------------------------

\func primProgram : LBProgram => (nil, prim (primInt, 7))

\func lbPrim (spec : LBSpec) : EvalProgram spec primProgram (prim (primInt, 7)) => evalPrim idp

\func jPrim : relatedTo primProgram 20 (prim (primInt, 7)) = true => idp

-- The relation must distinguish integers, or `jPrim` is vacuous.
\func jPrimRejects : relatedTo primProgram 20 (prim (primInt, 8)) = false => idp

-- ---------------------------------------------------------------------------
-- 5. `proj` -- the offset guard.
--
-- `ToJava.ard` compiles a projection to `((Rt.Data)(s)).fields[npars + idx]`,
-- folding the addition into one literal. "Drop the `npars` offset" is a
-- standing mutation candidate, so an instance with `npars > 0` is the guard
-- for it.
--
-- The inductive has one parameter and one constructor with two fields, so a
-- `construct` node carries 1 + 2 = 3 arguments and projecting field 1 must read
-- index 1 + 1 = 2, NOT index 1. The three arguments are deliberately
-- DISTINGUISHABLE so an off-by-one changes the answer instead of hiding.
-- ---------------------------------------------------------------------------

\func pairKername : Kername => \new Kername (mpFile nil) "Pair"

\func pairInd : InductiveId => \new InductiveId pairKername 0

\func pairCtors : Array ConstructorBody => (\new ConstructorBody "mk" 2) :: nil

\func pairMutual : MutualInductiveBody =>
  \new MutualInductiveBody finite 1
    ((\new OneInductiveBody "Pair" false IntoAny pairCtors
        ((\new ProjectionBody "fst") :: (\new ProjectionBody "snd") :: nil)) :: nil)

\func pairDecls : GlobalDeclarations => (pairKername, inductiveDecl pairMutual) :: nil

-- `mk <param> 20 21`, the parameter erased to `box`.
\func pairTerm : LBTerm =>
  construct pairInd 0 (box :: prim (primInt, 20) :: prim (primInt, 21) :: nil)

-- Project field 1 (the second field), i.e. index `npars + 1 = 2`, value 21.
\func projInfo1 : ProjectionInfo => \new ProjectionInfo pairInd 1 1

\func projProgram : LBProgram => (pairDecls, proj projInfo1 pairTerm)

-- The λ□ derivation. `evalProj`'s side conditions pin the offset arithmetic:
-- `constructorInfo` must report `(false, 1, 2)`, the argument array must have
-- length 1 + 2, and `nthArr (1 + 1)` must select the right field.
\func lbPair (spec : LBSpec) : Eval spec pairDecls pairTerm pairTerm =>
  evalConstruct idp idp
    (\lam i => \case \elim i \with {
      | 0 => evalAtomBox idp
      | 1 => evalPrim idp
      | 2 => evalPrim idp
    })
    idp

\func lbProj (spec : LBSpec) : EvalProgram spec projProgram (prim (primInt, 21)) =>
  evalProj (lbPair spec) idp idp idp (evalPrim idp)

\func jProj : relatedTo projProgram 40 (prim (primInt, 21)) = true => idp

-- The off-by-one guard: field 0 of the same value is 20. If either side dropped
-- the `npars` offset, `jProj` would land on 20 and disagree with `lbProj`.
\func jProjNotFieldZero : relatedTo projProgram 40 (prim (primInt, 20)) = false => idp

-- ---------------------------------------------------------------------------
-- 6. A `fix` block with TWO definitions -- the which-definition-got-selected
-- guard.
--
-- NOTE, because the branch this was ported from says otherwise: the encoding
-- has changed completely. That version compiled a `fix` to
--   final Rt.Fn[] x = new Rt.Fn[2];  x[0] = ...;  x[1] = ...;  x[idx]
-- and this instance existed to exercise the mutable knot -- allocate a two-cell
-- array, write both slots after the closures reading them were made, select
-- one. There is no array and no mutation now: a `fix` is a local class with one
-- method per definition, and siblings reach each other through the class. So
-- what this instance guards is only the SELECTION, which is still worth a check
-- ("wrong `fix` unfolding point" remains a mutation candidate).
--
-- The two definitions differ so that selecting the wrong one changes the
-- answer: definition 0 discards its argument and returns `box`, definition 1 is
-- the identity. Index 1 applied to 5 must give 5; slot 0 would give `box`.
-- ---------------------------------------------------------------------------

\func constBoxTerm : LBTerm => lambda anon box

\func twoDefs : Array (FixDef LBTerm) =>
  (\new FixDef LBTerm anon constBoxTerm 0) ::
  (\new FixDef LBTerm anon idTerm 0) :: nil

\func fix2Program : LBProgram => (nil, app (fix twoDefs 1) (prim (primInt, 5)))

\func lbFix2 (spec : LBSpec) : EvalProgram spec fix2Program (prim (primInt, 5)) =>
  evalFix (evalAtomFix idp) idp (evalPrim idp)
          (evalBeta (evalAtomLambda idp) (evalPrim idp) (evalPrim idp))

\func jFix2 : relatedTo fix2Program 40 (prim (primInt, 5)) = true => idp

-- The selection guard: had either side taken definition 0, the result is `box`.
\func jFix2NotSlotZero : relatedTo fix2Program 40 box = false => idp

-- ---------------------------------------------------------------------------
-- 7. Peano: `const` unfolding, `case`, and a one-definition `fix`, on a real
-- two-declaration program. The λ□ side comes from `evalT-sound` rather than by
-- hand -- a derivation this size is not writable by hand, which is what the
-- soundness proof bought.
-- ---------------------------------------------------------------------------

\func lbPeano : EvalProgram lbAxioms addProgram (suc' (suc' (suc' (suc' zero'))))
  => evalT-sound lbAxioms 2000 idp

\func jPeano : relatedTo addProgram 2000 (suc' (suc' (suc' (suc' zero')))) = true => idp

-- 3 is not 4: the relation distinguishes unary numerals.
\func jPeanoRejects : relatedTo addProgram 2000 three = false => idp

-- ---------------------------------------------------------------------------
-- 8. AN AXIOM -- impossible on the old branch, where λ□ had no rule for one.
--
-- `prim_add_int 2 3`, i.e. a case where the correctness of `Rt.java`'s
-- arithmetic is genuinely on the critical path. The old branch's finding that
-- `RtSpec` "costs nothing here" held only because these cases were vacuous.
-- ---------------------------------------------------------------------------

\func lbAxiom : EvalProgram lbAxioms addAxiomProgram (prim (primInt, 5))
  => evalT-sound lbAxioms 200 idp

\func jAxiom : relatedTo addAxiomProgram 200 (prim (primInt, 5)) = true => idp

\func jAxiomRejects : relatedTo addAxiomProgram 200 (prim (primInt, 6)) = false => idp

-- ---------------------------------------------------------------------------
-- THE REFUTATION. The backend is incorrect, and here is the proof.
--
-- The witness is `int63Program` (`Formal/Agreement.ard`): `prim_sub_int 1 2`.
-- λ□ says 2^63-1, because its primitive int is `Uint63` and subtraction wraps
-- unsigned; the JVM says -1, because the backend represents it as a `long`.
-- Both are right about their own model, and the backend is wrong to identify
-- them -- which is precisely the KNOWN MISMATCH `JavaAxioms.ard` has carried as
-- a comment since the beginning. It is now a theorem.
--
-- WHY THIS FORM AND NOT `Correct`: `Correct`'s conclusion is `JEval`, which
-- quantifies the clock existentially, so contradicting it needs to know that
-- the clock it hands back computes the same value as the clock we ran at --
-- fuel monotonicity, obligation (1), which is open. Naming the clock closes
-- that gap with one run. Lifting this refutation to `Correct` is one of the
-- things obligation (1) buys.
--
-- AND WHY THE PROGRAM IS FIXED TOO. A clock-fixed statement quantified over all
-- programs would be refutable without saying anything: `addProgram` needs 2000
-- fuel, so `\Pi {p} -> ... runClass ... 200 ...` fails on it for lack of fuel
-- rather than for lack of correctness. Fixing the program avoids that, and the
-- fuel objection cannot be raised here because `int63InJava` shows 200 ticks
-- SUFFICE: the run finishes and returns `vLong (neg 1)`. So the only thing left
-- that can fail is the value relation, which is the translation's business.
--
-- WHAT IT DOES NOT SAY: `CorrectGeneric` is untouched. Its hypothesis is
-- `OracleAgree spec rt`, and what this proves is that
-- `OracleAgree lbAxioms rtLong` does not hold -- the two runtimes disagree on
-- `prim_sub_int`. A backend whose primitive ints really were 63-bit would
-- satisfy the hypothesis, and that is the fix this points at.
-- ---------------------------------------------------------------------------

\func int63Value : LBTerm => prim (primInt, 9223372036854775807)

-- ---------------------------------------------------------------------------
-- THE INT63 DEFECT, FIXED. This section used to hold a refutation.
--
-- `prim_sub_int 1 2` was the witness: λ□ says 2^63-1 because its primitive int
-- is a `Uint63`, and the backend said -1 because it represented one as a JVM
-- `long`. That gave `oracleDisagrees` (the runtimes differ) and
-- `int63RefutesCorrect` (so does the compiled program), i.e. a machine-checked
-- proof that the backend was wrong.
--
-- `Rt.PRIM_*_INT63` and `JavaAxioms.primRepr := int63Repr` fixed it, so the
-- same witness now satisfies the conclusion instead of contradicting it. The
-- old answer has not been edited away -- `Formal/Agreement.ard`'s
-- `longWouldHaveSaid` still derives -1 from the model of the family that
-- produced it, and `oracleStillDisagreesOnNat` below shows the hypothesis is
-- still false for a DIFFERENT reason.
-- ---------------------------------------------------------------------------

\func lbInt63 : EvalProgram lbAxioms int63Program int63Value
  => evalT-sound lbAxioms 200 idp

-- What used to be refuted: the compiled program returns a value related to
-- what λ□ says. This is `CorrectAtProgram`'s conclusion, discharged.
\func int63NowAgrees : CorrectAtProgram 200 int63Program int63Value =>
  \lam _ => (vLong 9223372036854775807, int63InJava, (20, idp))

-- ---------------------------------------------------------------------------
-- WHAT IS STILL WRONG: Lean's `Nat`, and it is no longer hidden.
--
-- `Nat.add` at 2^63-1 and 1. Lean's `Nat` is arbitrary-precision, so λ□ says
-- 2^63; the backend routes `Nat.*` through `leanOpSuffix`, still `LONG`, so the
-- JVM says -2^63. That is limitation (L).
--
-- WHAT CHANGED IS THAT IT IS NOW VISIBLE. Under the old value relation
-- `wrap64` identified those two values, so the theorem ACCEPTED the truncation
-- and `natOverflowSatisfiesTheorem` pinned a `true` that was really a weakness.
-- The shipped relation normalizes with `norm63` instead, which does not
-- identify them -- so the same program now refutes the statement rather than
-- satisfying it. The defect did not appear; the relation stopped absorbing it.
-- ---------------------------------------------------------------------------

\func natOverflowProgram : LBProgram =>
  ((natAddKn, constantDecl (\new ConstantBody nothing)) :: nil,
   app (app (const natAddKn) (prim (primInt, 9223372036854775807))) (prim (primInt, 1)))

\func natOverflowValue : LBTerm => prim (primInt, 9223372036854775808)

\func natOverflowInLambdaBox
  : runProgram lbAxioms natOverflowProgram 200 = rOk natOverflowValue => idp

\func natOverflowInJava
  : runClass rtInt63 (compileClass progClassName natOverflowProgram) bodyMethodName 200
  = rOk (rvValue (vLong (neg 9223372036854775808)))
  => idp

\func lbNatOverflow : EvalProgram lbAxioms natOverflowProgram natOverflowValue
  => evalT-sound lbAxioms 200 idp

-- Not about fuel: 200 ticks suffice and the run returns a value. Only the
-- relation fails.
\func natOverflowRunSucceeds
  : \Sigma (jv : Value)
           (runClass rtInt63 (compileClass progClassName natOverflowProgram) bodyMethodName 200
            = rOk (rvValue jv))
  => (vLong (neg 9223372036854775808), natOverflowInJava)

\lemma natOverflowNotRelated (n : Nat)
  : agrees n natOverflowValue (vLong (neg 9223372036854775808)) = false \elim n
  | 0 => idp
  | suc n => idp

\func unRv (d : Value) (o : RunOut) : Value \elim o
  | rvValue v => v
  | rvThrown _ => d

\func resVal (d : Value) (r : Res RunOut) : Value \elim r
  | rOk o => unRv d o
  | rStuck => d
  | rOutOfFuel => d

-- THE BACKEND IS STILL INCORRECT, on the other family.
\func natOverflowRefutesCorrect
  (c : CorrectAtProgram 200 natOverflowProgram natOverflowValue) : Empty =>
  \case c lbNatOverflow \with {
    | (jv, run, (k, rel)) =>
      \let | jvIsNeg : jv = vLong (neg 9223372036854775808)
             => pmap (resVal jv) (inv run *> natOverflowInJava)
           | related : agrees k natOverflowValue (vLong (neg 9223372036854775808)) = true
             => transport (\lam w => agrees k natOverflowValue w = true) jvIsNeg rel
      \in true/=false (inv related *> natOverflowNotRelated k)
  }

-- And the root cause, proved directly rather than attributed through the
-- unproved `CorrectGeneric`: the runtime-agreement hypothesis fails at the
-- SHIPPED pair, on `Nat.add`.
--
-- `Nat.add` is a Lean family member, so `axiomRtName` sends it to
-- `PRIM_ADD_LONG` -- and the ARITY half still holds (`rtInt63` layers over
-- `rtLong`, so it knows that constant and its arity). As with the int63 defect
-- before it, the two runtimes agree on when to fire and differ on what they
-- compute.
\func natAddHasRuntimeName : axiomRtName natAddKn = just "PRIM_ADD_LONG" => idp

\func natAddArityAgrees
  : axiomArity {lbAxioms} natAddKn = builtinArity {rtInt63} "PRIM_ADD_LONG" => idp

\func oracleStillDisagreesOnNat (oa : OracleAgree lbAxioms rtInt63) : Empty =>
  \case oa.2 natAddKn "PRIM_ADD_LONG"
             (prim (primInt, 9223372036854775807) :: prim (primInt, 1) :: nil)
             (vLong 9223372036854775807 :: vLong 1 :: nil)
             natOverflowValue
             idp
             (\lam i => \case \elim i \with { | 0 => (1, idp) | 1 => (1, idp) })
             idp
  \with {
    | (jv, run, (k, rel)) =>
      \let related : agrees k natOverflowValue (vLong (neg 9223372036854775808)) = true
        => transport (\lam w => agrees k natOverflowValue w = true) (inv (rOk-inj run)) rel
      \in true/=false (inv related *> natOverflowNotRelated k)
  }

-- The fix is known and is one line (`leanOpSuffix := "INT"`, putting Lean's
-- `Nat` on the unbounded `BigInteger` family). It is not made here because it
-- is a performance decision about every Lean program in the corpus, not a
-- correctness question -- see limitation (L) in `Formal/Correct.ard`.

-- ---------------------------------------------------------------------------
-- COVERAGE. λ□ constructor -> is there an instance whose derivation reaches it?
--
--   box        yes (1, and as the erased parameter in 5)
--   bvar       yes (2 via letIn, 3 via the lambda parameter)
--   lambda     yes (3)
--   app        yes (3, 7, 8)
--   letIn      yes (2)
--   const      yes (7, `evalDelta`) and (8, `evalAxiom` -- a different rule)
--   construct  yes (5, 7)
--   case       yes (7, `evalIota`; and `Formal/Agreement.ard`'s `boolCaseProgram`
--              scrutinizes a value the ORACLE produced, which is the case that
--              depends on the axiom result carrying the right inductive)
--   proj       yes (5, with the npars offset guarded)
--   fix        yes (6 with two definitions and a selection guard; 7 with one)
--   prim       yes (4)
--   fvar       NO, deliberately: it has no `Eval` rule, so it cannot appear in
--              an instance of `Correct` at all. `ToJava.ard` compiles it to a
--              throwing `Rt.freeVar` call, which `Formal/JavaEval.ard` models;
--              that pairing needs a separate "ill-formed input throws"
--              statement, which nobody has written.
--
-- STILL UNCOVERED, in value order:
--   * a `case` whose scrutinee tag matches NO arm (the `Rt.noBranch` path).
--     Covered at the Java level in `Formal/JavaEvalRuns.ard`, but not as an
--     agreement -- and it cannot be, since λ□ has no rule for it either. Same
--     shape of gap as `fvar`.
--   * the `BigInteger` target: every instance here is at the `Long`
--     representation, which is what `agrees` is written for.
--   * the axioms NEITHER oracle covers (`Array.*`, the `Decidable`-returning
--     comparisons) -- the census is in `Formal/Agreement.ard`'s header.
-- ---------------------------------------------------------------------------
