\func peanoJava => putStrLn (compileProgram "Prog" addProgram)
\func axiomAddJava => putStrLn (compileProgram "Prog" Formal.Agreement.addAxiomProgram)
\func natAddJava => putStrLn (compileProgram "Prog" Formal.Agreement.natAddProgram)
\func natSubJava => putStrLn (compileProgram "Prog" Formal.Agreement.natSubProgram)
\func int63SubJava => putStrLn (compileProgram "Prog" Formal.Agreement.int63Program)
\func wrapAddJava => putStrLn (printClass wrapClass)
\func natDivJava => putStrLn (compileProgram "Prog" Formal.Agreement.natDivProgram)

\func subZeroKn : Kername => \new Kername (mpFile nil) "prim_sub_int"
\func subZeroProgram : LBProgram =>
  ((subZeroKn, constantDecl (\new ConstantBody nothing)) :: nil,
   app (app (const subZeroKn) (prim (primInt63, 0))) (prim (primInt63, 1)))
\func subZeroJava => putStrLn (compileProgram "Prog" subZeroProgram)

\func addNearOverflowProgram : LBProgram =>
  ((Formal.Agreement.axiomKn, constantDecl (\new ConstantBody nothing)) :: nil,
   app (app (const Formal.Agreement.axiomKn) (prim (primInt63, 9223372036854775806))) (prim (primInt63, 1)))
\func addNearOverflowJava => putStrLn (compileProgram "Prog" addNearOverflowProgram)
