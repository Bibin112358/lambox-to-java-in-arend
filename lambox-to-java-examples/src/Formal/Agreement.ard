\import Arith.Nat
\import Data.Bool
\import Data.Maybe
\import Data.String
\import ExamplePeano
\import Formal.JavaEval
\import Formal.JavaValue
\import Formal.Correct
\import Formal.LambdaBoxEval
\import Formal.LambdaBoxRun
\import Formal.LambdaBoxSound
\import Formal.LbAxioms
\import Formal.Res
\import Formal.RtInt63
\import Formal.RtLong (builtinRunLong, wrap64)
\import JavaAst
\import Int63 (wrap63)
\import LambdaBox
\import Paths
\import Set
\import StringUtil (intEqB)
\import ToJava

-- =============================================================================
-- The two semantics agree: λ□'s value and the compiled Java's value correspond.
--
-- This is the executable half of a correctness claim. The full statement --
-- "for EVERY well-formed program, `Eval` and `JEval` agree" -- is a theorem
-- nobody has proved here. What this module does is check the statement's
-- INSTANCES, by running both sides:
--
--   λ□     `Formal/LambdaBoxRun.evalT`   (an oracle for the `Eval` relation)
--   Java   `compileClass` then `Formal/JavaEval.runClass`
--
-- and comparing the two values with `agrees`. Each check is `idp`, so
-- typechecking this module IS the check, and it fails if either side is stuck,
-- runs out of fuel, or produces something the other does not match.
--
-- TWO ORACLES, ONE CHECK. Each side takes its runtime as a parameter, and the
-- two parameters are DIFFERENT FUNCTIONS written from different sources:
--
--   λ□     `lbAxioms` (Formal/LbAxioms.ard)  -- λ□'s i63, which is what both
--                                               `prim_*_int` and Lean's `Nat.*`
--                                               range over
--   Java   `rtInt63`  (Formal/RtInt63.ard)   -- `Rt.java` as `primRepr`
--                                               configures it: `PRIM_*_INT63`
--                                               for λ□ primitive ints, the
--                                               `_LONG` family for Lean's
--
-- That is what makes `bothAgree` worth running. If one oracle were defined in
-- terms of the other, every check below would pass and none would mean
-- anything. They are independent, and where they AGREE it is because the
-- backend was made to compute what the source language says -- `int63Agrees`
-- below is the case that used to fail and now does not. Where they still
-- disagree it is a finding, pinned as carefully as the agreements.
--
-- WHAT IT STILL CANNOT COVER:
--   * a program whose `construct`/`case`/`proj` has no inductive DECLARATION is
--     `rStuck` on the λ□ side (the arity and propositionality checks need it),
--     while the backend never looks. So the hand-written terms in
--     `Formal/JavaEvalRuns.ard`, which carry no declarations, are Java-side
--     only.
--   * an axiom NEITHER oracle covers -- `Array.*` needs a store λ□'s value
--     domain has no room for, `Decidable`-returning comparisons need an
--     inductive declaration the oracle would have to invent. Pinned below.
--   * an axiom only ONE side MODELS: `Nat.div` computes in λ□ and is a named
--     gap in `Formal/RtLong.ard`, so `bothAgree` is `false` for it. That is the
--     model being incomplete, not the backend being wrong -- `javaAxioms` does
--     realize it. Pinned, and labelled as such.
--   * a value that is a FUNCTION, including a partially-applied axiom -- see
--     `agrees` below.
-- =============================================================================

-- The value relation is `Formal/Correct.ard`'s `agrees`, imported rather than
-- defined here: it is part of the CORRECTNESS STATEMENT, and having a second
-- copy next to the checks that exercise it would let the two drift. Its
-- restriction -- first-order values only, so a closure or a partially-applied
-- axiom is `false` -- is documented there, along with the withdrawal of
-- limitation (L).

-- Run a program through both semantics and compare. `false` covers every way
-- this can fail to be an agreement, including either side not finishing.
--
-- The two oracles are fixed here, once: `lbAxioms` against `rtInt63`.
\func bothAgree (p : LBProgram) (fuel : Nat) : Bool =>
  \case runProgram lbAxioms p fuel,
        runClass rtInt63 (compileClass progClassName p) bodyMethodName fuel \with {
    | rOk t, rOk (rvValue v) => agrees fuel t v
    | _, _ => false
  }

-- ---------------------------------------------------------------------------
-- The instances.
-- ---------------------------------------------------------------------------

-- 1 + 3 on unary naturals: `fix`, `case`, `construct` and a `const` unfolding,
-- which between them are every λ□ rule that fires without an axiom.
\func peanoAgrees : bothAgree addProgram 2000 = true => idp

-- WITH SOUNDNESS, the oracle's answer IS a derivation of the relation. This is
-- `Eval` for a real program -- 1 + 3 through a `fix`, a `case` and a `const`
-- unfolding -- obtained by computation rather than by hand, which is what the
-- relation alone could not give: its own sanity checks in
-- `Formal/LambdaBoxEval.ard` are `id`, `let`, a literal and a one-line `fix`,
-- because a derivation for anything bigger is not writable by hand.
--
-- So `peanoAgrees` above is not "the oracle and the Java semantics agree" but
-- "λ□'s semantics and the Java semantics agree", on this program.
\func peanoEvalsToFour : EvalProgram lbAxioms addProgram (suc' (suc' (suc' (suc' zero'))))
  => evalT-sound lbAxioms 2000 idp

-- A bare constructor value, with no computation at all: the corresponding pair
-- is `suc (suc zero)` and `Data(1, {Data(1, {Data(0, {})})})`.
\func twoProgram : LBProgram => (decls, suc' (suc' zero'))

\func twoAgrees : bothAgree twoProgram 500 = true => idp

-- A `case` that selects the second branch, so the agreement is about a value
-- that came out of `iotaRed` on the λ□ side and out of a `?:` chain plus a
-- field read on the Java side.
\func natInd : InductiveId => \new InductiveId (\new Kername (mpFile nil) "Nat") 0

\func predProgram : LBProgram =>
  (decls, case natInd 0 (suc' (suc' zero'))
            (((nil : Array BinderName), zero') ::
             ((anon :: nil : Array BinderName), bvar 0) :: nil))

\func predAgrees : bothAgree predProgram 500 = true => idp

-- The other branch, which is a different reduction on both sides: `nthArr` at
-- index 0, and an `iotaRed` with NO fields to substitute (`dropArr npars args`
-- is empty), against the first arm of the `?:` chain rather than a later one.
\func zeroCaseProgram : LBProgram =>
  (decls, case natInd 0 zero'
            (((nil : Array BinderName), suc' zero') ::
             ((anon :: nil : Array BinderName), bvar 0) :: nil))

\func zeroCaseAgrees : bothAgree zeroCaseProgram 500 = true => idp

-- A primitive integer. Nothing to normalize at 42, so this checks only that a
-- literal survives `intLit` and comes back as the same number; the values where
-- normalization matters are at the bottom of this module.
\func litProgram : LBProgram => (nil, prim (primInt63, 42))

\func litAgrees : bothAgree litProgram 100 = true => idp

-- ---------------------------------------------------------------------------
-- THE AXIOMS. These are the checks the oracle exists for: before it, every one
-- of them was `rStuck` on the λ□ side, and the only honest thing to pin was the
-- gap itself.
-- ---------------------------------------------------------------------------

-- A λ□ primitive: `prim_add_int 2 3`. Both sides compute 5 -- λ□ through
-- `int63Run`, Java through `Rt.PRIM_ADD_INT63` -- and `agrees` matches them.
\func axiomKn : Kername => \new Kername (mpFile nil) "prim_add_int"

\func addAxiomProgram : LBProgram =>
  ((axiomKn, constantDecl (\new ConstantBody nothing)) :: nil,
   app (app (const axiomKn) (prim (primInt63, 2))) (prim (primInt63, 3)))

\func axiomAgrees : bothAgree addAxiomProgram 200 = true => idp

-- Each side separately, so a future change that breaks one is localized rather
-- than showing up only as `bothAgree = false`.
\func axiomRunsInLambdaBox
  : runProgram lbAxioms addAxiomProgram 200 = rOk (prim (primInt63, 5)) => idp

\func axiomRunsInJava
  : runClass rtInt63 (compileClass progClassName addAxiomProgram) bodyMethodName 200
  = rOk (rvValue (vLong 5))
  => idp

-- WITH SOUNDNESS AGAIN: the λ□ run above is a derivation, so this is `Eval`
-- deriving a value for a program with an AXIOM in it -- which is the whole
-- extension, exercised end to end through `evalAxiom` and `evalAxiomApp`.
\func axiomEvaluates : EvalProgram lbAxioms addAxiomProgram (prim (primInt63, 5))
  => evalT-sound lbAxioms 200 idp

-- AND THE SAME PROGRAM IS STUCK WITHOUT THE ORACLE, which is what makes the
-- three checks above about the oracle and not about the rest of the semantics.
-- `lbNone` is λ□ as MetaRocq and CertiRocq have it, and this line is exactly
-- what this module used to pin as a fact.
\func axiomStuckWithoutOracle : runProgram lbNone addAxiomProgram 200 = rStuck => idp

-- Lean's machine `Nat`, which is the family the corpus actually reaches:
-- `Nat.add` mangles to `c__Nat__add` and so lands on `Rt.PRIM_ADD_LONG`, while
-- λ□ reads it as unbounded addition.
--
-- HOW MUCH OF THE CORPUS THIS IS, counted rather than guessed. Across
-- `Imported/Leanbench*.ard` the bodyless constants are 132 occurrences:
--   covered by BOTH oracles   `Nat.add` 18, `Nat.sub` 23, `Nat.mul` 4,
--                             `Nat.beq` 21                              (66)
--   λ□ only (`rtLong` gap)    `Nat.div` 3, `Nat.mod` 7, `Nat.ble` 3     (13)
--   neither                   `Nat.decEq` 14, `Nat.decLt` 7,
--                             `Nat.decLe` 5, `Nat.pow` 2, `Array.*` 17,
--                             `Int.*` 8, `Eq.rec` 1                     (53)
-- So `leanbench-even`, whose only axioms are `Nat.beq` and `Nat.sub`, is inside
-- the intersection, while the `qsort`/`rbmap` family needs the
-- `Decidable`-returning comparisons and is not.
--
-- THAT DOES NOT MEAN THE BENCHMARK CAN BE CHECKED HERE. Running `program` from
-- `Imported/LeanbenchEven.ard` through `bothAgree` exhausts the JVM heap inside
-- Arend's normalizer (`OutOfMemoryError` in `SubstVisitor`), and lower fuel only
-- turns that into `rOutOfFuel`. The remaining obstacle to a real differential
-- corpus is therefore the cost of EVALUATING a benchmark-sized term in a
-- typechecker, not the missing oracle -- a different problem, and one the
-- harness (`test/run.py`, which runs the generated Java on a real JVM) already
-- solves from the other side.
--
-- What is checked here instead is the correspondence the oracle is responsible
-- for: the corpus's actual kernames, its actual `Bool` declaration, and a
-- `case` that scrutinizes what the oracle returns.
\func natAddKn : Kername => \new Kername (mpDot (mpFile nil) "Nat") "add"

\func natAddProgram : LBProgram =>
  ((natAddKn, constantDecl (\new ConstantBody nothing)) :: nil,
   app (app (const natAddKn) (prim (primInt63, 20))) (prim (primInt63, 22)))

\func natAddAgrees : bothAgree natAddProgram 200 = true => idp

-- A PARTIAL APPLICATION is a value on both sides, and `agrees` says `false` for
-- it (it is a function -- see the note on `agrees`). Pinned so that the `false`
-- is on record as a restriction of the COMPARISON, not of either semantics:
-- both sides really did produce a value here.
\func partialProgram : LBProgram =>
  ((natAddKn, constantDecl (\new ConstantBody nothing)) :: nil,
   app (const natAddKn) (prim (primInt63, 20)))

\func partialRunsInLambdaBox
  : runProgram lbAxioms partialProgram 200
  = rOk (app (const natAddKn) (prim (primInt63, 20))) => idp

\func partialRunsInJava
  : runClass rtInt63 (compileClass progClassName partialProgram) bodyMethodName 200
  = rOk (rvValue (vBuiltin "PRIM_ADD_INT63" (vLong 20 :: nil))) => idp

\func partialIsNotCompared : bothAgree partialProgram 200 = false => idp

-- ---------------------------------------------------------------------------
-- A BOOLEAN-RETURNING AXIOM, AND A `case` THAT READS IT.
--
-- The check the rest of this module does not reach: every other instance here
-- compares a primitive int, so nothing exercises the fact that `axiomRun` has to
-- return a value in the PROGRAM'S OWN inductive. `Formal/LbAxioms.ard` says why
-- that is delicate -- "a boolean built with the wrong id would compute and then
-- be stuck at the `case` that reads it", because `evalIota` checks that the
-- scrutinee's constructor belongs to the inductive the `case` names -- so the
-- claim needs a `case` on top of the axiom, not just the axiom.
--
-- The declaration is `Imported/LeanbenchEven.ard`'s, copied verbatim: the
-- Lean frontend's root-module `Bool`, with `Bool.false` and `Bool.true` as
-- constructors 0 and 1 and no parameters. So this pins `lbBool`'s inductive id
-- AND its tag convention against the corpus, and against `mkBool` on the Java
-- side, in one line.
-- ---------------------------------------------------------------------------

\func natBeqKn : Kername => \new Kername (mpDot (mpFile nil) "Nat") "beq"

\func boolDecls : GlobalDeclarations =>
  (natBeqKn, constantDecl (\new ConstantBody nothing)) ::
  ((\new Kername (mpFile nil) "Bool"),
   inductiveDecl
     (\new MutualInductiveBody
        finite
        0
        ((\new OneInductiveBody
            "Bool"
            false
            IntoAny
            ((\new ConstructorBody "Bool.false" 0) :: (\new ConstructorBody "Bool.true" 0) :: nil)
            nil
         ) :: nil))) :: nil

-- `case (Nat.beq 3 3) of { false => 100 ; true => 200 }`, so the answer is 200
-- exactly when the oracle's boolean is `Bool.true` of THIS `Bool`. A wrong
-- inductive id computes a value and then stops at the `case`, which is the
-- failure this rules out; a swapped tag convention picks 100.
\func boolCaseProgram : LBProgram =>
  (boolDecls,
   case boolInd 0
     (app (app (const natBeqKn) (prim (primInt63, 3))) (prim (primInt63, 3)))
     (((nil : Array BinderName), prim (primInt63, 100)) ::
      ((nil : Array BinderName), prim (primInt63, 200)) :: nil))

\func boolCaseAgrees : bothAgree boolCaseProgram 500 = true => idp

\func boolCaseInLambdaBox
  : runProgram lbAxioms boolCaseProgram 500 = rOk (prim (primInt63, 200)) => idp

-- And the unscrutinized boolean itself, so that what `lbBool` builds is on
-- record next to what `mkBool` builds (`vData 1 nil`).
\func boolProgram : LBProgram =>
  (boolDecls, app (app (const natBeqKn) (prim (primInt63, 3))) (prim (primInt63, 4)))

\func boolFalseInLambdaBox
  : runProgram lbAxioms boolProgram 500 = rOk (construct boolInd 0 nil) => idp

\func boolFalseAgrees : bothAgree boolProgram 500 = true => idp

-- The other corpus axiom, `Nat.sub`, which truncates at zero in Lean and is why
-- `javaAxioms` sends it to `NAT_SUB_LONG` rather than to a wrapping `PRIM_SUB`.
-- 3 - 5 is 0, not -2. Note the suffix: this is a LEAN family, routed by
-- `leanOpSuffix`, so the int63 change does not touch it.
\func natSubKn : Kername => \new Kername (mpDot (mpFile nil) "Nat") "sub"

\func natSubProgram : LBProgram =>
  ((natSubKn, constantDecl (\new ConstantBody nothing)) :: nil,
   app (app (const natSubKn) (prim (primInt63, 3))) (prim (primInt63, 5)))

\func natSubTruncates
  : runProgram lbAxioms natSubProgram 200 = rOk (prim (primInt63, 0)) => idp

\func natSubAgrees : bothAgree natSubProgram 200 = true => idp

-- ---------------------------------------------------------------------------
-- THE INT63/INT64 MISMATCH -- FIXED, and this is the witness that used to show
-- it was not.
--
-- `JavaAxioms.ard` called this a KNOWN MISMATCH from the start: λ□'s primitive
-- int is `Uint63` (unsigned, cyclic mod 2^63) while the backend represented it
-- as a JVM `long` (signed, cyclic mod 2^64). `prim_sub_int 1 2` is where the
-- two part company -- λ□ says 2^63-1, a `long` says -1 -- and with both sides
-- given a semantics it stopped being a caveat and became a refutation.
--
-- With `primRepr := int63Repr` the backend emits `Rt.PRIM_SUB_INT63`, which
-- masks to 63 bits, and the same program AGREES. Two lines below carry the
-- whole change: `int63Agrees` was `int63Disagrees`, and `int63InJava` said
-- `neg 1`.
-- ---------------------------------------------------------------------------

\func subAxiomKn : Kername => \new Kername (mpFile nil) "prim_sub_int"

\func int63Program : LBProgram =>
  ((subAxiomKn, constantDecl (\new ConstantBody nothing)) :: nil,
   app (app (const subAxiomKn) (prim (primInt63, 1))) (prim (primInt63, 2)))

\func int63Agrees : bothAgree int63Program 200 = true => idp

-- The two values, which are now the SAME value.
\func int63InLambdaBox
  : runProgram lbAxioms int63Program 200 = rOk (prim (primInt63, 9223372036854775807))
  => idp

\func int63InJava
  : runClass rtInt63 (compileClass progClassName int63Program) bodyMethodName 200
  = rOk (rvValue (vLong 9223372036854775807))
  => idp

-- AND THE OLD RUNTIME STILL SAYS WHAT IT SAID, from the model of the family it
-- used. Kept so the fix is a visible difference between two runtimes rather
-- than an edited constant -- and so that `Formal/CorrectInstances.ard` can
-- refute the agreement hypothesis at `rtLong` with something concrete.
\func longWouldHaveSaid
  : builtinRunLong "PRIM_SUB_LONG" (vLong 1 :: vLong 2 :: nil) = rOk (vLong (neg 1))
  => idp

\func theTwoAnswersDiffer
  : intEqB (pos 9223372036854775807) (neg 1) = false => idp

-- ---------------------------------------------------------------------------
-- The remaining gaps, pinned in both directions so that neither is mistaken for
-- coverage.
-- ---------------------------------------------------------------------------

-- ONE-SIDED, λ□ ONLY: `Nat.div` is in `javaAxioms` (as `PRIM_DIV_LONG`) but not
-- in `builtinArityLong`, a named gap in `Formal/RtLong.ard`. So λ□ computes and
-- the Java model cannot -- the reverse of the situation this module documented
-- before the oracle existed.
\func natDivKn : Kername => \new Kername (mpDot (mpFile nil) "Nat") "div"

\func natDivProgram : LBProgram =>
  ((natDivKn, constantDecl (\new ConstantBody nothing)) :: nil,
   app (app (const natDivKn) (prim (primInt63, 42))) (prim (primInt63, 5)))

\func natDivInLambdaBox
  : runProgram lbAxioms natDivProgram 200 = rOk (prim (primInt63, 8)) => idp

\func natDivDisagrees : bothAgree natDivProgram 200 = false => idp

-- NEITHER SIDE: `Array.push` is realized by `javaAxioms` and modelled by
-- neither oracle -- λ□'s value domain has no store, and `builtinArityLong` omits
-- the `ARRAY_*` family. Both stuck, which is the honest report.
\func arrayPushKn : Kername => \new Kername (mpDot (mpFile nil) "Array") "push"

\func arrayProgram : LBProgram =>
  ((arrayPushKn, constantDecl (\new ConstantBody nothing)) :: nil,
   app (app (const arrayPushKn) box) (prim (primInt63, 1)))

\func arrayStuckInLambdaBox : runProgram lbAxioms arrayProgram 200 = rStuck => idp

\func arrayDisagrees : bothAgree arrayProgram 200 = false => idp

-- And `agrees` itself is not constant-true: it rejects the right tag with the
-- wrong fields, and a value of the wrong shape. Without these, every check
-- above would hold for a relation that says yes to everything.
\func agreesRejectsArity : agrees 20 (suc' zero') (vData 1 nil) = false => idp

\func agreesRejectsShape : agrees 20 box (vLong 0) = false => idp

\func agreesRejectsTag : agrees 20 zero' (vData 1 nil) = false => idp

-- 2^63 IS NOT A λ□ VALUE, and can no longer be written as one. This is the
-- sharpest statement of what putting the kind in the term bought.
--
-- These checks used to be about how GENEROUS the value relation had to be. The
-- λ□ side could hold 2^63 (the payload was an unbounded `Int`), the JVM `long`
-- holding those bits reads -2^63, and `agrees` was parameterized by a
-- normalization so that the `longRepr` pairing could call them equal -- "one
-- bit pattern, two readings". The two `Int`s really are different:
\func int63TwoReadingsDiffer
  : intEqB (pos 9223372036854775808) (neg 9223372036854775808) = false => idp

-- Now `PrimModel primInt63` is `Fin int63Mod` and `wrap63` is the only way in,
-- so the out-of-range term does not exist to be compared. Writing the literal
-- gives the value λ□ means by it, which is 0:
\func int63LiteralNormalizes
  : prim (primInt63, wrap63 (pos 9223372036854775808)) = prim (primInt63, 0) => idp

-- ... and THAT agrees with what the backend computes, exactly -- no
-- normalization in the relation, because there is nothing left to normalize.
\func int63NormalizedAgrees
  : agrees 20 (prim (primInt63, wrap63 (pos 9223372036854775808))) (vLong 0) = true => idp

-- The relation is still not constant-true at this value.
\func int63NormalizedRejectsOld
  : agrees 20 (prim (primInt63, wrap63 (pos 9223372036854775808)))
              (vLong (neg 9223372036854775808)) = false
  => idp
