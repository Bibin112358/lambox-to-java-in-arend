\import Debug
\import Example (testProgram)
\import ExampleAxiomCollision (axiomCollisionAttrsOCaml, axiomCollisionProgram)
\import ExampleConstBlowup (constBlowupProgram)
\import ExampleMangleCollision (mangleCollisionProgram)
\import ExampleMatMul (matMulAttrsC, matMulAttrsOCaml, matMulProgram)
\import ExamplePeano (addProgram)
\import Serialize
\import ToJava

-- =============================================================================
-- Printing entry points for the example programs.
--
-- Typechecking a definition here prints its result (`putStrLn` runs during
-- typechecking). Kept OUT of the Example*.ard modules on purpose: evaluating a
-- whole generated program needs a much bigger stack (the Arend CLI has to be
-- run with e.g. `-Xss1g`), while the example *definitions* themselves
-- typecheck with the default stack -- so the two can be checked independently.
--
-- Only the example entry points are imported by name, since the modules
-- otherwise share definition names (`decls`, `mainTerm`, ...).
--
-- A plain `*Java` uses the default int representation, Java's built-in 64-bit
-- integers (`targetLong`, the closest approximation of λ□'s int63 -- see
-- `JavaTarget` in ToJava.ard). The `*JavaBigInteger` variants use unbounded
-- `BigInteger` instead; both share the same runtime file, so only the printed
-- program differs.
-- =============================================================================

\func exampleJava => putStrLn (compileProgram testProgram)
\func exampleJavaBigInteger => putStrLn (compileProgramWith targetBigInteger testProgram)
\func exampleSexpr => putStrLn (LambdaBoxToSrting testProgram)

\func peanoJava => putStrLn (compileProgram addProgram)
\func peanoJavaBigInteger => putStrLn (compileProgramWith targetBigInteger addProgram)
\func peanoSexpr => putStrLn (LambdaBoxToSrting addProgram)

\func matMulJava => putStrLn (compileProgram matMulProgram)
\func matMulJavaBigInteger => putStrLn (compileProgramWith targetBigInteger matMulProgram)
\func matMulSexpr => putStrLn (LambdaBoxToSrting matMulProgram)
\func matMulAttrsCText => putStrLn (AttributesToString matMulAttrsC)
\func matMulAttrsOCamlText => putStrLn (AttributesToString matMulAttrsOCaml)

-- The three programs that exist to state a property of the GENERATOR rather
-- than to be a sample computation; the last two are open bugs. The `*Java`
-- entry points are for reading the generated source by hand -- only the
-- `*Sexpr` ones (and the attribute text) are what the corpus checks in.
\func constBlowupJava => putStrLn (compileProgram constBlowupProgram)
\func constBlowupSexpr => putStrLn (LambdaBoxToSrting constBlowupProgram)

\func mangleCollisionJava => putStrLn (compileProgram mangleCollisionProgram)
\func mangleCollisionSexpr => putStrLn (LambdaBoxToSrting mangleCollisionProgram)

\func axiomCollisionJava => putStrLn (compileProgram axiomCollisionProgram)
\func axiomCollisionSexpr => putStrLn (LambdaBoxToSrting axiomCollisionProgram)
\func axiomCollisionAttrsOCamlText => putStrLn (AttributesToString axiomCollisionAttrsOCaml)
