\import Data.String  -- the `"Prog"` class-name literal the `*Java` printers pass
\import Debug
\import Example (testProgram)
\import ExampleLetChain (letChainProgram)
\import ExampleMatMul (matMulAttrsC, matMulAttrsOCaml, matMulProgram, matMulProgramOf)
\import ExamplePeano (addProgram)
\import ExampleSort (sortProgram)
\import Compiler.Serialize
\import Compiler.ToJava

-- Printing entry points for the example programs: typechecking a definition
-- here prints its result (`putStrLn` runs during typechecking). `*Java` prints
-- the generated Java, `*Sexpr` the peregrine export (Compiler/Serialize.ard).
--
-- Kept apart from the Example*.ard modules because evaluating a whole
-- generated program needs a big stack (run the Arend CLI with e.g. `-Xss1g`),
-- while the definitions themselves check with the default one. Entry points
-- are imported by name since the example modules share definition names.

\func exampleJava => putStrLn (compileProgram "Prog" testProgram)
\func exampleSexpr => putStrLn (LambdaBoxToString testProgram)

\func peanoJava => putStrLn (compileProgram "Prog" addProgram)
\func peanoSexpr => putStrLn (LambdaBoxToString addProgram)

-- Insertion sort (corpus program `insertion-sort`); see ExampleSort.ard.
\func sortJava => putStrLn (compileProgram "Prog" sortProgram)
\func sortSexpr => putStrLn (LambdaBoxToString sortProgram)

\func matMulJava => putStrLn (compileProgram "Prog" matMulProgram)
\func matMulSexpr => putStrLn (LambdaBoxToString matMulProgram)
-- The same program at other sizes, for the runtime benchmark of the corpus
-- (`matmul250`): identical term shape, one literal apart. See
-- ExampleMatMul.sizeLitOf and test/README.md ("Performance").
\func matMulSexpr200 => putStrLn (LambdaBoxToString (matMulProgramOf 200))
\func matMulSexpr250 => putStrLn (LambdaBoxToString (matMulProgramOf 250))
\func matMulSexpr300 => putStrLn (LambdaBoxToString (matMulProgramOf 300))
\func matMulAttrsCText => putStrLn (AttributesToString matMulAttrsC)
\func matMulAttrsOCamlText => putStrLn (AttributesToString matMulAttrsOCaml)

-- The `letIn` worst case (corpus program `letchain`). Java only, so no
-- attribute files; see ExampleLetChain.ard.
\func letChainJava => putStrLn (compileProgram "Prog" letChainProgram)
\func letChainSexpr => putStrLn (LambdaBoxToString letChainProgram)
