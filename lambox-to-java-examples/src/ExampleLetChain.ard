\import Compiler.LambdaBox
\import Data.Bool
\import Data.Maybe
\import Data.String

-- A worst case for the `letIn` encoding (corpus program `letchain`): a hot
-- loop that is almost entirely `let`s.
--
--   letChainInner j acc = if j == 0 then acc else
--     let a1 = acc + 1 in let a2 = a1 + 1 in .. let aN = a(N-1) + 1 in
--     letChainInner (j - 1) aN
--   letChainOuter i acc = if i == 0 then acc else
--     letChainOuter (i - 1) (letChainInner INNER acc)
--   res = letChainOuter OUTER 0
--
-- The value is OUTER * INNER * N. Every let is used by the next and costs one
-- `add`, so the cost of the let encoding dominates. Two nested loops, because
-- λ□ `fix` compiles to non-tail Java recursion: the recursion depth is about
-- OUTER + INNER rather than their product.
--
-- Read a regression here as the ceiling, not the cost on real code
-- (`lean-matmul` is the realistic middle; `matmul` has no `letIn`). Values
-- above `Long.valueOf`'s cache are boxed on every `add`, which raises the
-- baseline. Conventions as in ExampleMatMul.ard (hand-written `bvar`s, the
-- peregrine `prim_*_int` axiom names); only the Java backend is targeted, so
-- there are no attribute files.

\func app2 (f a b : LBTerm) : LBTerm => app (app f a) b

-- `eqb` returns this 2-constructor inductive: constructor 0 is false, 1 is true,
-- matching the branch order of every `case` below.
\func boolInd : InductiveId => \new InductiveId (\new Kername (mpFile nil) "BoolBlock") 0

\func primAddRef : LBTerm => const (\new Kername (mpFile nil) "prim_add_int")

\func primSubRef : LBTerm => const (\new Kername (mpFile nil) "prim_sub_int")

\func primEqbRef : LBTerm => const (\new Kername (mpFile nil) "prim_eqb_int")

\func innerRef : LBTerm => const (\new Kername (mpFile nil) "letChainInner")

\func outerRef : LBTerm => const (\new Kername (mpFile nil) "letChainOuter")

\func resRef : LBTerm => const (\new Kername (mpFile nil) "res")

-- `k` nested lets wrapping `body`, each binding `<the previous one> + 1`.
--
-- Every value is `add (bvar 0) 1`: at each step the most recent binding is index
-- 0, so one uniform term serves the whole chain. The FIRST (outermost) let
-- therefore reads whatever index 0 is at the point this is spliced in, which is
-- the accumulator.
\func letsThen (k : Nat) (body : LBTerm) : LBTerm \elim k
  | 0 => body
  | suc k => letIn anon (app2 primAddRef (bvar 0) (prim (primInt63, 1))) (letsThen k body)

-- letChainInner, the loop whose body is the chain.
--
-- Inside the fix body the environment is [acc, j, self]; after `n` lets it is
-- [a_n .. a_1, acc, j, self], so `self` is index n+2 and `j` is n+1 -- which is
-- why `letsThen` is given a body computed from `n`.
\func innerBody (n : Nat) : LBTerm =>
  lambda anon (lambda anon (
    case boolInd 0 (app2 primEqbRef (bvar 1) (prim (primInt63, 0))) (
      -- j /= 0: run the chain, then recurse on (j - 1) with the last binding
      (nil, letsThen n (app2 (bvar (n Nat.+ 2))
                             (app2 primSubRef (bvar (n Nat.+ 1)) (prim (primInt63, 1)))
                             (bvar 0))) ::
      -- j == 0: the accumulator
      (nil, bvar 0) ::
      nil
    )
  ))

\func innerFix (n : Nat) : LBTerm => fix ((\new FixDef LBTerm anon (innerBody n) 0) :: nil) 0

-- letChainOuter: the same loop shape with no lets, only to keep the recursion
-- depth of the whole program proportional to OUTER + INNER rather than to their
-- product. Environment inside its fix body is [acc, i, self].
\func outerBody (inner : Nat) : LBTerm =>
  lambda anon (lambda anon (
    case boolInd 0 (app2 primEqbRef (bvar 1) (prim (primInt63, 0))) (
      (nil, app2 (bvar 2)
                 (app2 primSubRef (bvar 1) (prim (primInt63, 1)))
                 (app2 innerRef (prim (primInt63, inner)) (bvar 0))) ::
      (nil, bvar 0) ::
      nil
    )
  ))

\func outerFix (inner : Nat) : LBTerm => fix ((\new FixDef LBTerm anon (outerBody inner) 0) :: nil) 0

\func resBodyOf (outer : Nat) : LBTerm => app2 outerRef (prim (primInt63, outer)) (prim (primInt63, 0))

-- Dependents first, as in ExampleMatMul.declsOf.
\func declsOf (lets inner outer : Nat) : GlobalDeclarations =>
  (\new Kername (mpFile nil) "res", constantDecl (\new ConstantBody (just (resBodyOf outer)))) ::
  (\new Kername (mpFile nil) "letChainOuter", constantDecl (\new ConstantBody (just (outerFix inner)))) ::
  (\new Kername (mpFile nil) "letChainInner", constantDecl (\new ConstantBody (just (innerFix lets)))) ::
  (\new Kername (mpFile nil) "prim_eqb_int", constantDecl (\new ConstantBody nothing)) ::
  (\new Kername (mpFile nil) "prim_sub_int", constantDecl (\new ConstantBody nothing)) ::
  (\new Kername (mpFile nil) "prim_add_int", constantDecl (\new ConstantBody nothing)) ::
  -- Required: peregrine checks `case` exhaustiveness against it. Constructor
  -- order is the ABI for `eqb`'s result: false is tag 0.
  (\new Kername (mpFile nil) "BoolBlock", inductiveDecl (\new MutualInductiveBody finite 0
                                                             ((\new OneInductiveBody "Bool" false IntoAny
                                                                    ((\new ConstructorBody "false" 0) :: (\new ConstructorBody "true" 0) :: nil)
                                                                    nil) :: nil))) ::
  nil

\func letChainProgramOf (lets inner outer : Nat) : LBProgram => (declsOf lets inner outer, resRef)

-- 20 lets, 10000 x 2000 iterations: 400,000,000 lets evaluated, recursion
-- depth ~12000. Sized so that the run takes seconds, well above JVM warmup
-- (see test/README.md, "Performance").
\func letChainProgram : LBProgram => letChainProgramOf 20 10000 2000
